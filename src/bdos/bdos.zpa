; ==========================================================================
; CP/M BDOS — Z80-native Basic Disk Operating System
; ==========================================================================
;
; @extern setup_fcb
; @param  %fcb:u16  de
; @out    ix
; @clobbers af,bc,hl
; @end
;
; @extern writeback_fcb
; @clobbers af,bc,de,hl
; @end
;
; @extern read_user_byte
; @param  %addr:u16 de
; @out    a
; @clobbers bc
; @end
;
; @extern write_user_byte
; @param  %byte:u8  a
; @param  %addr:u16 de
; @clobbers bc
; @end
;
; @extern copy_from_user
; @param  %src:u16  hl
; @param  %dst:u16  de
; @param  %count:u16 bc
; @clobbers af,bc
; @end
;
; @extern copy_to_user
; @param  %src:u16  hl
; @param  %dst:u16  de
; @param  %count:u16 bc
; @clobbers af,bc
; @end
;
; @extern copy_record_to_tpa
; @param  %src:u16  hl
; @param  %dst:u16  de
; @clobbers af,bc,de,hl
; @end
;
; @extern copy_record_from_tpa
; @param  %src:u16  hl
; @param  %dst:u16  de
; @clobbers af,bc,de,hl
; @end
;
; Implements the CP/M 2.2 BDOS API in native Z80 assembly.
; Called via JP at address 0005h.
;
; Key functions for a usable system:
;   Console: F0-F2, F6, F9-F12 (already working)
;   Disk:    F13-F14, F17-F18, F20, F22, F24-F27, F31-F32
;   File:    F15-F16, F19-F21, F22, F33-F36
;
; CP/M file system basics:
;   - Directory: 32-byte entries (extents) at start of data area
;   - Each extent: user, name[8], type[3], EX, S1, S2, RC, alloc[16]
;   - Block allocation tracked via bitmap (ALV)
;   - Files span multiple extents if > 16 blocks
;   - Sequential I/O via FCB fields: CR (current record), EX (extent)
;
; ==========================================================================

; BDOS stack and saved_sp are in common memory (common.asm).
; The common stub switches to bdos_stack before calling bdos_entry.

rdbuf_ptr:  dw 0               ; Buffer pointer for F10

; --- BDOS state ---
bdos_dma:   dw 0x0080          ; Current DMA address (default 0080h)
cur_disk:   db 0               ; Current default disk (0=A:) — the drive
                               ; letter visible at the CCP prompt. Only
                               ; fn 13 (Reset) and fn 14 (Select Disk)
                               ; change this. File functions that target
                               ; a specific drive via FCB[0] pass the drive
                               ; number directly to select_drive — they
                               ; don't touch cur_disk.
cur_user:   db 0               ; Current user number (0-15)
iobyte:     db 0               ; IOBYTE (F7/F8)
login_vec:  dw 0               ; Login vector (bit N = drive N logged in)
ro_vec:     dw 0               ; Read-only vector
error_mode: db 0               ; F45: BDOS error mode
con_mode:   dw 0x0003          ; F109: console mode word (default: PAGE + DISPLAY on)
                               ; bit 0 = PAGE    (SETDEF [PAGE]/[NOPAGE])
                               ; bit 1 = DISPLAY (SETDEF [DISPLAY]/[NO DISPLAY])
bdos_page_row: db 0            ; LFs output since last pause/input
out_delim:  db '$'             ; F110: F9 output delimiter

; --- Multi-sector I/O (F44) state ---
; The record count itself lives in the SCB (scb_multi) so F49 sees it.
; These track a transfer in progress.
ms_active:  db 0               ; 1 = inner record handlers return to caller
ms_left:    db 0               ; records left to transfer
ms_done:    db 0               ; records transferred so far
ms_result:  db 0               ; non-zero result from the inner handler
ms_fcb:     dw 0               ; user FCB pointer across iterations

; --- F46 free-space scratch ---
f46_left:   dw 0               ; blocks still to scan
f46_ptr:    dw 0               ; current ALV byte pointer
f46_mask:   db 0               ; bit mask within the current byte
f46_byte:   db 0               ; current ALV byte

; --- F40 zero-fill scratch ---
f40_zfill:  db 0               ; 1 = the next allocation must be zeroed
f40_pending: db 0              ; request consumed by bf_f21_core
f40_block:  dw 0               ; block being filled
f40_left:   db 0               ; records still to write
f40_rec:    dw 0               ; next absolute record in that block

; --- F59 / F111 scratch ---
f59_fcb:    dw 0               ; FCB passed to F59
f59_dest:   dw 0               ; load address from FCB+21h
f59_dma:    dw 0               ; saved DMA address
f111_addr:  dw 0               ; F111 text address
f111_len:   dw 0               ; F111 text length
f111_cb:    dw 0               ; F111 control block pointer
f99_target: dw 0               ; F99 requested length in records
f99_size:   dw 0               ; F99 current length in records
f99_pos:    dw 0               ; F99 directory scan position
f99_entry:  dw 0               ; F99 current directory entry
f99_blocks: db 0               ; F99 first alloc slot to free
f99_newrc:  db 0               ; F99 record count for the cut extent
f99_found:  db 0               ; F99 saw at least one extent

; Private SETDEF state (F120..F123). Not in the SCB — only reachable via
; our own BDOS functions. Default: no search path (current drive only),
; COM searched before SUB.
bdos_search_path: db 0xFF, 0, 0, 0   ; 4 drive slots: 0=empty, 1..16=A..P, 0xFF='*'
bdos_order:     db 0           ; 0=COM→SUB, 1=SUB→COM, 2=COM only, 3=SUB only
; Date/time fields are in the SCB (common.asm): scb_date, scb_minute, scb_sec

; Directory search state
search_pos: dw 0               ; Next directory entry to examine
search_fcb: dw 0               ; FCB being searched for
last_dir_sec: db 0xFF          ; Directory sector of last read_dir_entry (0xFF=invalid)
last_dir_drv: db 0xFF          ; Drive of last read_dir_entry cache (0xFF=invalid)

; Cached DPB values for current disk (avoid repeated pointer chasing)
cached_spt: dw 0               ; Sectors per track
cached_bsh: db 0               ; Block shift
cached_blm: db 0               ; Block mask
cached_dsm: dw 0               ; Max block number
cached_drm: dw 0               ; Max directory entry
cached_off: dw 0               ; Reserved track offset
cached_dpb: dw 0               ; Pointer to DPB
cached_alv: dw 0               ; Pointer to ALV
cached_csv: dw 0               ; Pointer to CSV
cached_drive: db 0xFF          ; Drive the cached_* above refer to (0xFF = none).
                               ; select_drive short-circuits when called for the
                               ; same drive, avoiding a full directory scan per
                               ; F20/F21/F33/F40 record. F13 invalidates it.
cached_blk16: db 0             ; 1 = DSM > 255: eight 16-bit block numbers per
                               ; extent, high byte first, instead of sixteen
                               ; 8-bit ones (CP/M 3 16-bit block format).

; Scratch for the allocation-map loops (build_alv, F19, F99).
map_base:   dw 0               ; 32-byte FCB or directory entry being scanned
map_idx:    db 0               ; current block slot


; ==========================================================================
; BDOS entry point
; ==========================================================================

bdos_entry:
    ; lint-exempt: stack  ; handlers pop saved BC/DE; bdos_ret rebases SP
    ; SP is already set to bdos_stack by the common stub (bdos_stub).
    ; The common stub also saved the user's SP in saved_sp.
    push bc                    ; Save function and parameter
    push de

    ld a, c
    ; --- Dispatch (compact table lookup) ---
    cp 51
    jr c, .low
    cp 99
    jr c, .mid
    cp 124
    jp nc, bdos_eok             ; 124+: unsupported
    sub 99
    add a, a
    ld e, a
    ld d, 0
    ld hl, dispatch_ext
    add hl, de
    ld a, (hl)
    inc hl
    ld h, (hl)
    ld l, a
    jp (hl)
.mid:
    ; 51..98: only a few are meaningful on this banked system.
    cp 59
    jp z, bf_f59                ; load overlay
    cp 60
    jp z, bdos_efail            ; call RSX - no RSXs resident
    cp 98
    jp z, bf_f98                ; clean up disc (CCP helper)
    jp bdos_eok                 ; 51..58, 61..97: unused/no-op
.low:
    add a, a
    ld e, a
    ld d, 0
    ld hl, dispatch_low
    add hl, de
    ld a, (hl)
    inc hl
    ld h, (hl)
    ld l, a
    jp (hl)

; Function number -> handler.  Slots that the old linear chain let fall
; through use bdos_eok (unknown/no-op) or bdos_efail (explicitly
; unsupported).  Handlers pop the saved BC/DE themselves; bdos_ret
; rebases SP, so the eok/efail stubs do not need to.
dispatch_low:
    dw bf_f00, bf_f01, bf_f02, bf_f03, bf_f04, bf_f05, bf_f06, bf_f07
    dw bf_f08, bf_f09, bf_f10, bf_f11, bf_f12, bf_f13, bf_f14, bf_f15
    dw bf_f16, bf_f17, bf_f18, bf_f19, bf_f20, bf_f21, bf_f22, bf_f23
    dw bf_f24, bf_f25, bf_f26, bf_f27, bf_f28, bf_f29, bf_f30, bf_f31
    dw bf_f32, bf_f33, bf_f34, bf_f35, bf_f36, bf_f37
    dw bdos_eok, bdos_eok                 ; 38, 39
    dw bf_f40
    dw bdos_eok, bdos_eok, bdos_eok  ; 41-43
    dw bf_f44
    dw bf_f45, bf_f46
    dw bf_f47
    dw bf_f48, bf_f49, bf_f50

dispatch_ext:                             ; function 99..123
    dw bf_f99, bdos_efail                 ; 99 truncate, 100 set label
    dw bdos_eok                           ; 101
    dw bdos_efail, bdos_efail             ; 102, 103
    dw bf_f104, bf_f105
    dw bdos_eok, bf_f107, bf_f108   ; 106, 107, 108
    dw bf_f109
    dw bf_f110, bf_f111, bf_f112    ; 110, 111, 112
    dw bdos_eok, bdos_eok, bdos_eok, bdos_eok, bdos_eok, bdos_eok, bdos_eok  ; 113-119
    dw bf_f120, bf_f121, bf_f122, bf_f123

; @proc bdos_ret
; @out   hl
; @out   a
; @clobbers af,bc,de,hl
; @end
bdos_ret:
    ; Return to common stub (bdos_stub).
    ; The CALL from bdos_stub pushed its return address at bdos_stack - 2.
    ; Reset SP to that point regardless of what BDOS functions pushed/popped.
    ld sp, bdos_stack - 2
    ret


; Shared return stubs for unimplemented extended functions.
; @proc bdos_efail
; @out   a
; @out   hl
; @clobbers af,hl
; @end
bdos_efail:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

; @proc bdos_eok
; @out   a
; @out   hl
; @clobbers af,hl
; @end
bdos_eok:
    xor a
    ld l, a
    ld h, a
    jp bdos_ret


; ==========================================================================
; Return helpers for the multi-sector wrappers
; ==========================================================================

; bdos_exit — return to the caller of a record core, or to the user
;   In:  A, HL = BDOS result already set
;   Out: nothing (returns to the wrapper, or to bdos_stub)
; @proc bdos_exit
; @out   a
; @out   hl
; @clobbers af
; @end
bdos_exit:
    ; lint-exempt: stack  ; two exit paths by design
    push af
    ld a, (ms_active)
    or a
    jr z, .full
    pop af
    ret                        ; back to multi_read/multi_write/F59
.full:
    pop af
    jp bdos_ret

; @proc bdos_eok_x
; @out   a
; @out   hl
; @clobbers af
; @end
bdos_eok_x:
    xor a
    ld l, a
    ld h, a
    jp bdos_exit

; @proc bdos_efail_x
; @out   a
; @out   hl
; @clobbers af
; @end
bdos_efail_x:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_exit


; ==========================================================================
; F44 single-record pass-through
; ==========================================================================
;
; The multi-sector count is accepted and kept in the SCB, but this BDOS
; transfers one record per call and reports it in H.  CP/M 3 allows a
; partial transfer, so programs that honour H (PIP does) just call again
; for the rest, and programs that ignore H see exactly the single-record
; behaviour they expect.

; @proc multi_read
; @param %fcb:u16 de
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
multi_read:
    ; lint-exempt: stack  ; returns through bdos_ret
    ld (ms_fcb), de
    ld a, 1
    ld (ms_active), a
    ld de, (ms_fcb)
    call f20_body
    push af
    xor a
    ld (ms_active), a
    pop af
    or a
    jr nz, .mr_out
    ld h, 1
.mr_out:
    jp bdos_ret

; @proc multi_write
; @param %fcb:u16 de
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
multi_write:
    ; lint-exempt: stack  ; returns through bdos_ret
    ld (ms_fcb), de
    ld a, 1
    ld (ms_active), a
    ld de, (ms_fcb)
    call f21_body
    push af
    xor a
    ld (ms_active), a
    pop af
    or a
    jr nz, .mw_out
    ld h, 1
.mw_out:
    jp bdos_ret


; sync_page0_du — Keep page zero 0004 = (user << 4) | drive
;   In:  nothing
;   Out: nothing
;   Clobbers: AF, BC, DE
; @proc sync_page0_du
; @clobbers af,bc,de
; @end
sync_page0_du:
    ld a, (cur_user)
    add a, a
    add a, a
    add a, a
    add a, a
    ld b, a
    ld a, (cur_disk)
    and 0x0F
    or b
    ld de, 0x0004
    call write_user_byte
    ret


; ==========================================================================
; Paging support — honors con_mode bit 0 (PAGE). Only BDOS-routed output
; paginates; direct BIOS/XBIOS output bypasses this wrapper.
; ==========================================================================

CON_MODE_PAGE    equ 0x01
CON_MODE_DISPLAY equ 0x02

; bdos_con_out — BIOS con_out with optional page-break pause
;   In: C = char
;   Clobbers: AF, BC, DE, HL, IX
; @proc bdos_con_out
; @param %char:u8 c
; @clobbers af,bc,de,hl,ix
; @end
bdos_con_out:
    ld a, c
    cp 0x0A
    jp nz, con_out             ; only LFs drive the page counter
    ld a, (con_mode)
    and CON_MODE_PAGE
    jp z, .tick                ; paging disabled → just count and emit
    ld a, (bdos_page_row)
    ld hl, scb_conpage
    cp (hl)                    ; A < conpage (page not full)?
    jr c, .tick
    ; Page is full.  Emit this LF first so the prompt lands on a fresh row:
    ; printing it before the LF would overwrite the line that was just
    ; written when the prompt is erased.
    ld c, 0x0A
    call con_out
    call bdos_page_pause       ; page full → pause (resets counter)
    ret
.tick:
    ld a, (bdos_page_row)
    inc a
    ld (bdos_page_row), a
    ld c, 0x0A
    jp con_out

; bdos_page_pause — show "-- More --", wait for key, erase, reset counter
;   Clobbers: AF, BC, DE, HL, IX
; @proc bdos_page_pause
; @clobbers af,bc,de,hl,ix
; @end
bdos_page_pause:
    ld hl, bdos_pause_msg
.msg_loop:
    ld a, (hl)
    or a
    jr z, .wait_key
    ld c, a
    push hl
    call con_out
    pop hl
    inc hl
    jr .msg_loop
.wait_key:
    call con_in
    cp 0x03                    ; Ctrl-C aborts to warm boot
    jp z, fn_wboot
    ; Erase prompt: CR, ESC, 'K' (clear to end of line)
    ld c, 0x0D
    call con_out
    ld c, 0x1B
    call con_out
    ld c, 'K'
    call con_out
    xor a
    ld (bdos_page_row), a
    ret

bdos_pause_msg: db 'Press RETURN to continue.', 0


; ==========================================================================
; Console functions (F0-F12)
; ==========================================================================

; F0: System Reset (warm boot)
; @proc bf_f00
; @param %param:u16 de
; @param %func:u8   c
; @clobbers af,bc,de,hl
; @end
bf_f00:
    pop de
    pop bc
    jp fn_wboot

; @proc bf_f01
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix
; @end
bf_f01:
    pop de
    pop bc
    xor a
    ld (bdos_page_row), a      ; input resets paging context
    call con_in
    push af                    ; lint: ignore — saving A return value, F is harmless
    ld c, a
    call con_out               ; Echo
    pop af
    jp bdos_ret

; @proc bf_f02
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix
; @end
bf_f02:
    pop de
    pop bc
    ld c, e
    call bdos_con_out
    jp bdos_ret

; F3: Auxiliary Input (reader)
;   Out: A = character from aux device
;   For now, returns 0x1A (Ctrl-Z / EOF) since we have no aux device
; @proc bf_f03
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f03:
    pop de
    pop bc
    ld a, 0x1A
    ld l, a
    ld h, 0
    jp bdos_ret

; F4: Auxiliary Output (punch)
;   In: E = character to send to aux device
;   Silently discards (no aux hardware)
; @proc bf_f04
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @clobbers af,bc,de,hl
; @end
bf_f04:
    pop de
    pop bc
    xor a
    jp bdos_ret

; F5: List Output (printer)
;   In: E = character to send to printer
;   Silently discards (no printer hardware)
; @proc bf_f05
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @clobbers af,bc,de,hl
; @end
bf_f05:
    pop de
    pop bc
    xor a
    jp bdos_ret

; @proc bf_f06
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix
; @end
bf_f06:
    pop de
    pop bc
    ld a, e
    cp 0xFF
    jp z, .input
    cp 0xFE
    jp z, .status
    ld c, e
    call con_out               ; direct I/O bypasses BDOS pagination
    jp bdos_ret
.input:
    xor a
    ld (bdos_page_row), a
    call con_status
    or a
    jp z, .none
    call con_in
    jp bdos_ret
.none:
    xor a
    jp bdos_ret
.status:
    call con_status
    jp bdos_ret

; F7: Get IOBYTE
; @proc bf_f07
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f07:
    pop de
    pop bc
    ld a, (iobyte)
    ld l, a
    ld h, 0
    jp bdos_ret

; F8: Set IOBYTE
;   In: E = new IOBYTE value
; @proc bf_f08
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @clobbers af,bc,de,hl
; @end
bf_f08:
    pop de
    pop bc
    ld a, e
    ld (iobyte), a
    ld de, 0x0003
    call write_user_byte
    jp bdos_ret

; @proc bf_f09
; @param %str:u16   de
; @param %func:u8   c
; @out   a
; @clobbers af,bc,de,hl,ix
; @end
bf_f09:
    pop de
    pop bc
.ploop:
    call read_user_byte(de) preserving %func        ; A = byte at (DE) in TPA
    ld b, a
    ld a, (out_delim)
    cp b
    jp z, bdos_ret
    ld c, b
    push de
    call bdos_con_out
    pop de
    inc de
    jp .ploop

; @proc bf_f10
; @param %buf:u16   de
; @param %func:u8   c
; @out   a
; @clobbers af,bc,de,hl,ix
; @end
bf_f10:
    pop de
    pop bc
    xor a
    ld (bdos_page_row), a
    ld (rdbuf_ptr), de
    call read_user_byte(de) preserving %func    ; A = max chars from buffer[0] in TPA (DE = buf addr)
    ld b, a
    ld c, 0                    ; C = count
.rd_loop:
    push bc
    call con_in
    pop bc
    cp 0x0D
    jp z, .rd_done
    cp 0x08
    jp z, .rd_bs
    cp 0x7F
    jp z, .rd_bs
    cp 0x03
    jp z, .rd_ctlc
    cp 0x1B
    jp z, .rd_esc
    cp 0x20
    jp c, .rd_loop
    push af
    ld a, c
    cp b
    jp nc, .rd_full
    pop af
    push bc
    ld hl, (rdbuf_ptr)
    ld e, c
    ld d, 0
    add hl, de
    inc hl
    inc hl
    ex de, hl                  ; DE = target address in TPA
    call write_user_byte(a, de) preserving %func ; Write A to user buffer
    pop bc
    inc c
    push bc
    ld c, a
    call con_out
    pop bc
    jp .rd_loop
.rd_full:
    pop af
    jp .rd_loop
.rd_bs:
    ld a, c
    or a
    jp z, .rd_loop
    dec c
    push bc
    ld c, 0x08
    call con_out
    ld c, ' '
    call con_out
    ld c, 0x08
    call con_out
    pop bc
    jp .rd_loop
.rd_ctlc:
    push bc
    ld c, '^'
    call con_out
    ld c, 'C'
    call con_out
    pop bc
    jp fn_wboot
.rd_esc:
    ; Let ESC reach the screen: the +3 manual changes screen size and
    ; colours by typing BREAK (ESC) sequences at the command prompt.
    ; The following characters are echoed normally and also enter the
    ; command line, exactly as the manual describes.
    push bc
    ld c, 0x1B
    call con_out
    pop bc
    jp .rd_loop
.rd_done:
    ld hl, (rdbuf_ptr)
    inc hl
    ex de, hl                  ; DE = &buffer[1] in TPA
    ld a, c
    call write_user_byte(a, de) preserving %func ; Write char count to TPA
    ld c, 0x0D
    call con_out
    ld c, 0x0A
    call con_out
    jp bdos_ret

; @proc bf_f11
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f11:
    pop de
    pop bc
    call con_status
    jp bdos_ret

; @proc bf_f12
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f12:
    pop de
    pop bc
    ld hl, 0x0031              ; CP/M 3.1, H=0 (CP/M system type, not MP/M)
    ld a, l
    jp bdos_ret


; ==========================================================================
; Disk management (F13-F14, F24-F27, F31-F32, F37)
; ==========================================================================

; F13: Reset disk system
; F13: Reset Disk System
;   Resets cur_disk, login_vec, ro_vec, bdos_dma per CP/M spec.
;   Re-logins drive A immediately so DPB cache and ALV are valid.
; @proc bf_f13
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f13:
    pop de
    pop bc
    xor a
    ld (cur_disk), a
    ld hl, 0
    ld (login_vec), hl
    ld (ro_vec), hl
    ld hl, 0x0080
    ld (bdos_dma), hl
    ld (scb_dma), hl
    ; Invalidate the drive cache so the select_drive below actually does
    ; the sel_disk + DPB refetch + ALV rebuild (disc may have changed).
    ld a, 0xFF
    ld (cached_drive), a

    ; Discard cached directory and deblock state as well.  Flush first so
    ; a clean reset does not lose a pending write; a real disc change
    ; should be done while no writes are pending.
    call flush_deblock
    ld a, 0xFF
    ld (last_dir_sec), a
    ld (last_dir_drv), a
    ld (deblock_drv), a
    xor a
    ld (deblock_dirty), a

    ; Re-login drive A: caches DPH/DPB/ALV pointers and rebuilds ALV
    xor a
    call select_drive
    jp bdos_eok

; F14: Select disk (E = drive number)
; @proc bf_f14
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f14:
    ; Select Disk is intentionally lightweight — we only update cur_disk;
    ; we do NOT call select_drive here. Doing a seek + READ ID + ALV
    ; rebuild just because the user typed "B:" at the prompt surprises
    ; the user and matches +3DOS's behaviour (CP/M Plus also treats
    ; SELDSK at the BIOS as a deferred first-login hint). The next file
    ; op (fn 15, 17, 19, etc.) will call select_drive and pick up the
    ; DPH/DPB/ALV for the new drive then.
    pop de
    pop bc
    ld a, e
    ld (cur_disk), a
    call sync_page0_du
    ld hl, 0                   ; Return 0 = OK. Drive validity is checked
    ld a, l                    ; on the first file op, not here.
    jp bdos_ret

; F24: Return login vector
; @proc bf_f24
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f24:
    pop de
    pop bc
    ld hl, (login_vec)
    ld a, l
    jp bdos_ret

; F25: Return current disk
; @proc bf_f25
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f25:
    pop de
    pop bc
    ld a, (cur_disk)
    ld l, a
    ld h, 0
    jp bdos_ret

; F26: Set DMA address
; @proc bf_f26
; @param %dma:u16   de
; @param %func:u8   c
; @out   a
; @clobbers af,bc,de,hl
; @end
bf_f26:
    pop de
    pop bc
    ld (bdos_dma), de
    ld (scb_dma), de
    xor a                       ; defined result (SETDMA has no return value)
    jp bdos_ret

; F27: Get allocation vector
; @proc bf_f27
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f27:
    pop de
    pop bc
    ; Refresh cached_* for the current drive; F14 deliberately does not
    ; select, so the last file operation may belong to another drive.
    ld a, (cur_disk)
    call select_drive
    jp c, .f27_err
    ld hl, (cached_alv)
    ld a, l
    jp bdos_ret
.f27_err:
    ld hl, 0
    xor a
    jp bdos_ret

; F28: Write Protect Disk
;   Sets the current disk read-only by setting its bit in ro_vec.
;   In:  nothing (uses cur_disk)
;   Out: nothing
;   Clobbers: AF, BC, DE, HL
; @proc bf_f28
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @clobbers af,bc,de,hl
; @end
bf_f28:
    pop de
    pop bc
    ld a, (cur_disk)
    ld b, a
    ld de, 1
    inc b
.shift:
    dec b
    jp z, .done
    sla e
    rl d
    jp .shift
.done:
    ld hl, (ro_vec)
    ld a, l
    or e
    ld l, a
    ld a, h
    or d
    ld h, a
    ld (ro_vec), hl
    jp bdos_ret

; F29: Get read-only vector
; @proc bf_f29
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f29:
    pop de
    pop bc
    ld hl, (ro_vec)
    ld a, l
    jp bdos_ret

; F30: Set File Attributes
;   In:  DE = FCB with attribute bits set in filename bytes 9-11 (bit 7)
;   Out: HL = 0 (OK), 0xFF (not found)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f30
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f30:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf

    ; Select drive from FCB (or cur_disk if FCB[0]=0). Don't touch cur_disk.
    call select_fcb_drive
    jp c, .f30_not_found       ; invalid drive → not found
    call is_fcb_readonly
    jp nz, .f30_not_found      ; read-only → not found

    ; Scan directory for matching entries
    ld de, 0
    ld bc, 0                   ; B = found count, C = don't-care
.f30_scan:
    push de
    push bc
    call read_dir_entry
    pop bc
    pop de
    jp c, .f30_done

    ; Only entries for the current user (0xE5 = deleted).
    ld a, (hl)
    cp 0xE5
    jp z, .f30_next
    ld a, (cur_user)
    cp (hl)
    jp nz, .f30_next

    ; Match name (bytes 1-8, ignoring attribute bits)
    push de
    push bc
    push hl
    push ix
    pop de                     ; DE = fcb_buf
    ; Compare bytes 1-8 (name) with bit 7 masked
    ld c, 8
    inc hl                     ; Skip user byte in dir entry
    inc de                     ; Skip drive byte in FCB
.f30_cmp_name:
    ld a, (de)
    and 0x7F
    ld b, a
    ld a, (hl)
    and 0x7F
    cp b
    jr nz, .f30_no_match
    inc hl
    inc de
    dec c
    jr nz, .f30_cmp_name

    ; Compare bytes 9-11 (type) with bit 7 masked
    ld c, 3
.f30_cmp_type:
    ld a, (de)
    and 0x7F
    ld b, a
    ld a, (hl)
    and 0x7F
    cp b
    jr nz, .f30_no_match
    inc hl
    inc de
    dec c
    jr nz, .f30_cmp_type

    ; Match — update attribute bits (bytes 9-11) in directory entry
    pop hl                     ; HL = dir entry base
    push hl
    ld de, 9                   ; Offset to first type byte (T1)
    add hl, de                 ; HL = &entry[9]
    push ix
    pop de
    ld a, 9
    add a, e
    ld e, a                    ; DE = &fcb_buf[9]
    ; Copy attribute bits: for each of 3 bytes, replace bit 7
    ld c, 3
.f30_set_attr:
    ld a, (de)                 ; FCB byte (with desired attribute bit)
    and 0x80                   ; Keep only attribute bit
    ld b, a
    ld a, (hl)                 ; Directory byte
    and 0x7F                   ; Clear old attribute bit
    or b                       ; Set new attribute bit
    ld (hl), a
    inc hl
    inc de
    dec c
    jr nz, .f30_set_attr

    call write_dir_entry

    pop hl
    pop bc
    pop de
    inc b                      ; Found count++
    jr .f30_next

.f30_no_match:
    pop hl
    pop bc
    pop de
.f30_next:
    inc de
    jp .f30_scan

.f30_done:
    ld a, b
    or a
    jp z, .f30_not_found
    xor a
    ld l, a
    ld h, 0
    jp bdos_ret
.f30_not_found:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

; F31: Get DPB address
; @proc bf_f31
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f31:
    pop de
    pop bc
    ; Make sure cached_dpb belongs to cur_disk (F14 does not select).
    ld a, (cur_disk)
    call select_drive
    jp c, .f31_err
    ld hl, (cached_dpb)
    ld a, l
    jp bdos_ret
.f31_err:
    ld hl, 0
    xor a
    jp bdos_ret

; F32: Get/Set user code
; @proc bf_f32
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f32:
    pop de
    pop bc
    ld a, e
    cp 0xFF
    jp z, .get
    and 0x0F
    ld (cur_user), a
    push af
    call sync_page0_du
    pop af
    jp bdos_ret
.get:
    ld a, (cur_user)
    ld l, a
    ld h, 0
    jp bdos_ret

; F37: Reset drive (DE = drive vector)
; @proc bf_f37
; @param %drives:u16 de
; @param %func:u8    c
; @out   a
; @clobbers af,bc,de,hl
; @end
bf_f37:
    pop de
    pop bc
    ; Clear login bits for specified drives
    ld hl, (login_vec)
    ld a, e
    cpl
    and l
    ld l, a
    ld a, d
    cpl
    and h
    ld h, a
    ld (login_vec), hl
    ; Invalidate cached_drive so select_drive won't short-circuit on
    ; a drive whose login bits we just cleared (mirrors F13 logic).
    ld a, 0xFF
    ld (cached_drive), a
    jp bdos_ret


; ==========================================================================
; @proc select_drive
; @param %drive:u8  a
; @out   carry
; @clobbers af,bc,de,hl,iy
; @end
; Internal: select_drive — Log in a drive, cache its DPB parameters for
; subsequent file operations.
;   In:  A = drive number (0=A:, 1=B:, ...)
;   Out: CF=0 on success (cached_* populated), CF=1 if drive not present.
;        cur_disk is NOT touched — this call is independent of the user's
;        default drive (FCB-drive overrides don't change A: to B:).
;   Clobbers: AF, BC, DE, HL
;
; IX is preserved across this call (we save/restore it ourselves) so
; BDOS file functions that hold IX = fcb_buf don't have to.
; ==========================================================================
select_drive:
    ; Fast path: same drive as last successful select — cached_* still apply,
    ; and ALV is up to date (F13 invalidates cached_drive on Reset). Skip
    ; sel_disk / DPB refetch / build_alv entirely.
    ld c, a                    ; C = drive — preserved across BIOS calls
    ld a, (cached_drive)
    cp c
    ret z
    ld a, c
    push ix                    ; fdc_login (via BIOS) clobbers IX
    push bc                    ; .select_body/build_alv clobbers BC; keep requested drive in C
    call .select_body
    pop bc
    jr c, .sd_err              ; invalid drive — leave cached_drive alone
    ld a, c
    ld (cached_drive), a       ; mark this drive as the currently cached one
.sd_err:
    pop ix
    ret

.select_body:
    ; Check if already logged in
    ld e, 0                    ; E=0: not logged in yet
    ld hl, (login_vec)
    ld b, a
    inc b
.shift:
    srl h
    rr l
    djnz .shift
    bit 0, l
    jp z, .do_login
    ld e, 1                    ; Already logged in
.do_login:
    push bc                    ; save drive in C — sel_disk clobbers BC on first-login
    push de                    ; save login flag
    call sel_disk              ; In: C = drive. Out: HL = DPH (0 = error).
    pop de
    pop bc
    ld a, h
    or l
    jp z, .sb_err              ; Invalid drive — return CF=1

    ; On first login of this drive, probe the disc format so the XDPB
    ; reflects what's actually inserted (Freeze=FF makes re-login a no-op).
    ld a, e
    or a
    jr nz, .skip_login         ; E=1 → already logged in this session
    bit 1, c
    jr nz, .skip_login         ; non-FDC drives provide their own SELDSK/login
    push hl                    ; save DPH (fdc_login clobbers HL, IX)
    push bc                    ; save drive in C (fdc_login clobbers BC)
    call fdc_login
    pop bc
    pop hl
.skip_login:

    ; Mark drive as logged in (C = drive, preserved)
    ld a, c
    ld b, a
    ld de, 1
    inc b
.shift2:
    dec b
    jp z, .done_shift
    sla e
    rl d
    jp .shift2
.done_shift:
    ld hl, (login_vec)
    ld a, l
    or e
    ld l, a
    ld a, h
    or d
    ld h, a
    ld (login_vec), hl

    ; Re-fetch DPH from BIOS (we clobbered HL with login_vec work above;
    ; C still = drive). Passing E=1 skips the fdc_login side-effect.
    ld e, 1
    call sel_disk
    ld a, h
    or l
    jr z, .sb_err

    ; DPH layout: XLT(2), scratch(6), DIRBUF(2), DPB(2), CSV(2), ALV(2)
    push hl
    ld de, 10                  ; Offset to DPB pointer
    add hl, de
    ld e, (hl)
    inc hl
    ld d, (hl)                 ; DE = DPB address
    ld (cached_dpb), de

    pop hl
    push hl
    ld de, 12                  ; Offset to CSV pointer
    add hl, de
    ld e, (hl)
    inc hl
    ld d, (hl)
    ld (cached_csv), de

    pop hl
    ld de, 14                  ; Offset to ALV pointer
    add hl, de
    ld e, (hl)
    inc hl
    ld d, (hl)
    ld (cached_alv), de

    ; Cache DPB fields
    ld hl, (cached_dpb)
    ld e, (hl)
    inc hl
    ld d, (hl)
    inc hl
    ld (cached_spt), de        ; SPT
    ld a, (hl)
    inc hl
    ld (cached_bsh), a         ; BSH
    ld a, (hl)
    inc hl
    ld (cached_blm), a         ; BLM
    inc hl                     ; Skip EXM
    ld e, (hl)
    inc hl
    ld d, (hl)
    inc hl
    ld (cached_dsm), de        ; DSM
    ; 16-bit block numbers when DSM > 255 (CP/M 3 16-bit block format).
    ld a, d
    or a
    ld a, 0
    jr z, .dsm_is_8bit
    ld a, 1
.dsm_is_8bit:
    ld (cached_blk16), a
    ld e, (hl)
    inc hl
    ld d, (hl)
    inc hl
    ld (cached_drm), de        ; DRM
    inc hl
    inc hl                     ; Skip AL0, AL1
    inc hl
    inc hl                     ; Skip CKS
    ld e, (hl)
    inc hl
    ld d, (hl)
    ld (cached_off), de        ; OFF

    ; Build allocation vector from directory on this (first) login. select_drive's
    ; short-circuit means we only reach here when this drive isn't already cached,
    ; so doing build_alv here is correct and not hot-pathed.
    call build_alv

    xor a                      ; CF=0 → success (also A=0)
    ret

.sb_err:
    scf                        ; CF=1 → invalid drive
    ret


; ==========================================================================
; @proc select_fcb_drive
; @out   carry
; @clobbers af,bc,de,hl,iy
; @end
; select_fcb_drive — Select the drive named by IX+0 (0 = current drive).
;   In:  IX = FCB (fcb_buf)
;   Out: CF=0 success, CF=1 invalid drive
;   Clobbers: AF, BC, DE, HL (IX preserved by select_drive)
select_fcb_drive:
    ld a, (ix + 0)
    or a
    jr nz, .has_drive
    ld a, (cur_disk)
    inc a
.has_drive:
    dec a                      ; A = 0-based drive
    call select_drive
    ret


; ==========================================================================
; @proc drive_ro_status
; @param %drive:u8 a
; @out   a
; @clobbers af,bc,de,hl
; @end
; drive_ro_status — A = 0 if drive A is writable, A = 2 if read-only.
drive_ro_status:
    ld b, a
    ld de, 1
    inc b
.shift:
    dec b
    jr z, .test
    sla e
    rl d
    jr .shift
.test:
    ld hl, (ro_vec)
    ld a, l
    and e
    ld c, a
    ld a, h
    and d
    or c
    jr z, .writable
    ld a, 2
    ret
.writable:
    xor a
    ret


; ==========================================================================
; @proc is_fcb_readonly
; @out   a
; @out   zero
; @clobbers af,bc,de,hl
; @end
; is_fcb_readonly — A = 0 if the FCB's drive is writable, 2 if R/O.
;   Calls ro_error so error_mode decides between returning 2 and aborting.
;   IX is preserved on the returning path.
is_fcb_readonly:
    ld a, (ix + 0)
    or a
    jr nz, .has_drive
    ld a, (cur_disk)
    inc a
.has_drive:
    dec a
    call drive_ro_status
    or a
    ret z
    jp ro_error


; ==========================================================================
; @proc ro_error
; @param %code:u8 a
; @out   a
; @clobbers af,bc,de,hl,ix
; @end
; ro_error — Handle a read-only write.
;   error_mode bit 0 = 1: return A=2 to the caller.
;   error_mode bit 0 = 0: print the classic message and warm boot.
ro_error:
    ld c, a
    ld a, (error_mode)
    and 1
    ld a, c
    ret nz
    ld hl, msg_ro
    call print_str
    jp warm_boot

msg_ro:
    db 0x0D, 0x0A, "Bdos Err: R/O", 0x0D, 0x0A, 0


; ==========================================================================
; @proc build_alv
; @clobbers af,bc,de,hl,ix,iy
; @end
; Internal: build_alv — Build allocation vector from directory
;   Scans all directory entries, marks used blocks in ALV.
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
build_alv:
    ; Invalidate directory sector cache
    ld a, 0xFF
    ld (last_dir_sec), a
    ld (last_dir_drv), a
    ; Clear ALV.  Size = (DSM >> 3) + 1, computed in 16 bits so DSM>255
    ; (PCW 720K, DSM=351) gets 44 bytes instead of the low byte's 12.
    ld hl, (cached_dsm)
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    inc hl
    ld b, l
    ld hl, (cached_alv)
    xor a
.clr:
    ld (hl), a
    inc hl
    djnz .clr

.mark_dir:
    ; Mark directory blocks as used (AL0/AL1 from DPB)
    ld hl, (cached_dpb)
    ld de, 9                   ; Offset to AL0
    add hl, de
    ld a, (hl)                 ; AL0
    ld b, a
    inc hl
    ld a, (hl)                 ; AL1
    ld c, a
    ; AL0 bits 7-0 correspond to blocks 0-7
    ; AL1 bits 7-0 correspond to blocks 8-15
    ld d, 0                    ; Block counter
.al_loop:
    rlc b                      ; Rotate AL0 left, bit 7 → carry
    jp nc, .al_skip0
    ld h, 0
    ld l, d
    call set_alloc_bit
.al_skip0:
    inc d
    ld a, d
    cp 8
    jp c, .al_loop

.al1_loop:
    rlc c
    jp nc, .al_skip1
    ld h, 0
    ld l, d
    call set_alloc_bit
.al_skip1:
    inc d
    ld a, d
    cp 16
    jp c, .al1_loop

    ; Scan directory entries and mark their blocks
    ld de, 0                   ; DE = directory entry index
.dir_scan:
    push de
    call read_dir_entry        ; Read entry DE into dir_buf, HL = entry addr
    pop de
    jp c, .dir_done            ; Past end of directory

    ; Check if entry is active (user != 0xE5)
    ld a, (hl)
    cp 0xE5
    jp z, .dir_next

    ; Mark allocation blocks as used (8 or 16 slots, 8- or 16-bit each).
    push de
    ld (map_base), hl
    xor a
    ld (map_idx), a
.mark_blk:
    ld a, (map_idx)
    ld hl, (map_base)
    call get_dir_block         ; HL = block, 0 = unused slot
    ld a, h
    or l
    jr z, .skip_blk
    call set_alloc_bit
.skip_blk:
    ld a, (map_idx)
    inc a
    ld (map_idx), a
    call map_count
    ld b, a
    ld a, (map_idx)
    cp b
    jr c, .mark_blk
    pop de

.dir_next:
    inc de
    ld hl, (cached_drm)
    inc hl                     ; HL = DRM+1 = total entries
    or a                       ; lint: ignore — clear carry for sbc, A value irrelevant
    sbc hl, de
    jp nz, .dir_scan

.dir_done:
    ret


; ==========================================================================
; Internal: Allocation vector operations
; ==========================================================================

; --------------------------------------------------------------------------
; Allocation-map access (8-bit or 16-bit block numbers)
;
; CP/M 3 uses sixteen 8-bit block numbers per extent when DSM <= 255, and
; eight 16-bit block numbers (high byte first) when DSM > 255.  The FCB map
; (bytes 16-31) and the directory entry map use the same encoding, so the
; accessors below work on either 32-byte block.
; --------------------------------------------------------------------------

; @proc map_count
; @out   a
; @clobbers af
; @end
; map_count — A = number of allocation-map slots in an extent (16 or 8).
map_count:
    ld a, (cached_blk16)
    or a
    ld a, 16
    ret z
    ld a, 8
    ret


; @proc map_block_addr
; @param %base:u16  hl             ; FCB or directory entry
; @param %index:u8  a              ; slot number
; @out   hl                        ; address of the slot
; @clobbers af,bc,hl
; @end
map_block_addr:
    push de
    ld e, a
    ld d, 0
    ex de, hl                      ; DE = base, HL = index
    ld a, (cached_blk16)
    or a
    jr z, .add
    add hl, hl                     ; two bytes per slot
.add:
    ld bc, 16
    add hl, bc
    add hl, de                     ; HL = base + 16 + index*width
    pop de
    ret


; @proc get_fcb_block
; @param %index:u8  a
; @out   hl                        ; block number, 0 = unallocated
; @clobbers af,bc,hl
; @end
get_fcb_block:
    push ix
    pop hl
    call map_block_addr
    ld a, (cached_blk16)
    or a
    jr z, .byte
    ld a, (hl)                     ; high byte first
    inc hl
    ld l, (hl)                     ; low byte
    ld h, a
    ret
.byte:
    ld a, (hl)
    ld l, a
    ld h, 0
    ret


; @proc put_fcb_block
; @param %index:u8  a
; @param %block:u16 hl
; @clobbers af,bc,de,hl
; @end
put_fcb_block:
    push af
    push hl
    push ix
    pop hl
    pop de                         ; DE = block
    pop af                         ; A = index
    call map_block_addr
    ld a, (cached_blk16)
    or a
    jr z, .byte
    ld a, d
    ld (hl), a                     ; high byte first
    inc hl
    ld a, e
    ld (hl), a
    ret
.byte:
    ld (hl), e
    ret


; @proc get_dir_block
; @param %entry:u16 hl             ; 32-byte directory entry
; @param %index:u8  a
; @out   hl                        ; block number, 0 = unused slot
; @clobbers af,bc,hl
; @end
get_dir_block:
    call map_block_addr
    ld a, (cached_blk16)
    or a
    jr z, .byte
    ld a, (hl)                     ; high byte first
    inc hl
    ld l, (hl)                     ; low byte
    ld h, a
    ret
.byte:
    ld a, (hl)
    ld l, a
    ld h, 0
    ret


; @proc set_alloc_bit
; @param %block:u16 hl
; @clobbers af
; @end
; set_alloc_bit — Mark block HL as used in the ALV
set_alloc_bit:
    push bc
    push de
    push hl
    ld a, l
    and 0x07
    ld b, a                    ; bit within the ALV byte
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l                       ; HL = block / 8
    ld de, (cached_alv)
    add hl, de
    ld a, b
    or a
    ld a, 0x80
    jr z, .apply
.shift:
    srl a
    djnz .shift
.apply:
    or (hl)
    ld (hl), a
    pop hl
    pop de
    pop bc
    ret


; @proc clear_alloc_bit
; @param %block:u16 hl
; @clobbers af
; @end
; clear_alloc_bit — Mark block HL as free in the ALV
clear_alloc_bit:
    push bc
    push de
    push hl
    ld a, l
    and 0x07
    ld b, a
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld de, (cached_alv)
    add hl, de
    ld a, b
    or a
    ld a, 0x80
    jr z, .apply
.shift:
    srl a
    djnz .shift
.apply:
    cpl
    and (hl)
    ld (hl), a
    pop hl
    pop de
    pop bc
    ret


; @proc find_free_block
; @out   hl                        ; first free block, 0 if none
; @out   carry                     ; set when the disk is full
; @clobbers af,bc,de,hl
; @end
find_free_block:
    ld hl, (cached_alv)
    ld bc, 0                   ; BC = block number
.byte_loop:
    ld a, (hl)
    cp 0xFF
    jr z, .skip_byte
    ld d, 0x80
.bit_loop:
    ld a, (hl)
    and d
    jr z, .found               ; bit clear = block free
    inc bc
    push hl
    ld hl, (cached_dsm)
    or a
    sbc hl, bc
    pop hl
    jp c, .full                ; past DSM
    srl d
    jr nz, .bit_loop
    inc hl
    jr .byte_loop
.skip_byte:
    ld a, c
    add a, 8
    ld c, a
    jr nc, .skip_nc
    inc b
.skip_nc:
    inc hl
    push hl
    ld hl, (cached_dsm)
    or a
    sbc hl, bc
    pop hl
    jp nc, .byte_loop
.full:
    scf
    ret
.found:
    ld h, b
    ld l, c
    or a                       ; clear carry
    ret


; ==========================================================================
; Internal: Directory operations
; ==========================================================================

; @proc read_dir_entry
; @param %entry:u16 de
; @out   hl
; @clobbers af,bc,de,hl,iy
; @end
; read_dir_entry — Read directory sector containing entry N, return pointer
;   In:  DE = directory entry number (0-based)
;   Out: HL = pointer to 32-byte entry within dir sector buffer
;        Carry set if entry beyond DRM
;   Clobbers: AF, BC
read_dir_entry:
    ; Check bounds
    push de
    ld hl, (cached_drm)
    inc hl
    or a
    sbc hl, de
    pop de
    jp z, .out_of_range
    jp c, .out_of_range

    ; Directory sector = entry / 4 (4 entries per 128-byte sector)
    ; Offset within sector = (entry % 4) * 32
    ld a, e                    ; Low byte of entry number (max 63 for us)
    push af                    ; Save for offset calculation
    srl a
    srl a                      ; A = entry / 4 = directory sector number

    ; Check if this sector is already cached in dirbuf
    ld b, a                    ; B = sector number
    ld a, (disk_drive)
    ld c, a                    ; C = currently selected BIOS drive
    ld a, (last_dir_drv)
    cp c
    jr nz, .need_read
    ld a, (last_dir_sec)
    cp b
    jr z, .dir_cached          ; Same sector — skip disk read

    ; Read this directory sector via BIOS
.need_read:
    ld a, b
    push af                    ; Save directory sector (BIOS calls clobber BC)
    call dir_sector_to_bios    ; Set BIOS track/sector

    ; Save user DMA, then redirect to our internal directory buffer
    ld hl, (bdos_dma)
    push hl
    ld bc, dirbuf
    call set_dma

    ; Read via BIOS
    call disk_read
    or a
    jp nz, .read_error_dma

    ; Cache is valid only after a successful read.
    pop hl                     ; Saved user DMA (pushed last)
    ld (bdos_dma), hl
    pop bc                     ; B = directory sector saved above
    ld a, b
    ld (last_dir_sec), a       ; Save sector number for write_dir_entry
    ld a, (disk_drive)
    ld (last_dir_drv), a

.dir_cached:
    pop af                     ; A = original entry number (from line 913)
    and 0x03                   ; Entry within sector (0-3)
    ; Multiply by 32
    ld l, a
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl                ; HL = (entry%4) * 32
    ld de, dirbuf
    add hl, de                 ; HL = &dirbuf[offset]
    or a                       ; Clear carry
    ret

.out_of_range:
    ; Reached before any pushes — stack is clean, just return with carry
    scf
    ret

.read_error_dma:
    pop hl                     ; saved bdos_dma
    ld (bdos_dma), hl          ; Restore user DMA before returning
    ld a, 0xFF
    ld (last_dir_sec), a
    ld (last_dir_drv), a
    pop bc                     ; discard saved directory sector
    pop af                     ; entry-number af pushed at top of routine
    scf
    ret


; @proc write_dir_entry
; @clobbers af,bc,de,hl,iy
; @end
; write_dir_entry — Write back the current directory sector
;   Re-seeks to the directory sector saved by read_dir_entry.
;   Clobbers: AF, BC, DE, HL
write_dir_entry:
    ld a, (last_dir_sec)       ; Re-establish correct track/sector
    call dir_sector_to_bios
    ld bc, dirbuf
    call set_dma
    call disk_write
    ret


; @proc dir_sector_to_bios
; @param %sector:u8 a
; @clobbers af,bc,de,hl
; @end
; dir_sector_to_bios — Set BIOS track/sector for directory sector N
;   In: A = directory sector number (0-based within directory area)
;   The directory starts at logical sector 0 of the first data track.
;   Clobbers: AF, BC, DE, HL
dir_sector_to_bios:
    ; Directory sector N maps to:
    ;   absolute_record = N (directory starts at record 0 of data area)
    ;   track = absolute_record / SPT + OFF
    ;   sector = absolute_record % SPT
    ld l, a
    ld h, 0                    ; HL = directory record number
    ld de, (cached_off)
    ; Track = OFF + record / SPT
    ; Since SPT=36 and records are small, this is just track=OFF for early records
    ld bc, (cached_spt)
    call div_hl_bc             ; HL = quotient (track offset), DE = remainder (sector)
    push de                    ; Save sector
    ld de, (cached_off)
    add hl, de                 ; HL = track
    ld b, h
    ld c, l
    call set_trk               ; BIOS set track

    pop bc                     ; BC = sector
    call set_sec               ; BIOS set sector
    ret


; ==========================================================================
; File functions (F15-F23, F33-F36, F40)
; ==========================================================================

; F17: Search First
; @proc bf_f17
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f17:
    pop de
    pop bc
    ; DE = FCB pointer in TPA — copy to fcb_buf for system-side access
    call setup_fcb(de)         ; Copy 36 bytes from TPA to fcb_buf, IX = fcb_buf
    ld de, fcb_buf
    ld (search_fcb), de        ; Point search at system copy
    ld hl, 0
    ld (search_pos), hl        ; Start from entry 0

    ; Make sure drive is selected
    call select_fcb_drive
    jp c, .f17_bad

    jp search_next_entry

.f17_bad:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

; F18: Search Next
; @proc bf_f18
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,iy
; @end
bf_f18:
    pop de
    pop bc
    ; Continue from search_pos

; @proc search_next_entry
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,iy
; @end
search_next_entry:
    ld de, (search_pos)
.loop:
    push de
    call read_dir_entry        ; HL = entry, carry if past end
    pop de
    jp c, .not_found

    ; Compare entry with search FCB
    push de
    push hl                    ; Save entry pointer
    ld de, (search_fcb)
    call match_fcb             ; Z = match
    pop hl
    pop de
    jp z, .found

    inc de
    jp .loop

.not_found:
    ; Return 0xFF = not found
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

.found:
    ; Store position for Search Next
    inc de
    ld (search_pos), de
    dec de

    ; Copy the directory sector to the user's DMA area
    ; The matching entry is at position (entry % 4) within the sector.
    ; CP/M convention: copy 128-byte directory sector to DMA,
    ; return A = index (0-3) of matching entry within it.
    ld hl, dirbuf                  ; Source: common memory
    ld de, (bdos_dma)              ; Dest: user DMA in TPA
    ld bc, 128
    call copy_to_user(hl, de, bc)  ; Inter-bank copy

    ; Return index of match within sector
    ld de, (search_pos)
    dec de                     ; Back to the matched entry
    ld a, e
    and 0x03                   ; Index within 128-byte sector (0-3)
    ld l, a
    ld h, 0
    jp bdos_ret


; @proc match_fcb
; @param %entry:u16 hl
; @param %fcb:u16   de
; @out   zero
; @clobbers af,bc,de,hl
; @end
; match_fcb — Compare directory entry at HL with FCB at DE
;   Compares user number and filename (bytes 0-12).
;   '?' in the FCB matches any character.
;   Out: Z = match, NZ = no match
;   Clobbers: AF, BC, DE, HL
match_fcb:
    ; Byte 0 of directory entry = user number.  Valid values 0-15 are
    ; real user areas; 0x10-0x1F are reserved for disc labels / timestamps
    ; in CP/M 3; 0xE5 means "deleted"; anything else is garbage (e.g. a
    ; never-written entry on a BFORMAT disc).  Only user 0-15 entries
    ; should be considered for a normal directory match.
    ld a, (hl)
    cp 16
    jp nc, .no_match           ; 16+ (labels, deleted, garbage) — skip

    push hl
    push de
    ; Check user: if search FCB byte 0 is '?', match any user
    ld a, (de)                 ; FCB byte 0 (drive code, not user for search)
    ; For search, byte 0 is drive. User is matched against cur_user.
    ld a, (cur_user)
    ld c, a                    ; C = current user
    ld a, (hl)                 ; Entry user
    cp c
    jp nz, .no_match_pop       ; Different user

    ; Compare filename bytes 1-11 (8 name + 3 type)
    inc hl
    inc de
    ld b, 11
.cmp_loop:
    ld a, (de)                 ; FCB char
    cp '?'
    jp z, .cmp_next            ; Wildcard matches anything
    and 0x7F                   ; Mask off attribute bit from FCB
    ld c, a
    ld a, (hl)                 ; Directory char
    and 0x7F                   ; Mask off attribute bit from directory
    cp c
    jp nz, .no_match_pop
.cmp_next:
    inc hl
    inc de
    djnz .cmp_loop

    ; Match!
    pop de
    pop hl
    xor a                      ; Set Z
    ret

.no_match_pop:
    pop de
    pop hl
.no_match:
    or 1                       ; Clear Z
    ret


; F15: Open File
; @proc bf_f15
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f15:
    pop de
    pop bc
    ; Copy FCB from TPA to fcb_buf
    call setup_fcb(de)         ; IX = fcb_buf, DE preserved
    ld de, fcb_buf
    push de

    ; Select drive from FCB (or cur_disk if FCB[0]=0). Don't touch cur_disk.
    call select_fcb_drive
    jp c, .not_found           ; invalid drive → treat as "file not found"

    ; Search for the file in the directory
    pop de                     ; DE = fcb_buf
    push de
    ld (search_fcb), de
    ld hl, 0
    ld (search_pos), hl

.search:
    ld de, (search_pos)
    push de
    call read_dir_entry
    pop de
    jp c, .not_found

    push de
    push hl
    ld de, (search_fcb)
    call match_fcb
    pop hl
    pop de
    jp z, .found

    inc de
    ld (search_pos), de
    jp .search

.not_found:
    pop de
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

.found:
    ; Copy directory entry to fcb_buf
    ; HL = directory entry, stack has fcb_buf pointer
    pop de                     ; DE = fcb_buf
    push de
    push hl
    ; Copy bytes 0-31 from directory to fcb_buf (except byte 0 = drive)
    inc hl                     ; Skip user byte in directory
    inc de                     ; Skip drive byte in fcb_buf
    ld bc, 31
    ldir                       ; directory → fcb_buf (both common/system — OK)
    pop hl
    pop de

    ; Set CR = 0 (start of file)
    push de
    pop hl
    ld de, 32
    add hl, de
    ld (hl), 0                 ; fcb_buf[32] = 0

    ; Write modified FCB back to TPA
    call writeback_fcb()

    ld a, 0                    ; Success
    ld l, a
    ld h, 0
    jp bdos_ret


; F16: Close File
;   In:  DE = FCB (EX must reflect the extent being closed)
;   Out: HL = 0 (OK)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f16
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f16:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    ; Cache DPB/ALV for the FCB's drive — close_dir_update walks the
    ; directory using cached_*.
    call select_fcb_drive
    jp c, .f16_err
    call is_fcb_readonly
    jp nz, .f16_ro

    call flush_deblock         ; Flush any pending write data
    call close_dir_update
    call writeback_fcb()
    xor a
    ld l, a
    ld h, 0
    jp bdos_ret

.f16_ro:
    ld l, a
    ld h, 0
    jp bdos_ret

.f16_err:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

; ------------------------------------------------------------------
; @proc close_dir_update
; @clobbers af,bc,de,hl,iy
; @end
; close_dir_update — Find directory entry matching FCB and update it
;   In:  IX = fcb_buf (with correct EX, RC, alloc map)
;   Clobbers: AF, BC, DE, HL
; ------------------------------------------------------------------
close_dir_update:
    ld de, 0
.cl_scan:
    push de
    call read_dir_entry        ; HL = ptr to 32-byte entry, carry = past end
    pop de
    jp c, .cl_done

    push de
    push hl
    ; Check user number
    ld a, (hl)
    cp 0xE5
    jp z, .cl_skip
    ld a, (cur_user)
    ld c, a
    ld a, (hl)
    cp c
    jp nz, .cl_skip
    ; Check filename bytes 1-11 (strip attribute bits from directory)
    push hl
    inc hl                     ; HL = &entry[1]
    push ix
    pop de
    inc de                     ; DE = &FCB[1]
    ld b, 11
.cl_name:
    ld a, (hl)
    and 0x7F
    ld c, a
    ld a, (de)
    and 0x7F                   ; Mask FCB attribute bit too
    cp c
    jp nz, .cl_name_fail
    inc hl
    inc de
    djnz .cl_name
    pop hl                     ; HL = entry base (from push before inc hl)
    ; Check EX (byte 12)
    ld de, 12
    add hl, de                 ; HL = &entry[12]
    ld a, (hl)
    ld c, a
    ld a, (ix + 12)
    cp c
    jp nz, .cl_skip_from_ex    ; EX mismatch — keep scanning
    ; Found the right entry — update RC and allocation map in-place
    ; HL = &entry[12], stack: [de_outer, hl_outer]
    ld de, 3
    add hl, de                 ; HL = &entry[15] (RC)
    ld a, (ix + 15)
    ld (hl), a                 ; entry.RC = FCB.RC
    inc hl                     ; HL = &entry[16]
    ; Copy FCB allocation map → directory entry (straight copy per spec)
    push ix
    pop de                     ; DE = FCB base
    push hl
    ld bc, 16
    ex de, hl
    add hl, bc                 ; HL = &FCB[16]
    ex de, hl                  ; DE = &FCB[16]
    pop hl                     ; HL = &entry[16]
    ex de, hl                  ; HL = &FCB[16], DE = &entry[16]
    ld bc, 16
    ldir                       ; FCB alloc → directory entry
    call write_dir_entry
    pop de                     ; Discard hl_outer
    pop de                     ; Discard de_outer
    ret

.cl_name_fail:
    pop hl                     ; Balance push hl before inc hl
.cl_skip_from_ex:              ; Stack: [de_outer, hl_outer]
.cl_skip:
    pop hl                     ; Discard hl_outer
    pop de                     ; Restore entry index
    inc de
    jp .cl_scan

.cl_done:
    ret


; F19: Delete File
;   In:  DE = FCB (filename may contain '?' wildcards in bytes 1-11)
;   Out: HL = 0 (deleted ≥1 entry), 0xFF (not found)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f19
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f19:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    ; Select drive from FCB (or cur_disk if FCB[0]=0). Don't touch cur_disk.
    call select_fcb_drive
    jp c, .del_none            ; invalid drive → not found
    call is_fcb_readonly
    jp nz, .del_none           ; read-only → not deleted

    ld de, 0                   ; Directory entry index
    ld b, 0                    ; B = found count
.del_scan:
    push de
    push bc                    ; lint: ignore — only B matters, C is don't-care
    call read_dir_entry        ; HL = entry, carry = past end
    pop bc
    pop de
    jp c, .del_done

    push de
    push bc
    push hl
    ; Call match_fcb: HL = entry, DE = FCB (with wildcard support)
    push ix
    pop de
    call match_fcb             ; Z = match, NZ = no match (clobbers AF, BC)
    pop hl
    pop bc
    pop de
    jp nz, .del_next

    ; Match — free all blocks and mark entry as deleted
    push de
    push bc
    ld (map_base), hl
    xor a
    ld (map_idx), a
.del_free:
    ld a, (map_idx)
    ld hl, (map_base)
    call get_dir_block         ; HL = block, 0 = unused slot
    ld a, h
    or l
    jr z, .del_skip_blk
    call clear_alloc_bit
.del_skip_blk:
    ld a, (map_idx)
    inc a
    ld (map_idx), a
    call map_count
    ld b, a
    ld a, (map_idx)
    cp b
    jr c, .del_free
    ld hl, (map_base)
    ld (hl), 0xE5              ; Mark entry as deleted
    call write_dir_entry
    pop bc
    pop de
    inc b                      ; B = found count++

.del_next:
    inc de
    jp .del_scan

.del_done:
    ld a, b
    or a
    jp z, .del_none
    xor a
    ld l, a
    ld h, 0
    jp bdos_ret
.del_none:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret


; F20: Read Sequential
;   In:  DE = FCB
;   Out: A = 0 (OK), 1 (EOF), 0xFF (error); H = records transferred
;   Transfers scb_multi records from the DMA address, advancing it by 128
;   bytes per record (CP/M 3 multi-sector count set by F44).
; @proc bf_f20
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f20:
    pop de
    pop bc
    jp multi_read

; f20_body - read one sequential record (single-record core)
; @proc f20_body
; @param %fcb:u16   de
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
f20_body:
    ; In: DE = FCB (the multi-sector wrapper supplies it)
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    ; Cache DPB/ALV for the FCB's drive so cached_* is consistent with
    ; this operation (and unaffected by what some earlier BDOS call left
    ; cached for a different drive).
    call select_fcb_drive
    jp c, .read_drv_err

    ; Get current position from FCB
    ; CR (byte 32) = current record within extent (0-127)
    ; EX (byte 12) = extent number
    ; The absolute record = EX * 128 + CR
    ; The block = allocation_map[record / records_per_block]
    ; Where records_per_block = block_size / 128

    push ix

    ; Check if we've reached the end of this extent
    ld a, (ix + 32)            ; CR
    ld b, a
    ld a, (ix + 15)            ; RC (record count in extent)
    cp b
    jp z, .next_extent         ; CR == RC → try next extent
    jp c, .next_extent

.do_read:
    ; Calculate which block within extent contains this record
    ; records_per_block = 2^BSH = 8 (for BSH=3, 1K blocks)
    ; block_index = CR / records_per_block = CR >> BSH
    ld a, (ix + 32)            ; CR
    ld c, a                    ; Save CR
    ld a, (cached_bsh)
    ld b, a
    or a
    ld a, c
    jr z, .shr_cr_done
.shr_cr:
    srl a
    djnz .shr_cr               ; A = CR >> BSH = block index in extent
.shr_cr_done:

    ; Get block number from the allocation map (8- or 16-bit slots)
    call get_fcb_block         ; HL = block number
    ld a, h
    or l
    jp z, .eof                 ; Block 0 = no more data

    ; Calculate absolute track/sector for this record
    ; record_in_block = CR & BLM
    push hl                    ; Save block number
    ld a, (ix + 32)            ; CR
    ld b, a
    ld a, (cached_blm)
    and b                      ; A = record within block
    ld c, a                    ; C = record in block
    pop hl                     ; HL = block number

    ; Absolute record = block * records_per_block + record_in_block
    ; = block << BSH + record_in_block
    ld a, (cached_bsh)
    ld b, a
    or a
    jr z, .shl_blk_done
.shl_blk:
    add hl, hl
    djnz .shl_blk              ; HL = block << BSH = block * records_per_block
.shl_blk_done:
    ld b, 0
    add hl, bc                 ; HL = absolute record in data area

    ; Convert to track/sector
    ld bc, (cached_spt)
    call div_hl_bc             ; HL = track offset, DE = sector
    push de
    ld de, (cached_off)
    add hl, de                 ; HL = absolute track
    ld b, h
    ld c, l
    call set_trk

    pop bc                     ; BC = sector
    call set_sec

    ; Set DMA to user's buffer
    ld bc, (bdos_dma)
    call set_dma

    ; Read
    call disk_read
    or a
    jp nz, .read_err

    ; Advance CR
    pop ix                     ; Restore FCB pointer
    inc (ix + 32)              ; CR++

    call writeback_fcb()
    ld a, 0                    ; Success
    ld l, a
    ld h, 0
    jp bdos_exit

; ------------------------------------------------------------------
; Open next extent when current extent is exhausted
;   IX = FCB pointer. Increment EX, search directory for next extent.
;   If found, copy allocation map to FCB, reset CR, continue reading.
; ------------------------------------------------------------------
.next_extent:
    ; Increment extent number, reset CR
    ld a, (ix + 12)            ; EX
    inc a
    ld (ix + 12), a
    ld (ix + 32), 0

    ; Search directory for an entry with same user, name, and matching EX.
    ; IX still holds fcb_buf across the whole search (it is preserved on
    ; the stack by the push ix at .do_read's entry, which we reuse).
    ld hl, 0
    ld (search_pos), hl

.next_ext_search:
    ld de, (search_pos)
    call read_dir_entry        ; HL = entry, carry = past end
    jp c, .eof

    ; Filter: user byte 0xE5 (deleted) or != cur_user
    ld a, (hl)
    cp 0xE5
    jr z, .next_ext_skip
    ld b, a
    ld a, (cur_user)
    cp b
    jr nz, .next_ext_skip

    ; Compare name+ext bytes (entry[1..11] vs fcb[1..11])
    push hl                    ; save entry_ptr
    inc hl                     ; HL = &entry[1]
    push ix
    pop de
    inc de                     ; DE = &fcb[1]
    ld b, 11
.next_ext_cmp:
    ld a, (de)
    and 0x7F                   ; mask FCB attribute bit too
    ld c, a
    ld a, (hl)
    and 0x7F                   ; strip attribute bit
    cp c
    jr nz, .next_ext_name_fail
    inc hl
    inc de
    djnz .next_ext_cmp

    ; HL now points at entry[12] (EX). Compare to our EX.
    ld a, (hl)
    ld b, a
    ld a, (ix + 12)
    cp b
    jr nz, .next_ext_name_fail

    ; Match. HL = &entry[12]. Advance to entry[15] (RC), copy to fcb.RC,
    ; then copy entry[16..31] (allocation map) to fcb[16..31].
    ld de, 3
    add hl, de                 ; HL = &entry[15]
    ld a, (hl)
    ld (ix + 15), a            ; FCB.RC = entry.RC
    inc hl                     ; HL = &entry[16]

    push ix
    pop de
    ld a, e
    add a, 16
    ld e, a
    jr nc, .next_ext_nc
    inc d
.next_ext_nc:                  ; DE = &fcb[16]
    ld bc, 16
    ldir                       ; Copy allocation map

    pop hl                     ; discard saved entry_ptr
    jp .do_read

.next_ext_name_fail:
    pop hl                     ; discard saved entry_ptr
.next_ext_skip:
    ld de, (search_pos)
    inc de
    ld (search_pos), de
    jp .next_ext_search

.eof:
    pop ix
    ld a, 1                    ; EOF / error
    ld l, a
    ld h, 0
    jp bdos_exit

.read_drv_err:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_exit

.read_err:
    pop ix
    ld a, 0xFF
    ld l, a
    ld h, 0xFF
    jp bdos_exit


; F21: Write Sequential
;   In:  DE = FCB
;   Out: HL = 0 (OK), 1 (disk full), 0xFF (write error)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f21
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f21:
    pop de
    pop bc
    jp multi_write

; f21_body - write one sequential record (single-record core)
; @proc f21_body
; @param %fcb:u16   de
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
f21_body:
    ; In: DE = FCB (the multi-sector wrapper supplies it)
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

bf_f21_core:
    ; Entry point for F34 (Write Random) and F40 — IX = FCB, EX/CR set.

    ; Consume a pending F40 zero-fill request.  Exactly one block is
    ; zeroed per call, and clearing the flag here keeps a request left
    ; over by a failed F40 from affecting a later F21/F34 write.
    ld a, (f40_zfill)
    ld (f40_pending), a
    xor a
    ld (f40_zfill), a

    ; Cache DPB/ALV for the FCB's drive so cached_* is consistent with
    ; this operation.
    call select_fcb_drive
    jp c, .wseq_error
    call is_fcb_readonly
    jp nz, .wseq_ro

    ; If CR == 128 this extent is full — create a new extent first
    ld a, (ix + 32)            ; CR
    cp 128
    jp z, .wseq_new_extent

.wseq_do:
    ; Compute block_index = CR >> BSH
    ld a, (ix + 32)            ; CR
    ld c, a
    ld a, (cached_bsh)
    ld b, a
    or a
    ld a, c
    jr z, .wseq_shr_done
.wseq_shr:
    srl a
    djnz .wseq_shr             ; A = CR >> BSH = block_index in alloc map
.wseq_shr_done:

    ; Get block number from the allocation map (8- or 16-bit slots)
    ld (map_idx), a            ; slot index, used by .wseq_alloc
    call get_fcb_block         ; HL = block number
    ld a, h
    or l
    jp z, .wseq_alloc          ; Zero = unallocated, need a new block

.wseq_have_block:
    ; HL = block number
    push hl                    ; Save block number
    ; record_in_block = CR & BLM
    ld a, (ix + 32)            ; CR
    ld b, a
    ld a, (cached_blm)
    and b                      ; A = record_in_block
    ld c, a
    pop hl                     ; HL = block number

    ; abs_record = (block << BSH) + record_in_block
    ld a, (cached_bsh)
    ld b, a
    or a
    jr z, .wseq_shl_done
.wseq_shl:
    add hl, hl
    djnz .wseq_shl             ; HL = block << BSH
.wseq_shl_done:
    ld b, 0
    add hl, bc                 ; HL = absolute record in data area

    ; Convert to track and sector
    ld bc, (cached_spt)
    call div_hl_bc             ; HL = track_in_data, DE = sector
    push de
    ld de, (cached_off)
    add hl, de
    ld b, h
    ld c, l
    call set_trk
    pop bc                     ; BC = sector
    call set_sec

    ; DMA = user's write buffer
    ld bc, (bdos_dma)
    call set_dma

    ; Write the 128-byte record
    ld c, 0                    ; Write type: normal
    call disk_write
    or a
    jp nz, .wseq_error

    ; RC = max(RC, CR+1): record count tracks how many records are in extent
    ld a, (ix + 32)            ; CR (current, before increment)
    inc a                      ; A = CR + 1
    ld b, a
    ld a, (ix + 15)            ; RC
    cp b
    jp nc, .wseq_no_rc         ; RC >= CR+1 already
    ld (ix + 15), b            ; RC = CR + 1
.wseq_no_rc:
    inc (ix + 32)              ; CR++
    call writeback_fcb()
    call close_dir_update      ; Persist RC/alloc for this extent
    jp bdos_eok_x

.wseq_alloc:
    ; Slot map_idx is unallocated — allocate a block here.
    call find_free_block       ; HL = free block, carry = disk full
    jp c, .wseq_diskfull
    push hl
    call set_alloc_bit         ; Mark block as used in ALV
    pop hl
    push hl
    ld a, (map_idx)
    call put_fcb_block         ; Store block number in the FCB map
    pop hl                     ; HL = block number

    ; F40 zero fill: a newly allocated block is filled with zeros before
    ; the record is written, so unwritten records read back as zeros.
    ld a, (f40_pending)
    or a
    jr z, .wseq_alloc_nofill
    push hl                    ; zero_fill_block clobbers HL
    call zero_fill_block       ; HL = block
    pop hl                     ; HL = block again
    or a
    jp nz, .wseq_error         ; A = BIOS WRITE error code
.wseq_alloc_nofill:
    jp .wseq_have_block        ; HL = block

.wseq_full:
    ld a, 1                    ; Directory full
    jr .wseq_ret

.wseq_diskfull:
    ld a, 2                    ; Disk full

.wseq_ret:
    ld l, a
    ld h, 0
    jp bdos_exit

.wseq_ro:
    ld l, a
    ld h, 0
    jp bdos_exit

.wseq_error:
    cp 2                       ; BIOS WRITE: 2 = read-only disk
    jp z, .wseq_ro
    jp bdos_efail_x

.wseq_new_extent:
    ; CR == 128: current extent is full.
    ; Must close the current extent (flush alloc map to directory).
    call flush_deblock
    call writeback_fcb()         ; Save FCB to TPA for close to read
    call wseq_close_cur        ; Close current extent via directory update

    ld de, 0                   ; Scan for a free (E5h) directory entry
.wseq_ne_find:
    push de
    call read_dir_entry        ; HL = entry, carry = past end
    pop de
    jp c, .wseq_full

    push de
    ld a, (hl)
    cp 0xE5
    jp nz, .wseq_ne_next

    ; Found a free directory entry — initialise it as new extent
    push hl
    ld b, 32
.wseq_ne_zero:
    ld (hl), 0
    inc hl
    djnz .wseq_ne_zero
    pop hl                     ; HL = entry base

    ; Set user
    ld a, (cur_user)
    ld (hl), a

    ; Copy filename from FCB[1..11] → entry[1..11], masking attribute bits
    inc hl                     ; HL = &entry[1]
    push ix
    pop de
    inc de                     ; DE = &FCB[1]
    ex de, hl                  ; HL = &FCB[1], DE = &entry[1]
    ld b, 11
.wseq_ne_copy:
    ld a, (hl)
    and 0x7F                   ; Strip attribute bit
    ld (de), a
    inc hl
    inc de
    djnz .wseq_ne_copy        ; After: DE = &entry[12], HL = &FCB[12]

    ; Set new EX = old EX + 1 in both FCB and directory entry
    ld a, (ix + 12)            ; Current FCB.EX
    inc a
    ld (ix + 12), a            ; FCB.EX = EX + 1
    ld (de), a                 ; entry.EX = EX + 1 (DE = &entry[12])
    ; Bytes 13-31 already zero: S1=0, S2=0, RC=0, alloc[0..15]=0

    call write_dir_entry

    ; Reset FCB for new extent
    ld (ix + 32), 0            ; CR = 0
    ld (ix + 15), 0            ; RC = 0
    push ix
    pop hl
    ld de, 16
    add hl, de                 ; HL = &FCB[16]
    ld b, 16
.wseq_ne_clr:
    ld (hl), 0
    inc hl
    djnz .wseq_ne_clr

    pop de                     ; Balance push de from ne_find loop
    jp .wseq_do                ; Write the record into the new extent

.wseq_ne_next:
    pop de
    inc de
    jp .wseq_ne_find

; ------------------------------------------------------------------
; @proc wseq_close_cur
; @clobbers af,bc,de,hl,iy
; @end
; wseq_close_cur — Close current extent by calling bf_f16 logic
;   Saves FCB to TPA, re-loads into fcb_buf, runs the close scan.
;   In:  IX = fcb_buf (writeback_fcb already called)
;   Out: IX = fcb_buf (reloaded)
;   Clobbers: AF, BC, DE, HL
; ------------------------------------------------------------------
wseq_close_cur:
    ; Reload FCB into fcb_buf from TPA (writeback already done)
    ld de, (fcb_user_addr)
    call setup_fcb(de)         ; IX = fcb_buf

    ; Run the close directory scan (inline version that returns here)
    call close_dir_update

    ; Reload FCB again (close may have changed fcb_buf)
    ld de, (fcb_user_addr)
    call setup_fcb(de)         ; IX = fcb_buf
    ret

; zero_fill_block — Fill a newly allocated data block with zeros
;   Writes every record in the block from the common zero buffer, so the
;   user's DMA area is never touched.  The caller must have the drive's
;   DPB cached (select_fcb_drive) before calling.
;   In:  HL = block number
;   Out: A = 0 on success, or the BIOS WRITE code (1 = error, 2 = read-only)
;   Clobbers: AF, BC, DE, HL
; @proc zero_fill_block
; @param %block:u16 hl
; @out   a
; @clobbers af,bc,de,hl
; @end
zero_fill_block:
    ld (f40_block), hl

    ; Clear the common zero buffer (a stray write cannot poison the fill).
    ld hl, f40_zero
    ld b, 128
.zf_clear:
    ld (hl), 0
    inc hl
    djnz .zf_clear

    ; First absolute record: block << BSH
    ld hl, (f40_block)
    ld a, (cached_bsh)
    ld b, a
    or a
    jr z, .zf_base
.zf_shl:
    add hl, hl
    djnz .zf_shl
.zf_base:
    ld (f40_rec), hl

    ; Records per block = BLM + 1 (2^BSH)
    ld a, (cached_blm)
    inc a
    ld (f40_left), a

.zf_loop:
    ld hl, (f40_rec)
    ld bc, (cached_spt)
    call div_hl_bc             ; HL = track in data area, DE = sector
    push de
    ld de, (cached_off)
    add hl, de                 ; HL = absolute track
    ld b, h
    ld c, l
    call set_trk
    pop bc
    call set_sec

    ld bc, f40_zero
    call set_dma
    call disk_write
    or a
    ret nz                     ; A = BIOS WRITE error code

    ld hl, (f40_rec)
    inc hl
    ld (f40_rec), hl
    ld a, (f40_left)
    dec a
    ld (f40_left), a
    jr nz, .zf_loop
    xor a
    ret


; F22: Make File
;   In:  DE = FCB (filename in bytes 1-11)
;   Out: HL = 0 (success), 0xFF (directory full)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f22
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f22:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    ; Select drive from FCB (or cur_disk if FCB[0]=0). Don't touch cur_disk.
    call select_fcb_drive
    jp c, .mk_full             ; invalid drive → error
    call is_fcb_readonly
    jp nz, .mk_full            ; read-only → error

    ; Scan directory for a free (E5h) entry
    ld de, 0
.mk_scan:
    push de
    call read_dir_entry        ; HL = entry, carry = past end
    pop de
    jp c, .mk_full

    push de
    ld a, (hl)
    cp 0xE5
    jp nz, .mk_next

    ; Found a free directory slot — initialise it
    push hl
    ld b, 32                   ; Zero all 32 bytes
.mk_zero:
    ld (hl), 0
    inc hl
    djnz .mk_zero
    pop hl                     ; HL = entry base

    ; Byte 0 = user number
    ld a, (cur_user)
    ld (hl), a

    ; Copy FCB[1..11] → entry[1..11], masking off attribute high bits
    inc hl                     ; HL = &entry[1]
    push ix
    pop de
    inc de                     ; DE = &FCB[1]
    ex de, hl                  ; HL = &FCB[1], DE = &entry[1]
    ld b, 11
.mk_copy_name:
    ld a, (hl)
    and 0x7F                   ; Strip attribute bit
    ld (de), a
    inc hl
    inc de
    djnz .mk_copy_name        ; Bytes 12-31 remain zero: EX=0, RC=0, alloc=0

    call write_dir_entry

    ; Zero FCB fields: EX, S1, S2, RC, alloc map, CR, random record
    push ix
    pop hl
    ld de, 12
    add hl, de                 ; HL = &FCB[12]
    ld b, 24                   ; Bytes 12-35
.mk_zero_fcb:
    ld (hl), 0
    inc hl
    djnz .mk_zero_fcb

    pop de                     ; Balance push de from scan
    call writeback_fcb()
    xor a
    ld l, a
    ld h, 0
    jp bdos_ret

.mk_next:
    pop de
    inc de
    jp .mk_scan

.mk_full:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

; F23: Rename File
;   In:  DE = FCB. Bytes 1-11 = old name, bytes 17-27 = new name.
;   Out: HL = 0 (OK), 0xFF (not found)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f23
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f23:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    ; Select drive from FCB (or cur_disk if FCB[0]=0). Don't touch cur_disk.
    call select_fcb_drive
    jp c, .ren_none            ; invalid drive → not found
    call is_fcb_readonly
    jp nz, .ren_none           ; read-only → not renamed

    ; Scan directory for entries matching old name (bytes 1-11)
    ld de, 0
    ld b, 0                    ; B = found count
.ren_scan:
    push de
    push bc                    ; lint: ignore — only B matters, C is don't-care
    call read_dir_entry
    pop bc
    pop de
    jp c, .ren_done

    push de
    push bc
    push hl
    ; Check user + old name (bytes 1-11)
    ld a, (hl)
    cp 0xE5
    jp z, .ren_skip
    ld a, (cur_user)
    cp (hl)
    jp nz, .ren_skip
    ; Compare name bytes 1-11
    push hl
    inc hl
    push ix
    pop de
    inc de                     ; DE = &FCB[1]
    ld c, 11
.ren_cmp:
    ld a, (de)
    cp '?'
    jp z, .ren_cmp_ok
    ld a, (hl)
    and 0x7F
    push bc
    ld b, a
    ld a, (de)
    cp b
    pop bc
    jp nz, .ren_cmp_fail
.ren_cmp_ok:
    inc hl
    inc de
    dec c
    jp nz, .ren_cmp
    pop hl                     ; HL = entry base

    ; Match — copy new name (FCB bytes 17-27) to entry bytes 1-11
    push hl                    ; save entry base
    inc hl                     ; HL = &entry[1]
    push hl                    ; save &entry[1] for DE (LDIR destination)
    push ix
    pop hl
    ld bc, 17
    add hl, bc                 ; HL = &FCB[17] (LDIR source)
    pop de                     ; DE = &entry[1]
    ld bc, 11
    ldir
    pop hl                     ; HL = entry base
    call write_dir_entry

    pop hl                     ; balance push hl from .ren_scan
    pop bc
    pop de
    inc b
    inc de
    jp .ren_scan

.ren_cmp_fail:
    pop hl                     ; balance push hl from cmp setup
.ren_skip:
    pop hl
    pop bc
    pop de
    inc de
    jp .ren_scan

.ren_done:
    ld a, b
    or a
    jp z, .ren_none
    xor a
    ld l, a
    ld h, 0
    jp bdos_ret
.ren_none:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret


; ==========================================================================
; Random access helpers
; ==========================================================================

; @proc rand_to_seq
; @out   a
; @clobbers af,bc
; @end
; rand_to_seq — Convert random record (FCB[33-35]) to EX and CR
;   In:  IX = FCB
;   Out: A = 0 (OK), 6 (out of range)
;        EX set in FCB[12], CR set in FCB[32]
;   Clobbers: AF, BC
;
;   Random record R = FCB[33] + FCB[34]*256 (+ FCB[35]*65536, ignored)
;   For our disk: EXM=0, so:
;     EX = R / 128
;     CR = R % 128 (= R & 0x7F)
rand_to_seq:
    ld a, (ix + 35)            ; R2 (high byte)
    or a
    jp nz, .rand_overflow
    ld a, (ix + 34)            ; R1
    ld b, a
    ld a, (ix + 33)            ; R0
    ; R = B:A (16-bit). EX = R / 128 = (B:A) >> 7
    ; CR = R & 0x7F = A & 0x7F
    ld c, a
    and 0x7F
    ld (ix + 32), a            ; CR = R & 0x7F
    ; EX = R1*2 + (R0 >> 7)
    ld a, c                    ; A = R0
    rlca                       ; rotate left, bit 7 -> bit 0, old bit 7 -> carry
    and 0x01                   ; A = R0 >> 7 (just the top bit)
    ld c, a                    ; C = R0 >> 7
    ld a, (ix + 34)            ; R1
    add a, a                   ; A = R1 * 2
    or c                       ; A = R1*2 + (R0>>7) = EX
    ld (ix + 12), a            ; FCB.EX = EX
    xor a                      ; Success
    ret

.rand_overflow:
    ld a, 6                    ; "seek past end" error
    ret


; F33: Read Random
;   In:  DE = FCB (R0/R1/R2 set at bytes 33-35)
;   Out: A = 0 (OK), 1 (reading unwritten data), 3 (cannot close extent),
;        4 (seek to unwritten extent), 6 (random record out of range)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f33
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f33:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    ; Cache DPB/ALV for the FCB's drive.
    call select_fcb_drive
    jp c, .rdrand_range

    ; Convert random record to EX/CR
    call rand_to_seq
    or a
    jp nz, .rdrand_err

    ; Find the correct extent in the directory for the target EX.
    ld hl, 0
    ld (search_pos), hl

.rdrand_search:
    ld de, (search_pos)
    push de
    call read_dir_entry
    pop de
    jp c, .rdrand_unwritten

    push de
    push hl
    ld a, (hl)
    cp 0xE5
    jp z, .rdrand_skip
    ld a, (cur_user)
    cp (hl)
    jp nz, .rdrand_skip

    ; Compare name bytes 1-11
    push hl
    inc hl
    push ix
    pop de
    inc de
    ld b, 11
.rdrand_cmp:
    ld a, (hl)
    and 0x7F
    ld c, a
    ld a, (de)
    and 0x7F                   ; mask FCB attribute bit too
    cp c
    jp nz, .rdrand_cmp_fail
    inc hl
    inc de
    djnz .rdrand_cmp
    pop hl                     ; HL = entry base

    ; Name matches — check EX
    push hl
    ld de, 12
    add hl, de
    ld a, (hl)                 ; entry EX
    pop hl
    ld b, a
    ld a, (ix + 12)            ; target EX
    cp b
    jp nz, .rdrand_skip

    ; Found! Copy RC + allocation map to FCB
    push hl
    ld de, 15
    add hl, de
    ld a, (hl)
    ld (ix + 15), a            ; FCB.RC = entry.RC
    inc hl                     ; HL = &entry[16]
    ; Copy 16 bytes from entry[16-31] to FCB[16-31]
    push hl                    ; save &entry[16] for LDIR source
    push ix
    pop hl
    ld bc, 16
    add hl, bc                 ; HL = &FCB[16]
    ex de, hl                  ; DE = &FCB[16] (LDIR destination)
    pop hl                     ; HL = &entry[16]
    ld bc, 16
    ldir
    pop hl
    pop de                     ; search_pos
    pop de                     ; discard outer push

    ; Now do the read: block lookup + BIOS read
    push ix
    ld a, (ix + 32)            ; CR
    ld c, a
    ld a, (cached_bsh)
    ld b, a
    or a
    ld a, c
    jr z, .rdrand_shr_done
.rdrand_shr:
    srl a
    djnz .rdrand_shr
.rdrand_shr_done:
    call get_fcb_block         ; HL = block (8- or 16-bit slot)
    ld a, h
    or l
    jp z, .rdrand_unwritten2

    push hl
    ld a, (ix + 32)
    ld b, a
    ld a, (cached_blm)
    and b
    ld c, a
    pop hl
    ld a, (cached_bsh)
    ld b, a
    or a
    jr z, .rdrand_shl_done
.rdrand_shl:
    add hl, hl
    djnz .rdrand_shl
.rdrand_shl_done:
    ld b, 0
    add hl, bc

    ld bc, (cached_spt)
    call div_hl_bc
    push de
    ld de, (cached_off)
    add hl, de
    ld b, h
    ld c, l
    call set_trk
    pop bc
    call set_sec
    ld bc, (bdos_dma)
    call set_dma
    call disk_read
    pop ix
    or a
    jp nz, .rdrand_read_err
    call writeback_fcb()
    xor a
    ld l, a
    ld h, 0
    jp bdos_ret

.rdrand_read_err:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

.rdrand_unwritten2:
    pop ix
    ld a, 1
    ld l, a
    ld h, 0
    jp bdos_ret

.rdrand_cmp_fail:
    pop hl                     ; balance push hl from cmp setup
.rdrand_skip:
    pop hl
    pop de
    inc de
    ld (search_pos), de
    jp .rdrand_search

.rdrand_unwritten:
    ld a, 4
    ld l, a
    ld h, 0
    jp bdos_ret

.rdrand_range:
    ld a, 6                    ; invalid drive / random record out of range
.rdrand_err:
    ld l, a
    ld h, 0
    jp bdos_ret


; ==========================================================================
; @proc find_fcb_extent
; @out   zero
; @clobbers af,bc,de,hl,iy
; @end
; find_fcb_extent — Find the directory extent for IX's EX.
;   In:  IX = FCB (fcb_buf) with EX set
;   Out: Z = found; RC and the 16-byte allocation map are copied into FCB
;        NZ = no entry with this user/name/EX
;   Clobbers: AF, BC, DE, HL
find_fcb_extent:
    ld hl, 0
    ld (search_pos), hl
.loop:
    ld de, (search_pos)
    push de                    ; save search position across read_dir_entry
    call read_dir_entry
    jp c, .not_found_pop
    push hl                    ; save entry pointer
    ld a, (hl)
    cp 0xE5
    jp z, .skip
    ld a, (cur_user)
    cp (hl)
    jp nz, .skip

    push hl                    ; save entry for the failure path
    inc hl                     ; HL = &entry[1]
    push ix
    pop de
    inc de                     ; DE = &fcb[1]
    ld b, 11
.cmp:
    ld a, (de)
    and 0x7F
    ld c, a
    ld a, (hl)
    and 0x7F
    cp c
    jp nz, .cmp_fail
    inc hl
    inc de
    djnz .cmp
    ; HL = &entry[12]; match EX
    ld a, (hl)
    ld b, a
    ld a, (ix + 12)
    cp b
    jp nz, .cmp_fail

    ; Found — HL = &entry[12].
    ld de, 3
    add hl, de                 ; HL = &entry[15] (RC)
    ld a, (hl)
    ld (ix + 15), a
    inc hl                     ; HL = &entry[16]
    push ix
    pop de
    ld a, e
    add a, 16
    ld e, a
    jr nc, .no_carry
    inc d
.no_carry:
    ld bc, 16
    ldir                       ; entry alloc map -> FCB[16..31]
    pop hl                     ; discard entry (cmp save)
    pop hl                     ; discard entry
    pop de                     ; discard search position
    xor a
    ret
.cmp_fail:
    pop hl                     ; discard entry (cmp save)
.skip:
    pop hl                     ; discard entry
    pop de                     ; discard search position
    inc de
    ld (search_pos), de
    jp .loop
.not_found_pop:
    pop de                     ; discard search position
.not_found:
    or 1
    ret


; ==========================================================================
; @proc create_fcb_extent
; @out   carry
; @clobbers af,bc,de,hl,iy
; @end
; create_fcb_extent — Create an empty directory extent for IX's current EX.
;   In:  IX = FCB (fcb_buf) with user/name and EX set
;   Out: CF=1 = directory full; CF=0 = entry created, FCB RC/alloc cleared
;   Clobbers: AF, BC, DE, HL
create_fcb_extent:
    push ix
    ld de, 0
.scan:
    push de
    call read_dir_entry
    pop de
    jr c, .full
    ld a, (hl)
    cp 0xE5
    jr z, .found
    inc de
    jr .scan
.found:
    push hl
    ld b, 32
.zero:
    ld (hl), 0
    inc hl
    djnz .zero
    pop hl                     ; HL = entry base
    ld a, (cur_user)
    ld (hl), a
    inc hl                     ; HL = &entry[1]
    push ix
    pop de
    inc de                     ; DE = &fcb[1]
    ex de, hl                  ; HL = &fcb[1], DE = &entry[1]
    ld b, 11
.copy:
    ld a, (hl)
    and 0x7F
    ld (de), a
    inc hl
    inc de
    djnz .copy                 ; DE = &entry[12]
    ld a, (ix + 12)
    ld (de), a                 ; entry.EX = FCB.EX
    call write_dir_entry

    ; The new extent starts with no records and no allocated blocks.
    xor a
    ld (ix + 13), a            ; S1
    ld (ix + 14), a            ; S2
    ld (ix + 15), a            ; RC
    push ix
    pop hl
    ld de, 16
    add hl, de
    ld b, 16
.clear:
    ld (hl), 0
    inc hl
    djnz .clear
    pop ix
    xor a                      ; CF=0
    ret
.full:
    pop ix
    scf
    ret


; F34: Write Random
;   In:  DE = FCB (R0/R1/R2 set)
;   Out: A = 0 (OK), 5 (directory full), 6 (out of range)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f34
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f34:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    call rand_to_seq
    or a
    jp nz, .wrrand_err

    ; Look up the target extent; create it when the random record lies
    ; beyond the current end of file.  Without this the write below would
    ; use the current FCB's allocation map and corrupt an earlier extent.
    call select_fcb_drive
    jp c, .wrrand_range
    call is_fcb_readonly
    jp nz, .wrrand_ro
    call find_fcb_extent
    jr z, .wrrand_write
    call create_fcb_extent
    jp c, .wrrand_full

.wrrand_write:
    jp bf_f21_core

.wrrand_ro:
    ld l, a
    ld h, 0
    jp bdos_ret

.wrrand_full:
    ld a, 1                    ; directory full
    ld l, a
    ld h, 0
    jp bdos_ret

.wrrand_range:
    ld a, 6                    ; random record out of range
    ld l, a
    ld h, 0
    jp bdos_ret

.wrrand_err:
    ld l, a
    ld h, 0
    jp bdos_ret


; F35: Compute File Size
;   In:  DE = FCB
;   Out: R0/R1/R2 (FCB[33-35]) = number of records in file
;   Clobbers: AF, BC, DE, HL
; @proc bf_f35
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f35:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    ; Select drive from FCB (or cur_disk if FCB[0]=0). Don't touch cur_disk.
    call select_fcb_drive
    jp c, .fsz_bad             ; invalid drive

    ; Initialize result to 0
    ld (ix + 33), 0
    ld (ix + 34), 0
    ld (ix + 35), 0

    ; Scan all directory entries for matching name
    ld de, 0
.fsz_scan:
    push de
    call read_dir_entry
    pop de
    jp c, .fsz_done

    push de
    push hl
    ; Check user + name match
    ld a, (hl)
    cp 0xE5
    jp z, .fsz_skip
    ld a, (cur_user)
    cp (hl)
    jp nz, .fsz_skip

    push hl
    inc hl
    push ix
    pop de
    inc de
    ld b, 11
.fsz_cmp:
    ld a, (hl)
    and 0x7F
    ld c, a
    ld a, (de)
    cp c
    jp nz, .fsz_cmp_fail
    inc hl
    inc de
    djnz .fsz_cmp
    pop hl                     ; HL = entry base

    ; Match — compute last record: EX * 128 + RC
    ; And update max in R0/R1
    push hl
    ld de, 12
    add hl, de
    ld a, (hl)                 ; EX
    ld b, a
    ld de, 3
    add hl, de                 ; HL = &entry[15]
    ld c, (hl)                 ; RC

    ; last_record = EX * 128 + RC (16-bit)
    pop hl

    ; Clean 16-bit calculation
    ld a, b                    ; A = EX
    ld h, 0
    ld l, a
    ; HL = EX
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl                ; HL = EX * 128
    ld b, 0
    add hl, bc                 ; HL = EX * 128 + RC

    ; Compare with current max in FCB[33-34]. Use SBC HL, DE as a
    ; destructive compare, then ADD HL, DE to restore HL. The carry out
    ; of the ADD mirrors the SBC borrow, so JR C means HL < DE.
    ; Equal is harmless (falls through and re-stores the same value).
    ld e, (ix + 33)
    ld d, (ix + 34)            ; DE = current max
    or a
    sbc hl, de
    add hl, de                 ; restore HL
    jp c, .fsz_skip            ; HL < DE, keep current max
    ; HL >= DE, update
    ld (ix + 33), l
    ld (ix + 34), h

.fsz_skip:
    pop hl
    pop de
    inc de
    jp .fsz_scan

.fsz_cmp_fail:
    pop hl
    jp .fsz_skip

.fsz_bad:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

.fsz_done:
    call writeback_fcb()
    xor a
    ld l, a
    ld h, 0
    jp bdos_ret


; F36: Set Random Record
;   In:  DE = FCB (EX and CR must be valid from sequential I/O)
;   Out: R0/R1/R2 (FCB[33-35]) set from current EX and CR
;   Clobbers: AF, BC, DE, HL
; @proc bf_f36
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix
; @end
bf_f36:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    ; R = EX * 128 + CR
    ld a, (ix + 12)            ; EX
    ld l, a
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl                ; HL = EX * 128
    ld a, (ix + 32)            ; CR
    ld c, a
    ld b, 0
    add hl, bc                 ; HL = EX * 128 + CR

    ld (ix + 33), l            ; R0
    ld (ix + 34), h            ; R1
    ld (ix + 35), 0            ; R2

    call writeback_fcb()
    jp bdos_eok                ; A=0, HL=0 on success


; F40: Write Random with Zero Fill
;   Same as F34, except that a newly allocated data block is filled with
;   zeros before the record is written, so unwritten records in that block
;   read back as zeros.  bf_f40 just marks the request; bf_f21_core does
;   the fill at the single block-allocation point.
; @proc bf_f40
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f40:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA
    call rand_to_seq
    or a
    jp nz, .wrrand0_err
    call select_fcb_drive
    jp c, .wrrand0_range
    call is_fcb_readonly
    jp nz, .wrrand0_ro
    call find_fcb_extent
    jr z, .wrrand0_write
    call create_fcb_extent
    jp c, .wrrand0_full
.wrrand0_write:
    ld a, 1
    ld (f40_zfill), a          ; bf_f21_core zero-fills the new block
    jp bf_f21_core
.wrrand0_ro:
    ld l, a
    ld h, 0
    jp bdos_ret
.wrrand0_full:
    ld a, 5                    ; directory full
    ld l, a
    ld h, 0
    jp bdos_ret
.wrrand0_range:
    ld a, 6                    ; random record out of range
    ld l, a
    ld h, 0
    jp bdos_ret
.wrrand0_err:
    ld l, a
    ld h, 0
    jp bdos_ret


; ==========================================================================
; @proc div_hl_bc
; @param %dividend:u16 hl
; @param %divisor:u16  bc
; @out   hl
; @out   de
; @clobbers af
; @end
; Utility: 16-bit division
;   div_hl_bc — HL = HL / BC, DE = HL % BC (remainder)
;   Clobbers: AF
; ==========================================================================
div_hl_bc:
    ld de, 0                   ; DE = remainder
    ld a, 16                   ; 16-bit division
.loop:
    add hl, hl                 ; Shift dividend left
    rl e
    rl d                       ; Shift into remainder
    push hl
    ld h, d
    ld l, e
    or a
    sbc hl, bc                 ; Try subtract divisor
    jp c, .no_sub
    ld d, h
    ld e, l                    ; Keep subtracted remainder
    pop hl
    set 0, l                   ; Set quotient bit
    dec a
    jp nz, .loop
    ret
.no_sub:
    pop hl
    dec a
    jp nz, .loop
    ret


; ==========================================================================
; Extended BDOS Functions (F45-F112)
; ==========================================================================


; F44: Set Multi-Sector Count
;   In:  E = record count (1..127)
;   Out: A = 0 (accepted) or 0xFF (invalid)
;   The count lives in the SCB (scb_multi, offset 0x4A) so that F49
;   reads and writes the same byte.  F20/F21 honour it; the random
;   functions always transfer a single record.
; @proc bf_f44
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f44:
    pop de
    pop bc
    ld a, e
    or a
    jr z, .f44_bad
    cp 128
    jr nc, .f44_bad
    ld (scb_multi), a
    jp bdos_eok
.f44_bad:
    jp bdos_efail


; F45: Set BDOS Error Mode
;   In: E = mode
;   Out: A = 0
;   Clobbers: AF, DE, BC, HL
; @proc bf_f45
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f45:
    pop de
    pop bc
    ld a, e
    ld (error_mode), a
    ld (scb_errmode), a
    jp bdos_eok


; F46: Get Free Space
;   In:  E = drive (0=A:, 1=B:, ...)
;   Out: A=0 on success; three bytes at the DMA address hold the free
;        128-byte record count (low, high, 0).  A=0xFF if the drive is
;        invalid.  The DMA address itself is unchanged.
; @proc bf_f46
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f46:
    pop de
    pop bc
    ld a, e
    cp 16
    jp nc, .f46_err
    call select_drive
    jp c, .f46_err

    ; Scan ALV bits 0..DSM.  Bit 7 of the first byte is block 0.
    ld hl, (cached_dsm)
    inc hl
    ld (f46_left), hl
    ld hl, (cached_alv)
    ld (f46_ptr), hl
    ld a, (hl)
    ld (f46_byte), a
    ld a, 0x80
    ld (f46_mask), a
    ld bc, 0                    ; BC = free block count

.f46_loop:
    ld a, (f46_byte)
    ld e, a
    ld a, (f46_mask)
    and e
    jr nz, .f46_used
    inc bc                      ; bit clear = block free
.f46_used:
    ; Step the mask; fetch the next ALV byte when it runs out.
    ld a, (f46_mask)
    srl a
    jr nc, .f46_store_mask
    ld a, 0x80
    ld (f46_mask), a
    push bc
    ld hl, (f46_ptr)
    inc hl
    ld (f46_ptr), hl
    ld a, (hl)
    ld (f46_byte), a
    pop bc
    jr .f46_next
.f46_store_mask:
    ld (f46_mask), a
.f46_next:
    ld hl, (f46_left)
    dec hl
    ld (f46_left), hl
    ld a, h
    or l
    jr nz, .f46_loop

    ; records = free blocks << BSH (records per block = 2^BSH)
    ld a, (cached_bsh)
    or a
    jr z, .f46_scaled
.f46_shift:
    sla c
    rl b
    dec a
    jr nz, .f46_shift
.f46_scaled:
    ; Deliver three bytes at the DMA address: low, high, 0.
    ld de, (bdos_dma)
    ld a, c
    push bc
    call write_user_byte
    pop bc
    push bc
    ld de, (bdos_dma)
    inc de
    ld a, b
    call write_user_byte
    pop bc
    ld de, (bdos_dma)
    inc de
    inc de
    xor a
    call write_user_byte
    jp bdos_eok

.f46_err:
    jp bdos_efail


; F47: Chain to Program
;   In:  E = 0xFF to adopt the current drive/user as the CCP's
;   The command line is already in the TPA at 0080h.  Mark a chain as
;   pending in the SCB and warm boot; the CCP sees the flag, consumes the
;   tail and does not clear the program return code.
;   Does not return on success.
; @proc bf_f47
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f47:
    pop de
    pop bc
    ld a, 1
    ld (scb_chain), a
    jp fn_wboot


; F48: Flush Buffers
;   Out: A = 0
;   Clobbers: AF, DE, BC, HL
; @proc bf_f48
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix
; @end
bf_f48:
    pop de
    pop bc
    call flush_deblock
    jp bdos_eok


; F59: Load Overlay
;   In:  DE = FCB of an already-open file; FCB+21h holds the load address
;        DE = 0: no load (nothing resident to clean up)
;   Out: A = 0 (OK), 0xFE (load error)
;   Loads 128-byte records sequentially at the address in the FCB until
;   end of file, then restores the DMA address.
; @proc bf_f59
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f59:
    ; lint-exempt: stack  ; pushes BC/DE for the inner core each pass
    pop de
    pop bc
    ld a, d
    or e
    jp z, bdos_eok              ; DE=0: nothing to load
    ld (f59_fcb), de
    ld hl, (bdos_dma)
    ld (f59_dma), hl

    ; Load address = word at FCB+21h
    ld hl, 33
    add hl, de
    ex de, hl
    call read_user_byte
    ld (f59_dest), a
    ld de, (f59_fcb)
    ld hl, 34
    add hl, de
    ex de, hl
    call read_user_byte
    ld (f59_dest + 1), a

    ld a, 1
    ld (ms_active), a
.f59_loop:
    ld hl, (f59_dest)
    ld (bdos_dma), hl
    ld (scb_dma), hl
    ld de, (f59_fcb)
    call f20_body
    or a
    jr z, .f59_next
    cp 1
    jr z, .f59_ok
    jr .f59_err
.f59_next:
    ld hl, (f59_dest)
    ld de, 128
    add hl, de
    ld (f59_dest), hl
    jr .f59_loop
.f59_ok:
    xor a
    jr .f59_ret
.f59_err:
    ld a, 0xFE
.f59_ret:
    ld (ms_result), a
    xor a
    ld (ms_active), a
    ld hl, (f59_dma)
    ld (bdos_dma), hl
    ld (scb_dma), hl
    ld a, (ms_result)
    ld l, a
    ld h, 0
    jp bdos_ret


; F98: Clean Up Disc (called by the CCP when a program terminates)
;   Our buffers are per-call, so there is nothing to purge.
; @proc bf_f98
; @param %func:u8 c
; @out   a
; @out   hl
; @clobbers af,hl
; @end
bf_f98:
    jp bdos_eok


; F49: Get/Set System Control Block
; @proc bf_f49
; @param %pb:u16    de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
;   In: DE = pointer to SCB parameter block in TPA
;        PB[0] = offset, PB[1] = operation (0=get, FE=set byte, FF=set word)
;        PB[2..3] = value for set operations
;   Out: HL = word at SCB[offset] (for get)
;   Clobbers: AF, BC, DE, HL
bf_f49:
    pop de
    pop bc
    ; Read offset and operation from user parameter block
    push de
    call read_user_byte(de) preserving %func    ; A = PB[0] = offset
    ld c, a                    ; C = offset
    pop de
    inc de
    push de
    push bc                    ; Save C (offset) — read_user_byte clobbers BC  ; lint: ignore
    call read_user_byte(de) preserving %func    ; A = PB[1] = operation
    pop bc                     ; Restore C = offset
    ld b, a                    ; B = operation
    pop de
    inc de
    ; DE now points to PB[2]

    ; Reject offsets outside the 100-byte SCB.  Offset 0x63 is the high
    ; byte of scb_tpa; a word access there would run into the visible BIOS
    ; table, so the whole range 0x63+ is invalid.
    ld a, c
    cp 99
    jp nc, .scb_bad

    ; Build the SCB value for this offset
    ld a, b
    or a
    jr z, .scb_get
    cp 0xFE
    jr z, .scb_setbyte
    cp 0xFF
    jr z, .scb_setword
    ; Unknown op, return 0
    jp bdos_eok

.scb_bad:
    jp bdos_efail              ; A=0xFF, HL=0

.scb_get:
    ; Get: return word from SCB at offset C
    call scb_read_field        ; Returns HL = word
    ld a, l
    jp bdos_ret

.scb_setbyte:
    ; Set byte: read PB[2], write to SCB[offset]
    push bc                    ; Save C = offset
    call read_user_byte(de) preserving %func    ; A = PB[2]
    pop bc
    ld e, a                    ; E = value
    call scb_write_field       ; C = offset, E = value
    ld l, e
    ld h, 0
    ld a, l
    jp bdos_ret

.scb_setword:
    ; Set word: read PB[2..3], write to SCB[offset..offset+1]
    push bc                    ; Save C = offset
    push de
    call read_user_byte(de) preserving %func    ; A = PB[2] (low byte)
    ld b, a
    pop de
    inc de
    push bc                    ; lint: ignore — only B matters, C is don't-care
    call read_user_byte(de) preserving %func    ; A = PB[3] (high byte)
    ld d, a                    ; D = high
    pop bc                     ; B = low
    ld e, b                    ; E = low
    pop bc                     ; C = offset
    push de                    ; Save value (D=high, E=low)
    call scb_write_field       ; Write low byte at offset C
    inc c
    ld e, d                    ; E = high byte
    call scb_write_field       ; Write high byte at offset C+1
    pop hl                     ; HL = value (H=high, L=low)
    ld a, l
    jp bdos_ret


; @proc scb_read_field
; @param %offset:u8 c
; @out   hl
; @clobbers af,de
; @end
; scb_read_field — Read SCB word at offset C
;   In: C = offset
;   Out: HL = word (L=low, H=high)
;   Clobbers: AF, DE
;
;   Syncs dynamic fields from BDOS state to the in-memory SCB,
;   then reads directly from the SCB block in common memory.
scb_read_field:
    ; Sync dynamic BDOS state → SCB before reading
    ld hl, (bdos_dma)
    ld (scb_dma), hl
    ld a, (cur_disk)
    ld (scb_curdsk), a
    ld a, (cur_user)
    ld (scb_user), a
    ld a, (error_mode)
    ld (scb_errmode), a
    ; Read word from scb_base + C
    ld l, c
    ld h, 0
    ld de, scb_base
    add hl, de                     ; HL = &scb_base[offset]
    ld a, (hl)
    inc hl
    ld h, (hl)
    ld l, a                        ; HL = word at SCB[offset]
    ret
; @proc scb_write_field
; @param %offset:u8  c
; @param %value:u8   e
; @out   e
; @clobbers af,hl
; @end
; scb_write_field — Write byte E to SCB at offset C
;   In: C = offset, E = value
;   Out: E preserved
;   Clobbers: AF, HL
;
;   First refreshes the dynamic SCB fields from BDOS state (so a write to
;   an unrelated field cannot copy stale state back), then writes the byte,
;   then pulls back only the field that was actually written.
scb_write_field:
    ; Sync dynamic BDOS state -> SCB before writing.
    ld hl, (bdos_dma)
    ld (scb_dma), hl
    ld a, (cur_disk)
    ld (scb_curdsk), a
    ld a, (cur_user)
    ld (scb_user), a
    ld a, (error_mode)
    ld (scb_errmode), a

    ; Write byte to scb_base + C
    ld l, c
    ld h, 0
    push de                        ; Save E (value)
    ld de, scb_base
    add hl, de                     ; HL = &scb_base[offset]
    pop de
    ld (hl), e                     ; Write value

    ; Pull back only the field that was written.
    ld a, c
    cp scb_dma - scb_base
    jr z, .dma_low
    cp scb_dma - scb_base + 1
    jr z, .dma_high
    cp scb_curdsk - scb_base
    jr z, .curdisk
    cp scb_user - scb_base
    jr z, .curuser
    cp scb_errmode - scb_base
    jr z, .errmode
    ret

.dma_low:
    ld a, e
    ld (bdos_dma), a
    ld a, (scb_dma + 1)
    ld (bdos_dma + 1), a
    ret
.dma_high:
    ld a, (scb_dma)
    ld (bdos_dma), a
    ld a, e
    ld (bdos_dma + 1), a
    ret
.curdisk:
    ld a, e
    ld (cur_disk), a
    ret
.curuser:
    ld a, e
    ld (cur_user), a
    ret
.errmode:
    ld a, e
    ld (error_mode), a
    ret


; F50: Direct BIOS Call
;   In:  DE = pointer to BIOS Parameter Block in TPA:
;         PB[0]   = BIOS function number (0-32)
;         PB[1]   = A register
;         PB[2-3] = BC (C lo, B hi)
;         PB[4-5] = DE (E lo, D hi)
;         PB[6-7] = HL (L lo, H hi)
;   Out: HL, A = return values from BIOS function
;   Clobbers: AF, BC, DE, HL
; @proc bf_f50
; @param %pb:u16    de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f50:
    pop de
    pop bc
    ; Read 8-byte parameter block from TPA
    call read_user_byte(de) preserving %func        ; PB[0] = func
    ld (_f50_func), a
    inc de
    call read_user_byte(de) preserving %func        ; PB[1] = A
    ld (_f50_a), a
    inc de
    call read_user_byte(de) preserving %func        ; PB[2] = C
    ld (_f50_c), a
    inc de
    call read_user_byte(de) preserving %func        ; PB[3] = B
    ld (_f50_b), a
    inc de
    call read_user_byte(de) preserving %func        ; PB[4] = E
    ld (_f50_e), a
    inc de
    call read_user_byte(de) preserving %func        ; PB[5] = D
    ld (_f50_d), a
    inc de
    call read_user_byte(de) preserving %func        ; PB[6] = L
    ld (_f50_l), a
    inc de
    call read_user_byte(de) preserving %func        ; PB[7] = H
    ld (_f50_h), a

    ; Map the public BIOS function number to a callable target.
    ; F50 is a TPA-facing BDOS service, so it follows the visible BIOS ABI:
    ;   - fn 30 (USERF) is rejected: the F50 parameter block has only
    ;     registers, but USERF requires an inline DW after CALL.
    ;   - fn 31 is reserved.
    ;   - fn 32 is SCRMODE via the bank-4 BIOS table.
    ;   - all other callable functions dispatch to the matching bank-4 slot.
    ld a, (_f50_func)
    cp 33
    jr nc, .f50_bad
    cp 30
    jr z, .f50_bad
    cp 31
    jr z, .f50_bad
    ld l, a
    ld h, 0
    ld d, h
    ld e, l
    add hl, hl
    add hl, de                     ; HL = func * 3
    ld de, BIOS4_BASE
    add hl, de                     ; HL = BIOS4_BASE + func * 3
    ld (_f50_target), hl

    ; Set up registers from PB and call the resolved target via RET trick.
    ; Push return address so the BIOS function RETs back to us.
    ld a, (_f50_a)
    ld bc, (_f50_bc)
    ld de, (_f50_de)
    ld hl, .f50_return
    push hl                        ; Return address for BIOS function
    ld hl, (_f50_hl)
    push hl                        ; PB's HL value
    ld hl, (_f50_target)
    ex (sp), hl                    ; Stack: [target, .f50_return], HL = PB's HL
    ret                            ; JP to BIOS function with all regs set

.f50_return:
    ; BIOS function returned. A, HL have results.
    jp bdos_ret

.f50_bad:
    jp bdos_eok

_f50_func:   db 0
_f50_a:      db 0
_f50_bc:
_f50_c:      db 0
_f50_b:      db 0
_f50_de:
_f50_e:      db 0
_f50_d:      db 0
_f50_hl:
_f50_l:      db 0
_f50_h:      db 0
_f50_target: dw 0


; F104: Set Date and Time
;   In: DE = pointer to 4-byte DAT in TPA [days_lo, days_hi, hour, min]
;   Out: A = 0
;   Clobbers: AF, BC, DE, HL
; @proc bf_f104
; @param %dat:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f104:
    pop de
    pop bc
    ; Read 4 bytes from TPA at DE
    push de
    call read_user_byte(de) preserving %func    ; A = days_lo
    ld (scb_date), a
    pop de
    inc de
    push de
    call read_user_byte(de) preserving %func    ; A = days_hi
    ld (scb_date+1), a
    pop de
    inc de
    ; Read BCD hour → binary, multiply by 60
    push de
    call read_user_byte(de) preserving %func    ; A = BCD hour
    call bcd_to_bin                              ; A = binary hour
    pop de
    inc de                         ; DE = minute pointer
    push de                        ; preserve across the hour*60 math
    ld l, a
    ld h, 0                        ; HL = hour
    add hl, hl
    add hl, hl                     ; HL = hour * 4
    push hl
    add hl, hl
    add hl, hl
    add hl, hl                     ; HL = hour * 32
    add hl, hl                     ; HL = hour * 64
    pop de                         ; DE = hour * 4
    or a
    sbc hl, de                     ; HL = hour * 60
    pop de                         ; DE = minute pointer (restored)
    push hl                        ; save hour * 60
    ; Read BCD min → binary, add to hour*60
    call read_user_byte(de) preserving %func    ; A = BCD min
    call bcd_to_bin                              ; A = binary min
    ld e, a
    ld d, 0
    pop hl                         ; HL = hour * 60
    add hl, de                     ; HL = minutes since midnight
    ld (scb_minute), hl
    xor a
    ld (scb_sec), a
    ld l, a
    ld h, a
    jp bdos_ret


; F105: Get Date and Time
;   Out: DMA[0..4] = days_lo, days_hi, hour, min, sec (BCD)
;        A = BCD sec, HL = scb_date
;   Clobbers: AF, BC, DE, HL
; @proc bf_f105
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f105:
    pop de
    pop bc
    ld de, (bdos_dma)
    ld a, (scb_date)
    call write_user_byte(a, de) preserving %func ; DMA[0] = days_lo
    inc de
    ld a, (scb_date+1)
    call write_user_byte(a, de) preserving %func ; DMA[1] = days_hi
    inc de
    ; minutes → BCD hour + BCD minute
    ld hl, (scb_minute)
    call div_hl_60                  ; A = hour, L = minute
    ld b, l                         ; B = minute (bin_to_bcd preserves BC)
    call bin_to_bcd                 ; A = BCD hour
    call write_user_byte(a, de) preserving %func ; DMA[2] = BCD hour
    inc de
    ld a, b                         ; A = minute
    call bin_to_bcd                 ; A = BCD minute
    call write_user_byte(a, de) preserving %func ; DMA[3] = BCD minute
    inc de
    ld a, (scb_sec)
    call bin_to_bcd                 ; A = BCD second
    ld b, a                         ; save BCD sec (write_user_byte may clobber A)
    call write_user_byte(a, de) preserving %func ; DMA[4] = BCD sec
    ld hl, (scb_date)
    ld a, b                         ; A = BCD sec (return value)
    jp bdos_ret


; ------------------------------------------------------------------
; bcd_to_bin — convert BCD byte to binary
;
; @proc bcd_to_bin
; @param %bcd:u8  a                ; BCD value (e.g. 0x23 = 23)
; @out   a                         ; binary value
; @clobbers af
; @end
bcd_to_bin:
    push bc
    ld b, a
    and 0x0F
    ld c, a                         ; C = units
    ld a, b
    rrca
    rrca
    rrca
    rrca
    and 0x0F                        ; A = tens
    ld b, a
    add a, a
    add a, a
    add a, a                        ; tens * 8
    add a, b
    add a, b                        ; tens * 10
    add a, c                        ; + units
    pop bc
    ret


; ------------------------------------------------------------------
; bin_to_bcd — convert binary byte to BCD
;
; @proc bin_to_bcd
; @param %val:u8  a                ; binary 0-99
; @out   a                         ; BCD encoded
; @clobbers af
; @end
bin_to_bcd:
    push bc
    ld b, 0
.lp:
    cp 10
    jr c, .done
    sub 10
    inc b
    jr .lp
.done:
    ld c, a                         ; C = units
    ld a, b                         ; A = tens
    add a, a
    add a, a
    add a, a
    add a, a                        ; tens << 4
    or c                            ; (tens << 4) | units
    pop bc
    ret


; ------------------------------------------------------------------
; div_hl_60 — divide HL by 60
;
; @proc div_hl_60
; @param %dividend:u16  hl         ; 0-1439
; @out   a                         ; quotient (0-23)
; @out   l                         ; remainder (0-59)
; @clobbers af,h
; @end
div_hl_60:
    push bc
    xor a
.lp:
    ld b, a
    ld a, h
    or a
    jr nz, .sub
    ld a, l
    cp 60
    jr c, .done
.sub:
    ld a, l
    sub 60
    ld l, a
    jr nc, .nb
    dec h
.nb:
    ld a, b
    inc a
    jr .lp
.done:
    ld a, b
    pop bc
    ret


; F109: Get/Set Console Mode
;   In: DE = 0xFFFF to get, else sets con_mode = DE
;   Out: HL = con_mode (get) or A = 0 (set)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f109
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f109:
    pop de
    pop bc
    ld a, d
    and e
    cp 0xFF                    ; DE == 0xFFFF?
    jr nz, .cm_set
    ld hl, (con_mode)
    ld a, l
    jp bdos_ret
.cm_set:
    ld (con_mode), de
    jp bdos_eok


; F110: Get/Set Output Delimiter
;   In: DE = 0xFFFF (get) or E = new delimiter (set)
;   Out: A = current delimiter, HL = current delimiter
;   Clobbers: AF, BC, DE, HL
; @proc bf_f110
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f110:
    pop de
    pop bc
    ld a, d
    and e
    inc a                      ; 0xFF -> DE was 0xFFFF (get)
    jr z, .dl_get
    ld a, e
    ld (out_delim), a
    jr .dl_ret
.dl_get:
    ld a, (out_delim)
.dl_ret:
    ld l, a
    ld h, 0
    jp bdos_ret


; F107: Get Serial Number
;   In:  DE = buffer in the TPA
;   Out: A = 0; six ASCII bytes written at DE
; @proc bf_f107
; @param %buf:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f107:
    pop de
    pop bc
    ld hl, f107_serial
    ld b, 6
.f107_loop:
    ld a, (hl)
    push hl
    push bc
    call write_user_byte
    pop bc
    pop hl
    inc hl
    inc de
    djnz .f107_loop
    jp bdos_eok

f107_serial: db 'OPNCP3'


; F108: Get/Set Program Return Code
;   In:  DE = 0xFFFF to read, otherwise the new 16-bit code
;   Out: HL = current code
; @proc bf_f108
; @param %code:u16  de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f108:
    pop de
    pop bc
    ld a, d
    and e
    cp 0xFF
    jr z, .f108_get
    ld (scb_rc), de
.f108_get:
    ld hl, (scb_rc)
    ld a, l
    jp bdos_ret


; F111: Send Block of Text to Console
;   In:  DE = character control block in the TPA: [addr lo, addr hi, len lo, len hi]
;   Out: A = 0
; @proc bf_f111
; @param %cb:u16    de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix
; @end
bf_f111:
    pop de
    pop bc
    ld (f111_cb), de
    call read_user_byte         ; CB[0] = text address low
    ld (f111_addr), a
    ld de, (f111_cb)
    inc de
    call read_user_byte
    ld (f111_addr + 1), a
    ld de, (f111_cb)
    inc de
    inc de
    call read_user_byte         ; CB[2] = length low
    ld (f111_len), a
    ld de, (f111_cb)
    inc de
    inc de
    inc de
    call read_user_byte
    ld (f111_len + 1), a
.f111_loop:
    ld hl, (f111_len)
    ld a, h
    or l
    jr z, .f111_done
    dec hl
    ld (f111_len), hl
    ld de, (f111_addr)
    call read_user_byte
    ld c, a
    call bdos_con_out
    ld hl, (f111_addr)
    inc hl
    ld (f111_addr), hl
    jr .f111_loop
.f111_done:
    jp bdos_eok

; F112: Send Block of Text to the Printer
;   No printer is fitted; the block is discarded.
; @proc bf_f112
; @param %cb:u16    de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f112:
    jp bdos_eok


; F99: Truncate File
;   In:  DE = FCB; R0/R1/R2 = required length in 128-byte records
;   Out: A = 0 (truncated) or 0xFF (not found, would extend, bad drive,
;        read-only file, or R2 != 0)
;   Extents past the new length are deleted and their blocks returned to
;   the allocation vector; the extent holding the cut keeps only the
;   blocks below it and gets RC = target - extent_base.  The FCB is
;   re-synchronised to extent 0 (like F15), with CR = 0.
; @proc bf_f99
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f99:
    pop de
    pop bc
    call setup_fcb(de)
    call select_fcb_drive
    jp c, .f99_err
    call is_fcb_readonly
    jp nz, .f99_err

    ; New length comes from R0/R1; R2 must be zero on this filesystem.
    ld a, (ix + 35)
    or a
    jp nz, .f99_err
    ld a, (ix + 34)
    ld (f99_target + 1), a
    ld a, (ix + 33)
    ld (f99_target), a

    ; --- pass 1: find the file and its current length -------------------
    xor a
    ld (f99_found), a
    ld hl, 0
    ld (f99_size), hl
    ld (f99_pos), hl
.p1_loop:
    ld de, (f99_pos)
    call read_dir_entry
    jp c, .p1_done
    ex de, hl                   ; DE = entry
    call f99_match_de
    jr nz, .p1_next
    ld a, 1
    ld (f99_found), a
    call f99_base_of            ; HL = extent base in records
    push de
    push hl
    ld hl, de
    ld bc, 15
    add hl, bc
    ld a, (hl)                  ; RC
    pop hl
    pop de
    ld c, a
    ld b, 0
    add hl, bc                  ; base + RC = end record of this extent
    ld de, (f99_size)
    ld a, h
    cp d
    jr c, .p1_next
    jr nz, .p1_set
    ld a, l
    cp e
    jr c, .p1_next
.p1_set:
    ld (f99_size), hl
.p1_next:
    ld hl, (f99_pos)
    inc hl
    ld (f99_pos), hl
    jr .p1_loop

.p1_done:
    ld a, (f99_found)
    or a
    jp z, .f99_err
    ; Target must not exceed the current length (F99 cannot extend).
    ld hl, (f99_target)
    ld de, (f99_size)
    ld a, h
    cp d
    jp c, .p2_start
    jp nz, .f99_err
    ld a, l
    cp e
    jp c, .p2_start
    jp z, .p2_start
    jp .f99_err

    ; --- pass 2: cut the extents ---------------------------------------
.p2_start:
    ld hl, 0
    ld (f99_pos), hl
.p2_loop:
    ld de, (f99_pos)
    call read_dir_entry
    jp c, .p2_done
    ex de, hl                   ; DE = entry
    ld (f99_entry), de
    call f99_match_de
    jp nz, .p2_next
    call f99_base_of            ; HL = base
    ld de, (f99_target)
    ld a, h
    cp d
    jp c, .p2_below
    jp nz, .p2_above
    ld a, l
    cp e
    jr c, .p2_below
.p2_above:
    ; base >= target: drop this extent, unless it is extent 0 and the
    ; file is being truncated to nothing (keep an empty file).
    ld a, h
    or l
    jr nz, .p2_drop
    xor a
    ld (f99_newrc), a
    ld (f99_blocks), a
    call f99_free_from
    ld hl, (f99_entry)
    ld de, 15
    add hl, de
    xor a
    ld (hl), a                  ; RC = 0
    call write_dir_entry
    jr .p2_next
.p2_below:
    ; Is the cut inside this extent?  base + 128 > target?
    push hl
    ld de, 128
    add hl, de
    ld de, (f99_target)
    ld a, h
    cp d
    jr c, .p2_keep
    jr nz, .p2_partial
    ld a, l
    cp e
    jr c, .p2_keep
    jr z, .p2_keep
.p2_partial:
    pop hl                      ; HL = base
    ; newrc = target - base
    ld a, (f99_target)
    sub l
    ld (f99_newrc), a
    ; blocks needed = (newrc + BLM) >> BSH
    ld a, (cached_blm)
    ld b, a
    ld a, (f99_newrc)
    add a, b
    ld b, a
    ld a, (cached_bsh)
    or a
    jr z, .p2_blk_ready
    ld c, a
    ld a, b
.p2_blk_shift:
    srl a
    dec c
    jr nz, .p2_blk_shift
    ld b, a
.p2_blk_ready:
    ld a, b
    ld (f99_blocks), a
    call f99_free_from
    ld hl, (f99_entry)
    ld de, 15
    add hl, de
    ld a, (f99_newrc)
    ld (hl), a                  ; RC = records left in this extent
    call write_dir_entry
    jr .p2_next
.p2_keep:
    pop hl
    jr .p2_next

.p2_drop:
    xor a
    ld (f99_blocks), a
    call f99_free_from
    ld hl, (f99_entry)
    ld (hl), 0xE5               ; delete the entry
    call write_dir_entry

.p2_next:
    ld hl, (f99_pos)
    inc hl
    ld (f99_pos), hl
    jp .p2_loop

.p2_done:
    ; Re-synchronise the FCB with extent 0, as an open would.
    ld (ix + 12), 0
    ld (ix + 14), 0
    ld (ix + 32), 0
    call find_fcb_extent        ; fills RC and the allocation map for EX=0
    jr z, .f99_ok
    ld (ix + 15), 0
    push ix
    pop hl
    ld de, 16
    add hl, de
    ld b, 16
.f99_clear_map:
    ld (hl), 0
    inc hl
    djnz .f99_clear_map
.f99_ok:
    call writeback_fcb
    xor a
    ld l, a
    ld h, a
    jp bdos_ret

.f99_err:
    jp bdos_efail


; @proc f99_match_de
; @param %entry:u16 de
; @out   zero
; @clobbers af,bc,de,hl
; @end
; f99_match_de — Z set when the directory entry at DE belongs to IX's file.
f99_match_de:
    push de
    ex de, hl
    ld a, (hl)
    cp 0xE5
    jr z, .no
    ld b, a
    ld a, (cur_user)
    cp b
    jr nz, .no
    inc hl
    push ix
    pop de
    inc de
    ld b, 11
.loop:
    ld a, (de)
    and 0x7F
    ld c, a
    ld a, (hl)
    and 0x7F
    cp c
    jr nz, .no
    inc hl
    inc de
    djnz .loop
    pop de
    xor a                       ; Z set = match
    ret
.no:
    pop de
    or 1                        ; Z clear = no match
    ret


; @proc f99_base_of
; @param %entry:u16 de
; @out   hl
; @out   de
; @clobbers af,bc
; @end
; f99_base_of — HL = first record of the extent whose directory entry is DE.
f99_base_of:
    push de
    ex de, hl
    ld bc, 12
    add hl, bc
    ld a, (hl)                  ; EX
    and 0x1F
    ld e, a
    inc hl
    inc hl                      ; +14 = S2
    ld a, (hl)
    and 0x07
    rrca
    rrca
    rrca                        ; (S2 & 7) << 5
    or e
    ld l, a
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl                  ; * 128
    pop de
    ret


; @proc f99_free_from
; @clobbers af,bc,de,hl
; @end
; f99_free_from — Free allocation slots (f99_blocks)..15 of the entry at
; (f99_entry), clearing them in the directory entry.
f99_free_from:
.loop:
    call map_count
    ld b, a
    ld a, (f99_blocks)
    cp b
    ret nc
    ld a, (f99_blocks)
    ld hl, (f99_entry)
    call get_dir_block         ; HL = block, 0 = unused slot
    ld a, h
    or l
    jr z, .next
    call clear_alloc_bit
.next:
    ; Clear the slot itself (one byte, or two in 16-bit block format).
    ld a, (f99_blocks)
    ld hl, (f99_entry)
    call map_block_addr
    ld (hl), 0
    ld a, (cached_blk16)
    or a
    jr z, .advance
    inc hl
    ld (hl), 0
.advance:
    ld a, (f99_blocks)
    inc a
    ld (f99_blocks), a
    jr .loop


; F120: Get SETDEF order byte
;   Out: A = bdos_order (0=COM→SUB, 1=SUB→COM, 2=COM only, 3=SUB only)
; @proc bf_f120
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f120:
    pop de
    pop bc
    ld a, (bdos_order)
    ld l, a
    ld h, 0
    jp bdos_ret


; F121: Set SETDEF order byte
;   In: E = new order value
;   Out: A = 0
; @proc bf_f121
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f121:
    pop de
    pop bc
    ld a, e
    ld (bdos_order), a
    jp bdos_eok


; F122: Get SETDEF search path
;   In: DE = 4-byte TPA buffer to receive path
;   Out: A = 0 (buffer written with 4 drive bytes)
; @proc bf_f122
; @param %buf:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f122:
    pop de
    pop bc
    ld hl, bdos_search_path
    ld b, 4
.f122_loop:
    push bc
    push hl
    push de
    ld a, (hl)
    call write_user_byte(a, de) preserving %func  ; byte → TPA[DE]
    pop de
    pop hl
    pop bc
    inc hl
    inc de
    djnz .f122_loop
    jp bdos_eok


; F123: Set SETDEF search path
;   In: DE = 4-byte TPA buffer with new path
;   Out: A = 0
; @proc bf_f123
; @param %buf:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl
; @end
bf_f123:
    pop de
    pop bc
    ld hl, bdos_search_path
    ld b, 4
.f123_loop:
    push bc
    push hl
    push de
    call read_user_byte(de) preserving %func      ; A = TPA[DE]
    pop de
    pop hl
    pop bc
    ld (hl), a
    inc hl
    inc de
    djnz .f123_loop
    jp bdos_eok
