; ==========================================================================
; CP/M 3.1 BIOS for ZX Spectrum +3 — Banked Architecture
; ==========================================================================
;
; Memory layout:
;   TPA (mode 0: banks 0,1,2,3):
;     0000-00FF   Page zero (JP stubs to common memory)
;     0100-F5FF   TPA (~61K)
;     F600-FFFF   Common memory stub (bank 3, always visible)
;
;   System (mode 3: banks 4,7,6,3):
;     0000-3FFF   Bank 4 — BIOS, BDOS, drivers, font loaders, buffers
;     4000-7FFF   Bank 7 — C: RAM disk (16K) when RAMDISK.FID is loaded
;     8000-BFFF   Bank 6 — fonts, RAMDISK.FID, FDC deblock buffer, text buffers
;     F600-FFFF   Common memory stub (bank 3, always visible)
;
;   Screen access (mode 2: banks 4,5,6,3):
;     4000-7FFF   Bank 5 — Screen RAM (paged in temporarily)
;
; The loader places CPM3.SYS at C000h (bank 3). The init code below
; copies the system image to bank 4 and the common stub to F600h,
; then jumps to cold_boot in bank 4.
;
; Assembled with:
;   sjasmplus --raw=build/bios.bin src/bios/bios.asm
;
; ==========================================================================

    device zxspectrum128
    org 0xC000

; --- Port definitions (global, used by all sections) ---
PORT_1FFD   equ 0x1FFD
PORT_FDC_ST equ 0x2FFD             ; FDC main status register (read)
PORT_FDC_DT equ 0x3FFD             ; FDC data register (read/write)
PORT_ULA    equ 0xFE

; --- Banking modes ---
; Bank 0 (TPA):    mode 0 — banks 0,1,2,3
; Bank 1 (system): mode 3 — banks 4,7,6,3
; Screen access:   mode 2 — banks 4,5,6,3 (temporary, for bank 5)
BANK0_1FFD  equ 0x01              ; Special mode 0, motor off
BANK1_1FFD  equ 0x07              ; Special mode 3, motor off
MOTOR_BIT   equ 0x08              ; OR this in for motor on

; --- CP/M constants ---
CCP_ADDR    equ 0x0100            ; CCP loads here in TPA
; The CCP is no longer embedded in CPM3.SYS.  CCP.COM is read from the boot
; disk into the top of bank 6 on cold boot and copied to CCP_ADDR on every
; warm boot.  Bank 7 belongs to the C: RAM disk, and bank 6 below A900 holds
; the fonts, FID and screen/FDC/BDOS buffers, so B000-BFFF is the only free
; 4K window that nothing touches at run time.
CCP_STAGE   equ 0xB000            ; Staged CCP image (bank 6)
CCP_MAX_BLK equ 4                 ; 1K blocks staged (the whole B000-BFFF window)
JMP_OPCODE  equ 0xC3              ; JP instruction
COMMON_BASE equ 0xF600            ; Start of bank-3 common memory
TPA_TOP     equ COMMON_BASE       ; First byte of common memory = top of TPA
RAMDISK_MSG equ 0x93E0            ; Status string embedded in RAMDISK.FID

; Bank-4 BIOS jump table base.  It must not overlap the IM 1 vector at
; 0038h, so the table starts at 0040h and 0000-003F is page-zero/ISR space.
BIOS4_BASE  equ 0x0040


; ######################################################################
; INIT — One-shot setup code (runs at C000h, copies code to banks)
; ######################################################################

; @proc init
; @clobbers af,bc,de,hl,ix,iy
; @end
init:
    di

    ; ---- Copy system code to bank 4 at 0000h ----
    ; We're in mode 2 (loader left us here): bank 4 @ 0000, bank 3 @ C000.
    ; Do this before installing common.  With COMMON_BASE below the physical
    ; tail of system_image, copying common first would overwrite bytes that
    ; this LDIR still needs to read.
_copy_sys_size equ system_image_end - system_image
    assert system_image >= (0x0000 + _copy_sys_size), "LDIR safe: no overlap (src >= dst+count)"
    ld hl, system_image
    ld de, 0x0000
    ld bc, _copy_sys_size
    ldir

    ; ---- Install common memory stub at COMMON_BASE (bank 3) ----
    ; common_image sits in the file just past system_image; it must be
    ; copied to COMMON_BASE.  Source and destination usually overlap, so the
    ; copy direction matters: LDDR is safe when src starts BELOW dst,
    ; LDIR is safe when src starts AT/ABOVE dst.  We pick at assembly
    ; time based on where common_image actually landed.
_copy_common_size equ common_image_end - common_image
    assert _copy_common_size <= 0x10000 - COMMON_BASE, "common stub overflows bank 3"
    IF common_image < COMMON_BASE
    ld hl, common_image + _copy_common_size - 1
    ld de, COMMON_BASE + _copy_common_size - 1
    ld bc, _copy_common_size
    lddr
    ELSE
    ld hl, common_image
    ld de, COMMON_BASE
    ld bc, _copy_common_size
    ldir
    ENDIF

    ; ---- Jump to cold_boot (now live in bank 4) ----
    jp cold_boot


; ######################################################################
; SYSTEM CODE — Lives in bank 4 (0000-3FFF)
; ######################################################################
;
; Assembled with PHASE 0x0000 so labels resolve to bank 4 addresses.
; The init code copies these bytes from C000+offset to 0000.

system_image:
    PHASE 0x0000

; Reserve page zero (0000-003F) for the IM 1 vector at 0038; the BIOS
; jump table starts at BIOS4_BASE so the vector cannot overwrite entries.
    block BIOS4_BASE, 0

; ==========================================================================
; BIOS Jump Table — 33 entry points, 3 bytes each (JP addr)
; ==========================================================================

bios_base:
fn_boot:  jp cold_boot            ; 0: Cold start
fn_wboot: jp warm_boot            ; 1: Warm start
fn_const: jp con_status            ; 2: Console input status
fn_conin: jp con_in                ; 3: Console input
fn_cono:  jp con_out               ; 4: Console output
fn_list:  jp list_out              ; 5: List (printer) output
fn_auxo:  jp aux_out               ; 6: Aux output
fn_auxi:  jp aux_in                ; 7: Aux input
fn_home:  jp disk_home             ; 8: Home disk
fn_sldsk: jp sel_disk              ; 9: Select disk
fn_sttrk: jp set_trk               ; 10: Set track
fn_stsec: jp set_sec               ; 11: Set sector
fn_stdma: jp set_dma               ; 12: Set DMA address
fn_read:  jp disk_read             ; 13: Read sector
fn_write: jp disk_write            ; 14: Write sector
fn_lists: jp list_status           ; 15: List output status
fn_sctrn: jp sec_trn               ; 16: Sector translate
fn_conos: jp con_out_status        ; 17: Console output status
fn_auxis: jp aux_in_status         ; 18: Aux input status
fn_auxos: jp aux_out_status        ; 19: Aux output status
fn_dvtbl: jp dev_tbl               ; 20: Device table
fn_devin: jp dev_init              ; 21: Device init
fn_drtbl: jp drv_tbl               ; 22: Drive table
fn_mltio: jp multi_io              ; 23: Multi-sector count
fn_flush: jp flush_buf             ; 24: Flush buffers
fn_mov:   jp bios_move             ; 25: Block move
fn_tim:   jp bios_time             ; 26: Time/date
fn_bnksl: jp bank_sel              ; 27: Bank select (in common memory)
fn_stbnk: jp set_bnk               ; 28: Set DMA bank
fn_xmov:  jp bios_xmove            ; 29: Set move banks
        jp 0                     ; 30: reserved
        jp 0                     ; 31: reserved
fn_scrm: jp scr_set_cols          ; 32: SCRMODE — set column count (A=32, 51 or 64)


; ==========================================================================
; System state (bank 4)
; ==========================================================================
dma_bank:     db 0                 ; Bank for disk DMA operations
xmove_src:    db 0                 ; Source bank for next ?move
xmove_dst:    db 0                 ; Dest bank for next ?move
xmove_active: db 0                 ; 1 = inter-bank move pending

; Disk state
disk_drive:   db 0                 ; Currently selected drive
disk_head:    db 0                 ; Physical head (0 or 1; set by ensure_sector)
disk_track:   dw 0                 ; Current track
disk_sector:  dw 0                 ; Current sector
disk_dma:     dw 0                 ; Current DMA address


; ==========================================================================
; COLD BOOT — System startup
;
; @proc cold_boot
; @clobbers af,bc,de,hl,ix,iy
; @end
cold_boot:
    di
    ld sp, bdos_stack              ; Use common-memory stack

    ; Initialize drivers
    call scr_init                  ; Screen: clear, set attributes
    call kbd_init                  ; Keyboard: reset state
    call fdc_init                  ; FDC: recalibrate drive
    call load_fonts                ; Directory scan: fonts, CCP.COM, RAMDISK.FID
    call load_ccp                  ; Stage CCP.COM in bank 6
    call load_fid                  ; Optional: register C: ramdisk if RAMDISK.FID present
    call motor_off                 ; Spin drive down before CCP takes over

    ; Print signon
    ld hl, signon_msg
    call print_str(hl)
    ld hl, (drive_table_c_slot)
    ld a, h
    or l
    jr z, .no_fid_msg
    ld hl, RAMDISK_MSG
    call print_str(hl)
.no_fid_msg:

    ; Without a CCP there is nothing to run: say so instead of jumping into
    ; whatever happens to be at 0100h.
    ld hl, (_ccp_len)
    ld a, h
    or l
    jr nz, .ccp_ok
    ld hl, MSG_NO_CCP
    call print_str
.halt:
    jr .halt
.ccp_ok:

    ; Initialize state
    xor a
    ld (xmove_active), a
    ld (dma_bank), a

    ; Set up ISR vector in bank 4 (system mode uses bank 4 at 0x0000)
    ld a, 0xC3                     ; JP opcode
    ld (0x0038), a
    ld hl, isr_handler
    ld (0x0039), hl

    ; Patch SCB dynamic fields
    ld hl, scb_base
    ld (scb_common), hl            ; SCB[0x3A] = common memory base
    ld hl, TPA_TOP
    ld (scb_tpa), hl               ; SCB[0x62] = top of TPA (not bdos_stub)

    ; Fall through to warm boot (loads CCP and starts it)


; ==========================================================================
; WARM BOOT — Reload CCP after program exit
;
; @proc warm_boot
; @clobbers af,bc,de,hl
; @end
warm_boot:
    di
    ld sp, bdos_stack

    ; CP/M 3 resets the F9 output delimiter to '$' when a transient
    ; program begins.  A program that changes it via F110 must not leak
    ; that setting into the CCP's own $-terminated messages.
    ld a, '$'
    ld (out_delim), a

    ; Likewise the multi-sector count: a program that calls F44 must not
    ; leave the CCP's .COM loader reading several records per call.
    ld a, 1
    ld (scb_multi), a

    ; Copy the staged CCP from bank 6 to TPA at 0100h via inter-bank copy.
    ; The image was loaded from CCP.COM during cold boot; warm boot never
    ; touches the disk, so a program that clobbers the TPA (or erases
    ; CCP.COM) still gets a clean CCP.
    ld hl, CCP_STAGE               ; Source: bank 6 (system mode)
    ld de, CCP_ADDR                ; Dest: 0100h in bank 0
    ld bc, (_ccp_len)
    call copy_block_to_tpa(hl, de, bc)

    ; Set default DMA to 0080h
    ld bc, 0x0080
    ld (disk_dma), bc

    ; Reset state
    xor a
    ld (xmove_active), a
    ld (dma_bank), a

    ; Switch to TPA, set up page zero, start CCP
    jp start_tpa                   ; Common-memory routine (never returns)


; ==========================================================================
; Console I/O
; ==========================================================================

; @proc con_status
; @out a                           ; 0xFF = ready, 0x00 = not ready
; @clobbers af,bc,de,hl
; @end
con_status:
    jp kbd_status

; @proc con_in
; @out a                           ; character
; @clobbers af,bc,de,hl
; @end
con_in:
    jp kbd_getchar

; @proc con_out
; @param %char:u8  c               ; character to output
; @clobbers af,bc,de,hl,ix
; @end
con_out:
    ld a, %char
    jp scr_putchar

; @proc con_out_status
; @out a                           ; 0xFF (always ready)
; @clobbers af
; @end
con_out_status:
    jp scr_status


; ==========================================================================
; List / Aux — Stubbed (no printer or serial port)
; ==========================================================================

; @proc list_out
; @clobbers
; @end
list_out:
; @proc aux_out
; @clobbers
; @end
aux_out:
    ret

; @proc aux_in
; @out a                           ; 0x1A (EOF)
; @clobbers bc,de,hl
; @end
aux_in:
    ld a, 0x1A                     ; Return EOF
    ret

; @proc list_status
; @out a
; @clobbers
; @end
list_status:
; @proc aux_in_status
; @out a
; @clobbers
; @end
aux_in_status:
; @proc aux_out_status
; @out a                           ; 0 (not ready)
; @clobbers
; @end
aux_out_status:
    xor a                          ; Not ready
    ret

; @proc dev_init
; @clobbers
; @end
dev_init:
    ret


; ==========================================================================
; Device and Drive Tables
; ==========================================================================

; @proc dev_tbl
; @out hl                          ; pointer to char_dev_table
; @clobbers af,bc,de
; @end
dev_tbl:
    ld hl, char_dev_table
    ret

char_dev_table:
    db 'CON   '                    ; Device name (6 chars)
    db 0x03                        ; Mode: input + output
    db 0                           ; Baud: N/A
    db 0                           ; Table terminator

; @proc drv_tbl
; @out hl                          ; pointer to drive_table
; @clobbers af,bc,de
; @end
drv_tbl:
    ld hl, drive_table
    ret

; drive_table moved to common memory (common.zpa) so TPA programs can
; dereference it — label resolves to its common-memory address.


; ==========================================================================
; Disk Operations
; ==========================================================================

; @proc disk_home
; @clobbers bc
; @end
disk_home:
    ld bc, 0
    ; Fall through to set_trk

; @proc set_trk
; @param %track:u16  bc
; @clobbers
; @end
set_trk:
    ld (disk_track), %track
    ret

; @proc set_sec
; @param %sector:u16  bc
; @clobbers
; @end
set_sec:
    ld (disk_sector), %sector
    ret

; @proc set_dma
; @param %dma:u16  bc
; @clobbers
; @end
set_dma:
    ld (disk_dma), %dma
    ret

; @proc sel_disk
; @param %drive:u8  c              ; drive number (0=A:)
; @param %login:u8  e              ; E bit 0 = 0 → first selection → run fdc_login
; @out   hl                        ; DPH address (0 = invalid)
; @clobbers af,bc,de
; @end
;
; Per CP/M 3 BIOS convention: E bit 0 = 0 means this is the first SELDSK
; for the drive since cold boot, warm reset, or BDOS fn 37 (reset disk);
; bit 0 = 1 means it's already been logged in this session. We probe the
; disc geometry only on the first-select case so normal file I/O never
; re-reads the boot sector. fdc_login self-gates via the XDPB Freeze byte
; as a second safety net — a redundant call is one byte-compare + ret z.
;
; The BDOS (select_drive) also calls fdc_login explicitly on its own
; first-login path; this hook covers TPA programs that drive SELDSK
; directly (FORMAT, DISCKIT, SHOWXDPB, etc.) so they don't read stale
; defaults out of xdpb_a / xdpb_b.
sel_disk:
    ld a, %drive
    cp 3
    jr nc, .bad_drive              ; Drives 0 (A:), 1 (B:), 2 (C: ramdisk)
    cp 2
    jr z, .sel_c                   ; C: needs FID-supplied login, not fdc_login
    ld (disk_drive), a
    bit 0, %login
    jr nz, .pick_dph               ; bit 0 = 1 → already logged in → fast path
    push ix                        ; fdc_login uses IX; TPA callers may rely on it
    call fdc_login
    pop ix
.pick_dph:
    ld a, (disk_drive)
    or a
    jr nz, .is_b
    ld hl, xdph_a
    ret
.is_b:
    ld hl, xdph_b
    ret
.sel_c:
    ; Reject if no FID was loaded.  RAM disk needs no login probe — the
    ; loader populated xdpb_c at boot and the format never changes.
    ld hl, (drive_table_c_slot)
    ld a, h
    or l
    jr z, .bad_drive
    ld a, 2
    ld (disk_drive), a
    ret
.bad_drive:
    ld hl, 0
    ret

; @proc disk_read
; @out a                           ; 0=ok, 1=error
; @clobbers af,bc,de,hl
; @end
disk_read:
    ld a, (disk_drive)
    cp 2
    jp c, fdc_read                 ; A: or B: → floppy
    push iy                        ; preserve caller IY (RAM-disk dispatch)
    ld iy, (xdph_c_read_slot)
    jr _disk_io_c

; @proc disk_write
; @out a                           ; 0=ok, 1=error, 2=read-only
; @clobbers af,bc,de,hl
; @end
disk_write:
    ld a, (disk_drive)
    cp 2
    jp c, fdc_write                ; A: or B: → floppy
    push iy                        ; preserve caller IY (RAM-disk dispatch)
    ld iy, (xdph_c_write_slot)
    ; fall through to _disk_io_c
_disk_io_c:
    ; lint-exempt: stack  ; the third pop pairs with the caller-IY push
    ; in disk_read/disk_write (this fragment is only reached by
    ; fall-through from them)
    push ix
    push iy
    ld hl, (disk_sector)
    ld de, (disk_dma)
    call _call_iy
    pop iy                         ; slot pointer (dead)
    pop ix
    pop iy                         ; caller IY restored
    ret

; Helper used by the FID dispatcher (Z80 has no "call (iy)" — emulate
; via call→jp register).
_call_iy:
    ; lint-exempt: stack
    jp (iy)

; @proc sec_trn
; @param %lsec:u16  bc             ; logical sector
; @param %tbl:u16   de             ; translate table (ignored: 1:1)
; @out   hl                        ; physical sector
; @clobbers
; @end
sec_trn:
    ld l, c                        ; no translation: physical = logical (c = low byte of %lsec)
    ld h, b
    ret

; @proc multi_io
; @param %count:u8  a
; @clobbers
; @end
; Multi-sector I/O is not implemented; accept and ignore the count.
multi_io:
    ret

; @proc flush_buf
; @out a                           ; 0 = success
; @clobbers
; @end
flush_buf:
    xor a                          ; Success
    ret

; @proc set_bnk
; @param %bank:u8  a
; @clobbers
; @end
set_bnk:
    ld (dma_bank), %bank
    ret


; ==========================================================================
; Block Move / Cross-bank Move
; ==========================================================================

; @proc bios_move
; @param %dst:u16   hl
; @param %src:u16   de
; @param %count:u16 bc
; @out   hl                        ; advanced past moved data
; @out   de                        ; advanced past moved data
; @clobbers af,bc
; @end
bios_move:
    ld a, (xmove_active)
    or a
    jp nz, interbank_move          ; → common memory routine

    ; Same-bank move.  CP/M's convention is HL=dst, DE=src, BC=count
    ; (LDIR wants the opposite), and HL/DE must be advanced on return.
    ex de, hl
    ldir
    ex de, hl
    ret

; @proc bios_xmove
; @param %dst_bank:u8  b           ; destination bank number
; @param %src_bank:u8  c           ; source bank number
; @clobbers af
; @end
bios_xmove:
    ld a, %src_bank
    ld (xmove_src), a
    ld a, %dst_bank
    ld (xmove_dst), a
    ld a, 1
    ld (xmove_active), a
    ret


; ==========================================================================
; Time — Read/write SCB time fields
;
; @proc bios_time
; @param %mode:u8  c               ; 0 = get, 0FFh = set
; @clobbers
; @end
bios_time:
    ret


; ==========================================================================
; XBIOS dispatch — called from common-memory userf_stub with A = func_id
; and caller's registers already switched to system bank by bios_call_bank4.
; Only non-CD_VERSION IDs reach here; CD_VERSION is handled inline in the
; common stub to save a bank switch on the hot path.
; ==========================================================================
; @proc xbios_handler
; @param %func_id:u8 a
; @out   af bc de hl
; @clobbers
; @end
xbios_handler:
    cp 0xBF
    jr z, .te_ask
    cp 0xE3
    jr z, .cd_version
    cp 0xE6
    jr z, .cd_info
    cp 0xC5
    jr z, .te_stl_ask
    cp 0xC8
    ret z                          ; TE_STL_ON_OFF — swallow, no status line
    cp 0x98
    jr z, .dd_drive_status
    ld a, 0xFF                     ; unknown XBIOS ID
    ret

.cd_version:
    ; CD_VERSION (0x00E3): A=machine type, B=major, C=minor.
    ld a, 3
    ld bc, 0x0100
    ret

.cd_info:
    ; CD_INFO (0x00E6): hardware configuration.
    ;   A = 0x00 (one drive)
    ;   B = 8    (128K in 16K pages)
    ;   C = 0x00 (no serial)
    ;   D = 0x00 (drive B absent)
    ;   E = 0x15 (drive A: SS, 40-track, 3-inch)
    ;   HL = address of a buffer-descriptor table terminated by 0xFF
    ld bc, 0x0800
    ld de, 0x0015
    ld hl, .buftab
    xor a
    ret

.te_stl_ask:
    ; TE_STL_ASK (0x00C5): status line always off on our driver.
    ;   A = 0x00 (disabled), Zero flag set
    xor a
    ret

.te_ask:
    ; TE_ASK (0x00BF): viewport position/size and cursor position.
    ;   Out: B = viewport top row, C = viewport left column,
    ;        D = viewport height - 1, E = viewport width - 1,
    ;        H = cursor row, L = cursor column.
    ; Our viewport is always the whole screen, so the top-left corner is
    ; (0,0) and the cursor coordinates are already viewport-relative.
    ld b, 0
    ld c, 0
    ld d, SCR_ROWS - 1
    ld a, (scr_cols)
    dec a
    ld e, a
    ld a, (cursor_row)
    ld h, a
    ld a, (cursor_col)
    ld l, a
    ret

.dd_drive_status:
    ; DD_DRIVE_STATUS (0x0098): SENSE DRIVE STATUS, return ST3 in A.
    ;   In:  C = bits 1-0 unit, bit 2 head
    ;   Out: A = µPD765A ST3 byte
    ;          bit 7 Fault, bit 6 WP, bit 5 Ready, bit 4 T0
    ;          bit 3 Two-Sided, bit 2 Head, bits 1-0 Unit
    ; Drive A (unit 0): report Ready + T0 + single-sided + drive A.
    ; Drive B (unit 1): not fitted — Ready and WP both clear (per spec).
    ld a, c
    and 0x03                       ; isolate unit number
    or a
    jr nz, .drive_absent
    ; Unit 0 (drive A): Ready | Track0 | unit-0
    ld a, 0x30                     ; bit 5 = Ready, bit 4 = Track 0
    ret
.drive_absent:
    ; Unit 1 (or higher): drive not fitted.
    ld a, 0x01                     ; unit bit set, Ready=0, WP=0
    ret

.buftab:
    db 0xFF                        ; empty buffer-table terminator


; ==========================================================================
; Utility
; ==========================================================================

; @proc print_str
; @param %str:u16  hl              ; pointer to null-terminated string
; @clobbers af,bc,de,hl,ix
; @end
print_str:
    ld a, (%str)
    or a
    ret z
    ld c, a
    push %str
    call con_out
    pop %str
    inc %str
    jr print_str

    IFNDEF BUILD_NUM
BUILD_NUM equ 0
    ENDIF

TPA_KB equ (TPA_TOP - 0x0100) / 1024

signon_msg:
    db 0x0D, 0x0A
    db "Open CP/M +3 (Build "
    LUA ALLPASS
    local bn = _c("BUILD_NUM")
    local hx = "0123456789ABCDEF"
    local h = function(n) return hx:sub(n+1,n+1) end
    _pc("db '" .. h(bn >> 8) .. h((bn >> 4) & 0xF) .. h(bn & 0xF) .. "'")
    ENDLUA
    db "), "
    db '0' + (TPA_KB / 10) % 10
    db '0' + TPA_KB % 10
    db "K TPA", 0x0D, 0x0A
    db 0x0D, 0x0A
    db 0

MSG_NO_CCP:
    db "CCP.COM missing on drive A:", 0x0D, 0x0A, 0

; ==========================================================================
; Screen driver (includes font data)
; ==========================================================================

    include "screen.asm"

; ==========================================================================
; Keyboard driver
; ==========================================================================

    include "keyboard.asm"

; ==========================================================================
; FDC disk driver
; ==========================================================================

    include "fdc765.asm"


; ==========================================================================
; load_fonts — Directory scan for FONT51/FONT32/FONT64/CCP/RAMDISK
;   Scans the CP/M directory (track 1, physical sectors 1-4) once, records
;   the blocks of the files we need, then loads the three fonts into bank 6
;   (always visible in system mode):
;     FONT51.BIN → 0x8000 (5px-wide, used for 51-col mode)
;     FONT32.BIN → 0x8800 (8px-wide, used for 32-col mode)
;     FONT64.BIN → 0x9400 (4px-wide, used for 64-col mode)
;   CCP.COM is only *recorded* here (see load_ccp); load_fonts leaves the
;   motor on and drive A: selected for it and for load_fid.
;   Called from cold_boot after fdc_init.  fdc_init leaves the motor off,
;   so spin it up here and leave it on for the other loaders (cold_boot
;   spins it down after them).
;   In:  nothing
;   Out: nothing
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc load_fonts
; @clobbers af,bc,de,hl,ix
; @end
load_fonts:
    xor a
    ld (disk_drive), a              ; drive A:
    ld (_lf_found), a
    ld (_font51_blk0), a
    ld (_font51_blk1), a
    ld (_font32_blk0), a
    ld (_font32_blk1), a
    ld (_font64_blk0), a
    ld (_font64_blk1), a
    ld (_ccp_al), a                 ; CCP not found yet
    ld (_fid_block), a              ; FID not yet found; load_fid will check this

    call motor_on                   ; fdc_init left the motor off

    ; Seek to track 1 (first data track: OFF=1)
    ld a, 1
    call fdc_seek

    ; Scan 4 physical sectors (sectors 1-4) = 64 directory entries
    ld bc, 1                        ; B=0 (only C used; B initialized so push bc below is defined)
.lf_dsec:
    ld a, c
    cp 5
    jr nc, .lf_dsec_done
    push bc
    call fdc_read_sector            ; → deblock_buf
    pop bc
    jr nz, .lf_dsec_done            ; I/O error — abort

    push bc
    ld hl, deblock_buf
    ld b, 16                        ; 16 entries per sector
.lf_dent:
    push bc
    push hl
    call _lf_check_entry
    pop hl
    pop bc
    ld de, 32
    add hl, de
    djnz .lf_dent
    pop bc

    ld a, (_lf_found)
    cp 31
    jr z, .lf_dsec_done             ; found all five files — done early
    inc c
    jr .lf_dsec

.lf_dsec_done:
    ld hl, _font51_blk0
    ld de, 0x8000
    ld b, 2
    call _lf_load_n                 ; load font51 → bank 6 at 0x8000

    ld hl, _font32_blk0
    ld de, 0x8800
    ld b, 2
    call _lf_load_n                 ; load font32 → bank 6 at 0x8800

    ld hl, _font64_blk0
    ld de, 0x9400
    ld b, 2
    call _lf_load_n                 ; load font64 → bank 6 at 0x9400
    ret


; _lf_check_entry — Record blocks for FONT51/FONT32/CCP/RAMDISK dir entries
;   In:  HL = 32-byte directory entry
;   Out:  _lf_found bit set for a recognised file
;   Clobbers: AF, BC, DE, HL
; @proc _lf_check_entry
; @clobbers af,bc,de,hl
; @end
_lf_check_entry:
    ld a, (hl)
    or a
    ret nz                          ; user != 0 — skip

    push hl
    inc hl                          ; HL = entry[1..11] (name+ext)
    ld de, _lf_name51
    ld b, 11
    call _lf_cmp11                  ; Z if match
    pop hl
    jr nz, .lf_try32

    ld bc, 16
    add hl, bc                      ; HL = &entry[16] = AL[0]
    ld a, (hl)
    ld (_font51_blk0), a
    inc hl
    ld a, (hl)
    ld (_font51_blk1), a
    ld a, (_lf_found)
    or 0x01
    ld (_lf_found), a
    ret

.lf_try32:
    push hl
    inc hl
    ld de, _lf_name32
    ld b, 11
    call _lf_cmp11
    pop hl
    jr nz, .lf_try64

    ld bc, 16
    add hl, bc
    ld a, (hl)
    ld (_font32_blk0), a
    inc hl
    ld a, (hl)
    ld (_font32_blk1), a
    ld a, (_lf_found)
    or 0x02
    ld (_lf_found), a
    ret

.lf_try64:
    push hl
    inc hl
    ld de, _lf_name64
    ld b, 11
    call _lf_cmp11
    pop hl
    jr nz, .lf_try_ccp

    ld bc, 16
    add hl, bc
    ld a, (hl)
    ld (_font64_blk0), a
    inc hl
    ld a, (hl)
    ld (_font64_blk1), a
    ld a, (_lf_found)
    or 0x10
    ld (_lf_found), a
    ret

.lf_try_ccp:
    ; The CCP is loaded later (load_ccp) so keep the whole allocation map:
    ; a future CCP may use every block of its extent.
    push hl
    inc hl
    ld de, _lf_name_ccp
    ld b, 11
    call _lf_cmp11
    pop hl
    jr nz, .lf_try_fid

    ld bc, 16
    add hl, bc                      ; HL = &entry[16] = AL[0]
    ld de, _ccp_al
    ld bc, 16
    ldir
    ld a, (_lf_found)
    or 0x08
    ld (_lf_found), a
    ret

.lf_try_fid:
    push hl
    inc hl
    ld de, _lf_name_fid
    ld b, 11
    call _lf_cmp11
    pop hl
    ret nz
    ld bc, 16
    add hl, bc
    ld a, (hl)
    ld (_fid_block), a              ; AL[0] = first 1K block of RAMDISK.FID
    ld a, (_lf_found)
    or 0x04
    ld (_lf_found), a
    ret


; _lf_cmp11 — Compare 11 bytes (HL) vs (DE), masking attribute bits
;   In:  HL = source, DE = reference, B = 11
;   Out: Z if all 11 bytes match, NZ on first mismatch
;   Clobbers: AF, BC, DE, HL
; @proc _lf_cmp11
; @out   zero
; @clobbers af,bc,de,hl
; @end
_lf_cmp11:
    ld a, (hl)
    and 0x7F                        ; strip attribute bit
    ld c, a
    ld a, (de)
    cp c
    ret nz
    inc hl
    inc de
    djnz _lf_cmp11
    ret                             ; Z set from last cp (all matched)


; _lf_load_n — Load up to B × 1K blocks from disk to destination DE
;   In:  HL = pointer to a 16-byte allocation map (0 = not allocated / end)
;        DE = destination address (system memory)
;        B  = maximum blocks to load
;   Out: DE = first byte after the loaded image
;   Clobbers: AF, BC, DE, HL
; @proc _lf_load_n
; @out   de
; @clobbers af,bc,hl,ix
; @end
_lf_load_n:
.lf_blk:
    push bc
    push hl
    ld a, (hl)
    or a
    jr z, .lf_blk_skip              ; block 0 = not allocated (file not found)
    call _lf_load_block             ; reads 1K to DE, advances DE by 1024
.lf_blk_skip:
    pop hl
    inc hl
    pop bc
    djnz .lf_blk
    ret


; ==========================================================================
; load_ccp — Stage CCP.COM from the boot disk into bank 6
;   load_fonts has already scanned the directory and copied the file's
;   allocation map into _ccp_al, so no second directory pass is needed.
;   Keeping the CCP out of CPM3.SYS makes the system image ~3K smaller;
;   the staging window is otherwise unused RAM, so it costs no file bytes.
;   In:  _ccp_al populated by load_fonts; motor on, drive A: selected
;   Out: _ccp_len = bytes staged (0 = CCP.COM is not on the disk)
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc load_ccp
; @clobbers af,bc,de,hl,ix
; @end
load_ccp:
    ld hl, 0
    ld (_ccp_len), hl
    ld a, (_ccp_al)
    or a
    ret z                           ; not on the disk — cold_boot reports it
    ld hl, _ccp_al
    ld de, CCP_STAGE
    ld b, CCP_MAX_BLK
    call _lf_load_n                 ; DE = first byte past the staged image
    ex de, hl                       ; HL = end of image
    ld bc, 0 - CCP_STAGE
    add hl, bc                      ; HL = bytes staged
    ld (_ccp_len), hl
    ret


; _lf_load_block — Read one 1K block (2 physical sectors) to DE
;   In:  A = CP/M block number (2..174), DE = destination
;   Out: DE advanced by 1024
;   Clobbers: AF, BC, HL
; @proc _lf_load_block
; @clobbers af,bc,de,hl,ix
; @end
_lf_load_block:
    ld l, a
    ld h, 0
    add hl, hl                      ; HL = block * 2 = first abs physical sector
    ld (_lf_abs_phys), hl

    ld b, 2                         ; 2 physical sectors per 1K block
.lf_phys:
    push bc
    push de
    ld hl, (_lf_abs_phys)
    call _lf_div9                   ; B = HL/9 (quotient), A = HL%9 (remainder)
    inc a                           ; sector ID = remainder + 1
    ld (_lf_sec_id), a              ; save across fdc_seek (avoids push/pop)
    ld a, b
    inc a                           ; track = quotient + OFF (OFF=1)
    call fdc_seek                   ; clobbers AF, BC, DE, HL
    ld a, (_lf_sec_id)
    call fdc_read_sector            ; → deblock_buf; clobbers AF, BC, DE, HL
    pop de                          ; DE = destination
    ld hl, deblock_buf
    ld bc, 512
    ldir                            ; copy 512B; DE += 512 automatically
    ld hl, (_lf_abs_phys)
    inc hl
    ld (_lf_abs_phys), hl
    pop bc
    djnz .lf_phys
    ret


; _lf_div9 — Divide HL by 9 via repeated subtraction
;   In:  HL = dividend (0..349 for our block range)
;   Out: B = quotient, A = remainder
;   Clobbers: AF, BC, HL
; @proc _lf_div9
; @out   b,a
; @clobbers af,bc,hl
; @end
_lf_div9:
    ld b, 0
.lf_d9:
    ld a, h
    or a
    jr nz, .lf_d9_sub               ; HL >= 256 → definitely >= 9
    ld a, l
    cp 9
    jr c, .lf_d9_done               ; HL < 9 → done
.lf_d9_sub:
    ld a, l
    sub 9
    ld l, a
    jr nc, .lf_d9_nb
    dec h
.lf_d9_nb:
    inc b
    jr .lf_d9
.lf_d9_done:
    ld a, l                         ; A = remainder
    ret


; --- Font/FID/CCP loader data ---
_lf_found:    db 0                  ; bit 0=font51, 1=font32, 2=fid, 3=ccp, 4=font64
_font51_blk0: db 0                  ; first block number of FONT51.BIN
_font51_blk1: db 0                  ; second block number
_font32_blk0: db 0                  ; first block number of FONT32.BIN
_font32_blk1: db 0
_font64_blk0: db 0                  ; first block number of FONT64.BIN
_font64_blk1: db 0
_fid_block:   db 0                  ; first block number of RAMDISK.FID (0 = absent)
_ccp_al:      ds 16                 ; CCP.COM allocation map (0 = end of file)
_ccp_len:     dw 0                  ; bytes staged at CCP_STAGE (0 = missing)
_lf_abs_phys: dw 0                  ; scratch: current absolute physical sector
_lf_sec_id:   db 0                  ; scratch: sector ID saved across fdc_seek
_lf_name51:   db "FONT51  BIN"      ; 11-char CP/M name (6+2spaces+3ext)
_lf_name32:   db "FONT32  BIN"
_lf_name64:   db "FONT64  BIN"
_lf_name_ccp: db "CCP     COM"
_lf_name_fid: db "RAMDISK FID"
_fid_magic:   db "OCFID", 0         ; 6-byte signature inside RAMDISK.FID


; ==========================================================================
; load_fid — Register C: if the RAMDISK.FID dir scan during load_fonts
; found one.  Loads its first 1K block to 0x9000 in bank 6, verifies the
; OCFID magic, copies the XDPB template into xdpb_c, fills xdph_c's
; prefix slots from the header's entry-point fields, points drive_table[2]
; at xdph_c, and tail-calls the FID's init routine.
;
; Helper stub addresses are NOT patched — RAMDISK.FID hardcodes
; copy_record_to_tpa / copy_record_from_tpa addresses (asserts in
; common.zpa pin them).
;
;   In:  _fid_block populated by load_fonts (0 = no FID found),
;        motor on, drive 0 selected
;   Out: nothing
;   Clobbers: AF, BC, DE, HL, IY
; ==========================================================================
; @proc load_fid
; @clobbers af,bc,de,hl,ix,iy
; @end
load_fid:
    ld a, (_fid_block)
    or a
    ret z                           ; no FID found in dir scan

    ; Load the FID's first 1K block to 0x9000 in bank 6
    ld de, 0x9000
    call _lf_load_block             ; A = block #, DE = dest

    ; Validate "OCFID\0" magic at 0x9000
    ld hl, 0x9000
    ld de, _fid_magic
    ld b, 6
.vm:
    ld a, (de)
    cp (hl)
    ret nz                          ; bad magic — abort registration
    inc de
    inc hl
    djnz .vm

    ; Copy entry addresses (8 bytes: write, read, login, init) into the
    ; xdph_c prefix slots — header layout matches slot order so a single
    ; LDIR does it.
    ld hl, 0x9000 + 12
    ld de, xdph_c_write_slot
    ld c, 8
    ldir

    ; Copy 27-byte XDPB template (header[+24..+50]) into xdpb_c
    ld hl, 0x9000 + 24
    ld de, xdpb_c
    ld c, 27
    ldir

    ; Run init before making C: visible.  A non-zero return leaves
    ; drive_table[2] at zero, so the FID remains unmounted.
    ld iy, (xdph_c_init_slot)
    call _call_iy
    or a
    ret nz

    ; Wire drive_table[2] = xdph_c only after init succeeds.
    ld hl, xdph_c
    ld (drive_table_c_slot), hl
    ret

; ALV vector for C: — read/written by BDOS while bank 4 is mapped.
; 16 blocks → ceil(16/8) = 2 bytes; add slack for safety.
alv_c:          equ 0xA840


; ==========================================================================
; CCP
; ==========================================================================
; The CCP is not part of CPM3.SYS.  It is CCP.COM on the boot disk, staged
; into the top of bank 6 by load_ccp and copied to 0100h on every boot.
; CCP_STAGE must hold one full 4K window inside bank 6.
    assert CCP_STAGE + CCP_MAX_BLK * 1024 <= 0xC000, "CCP staging area exceeds bank 6!"
    assert CCP_STAGE >= 0xB000, "CCP staging area collides with the RAMDISK.FID / screen buffers"


; ==========================================================================
; BDOS
; ==========================================================================

    include "bdos.asm"


; ==========================================================================
system_end:
    assert system_end <= 0x4000, "System code exceeds bank 4 (16K)!"

    DEPHASE
system_image_end:

; ######################################################################
; COMMON MEMORY STUB — Lives at F600-FFFF (bank 3, always visible)
; ######################################################################
;
; Assembled with PHASE COMMON_BASE so labels resolve to common memory addresses.
; The init code copies these bytes from the binary to COMMON_BASE.

common_image:
    PHASE COMMON_BASE

    include "common.asm"

    DEPHASE
common_image_end:


; ######################################################################
; End of CPM3.SYS image
; ######################################################################

    assert $ <= 0x10000, "CPM3.SYS image overflows bank 3!"
