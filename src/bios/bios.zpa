; ==========================================================================
; CP/M 3.1 BIOS for ZX Spectrum +3 — Banked Architecture
; ==========================================================================
;
; Memory layout:
;   TPA (mode 0: banks 0,1,2,3):
;     0000-00FF   Page zero (JP stubs to common memory)
;     0100-F5FF   TPA (~61K)
;     F600-FFFF   Common memory stub (bank 3, always visible)
;
;   System (mode 3: banks 4,7,6,3):
;     0000-3FFF   Bank 4 — BIOS, BDOS, drivers, font loaders, buffers
;     4000-7FFF   Bank 7 — C: RAM disk (16K) when RAMDISK.FID is loaded
;     8000-BFFF   Bank 6 — fonts, RAMDISK.FID, FDC deblock buffer, text buffers
;     F600-FFFF   Common memory stub (bank 3, always visible)
;
;   Screen access (mode 2: banks 4,5,6,3):
;     4000-7FFF   Bank 5 — Screen RAM (paged in temporarily)
;
; The loader places CPM3.SYS at C000h (bank 3). The init code below
; copies the system image to bank 4 and the common stub to F600h,
; then jumps to cold_boot in bank 4.
;
; Assembled with:
;   sjasmplus --raw=build/bios.bin src/bios/bios.asm
;
; ==========================================================================

    device zxspectrum128
    org 0xC000

; --- Port definitions (global, used by all sections) ---
PORT_1FFD   equ 0x1FFD
PORT_FDC_ST equ 0x2FFD             ; FDC main status register (read)
PORT_FDC_DT equ 0x3FFD             ; FDC data register (read/write)
PORT_ULA    equ 0xFE

; --- Banking modes ---
; Bank 0 (TPA):    mode 0 — banks 0,1,2,3
; Bank 1 (system): mode 3 — banks 4,7,6,3
; Screen access:   mode 2 — banks 4,5,6,3 (temporary, for bank 5)
BANK0_1FFD  equ 0x01              ; Special mode 0, motor off
BANK1_1FFD  equ 0x07              ; Special mode 3, motor off
MOTOR_BIT   equ 0x08              ; OR this in for motor on

; --- CP/M constants ---
CCP_ADDR    equ 0x0100            ; CCP loads here in TPA
; The CCP is no longer embedded in CPM3.SYS.  CCP.COM is read from the boot
; disk into the top of bank 6 on cold boot and copied to CCP_ADDR on every
; warm boot.  Bank 7 belongs to the C: RAM disk, and bank 6 below A900 holds
; the fonts, FID and screen/FDC/BDOS buffers, so B000-BFFF is the only free
; 4K window that nothing touches at run time.
CCP_STAGE   equ 0xB000            ; Staged CCP image (bank 6)
CCP_MAX_BLK equ 4                 ; 1K blocks staged (the whole B000-BFFF window)
JMP_OPCODE  equ 0xC3              ; JP instruction
COMMON_BASE equ 0xF600            ; Start of bank-3 common memory
TPA_TOP     equ COMMON_BASE       ; First byte of common memory = top of TPA
RAMDISK_MSG equ 0x93E0            ; Status string embedded in RAMDISK.FID

; Bank-4 BIOS jump table base.  It must not overlap the IM 1 vector at
; 0038h, so the table starts at 0040h and 0000-003F is page-zero/ISR space.
BIOS4_BASE  equ 0x0040


; ######################################################################
; INIT — One-shot setup code (runs at C000h, copies code to banks)
; ######################################################################

; @proc init
; @clobbers af,bc,de,hl,ix,iy
; @end
init:
    di

    ; ---- Copy system code to bank 4 at 0000h ----
    ; We're in mode 2 (loader left us here): bank 4 @ 0000, bank 3 @ C000.
    ; Do this before installing common.  With COMMON_BASE below the physical
    ; tail of system_image, copying common first would overwrite bytes that
    ; this LDIR still needs to read.
_copy_sys_size equ system_image_end - system_image
    assert system_image >= (0x0000 + _copy_sys_size), "LDIR safe: no overlap (src >= dst+count)"
    ld hl, system_image
    ld de, 0x0000
    ld bc, _copy_sys_size
    ldir

    ; ---- Install common memory stub at COMMON_BASE (bank 3) ----
    ; common_image sits in the file just past system_image; it must be
    ; copied to COMMON_BASE.  Source and destination usually overlap, so the
    ; copy direction matters: LDDR is safe when src starts BELOW dst,
    ; LDIR is safe when src starts AT/ABOVE dst.  We pick at assembly
    ; time based on where common_image actually landed.
_copy_common_size equ common_image_end - common_image
    assert _copy_common_size <= 0x10000 - COMMON_BASE, "common stub overflows bank 3"
    IF common_image < COMMON_BASE
    ld hl, common_image + _copy_common_size - 1
    ld de, COMMON_BASE + _copy_common_size - 1
    ld bc, _copy_common_size
    lddr
    ELSE
    ld hl, common_image
    ld de, COMMON_BASE
    ld bc, _copy_common_size
    ldir
    ENDIF

    ; ---- Jump to cold_boot (now live in bank 4) ----
    jp cold_boot


; ######################################################################
; SYSTEM CODE — Lives in bank 4 (0000-3FFF)
; ######################################################################
;
; Assembled with PHASE 0x0000 so labels resolve to bank 4 addresses.
; The init code copies these bytes from C000+offset to 0000.

system_image:
    PHASE 0x0000

; Reserve page zero (0000-003F) for the IM 1 vector at 0038; the BIOS
; jump table starts at BIOS4_BASE so the vector cannot overwrite entries.
    block BIOS4_BASE, 0

; ==========================================================================
; BIOS Jump Table — 33 entry points, 3 bytes each (JP addr)
; ==========================================================================

bios_base:
fn_boot:  jp cold_boot            ; 0: Cold start
fn_wboot: jp warm_boot            ; 1: Warm start
fn_const: jp con_status            ; 2: Console input status
fn_conin: jp con_in                ; 3: Console input
fn_cono:  jp con_out               ; 4: Console output
fn_list:  jp list_out              ; 5: List (printer) output
fn_auxo:  jp aux_out               ; 6: Aux output
fn_auxi:  jp aux_in                ; 7: Aux input
fn_home:  jp disk_home             ; 8: Home disk
fn_sldsk: jp sel_disk              ; 9: Select disk
fn_sttrk: jp set_trk               ; 10: Set track
fn_stsec: jp set_sec               ; 11: Set sector
fn_stdma: jp set_dma               ; 12: Set DMA address
fn_read:  jp disk_read             ; 13: Read sector
fn_write: jp disk_write            ; 14: Write sector
fn_lists: jp list_status           ; 15: List output status
fn_sctrn: jp sec_trn               ; 16: Sector translate
fn_conos: jp con_out_status        ; 17: Console output status
fn_auxis: jp aux_in_status         ; 18: Aux input status
fn_auxos: jp aux_out_status        ; 19: Aux output status
fn_dvtbl: jp dev_tbl               ; 20: Device table
fn_devin: jp dev_init              ; 21: Device init
fn_drtbl: jp drv_tbl               ; 22: Drive table
fn_mltio: jp multi_io              ; 23: Multi-sector count
fn_flush: jp flush_buf             ; 24: Flush buffers
fn_mov:   jp bios_move             ; 25: Block move
fn_tim:   jp bios_time             ; 26: Time/date
fn_bnksl: jp bank_sel              ; 27: Bank select (in common memory)
fn_stbnk: jp set_bnk               ; 28: Set DMA bank
fn_xmov:  jp bios_xmove            ; 29: Set move banks
        jp 0                     ; 30: reserved
        jp 0                     ; 31: reserved
fn_scrm: jp scr_set_cols          ; 32: SCRMODE — set column count (A=32, 51 or 64)


; ==========================================================================
; System state (bank 4)
; ==========================================================================
dma_bank:     db 0                 ; Bank for disk DMA operations
xmove_src:    db 0                 ; Source bank for next ?move
xmove_dst:    db 0                 ; Dest bank for next ?move
xmove_active: db 0                 ; 1 = inter-bank move pending

; Disk state
disk_drive:   db 0                 ; Currently selected drive
disk_head:    db 0                 ; Physical head (0 or 1; set by ensure_sector)
disk_track:   dw 0                 ; Current track
disk_sector:  dw 0                 ; Current sector
disk_dma:     dw 0                 ; Current DMA address

; XBIOS DD_READ_SECTOR / WRITE / CHECK / FORMAT scratch
dd_bank:      db 0                 ; CP/M bank of the caller's buffer
dd_unit:      db 0
dd_track:     db 0                 ; logical track
dd_sector:    db 0                 ; logical sector
dd_user_ptr:  dw 0                 ; caller's buffer
dd_phys_sec:  db 0                 ; mapped physical sector ID
dd_cylinder:  db 0                 ; mapped physical cylinder
dd_filler:    db 0                 ; DD_FORMAT filler byte
dd_format_sc: db 0                 ; DD_FORMAT sectors per track

; DD_L_DPB / DD_L_XDPB spec -> XDPB builder
dd_spec:      ds 10                ; copied disc specification
dd_xdpb_buf:  ds 27                ; built XDPB/DPB image
dd_copy_len:  db 0                 ; 17 = DPB, 27 = XDPB
dd_type:      db 0
dd_psh:       db 0
dd_bsh:       db 0

; DD_L_READ / DD_L_WRITE parameter-block state
dd_param_ptr: dw 0
dd_cmd_ptr:   dw 0
dd_cmd_left:  db 0
dd_xfer_ptr:  dw 0
dd_xfer_left: dw 0
dd_res_idx:   db 0


; ==========================================================================
; COLD BOOT — System startup
;
; @proc cold_boot
; @clobbers af,bc,de,hl,ix,iy
; @end
cold_boot:
    di
    ld sp, bdos_stack              ; Use common-memory stack

    ; Initialize drivers
    call scr_init                  ; Screen: clear, set attributes
    call kbd_init                  ; Keyboard: reset state
    call fdc_init                  ; FDC: recalibrate drive
    call load_fonts                ; Directory scan: fonts, CCP.COM, RAMDISK.FID
    call load_ccp                  ; Stage CCP.COM in bank 6
    call load_fid                  ; Optional: register C: ramdisk if RAMDISK.FID present
    call motor_off                 ; Spin drive down before CCP takes over

    ; Print signon
    ld hl, signon_msg
    call print_str(hl)
    ld hl, (drive_table_c_slot)
    ld a, h
    or l
    jr z, .no_fid_msg
    ld hl, RAMDISK_MSG
    call print_str(hl)
.no_fid_msg:

    ; Without a CCP there is nothing to run: say so instead of jumping into
    ; whatever happens to be at 0100h.
    ld hl, (_ccp_len)
    ld a, h
    or l
    jr nz, .ccp_ok
    ld hl, MSG_NO_CCP
    call print_str
.halt:
    jr .halt
.ccp_ok:

    ; Initialize state
    xor a
    ld (xmove_active), a
    ld (dma_bank), a

    ; Set up ISR vector in bank 4 (system mode uses bank 4 at 0x0000)
    ld a, 0xC3                     ; JP opcode
    ld (0x0038), a
    ld hl, isr_handler
    ld (0x0039), hl

    ; Patch SCB dynamic fields
    ld hl, scb_base
    ld (scb_common), hl            ; SCB[0x3A] = common memory base
    ld hl, TPA_TOP
    ld (scb_tpa), hl               ; SCB[0x62] = top of TPA (not bdos_stub)

    ; Fall through to warm boot (loads CCP and starts it)


; ==========================================================================
; WARM BOOT — Reload CCP after program exit
;
; @proc warm_boot
; @clobbers af,bc,de,hl
; @end
warm_boot:
    di
    ld sp, bdos_stack

    ; CP/M 3 resets the F9 output delimiter to '$' when a transient
    ; program begins.  A program that changes it via F110 must not leak
    ; that setting into the CCP's own $-terminated messages.
    ld a, '$'
    ld (out_delim), a

    ; Likewise the multi-sector count: a program that calls F44 must not
    ; leave the CCP's .COM loader reading several records per call.
    ld a, 1
    ld (scb_multi), a

    ; Copy the staged CCP from bank 6 to TPA at 0100h via inter-bank copy.
    ; The image was loaded from CCP.COM during cold boot; warm boot never
    ; touches the disk, so a program that clobbers the TPA (or erases
    ; CCP.COM) still gets a clean CCP.
    ld hl, CCP_STAGE               ; Source: bank 6 (system mode)
    ld de, CCP_ADDR                ; Dest: 0100h in bank 0
    ld bc, (_ccp_len)
    call copy_block_to_tpa(hl, de, bc)

    ; Set default DMA to 0080h
    ld bc, 0x0080
    ld (disk_dma), bc

    ; Reset state
    xor a
    ld (xmove_active), a
    ld (dma_bank), a

    ; Switch to TPA, set up page zero, start CCP
    jp start_tpa                   ; Common-memory routine (never returns)


; ==========================================================================
; Console I/O
; ==========================================================================

; @proc con_status
; @out a                           ; 0xFF = ready, 0x00 = not ready
; @clobbers af,bc,de,hl
; @end
con_status:
    jp kbd_status

; @proc con_in
; @out a                           ; character
; @clobbers af,bc,de,hl
; @end
con_in:
    jp kbd_getchar

; @proc con_out
; @param %char:u8  c               ; character to output
; @clobbers af,bc,de,hl,ix
; @end
con_out:
    ld a, %char
    jp scr_putchar

; @proc con_out_status
; @out a                           ; 0xFF (always ready)
; @clobbers af
; @end
con_out_status:
    jp scr_status


; ==========================================================================
; List / Aux — Stubbed (no printer or serial port)
; ==========================================================================

; @proc list_out
; @clobbers
; @end
list_out:
; @proc aux_out
; @clobbers
; @end
aux_out:
    ret

; @proc aux_in
; @out a                           ; 0x1A (EOF)
; @clobbers bc,de,hl
; @end
aux_in:
    ld a, 0x1A                     ; Return EOF
    ret

; @proc list_status
; @out a
; @clobbers
; @end
list_status:
; @proc aux_in_status
; @out a
; @clobbers
; @end
aux_in_status:
; @proc aux_out_status
; @out a                           ; 0 (not ready)
; @clobbers
; @end
aux_out_status:
    xor a                          ; Not ready
    ret

; @proc dev_init
; @clobbers
; @end
dev_init:
    ret


; ==========================================================================
; Device and Drive Tables
; ==========================================================================

; @proc dev_tbl
; @out hl                          ; pointer to char_dev_table
; @clobbers af,bc,de
; @end
dev_tbl:
    ld hl, char_dev_table
    ret

char_dev_table:
    db 'CON   '                    ; Device name (6 chars)
    db 0x03                        ; Mode: input + output
    db 0                           ; Baud: N/A
    db 0                           ; Table terminator

; @proc drv_tbl
; @out hl                          ; pointer to drive_table
; @clobbers af,bc,de
; @end
drv_tbl:
    ld hl, drive_table
    ret

; drive_table moved to common memory (common.zpa) so TPA programs can
; dereference it — label resolves to its common-memory address.


; ==========================================================================
; Disk Operations
; ==========================================================================

; @proc disk_home
; @clobbers bc
; @end
disk_home:
    ld bc, 0
    ; Fall through to set_trk

; @proc set_trk
; @param %track:u16  bc
; @clobbers
; @end
set_trk:
    ld (disk_track), %track
    ret

; @proc set_sec
; @param %sector:u16  bc
; @clobbers
; @end
set_sec:
    ld (disk_sector), %sector
    ret

; @proc set_dma
; @param %dma:u16  bc
; @clobbers
; @end
set_dma:
    ld (disk_dma), %dma
    ret

; @proc sel_disk
; @param %drive:u8  c              ; drive number (0=A:)
; @param %login:u8  e              ; E bit 0 = 0 → first selection → run fdc_login
; @out   hl                        ; DPH address (0 = invalid)
; @clobbers af,bc,de
; @end
;
; Per CP/M 3 BIOS convention: E bit 0 = 0 means this is the first SELDSK
; for the drive since cold boot, warm reset, or BDOS fn 37 (reset disk);
; bit 0 = 1 means it's already been logged in this session. We probe the
; disc geometry only on the first-select case so normal file I/O never
; re-reads the boot sector. fdc_login self-gates via the XDPB Freeze byte
; as a second safety net — a redundant call is one byte-compare + ret z.
;
; The BDOS (select_drive) also calls fdc_login explicitly on its own
; first-login path; this hook covers TPA programs that drive SELDSK
; directly (FORMAT, DISCKIT, SHOWXDPB, etc.) so they don't read stale
; defaults out of xdpb_a / xdpb_b.
sel_disk:
    ld a, %drive
    cp 3
    jr nc, .bad_drive              ; Drives 0 (A:), 1 (B:), 2 (C: ramdisk)
    cp 2
    jr z, .sel_c                   ; C: needs FID-supplied login, not fdc_login
    ld (disk_drive), a
    bit 0, %login
    jr nz, .pick_dph               ; bit 0 = 1 → already logged in → fast path
    push ix                        ; fdc_login uses IX; TPA callers may rely on it
    call fdc_login
    pop ix
.pick_dph:
    ld a, (disk_drive)
    or a
    jr nz, .is_b
    ld hl, xdph_a
    ret
.is_b:
    ld hl, xdph_b
    ret
.sel_c:
    ; Reject if no FID was loaded.  RAM disk needs no login probe — the
    ; loader populated xdpb_c at boot and the format never changes.
    ld hl, (drive_table_c_slot)
    ld a, h
    or l
    jr z, .bad_drive
    ld a, 2
    ld (disk_drive), a
    ret
.bad_drive:
    ld hl, 0
    ret

; @proc disk_read
; @out a                           ; 0=ok, 1=error
; @clobbers af,bc,de,hl
; @end
disk_read:
    ld a, (disk_drive)
    cp 2
    jp c, fdc_read                 ; A: or B: → floppy
    push iy                        ; preserve caller IY (RAM-disk dispatch)
    ld iy, (xdph_c_read_slot)
    jr _disk_io_c

; @proc disk_write
; @out a                           ; 0=ok, 1=error, 2=read-only
; @clobbers af,bc,de,hl
; @end
disk_write:
    ld a, (disk_drive)
    cp 2
    jp c, fdc_write                ; A: or B: → floppy
    push iy                        ; preserve caller IY (RAM-disk dispatch)
    ld iy, (xdph_c_write_slot)
    ; fall through to _disk_io_c
_disk_io_c:
    ; lint-exempt: stack  ; the third pop pairs with the caller-IY push
    ; in disk_read/disk_write (this fragment is only reached by
    ; fall-through from them)
    push ix
    push iy
    ld hl, (disk_sector)
    ld de, (disk_dma)
    call _call_iy
    pop iy                         ; slot pointer (dead)
    pop ix
    pop iy                         ; caller IY restored
    ret

; Helper used by the FID dispatcher (Z80 has no "call (iy)" — emulate
; via call→jp register).
_call_iy:
    ; lint-exempt: stack
    jp (iy)

; @proc sec_trn
; @param %lsec:u16  bc             ; logical sector
; @param %tbl:u16   de             ; translate table (ignored: 1:1)
; @out   hl                        ; physical sector
; @clobbers
; @end
sec_trn:
    ld l, c                        ; no translation: physical = logical (c = low byte of %lsec)
    ld h, b
    ret

; @proc multi_io
; @param %count:u8  a
; @clobbers
; @end
; Multi-sector I/O is not implemented; accept and ignore the count.
multi_io:
    ret

; @proc flush_buf
; @out a                           ; 0 = success
; @clobbers
; @end
flush_buf:
    xor a                          ; Success
    ret

; @proc set_bnk
; @param %bank:u8  a
; @clobbers
; @end
set_bnk:
    ld (dma_bank), %bank
    ret


; ==========================================================================
; Block Move / Cross-bank Move
; ==========================================================================

; @proc bios_move
; @param %dst:u16   hl
; @param %src:u16   de
; @param %count:u16 bc
; @out   hl                        ; advanced past moved data
; @out   de                        ; advanced past moved data
; @clobbers af,bc
; @end
bios_move:
    ld a, (xmove_active)
    or a
    jp nz, interbank_move          ; → common memory routine

    ; Same-bank move.  CP/M's convention is HL=dst, DE=src, BC=count
    ; (LDIR wants the opposite), and HL/DE must be advanced on return.
    ex de, hl
    ldir
    ex de, hl
    ret

; @proc bios_xmove
; @param %dst_bank:u8  b           ; destination bank number
; @param %src_bank:u8  c           ; source bank number
; @clobbers af
; @end
bios_xmove:
    ld a, %src_bank
    ld (xmove_src), a
    ld a, %dst_bank
    ld (xmove_dst), a
    ld a, 1
    ld (xmove_active), a
    ret


; ==========================================================================
; Time — Read/write SCB time fields
;
; @proc bios_time
; @param %mode:u8  c               ; 0 = get, 0FFh = set
; @clobbers
; @end
bios_time:
    ret


; ==========================================================================
; XBIOS dispatch — called from common-memory userf_stub with A = func_id
; and caller's registers already switched to system bank by bios_call_bank4.
; Only non-CD_VERSION IDs reach here; CD_VERSION is handled inline in the
; common stub to save a bank switch on the hot path.
; ==========================================================================
; @proc xbios_handler
; @param %func_id:u8 a
; @out   af bc de hl
; @out   ix iy
; @clobbers
; @end
xbios_handler:
    cp 0xBF
    jp z, .te_ask
    cp 0xC2
    jp z, .te_reset
    cp 0xE3
    jr z, .cd_version
    cp 0xE6
    jr z, .cd_info
    cp 0xC5
    jr z, .te_stl_ask
    cp 0xC8
    ret z                          ; TE_STL_ON_OFF — swallow, no status line
    cp 0xCB
    jp z, .te_set_ink
    cp 0xCE
    jp z, .te_set_border
    cp 0xD1
    ret z                          ; TE_SET_SPEED — +3 flash is hardware-only
    cp 0xE9
    jp z, .scr_run_routine
    cp 0x98
    jp z, .dd_drive_status
    cp 0x80
    jp z, .dd_init
    cp 0x83
    jp z, .dd_setup
    cp 0x95
    jp z, .dd_sel_format
    cp 0x9B
    jp z, .dd_read_id
    cp 0x9E
    jp z, .dd_l_dpb
    cp 0xA1
    jp z, .dd_l_xdpb
    cp 0xA4
    jp z, .dd_l_on_motor
    cp 0xA7
    jp z, .dd_l_t_off_motor
    cp 0xAA
    jp z, .dd_off_motor
    cp 0xAD
    jp z, .dd_l_read
    cp 0xB3
    jp z, .dd_l_seek
    cp 0x86
    jp z, .dd_read_sector
    cp 0x89
    jp z, .dd_write
    cp 0x8C
    jp z, .dd_check
    cp 0x8F
    jp z, .dd_format
    cp 0x92
    jp z, .dd_login
    ld a, 0xFF                     ; unknown XBIOS ID
    ret

.cd_version:
    ; CD_VERSION (0x00E3): A=machine type, B=major, C=minor.
    ld a, 3
    ld bc, 0x0100
    ret

.cd_info:
    ; CD_INFO (0x00E6): hardware configuration.
    ;   A = 0x00 (one drive)
    ;   B = 8    (128K in 16K pages)
    ;   C = 0x00 (no serial)
    ;   D = 0x00 (drive B absent)
    ;   E = 0x15 (drive A: SS, 40-track, 3-inch)
    ;   HL = address of a buffer-descriptor table terminated by 0xFF
    ld bc, 0x0800
    ld de, 0x0015
    ld hl, .buftab
    xor a
    ret

.te_stl_ask:
    ; TE_STL_ASK (0x00C5): status line always off on our driver.
    ;   A = 0x00 (disabled), Zero flag set
    xor a
    ret

.te_ask:
    ; TE_ASK (0x00BF): viewport position/size and cursor position.
    ;   Out: B = viewport top row, C = viewport left column,
    ;        D = viewport height - 1, E = viewport width - 1,
    ;        H = cursor row, L = cursor column.
    ; Our viewport is always the whole screen, so the top-left corner is
    ; (0,0) and the cursor coordinates are already viewport-relative.
    ld b, 0
    ld c, 0
    ld d, SCR_ROWS - 1
    ld a, (scr_cols)
    dec a
    ld e, a
    ld a, (cursor_row)
    ld h, a
    ld a, (cursor_col)
    ld l, a
    ret

.te_reset:
    ; TE_RESET (0x00C2): re-initialise the terminal emulator.
    ; Clears the screen, homes the cursor and restores the default
    ; palette/wrap/page-mode state.  The screen width is left unchanged.
    call scr_reset
    ret

.te_set_ink:
    ; TE_SET_INK (0x00CB): set the colour of ink 0 or ink 1.
    ;   In:  A = ink number (preserved by userf_stub), B = colour (0-63),
    ;        C = flash colour (0-63)
    ;   Out: AF BC DE HL corrupt
    ; Ink 0 is the background and the border; ink 1 is the foreground.
    ; Other ink numbers are ignored.  Only future characters take the new
    ; colours; existing screen cells keep the attribute they were drawn
    ; with.  Both inks flashing turns on the hardware FLASH attribute.
    ld a, (xbios_arg_a)
    cp 1
    jr z, .tsi_ink
    or a
    ret nz                         ; inks > 1 are ignored

    ; --- ink 0: paper and border ---
    ld a, b
    and 0x3F
    ld e, a                        ; E = steady colour
    ld a, c
    and 0x3F
    cp e
    ld a, 0
    jr z, .tsi_paper_flash
    inc a
.tsi_paper_flash:
    ld (scr_paper_fl), a
    ld a, e
    call _decode_te_colour
    ld a, b
    ld (scr_paper), a
    ld (scr_border_v), a
    out (PORT_ULA), a
    ld a, c
    ld (scr_paper_br), a
    jr .tsi_done

.tsi_ink:
    ; --- ink 1: foreground ---
    ld a, b
    and 0x3F
    ld e, a
    ld a, c
    and 0x3F
    cp e
    ld a, 0
    jr z, .tsi_ink_flash
    inc a
.tsi_ink_flash:
    ld (scr_ink_fl), a
    ld a, e
    call _decode_te_colour
    ld a, b
    ld (scr_ink), a
    ld a, c
    ld (scr_ink_br), a

.tsi_done:
    call _set_attr
    ret

.te_set_border:
    ; TE_SET_BORDER (0x00CE): set the screen border colour.
    ;   In:  B = colour (0-63), same encoding as TE_SET_INK
    ;   Out: AF BC DE HL corrupt
    ; The border has no bright or flash state; only the three colour
    ; bits are used.  TE_SET_INK ink 0 also changes the border.
    ld a, b
    and 0x3F
    call _decode_te_colour
    ld a, b
    ld (scr_border_v), a
    out (PORT_ULA), a
    ret

.scr_run_routine:
    ; SCR_RUN_ROUTINE (0x00E9): run a routine with the screen paged in.
    ;   In:  BC = routine address, DE/HL/IX/IY = arguments
    ;   Out: AF/DE/HL/IX/IY as returned by the routine; BC corrupt
    ; The text screen is bank 5 at 4000h in screen mode (4,5,6,3).  Only
    ; code in common memory (C000-F5FF) stays visible there, so the routine
    ; must live in that window.  It must not call BDOS or BIOS: those switch
    ; back to TPA/system mode and page the screen out.
    ld a, b
    cp 0xC0
    ret c                          ; below common memory: cannot page it in
    cp 0xF6
    ret nc                         ; common stub above the TPA

    ld ix, (xbios_ret_ix)          ; pass the caller's IX/IY through
    ld iy, (xbios_ret_iy)
    push bc                        ; keep the routine address across the switch
    ld a, (motor_flag)
    or PAGING_SCREEN
    call write_1ffd                ; screen mode: bank 5 at 4000h
    pop bc

    ld (xbios_tmp_hl), hl          ; save caller HL (XBIOS argument)
    ld (.srr_call + 1), bc         ; patch the call target
    ld hl, (xbios_tmp_hl)          ; restore caller HL before it starts
    call .srr_call
    jr .srr_after
.srr_call:
    call 0                         ; patched to the routine address
    ret

.srr_after:
    ld (xbios_ret_ix), ix          ; capture the routine's IX/IY results
    ld (xbios_ret_iy), iy
    push af
    push de
    push hl
    ld a, (motor_flag)
    or BANK1_1FFD
    call write_1ffd                ; back to system mode (4,7,6,3)
    pop hl
    pop de
    pop af
    ret

.dd_init:
    ; DD_INIT (0x0080): reset the disc driver, motor off.
    ;   Out: AF BC DE HL corrupt
    call fdc_init
    ret

.dd_setup:
    ; DD_SETUP (0x0083): set disc timings.
    ;   In:  HL = 7-byte parameter block in common memory
    ;   Out: AF BC DE HL corrupt
    ld de, dd_setup_pb
    ld bc, 7
    ldir

    ; Motor-off timeout: byte 1 is in 100 ms units; the ISR counts 50 Hz
    ; frames.  Clamp to 51 units (255 frames); zero disables the timeout.
    ld a, (dd_setup_pb + 1)
    or a
    jr z, .dsu_no_motor_off
    cp 52
    jr c, .dsu_scale
    ld a, 51
.dsu_scale:
    ld b, a
    add a, a
    add a, a
    add a, b
    ld (motor_off_ticks), a
    jr .dsu_specify
.dsu_no_motor_off:
    xor a
    ld (motor_off_ticks), a
.dsu_specify:
    call fdc_specify
    ret

.dd_sel_format:
    ; DD_SEL_FORMAT (0x0095): load a standard XDPB.
    ;   In:  A = format 0-3, IX = destination XDPB in common memory
    ;   Out: carry set + A = format, or carry clear + A = 6 (bad format)
    ;        BC corrupt; DE/HL/IX/IY preserved
    ld a, (xbios_arg_a)            ; A = caller's requested format
    ld ix, (xbios_ret_ix)
    cp 4
    jr nc, .dsf_bad
    push de
    push hl
    call xdpb_table_offset         ; HL = format * 27
    ld de, xdpb_std_table
    add hl, de
    push ix
    pop de
    ld bc, 27
    ldir
    pop hl
    pop de
    ld a, (xbios_arg_a)
    scf
    ret
.dsf_bad:
    ld a, 6
    or a
    ret

.dd_read_id:
    ; DD_READ_ID (0x009B): read the first sector ID on a logical track.
    ;   In:  C = unit, D = logical track, IX = XDPB
    ;   Out: carry set + A = sector number, or carry clear + A = error
    ;        (0 not ready, 2 seek fail, 3 data error, 5 missing address
    ;        mark); HL = dd_results (count + ST0 ST1 ST2 C H R N)
    xor a
    ld (dd_results), a
    ld a, c
    and 0x03
    jp nz, .dri_not_ready
    ld ix, (xbios_ret_ix)
    ld a, ixh
    cp 0xC0
    jp c, .dri_not_ready          ; XDPB must be in common memory
    call motor_on
    xor a
    ld (disk_drive), a
    ld a, (ix + XDPB_SIDES)
    cp 1
    jr z, .dri_alt_ds
    xor a                         ; SS: head 0, cylinder = track
    ld (disk_head), a
    ld a, d
    jr .dri_seek
.dri_alt_ds:
    ld a, d
    and 1
    ld (disk_head), a             ; head = track & 1
    ld a, d
    srl a                         ; cylinder = track / 2
.dri_seek:
    call fdc_seek
    jr nz, .dri_seek_fail         ; lint: ignore - fdc_seek returns Z/NZ

    ld a, FDC_READ_ID
    call fdc_send_byte
    ld a, (disk_head)
    rlca
    rlca
    and 0x04
    ld b, a
    ld a, (disk_drive)
    and 0x03
    or b
    call fdc_send_byte

    ld hl, dd_results + 1
    ld b, 7
.dri_read:
    push bc
    push hl
    call fdc_read_byte
    pop hl
    pop bc
    ld (hl), a
    inc hl
    djnz .dri_read
    ld a, 7
    ld (dd_results), a

    ld a, (dd_results + 1)        ; ST0
    and 0xC0
    cp 0x80
    jr nc, .dri_data_error
    ld a, (dd_results + 2)        ; ST1
    and 0x3B
    jr nz, .dri_data_error
    ld a, (dd_results + 6)        ; R
    scf
    ld hl, dd_results
    ret
.dri_data_error:
    ld a, (dd_results + 2)
    and 0x01                      ; missing address mark?
    ld a, 3
    jr z, .dri_fail
    ld a, 5
    jr .dri_fail
.dri_seek_fail:
    ld a, 2
.dri_fail:
    or a                          ; clear carry
    ld hl, dd_results
    ret
.dri_not_ready:
    xor a                         ; A = 0, carry clear
    ld hl, dd_results
    ret

.dd_l_dpb:
    ; DD_L_DPB (0x009E): build a standard 17-byte DPB from a disc spec.
    ;   In: HL = 10-byte spec in common memory, IX = destination DPB
    ;   Out: carry set + A = disc type, or carry clear + A = 6
    ld a, 17
    jr .dd_l_build

.dd_l_xdpb:
    ; DD_L_XDPB (0x00A1): build a 27-byte XDPB from a disc spec.
    ;   In: HL = 10-byte spec in common memory, IX = destination XDPB
    ;   Out: carry set + A = disc type, or carry clear + A = 6
    ld a, 27
.dd_l_build:
    ld (dd_copy_len), a
    call .dd_build_xdpb
    ret nc
    ld ix, (xbios_ret_ix)
    ld hl, dd_xdpb_buf
    push ix
    pop de
    ld a, (dd_copy_len)
    ld c, a
    ld b, 0
    ldir
    ld a, (dd_type)
    scf
    ret

; Build a 27-byte XDPB in dd_xdpb_buf from the 10-byte spec at HL.
;   Out: A = disc type + carry set, or A = 6 + carry clear
;   Clobbers: AF, BC, DE, HL
.dd_build_xdpb:
    ld de, dd_spec
    ld bc, 10
    ldir

    ld a, (dd_spec + 0)            ; disc type 0-3
    cp 4
    jp nc, .ddb_bad
    ld (dd_type), a

    ld a, (dd_spec + 1)            ; arrangement 0-2
    and 0x7F
    cp 3
    jp nc, .ddb_bad
    ld (dd_xdpb_buf + 17), a

    ld a, (dd_spec + 2)            ; tracks per side
    or a
    jp z, .ddb_bad
    ld (dd_xdpb_buf + 18), a
    ld a, (dd_spec + 3)            ; sectors per track
    or a
    jp z, .ddb_bad
    ld (dd_xdpb_buf + 19), a

    ld a, (dd_spec + 4)            ; sector-size code (max 512)
    cp 3
    jp nc, .ddb_bad
    ld (dd_psh), a
    ld a, (dd_spec + 6)            ; block-size code (max 16K)
    cp 8
    jp nc, .ddb_bad
    ld (dd_bsh), a

    ld a, (dd_spec + 7)            ; directory blocks 1-16
    or a
    jp z, .ddb_bad
    cp 17
    jp nc, .ddb_bad

    ; SPT = sectors << PSH
    ld a, (dd_spec + 3)
    ld b, a
    ld a, (dd_psh)
    ld c, a
    or a
    jr z, .ddb_spt_store
.ddb_spt_sh:
    sla b
    dec c
    jr nz, .ddb_spt_sh
.ddb_spt_store:
    ld a, b
    ld (dd_xdpb_buf + 0), a
    xor a
    ld (dd_xdpb_buf + 1), a

    ; BSH / BLM
    ld a, (dd_bsh)
    ld (dd_xdpb_buf + 2), a
    ld b, a
    ld a, 1
    inc b
.ddb_blm_loop:
    dec b
    jr z, .ddb_blm_done
    add a, a
    jr .ddb_blm_loop
.ddb_blm_done:
    dec a
    ld (dd_xdpb_buf + 3), a

    ; Data tracks = tracks * sides - reserved
    ld a, (dd_spec + 1)
    and 0x7F
    ld b, 1
    or a
    jr z, .ddb_sides_ok
    ld b, 2
.ddb_sides_ok:
    ld a, (dd_spec + 2)
    ld l, a
    ld h, 0
    dec b
    jr z, .ddb_tracks_ok
    add hl, hl
.ddb_tracks_ok:
    ld a, (dd_spec + 5)
    ld e, a
    ld d, 0
    or a
    sbc hl, de
    jp c, .ddb_bad
    jp z, .ddb_bad

    ; HL = tracks * sectors
    ex de, hl
    ld a, (dd_spec + 3)
    ld hl, 0
    ld b, 8
.ddb_mul:
    srl a
    jr nc, .ddb_mul_skip
    add hl, de
.ddb_mul_skip:
    sla e
    rl d
    djnz .ddb_mul

    ; blocks = (tracks * sectors) << PSH >> BSH
    ld a, (dd_bsh)
    ld b, a
    ld a, (dd_psh)
    sub b
    jr z, .ddb_blocks_ready
    jp m, .ddb_blocks_right
    ld b, a                       ; PSH > BSH: shift left
.ddb_blocks_left_loop:
    add hl, hl
    djnz .ddb_blocks_left_loop
    jr .ddb_blocks_ready
.ddb_blocks_right:
    neg                           ; BSH > PSH: shift right
    ld b, a
.ddb_blocks_right_loop:
    srl h
    rr l
    djnz .ddb_blocks_right_loop
.ddb_blocks_ready:
    ld a, h
    or l
    jp z, .ddb_bad
    dec hl
    ld a, l
    ld (dd_xdpb_buf + 5), a
    ld a, h
    ld (dd_xdpb_buf + 6), a

    ; EXM = (1 << (BSH - 3)) - 1, halved for 16-bit block numbers
    ld a, (dd_bsh)
    cp 4
    jr c, .ddb_exm_zero
    sub 3
    ld b, a
    ld a, 1
.ddb_exm_shift:
    add a, a
    dec b
    jr nz, .ddb_exm_shift
    dec a
    ld b, a
    ld a, (dd_xdpb_buf + 6)
    ld a, b
    jr z, .ddb_exm_store
    srl a
    jr .ddb_exm_store
.ddb_exm_zero:
    xor a
.ddb_exm_store:
    ld (dd_xdpb_buf + 4), a

    ; DRM + 1 = dir_blocks << (BSH + 2)
    ld a, (dd_spec + 7)
    ld l, a
    ld h, 0
    ld a, (dd_bsh)
    add a, 2
    ld b, a
.ddb_drm_shift:
    add hl, hl
    djnz .ddb_drm_shift
    ; CKS = (DRM + 1) / 4
    ld b, h
    ld c, l
    srl b
    rr c
    srl b
    rr c
    ld a, c
    ld (dd_xdpb_buf + 11), a
    ld a, b
    ld (dd_xdpb_buf + 12), a
    ; DRM = (DRM + 1) - 1
    dec hl
    ld a, l
    ld (dd_xdpb_buf + 7), a
    ld a, h
    ld (dd_xdpb_buf + 8), a

    ; AL0/AL1 = top dir_blocks bits
    ld a, (dd_spec + 7)
    ld b, a
    ld hl, 0
.ddb_alv:
    scf
    rr h
    rr l
    djnz .ddb_alv
    ld a, h
    ld (dd_xdpb_buf + 9), a
    ld a, l
    ld (dd_xdpb_buf + 10), a

    ; OFF
    ld a, (dd_spec + 5)
    ld (dd_xdpb_buf + 13), a
    xor a
    ld (dd_xdpb_buf + 14), a

    ; PSH / PHM
    ld a, (dd_psh)
    ld (dd_xdpb_buf + 15), a
    ld b, a
    ld a, 1
    inc b
.ddb_phm_loop:
    dec b
    jr z, .ddb_phm_done
    add a, a
    jr .ddb_phm_loop
.ddb_phm_done:
    dec a
    ld (dd_xdpb_buf + 16), a

    ; First sector ID from the disc type
    ld a, (dd_type)
    ld b, 1
    cp 1
    jr nz, .ddb_first2
    ld b, 0x41
    jr .ddb_first_store
.ddb_first2:
    cp 2
    jr nz, .ddb_first_store
    ld b, 0xC1
.ddb_first_store:
    ld a, b
    ld (dd_xdpb_buf + 20), a

    ; Physical sector size = 128 << PSH
    ld a, (dd_psh)
    ld hl, 128
    or a
    jr z, .ddb_ssize_store
    ld b, a
.ddb_ssize_loop:
    add hl, hl
    djnz .ddb_ssize_loop
.ddb_ssize_store:
    ld a, l
    ld (dd_xdpb_buf + 21), a
    ld a, h
    ld (dd_xdpb_buf + 22), a

    ld a, (dd_spec + 8)            ; gap 1
    ld (dd_xdpb_buf + 23), a
    ld a, (dd_spec + 9)            ; gap 2
    ld (dd_xdpb_buf + 24), a
    ld a, 0x40                     ; MFM
    ld (dd_xdpb_buf + 25), a
    ld a, 0xFF                     ; fixed/detected
    ld (dd_xdpb_buf + 26), a

    ld a, (dd_type)
    scf
    ret
.ddb_bad:
    ld a, 6
    or a
    ret

.dd_l_on_motor:
    ; DD_L_ON_MOTOR (0x00A4): motor on, wait for spin-up.
    ;   Out: all registers and flags preserved
    push bc
    call motor_on
    pop bc
    push bc
    ld bc, (xbios_arg_af)
    push bc
    pop af
    pop bc
    ret

.dd_l_t_off_motor:
    ; DD_L_T_OFF_MOTOR (0x00A7): arm the motor-off timeout.
    ;   Out: all registers and flags preserved
    ld a, (motor_off_ticks)
    ld (motor_countdown), a
    push bc
    ld bc, (xbios_arg_af)
    push bc
    pop af
    pop bc
    ret

.dd_off_motor:
    ; DD_OFF_MOTOR (0x00AA): stop the motor now.
    ;   Out: AF BC DE HL corrupt
    call motor_off
    ret

.dd_l_seek:
    ; DD_L_SEEK (0x00B3): seek to a physical track.
    ;   In:  C = unit (bits 0-1) + head (bit 2), D = physical track,
    ;        IX = XDPB (unused; geometry is already physical)
    ;   Out: carry set OK, or carry clear + A = 0 (not ready) / 2 (seek)
    ;        B corrupt; all other registers preserved
    ld a, c
    and 0x03
    jr nz, .dls_not_ready
    xor a
    ld (disk_drive), a
    ld a, c
    and 0x04
    jr z, .dls_head0
    ld a, 1
    jr .dls_set_head
.dls_head0:
    xor a
.dls_set_head:
    ld (disk_head), a
    push bc
    push de
    push hl
    ld a, d
    call fdc_seek
    pop hl
    pop de
    pop bc
    jr nz, .dls_seek_fail         ; lint: ignore - fdc_seek returns Z/NZ
    scf
    ret
.dls_seek_fail:
    ld a, 2
    or a
    ret
.dls_not_ready:
    xor a                         ; A = 0, carry clear
    ret

.dd_l_read:
    ; DD_L_READ (0x00AD): raw uPD765A read-type command driver.
    ;   In:  HL = parameter block in common memory:
    ;          +0 CP/M bank, +1 buffer, +3 byte count,
    ;          +5 command-byte count, +6 command bytes
    ;   Out: HL = dd_results (count + result bytes)
    ; Only CP/M bank 1 (TPA) is supported; other banks return no data.
    ld (dd_param_ptr), hl
    ld a, (hl)
    cp 1
    jp nz, .ddlr_no_xfer
    inc hl
    ld e, (hl)
    inc hl
    ld d, (hl)
    ld (dd_xfer_ptr), de
    inc hl
    ld e, (hl)
    inc hl
    ld d, (hl)
    ld (dd_xfer_left), de

    ld hl, (dd_param_ptr)
    call .dd_send_cmd

    ld hl, (dd_xfer_left)
    ld a, h
    or l
    jr z, .ddlr_results
.ddlr_loop:
    call fdc_read_byte
    ld de, (dd_xfer_ptr)
    call write_user_byte
    ld hl, (dd_xfer_ptr)
    inc hl
    ld (dd_xfer_ptr), hl
    ld hl, (dd_xfer_left)
    dec hl
    ld (dd_xfer_left), hl
    ld a, h
    or l
    jr nz, .ddlr_loop
.ddlr_results:
    call .dd_drain_results
    ld hl, dd_results
    ret
.ddlr_no_xfer:
    xor a
    ld (dd_results), a
    ld hl, dd_results
    ret

.dd_send_cmd:
    ; Send the command bytes from the parameter block at HL.
    ld de, 6
    add hl, de
    ld (dd_cmd_ptr), hl
    ld de, 5
    ld hl, (dd_param_ptr)
    add hl, de
    ld a, (hl)
    ld (dd_cmd_left), a
.dsc_loop:
    ld a, (dd_cmd_left)
    or a
    ret z
    ld hl, (dd_cmd_ptr)
    ld a, (hl)
    inc hl
    ld (dd_cmd_ptr), hl
    call fdc_send_byte
    ld a, (dd_cmd_left)
    dec a
    ld (dd_cmd_left), a
    jr .dsc_loop

.dd_drain_results:
    ; Drain up to 7 result bytes into dd_results.
    xor a
    ld (dd_results), a
    ld (dd_res_idx), a
    ld bc, PORT_FDC_ST
    ld de, 0xFFFF
.ddr_wait:
    in a, (c)
    and 0xC0
    cp 0xC0
    jr z, .ddr_drain
    dec de
    ld a, d
    or e
    jr nz, .ddr_wait
    ret
.ddr_drain:
    ld a, (dd_res_idx)
    cp 7
    jr nc, .ddr_done
    in a, (c)
    and 0xC0
    cp 0xC0
    jr nz, .ddr_done
    push bc
    call fdc_read_byte
    pop bc
    push af
    ld hl, dd_results + 1
    ld a, (dd_res_idx)
    ld e, a
    ld d, 0
    add hl, de
    pop af
    ld (hl), a
    ld a, (dd_res_idx)
    inc a
    ld (dd_res_idx), a
    jr .ddr_drain
.ddr_done:
    ld a, (dd_res_idx)
    ld (dd_results), a
    ret

; --- Phase-2 disc calls ---

.dd_login:
    ; DD_LOGIN (0x0092): detect the format and initialise the caller's XDPB.
    ;   In:  C = unit, IX = destination XDPB in common memory
    ;   Out: carry set + A = disc type, DE = ALV size, HL = hash size;
    ;        carry clear + A = error
    ld a, c
    and 0x03
    jp nz, .dd2_not_ready
    ld ix, (xbios_ret_ix)
    ld a, ixh
    cp 0xC0
    jp c, .dd2_bad_bank
    xor a
    ld (disk_drive), a
    ld a, 1
    ld (fdc_login_force), a
    call fdc_login

    ; Copy the detected XDPB to the caller's buffer.
    ld ix, (xbios_ret_ix)
    ld hl, xdpb_a
    push ix
    pop de
    ld bc, 27
    ldir

    ; DE = floor(DSM / 4) + 2, HL = 4 * (DRM + 1)
    ld ix, (xbios_ret_ix)
    ld l, (ix + 5)
    ld h, (ix + 6)                ; DSM
    srl h
    rr l
    srl h
    rr l
    ld de, 2
    add hl, de
    ex de, hl                    ; DE = ALV size
    ld l, (ix + 7)
    ld h, (ix + 8)                ; DRM
    inc hl
    add hl, hl
    add hl, hl                   ; HL = hash table size
    ld a, (fdc_login_type)
    scf
    ret

.dd_read_sector:
    ; DD_READ_SECTOR (0x0086)
    ;   In:  B = CP/M bank, C = unit, D = logical track,
    ;        E = logical sector, HL = destination, IX = XDPB
    ;   Out: carry set OK; carry clear + A = error
    call .dd_prepare
    ret nz
    ld a, (dd_phys_sec)
    call fdc_read_sector
    jp nz, .dd2_data_error
    ld hl, deblock_buf
    ld de, (dd_user_ptr)
    ld bc, 512
    call copy_to_user
    scf
    ret

.dd_write:
    ; DD_WRITE (0x0089)
    ;   In:  B = CP/M bank, C = unit, D = logical track,
    ;        E = logical sector, HL = source, IX = XDPB
    ;   Out: carry set OK; carry clear + A = error (1 = write protected)
    call .dd_prepare
    ret nz
    ld hl, (dd_user_ptr)
    ld de, deblock_buf
    ld bc, 512
    call copy_from_user
    ld a, (dd_phys_sec)
    call fdc_write_sector
    jp nz, .dd2_write_error     ; lint: ignore - write returns Z/NZ
    ld a, 0xFF
    ld (deblock_drv), a
    xor a
    ld (deblock_dirty), a
    scf
    ret

.dd_check:
    ; DD_CHECK_SECTOR (0x008C)
    ;   In:  B = CP/M bank, C = unit, D = logical track,
    ;        E = logical sector, HL = compare buffer, IX = XDPB
    ;   Out: carry set + Z set if equal, Z clear if different;
    ;        carry clear + A = error
    call .dd_prepare
    ret nz
    ld a, (dd_phys_sec)
    call fdc_read_sector
    jp nz, .dd2_data_error
    ld hl, (dd_user_ptr)
    ld de, dd_compare_buf
    ld bc, 512
    call copy_from_user
    ld hl, deblock_buf
    ld de, dd_compare_buf
    ld bc, 512
.ddc_loop:
    ld a, (de)
    cp (hl)
    jr nz, .ddc_diff
    inc hl
    inc de
    dec bc
    ld a, b
    or c
    jr nz, .ddc_loop
    scf
    ret
.ddc_diff:
    scf
    ret

.dd_format:
    ; DD_FORMAT (0x008F): format a logical track.
    ;   In:  B = CP/M bank, C = unit, D = logical track, E = filler,
    ;        HL = header table (track, head, sector, size per sector),
    ;        IX = XDPB
    ;   Out: carry set OK; carry clear + A = error
    ld a, b
    cp 1
    jp nz, .dd2_bad_bank
    ld a, c
    and 0x03
    jp nz, .dd2_not_ready
    ld ix, (xbios_ret_ix)
    ld a, ixh
    cp 0xC0
    jp c, .dd2_bad_bank
    ld a, (ix + XDPB_SECTS)
    or a
    jp z, .dd2_bad_bank
    cp 10
    jr c, .ddf_sc_ok
    ld a, 9
.ddf_sc_ok:
    ld (dd_format_sc), a
    ld a, d
    ld (dd_track), a
    ld a, e
    ld (dd_filler), a
    ld (dd_user_ptr), hl

    ; Copy 4 * SC header bytes to the common buffer.
    ld a, (dd_format_sc)
    add a, a
    add a, a
    ld c, a
    ld b, 0
    ld hl, (dd_user_ptr)
    ld de, dd_format_hdr
    call copy_from_user

    call flush_deblock_body
    jp nz, .dd2_write_error        ; lint: ignore - flush returns Z/NZ
    ld a, 0xFF
    ld (deblock_drv), a
    xor a
    ld (deblock_dirty), a

    ld ix, (xbios_ret_ix)
    ld a, (dd_track)
    ld d, a
    call .dd_map_track
    ld (dd_cylinder), a
    xor a
    ld (disk_drive), a
    call motor_on
    ld a, (dd_cylinder)
    call fdc_seek
    jp nz, .dd2_seek_error      ; lint: ignore - fdc_seek returns Z/NZ

    ld ix, (xbios_ret_ix)
    ld a, (dd_format_sc)
    ld b, a                       ; SC
    ld c, (ix + XDPB_GAP2)        ; GPL
    ld a, (dd_filler)
    ld d, a
    ld a, (ix + XDPB_PSH)         ; N
    ld hl, dd_format_hdr
    call fdc_format_track
    jp nz, .ddf_fail
    scf
    ret
.ddf_fail:
    or a
    ret

; Shared READ/WRITE/CHECK setup.  On success: dd_phys_sec and dd_user_ptr
; set, disk_drive=0, motor on and the head on the right cylinder.
;   Out: Z success, NZ + A = error
.dd_prepare:
    ld a, b
    cp 1
    jr nz, .ddp_bad_bank
    ld a, c
    and 0x03
    jr nz, .ddp_not_ready
    ld a, d
    ld (dd_track), a
    ld a, e
    ld (dd_sector), a
    ld (dd_user_ptr), hl

    call flush_deblock_body
    jr nz, .ddp_write_error     ; lint: ignore - flush returns Z/NZ
    ld a, 0xFF
    ld (deblock_drv), a
    xor a
    ld (deblock_dirty), a

    ld ix, (xbios_ret_ix)
    ld a, ixh
    cp 0xC0
    jr c, .ddp_bad_bank
    ld a, (dd_sector)
    ld e, a
    call .dd_map_sector
    ld (dd_phys_sec), a
    ld a, (dd_track)
    ld d, a
    call .dd_map_track
    ld (dd_cylinder), a

    xor a
    ld (disk_drive), a
    call motor_on
    ld a, (dd_cylinder)
    call fdc_seek
    jr nz, .ddp_seek_error      ; lint: ignore - fdc_seek returns Z/NZ
    xor a
    ret
.ddp_bad_bank:
    ld a, 9                       ; unsuitable: only CP/M bank 1 supported
    or a
    ret
.ddp_not_ready:
    xor a
    ret
.ddp_seek_error:
    ld a, 2
    or a
    ret
.ddp_write_error:
    ld a, 1
    or a
    ret

; D = logical track, IX = XDPB; returns A = physical cylinder and sets
; disk_head from the XDPB sidedness.
.dd_map_track:
    ld a, (ix + XDPB_SIDES)
    cp 1
    jr z, .dmt_alt
    xor a
    ld (disk_head), a
    ld a, d
    ret
.dmt_alt:
    ld a, d
    and 1
    ld (disk_head), a
    ld a, d
    srl a
    ret

; E = logical sector, IX = XDPB; returns A = physical sector ID.
.dd_map_sector:
    ld a, e
    ld b, (ix + XDPB_PSH)
.dms_shift:
    dec b
    jp m, .dms_done
    srl a
    jr .dms_shift
.dms_done:
    add a, (ix + XDPB_FIRST)
    ret

.dd2_bad_bank:
    ld a, 9
    or a
    ret
.dd2_not_ready:
    xor a
    ret
.dd2_seek_error:
    ld a, 2
    or a
    ret
.dd2_data_error:
    ld a, 3
    or a
    ret
.dd2_write_error:
    ld a, 1
    or a
    ret

.dd_drive_status:
    ; DD_DRIVE_STATUS (0x0098): SENSE DRIVE STATUS, return ST3 in A.
    ;   In:  C = bits 1-0 unit, bit 2 head
    ;   Out: A = µPD765A ST3 byte
    ;          bit 7 Fault, bit 6 WP, bit 5 Ready, bit 4 T0
    ;          bit 3 Two-Sided, bit 2 Head, bits 1-0 Unit
    ; Drive A (unit 0): report Ready + T0 + single-sided + drive A.
    ; Drive B (unit 1): not fitted — Ready and WP both clear (per spec).
    ld a, c
    and 0x03                       ; isolate unit number
    or a
    jr nz, .drive_absent
    ; Unit 0 (drive A): Ready | Track0 | unit-0
    ld a, 0x30                     ; bit 5 = Ready, bit 4 = Track 0
    ret
.drive_absent:
    ; Unit 1 (or higher): drive not fitted.
    ld a, 0x01                     ; unit bit set, Ready=0, WP=0
    ret

.buftab:
    db 0xFF                        ; empty buffer-table terminator


; ==========================================================================
; Utility
; ==========================================================================

; @proc print_str
; @param %str:u16  hl              ; pointer to null-terminated string
; @clobbers af,bc,de,hl,ix
; @end
print_str:
    ld a, (%str)
    or a
    ret z
    ld c, a
    push %str
    call con_out
    pop %str
    inc %str
    jr print_str

    IFNDEF BUILD_NUM
BUILD_NUM equ 0
    ENDIF

TPA_KB equ (TPA_TOP - 0x0100) / 1024

signon_msg:
    db 0x0D, 0x0A
    db "Open CP/M +3 (Build "
    LUA ALLPASS
    local bn = _c("BUILD_NUM")
    local hx = "0123456789ABCDEF"
    local h = function(n) return hx:sub(n+1,n+1) end
    _pc("db '" .. h(bn >> 8) .. h((bn >> 4) & 0xF) .. h(bn & 0xF) .. "'")
    ENDLUA
    db "), "
    db '0' + (TPA_KB / 10) % 10
    db '0' + TPA_KB % 10
    db "K TPA", 0x0D, 0x0A
    db 0x0D, 0x0A
    db 0

MSG_NO_CCP:
    db "CCP.COM missing on drive A:", 0x0D, 0x0A, 0

; ==========================================================================
; Screen driver (includes font data)
; ==========================================================================

    include "screen.asm"

; ==========================================================================
; Keyboard driver
; ==========================================================================

    include "keyboard.asm"

; ==========================================================================
; FDC disk driver
; ==========================================================================

    include "fdc765.asm"


; ==========================================================================
; load_fonts — Directory scan for FONT51/FONT32/FONT64/CCP/RAMDISK
;   Scans the CP/M directory (track 1, physical sectors 1-4) once, records
;   the blocks of the files we need, then loads the three fonts into bank 6
;   (always visible in system mode):
;     FONT51.BIN → 0x8000 (5px-wide, used for 51-col mode)
;     FONT32.BIN → 0x8800 (8px-wide, used for 32-col mode)
;     FONT64.BIN → 0x9400 (4px-wide, used for 64-col mode)
;   CCP.COM is only *recorded* here (see load_ccp); load_fonts leaves the
;   motor on and drive A: selected for it and for load_fid.
;   Called from cold_boot after fdc_init.  fdc_init leaves the motor off,
;   so spin it up here and leave it on for the other loaders (cold_boot
;   spins it down after them).
;   In:  nothing
;   Out: nothing
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc load_fonts
; @clobbers af,bc,de,hl,ix
; @end
load_fonts:
    xor a
    ld (disk_drive), a              ; drive A:
    ld (_lf_found), a
    ld (_font51_blk0), a
    ld (_font51_blk1), a
    ld (_font32_blk0), a
    ld (_font32_blk1), a
    ld (_font64_blk0), a
    ld (_font64_blk1), a
    ld (_ccp_al), a                 ; CCP not found yet
    ld (_fid_block), a              ; FID not yet found; load_fid will check this

    call motor_on                   ; fdc_init left the motor off

    ; Seek to track 1 (first data track: OFF=1)
    ld a, 1
    call fdc_seek

    ; Scan 4 physical sectors (sectors 1-4) = 64 directory entries
    ld bc, 1                        ; B=0 (only C used; B initialized so push bc below is defined)
.lf_dsec:
    ld a, c
    cp 5
    jr nc, .lf_dsec_done
    push bc
    call fdc_read_sector            ; → deblock_buf
    pop bc
    jr nz, .lf_dsec_done            ; I/O error — abort

    push bc
    ld hl, deblock_buf
    ld b, 16                        ; 16 entries per sector
.lf_dent:
    push bc
    push hl
    call _lf_check_entry
    pop hl
    pop bc
    ld de, 32
    add hl, de
    djnz .lf_dent
    pop bc

    ld a, (_lf_found)
    cp 31
    jr z, .lf_dsec_done             ; found all five files — done early
    inc c
    jr .lf_dsec

.lf_dsec_done:
    ld hl, _font51_blk0
    ld de, 0x8000
    ld b, 2
    call _lf_load_n                 ; load font51 → bank 6 at 0x8000

    ld hl, _font32_blk0
    ld de, 0x8800
    ld b, 2
    call _lf_load_n                 ; load font32 → bank 6 at 0x8800

    ld hl, _font64_blk0
    ld de, 0x9400
    ld b, 2
    call _lf_load_n                 ; load font64 → bank 6 at 0x9400
    ret


; _lf_check_entry — Record blocks for FONT51/FONT32/CCP/RAMDISK dir entries
;   In:  HL = 32-byte directory entry
;   Out:  _lf_found bit set for a recognised file
;   Clobbers: AF, BC, DE, HL
; @proc _lf_check_entry
; @clobbers af,bc,de,hl
; @end
_lf_check_entry:
    ld a, (hl)
    or a
    ret nz                          ; user != 0 — skip

    push hl
    inc hl                          ; HL = entry[1..11] (name+ext)
    ld de, _lf_name51
    ld b, 11
    call _lf_cmp11                  ; Z if match
    pop hl
    jr nz, .lf_try32

    ld bc, 16
    add hl, bc                      ; HL = &entry[16] = AL[0]
    ld a, (hl)
    ld (_font51_blk0), a
    inc hl
    ld a, (hl)
    ld (_font51_blk1), a
    ld a, (_lf_found)
    or 0x01
    ld (_lf_found), a
    ret

.lf_try32:
    push hl
    inc hl
    ld de, _lf_name32
    ld b, 11
    call _lf_cmp11
    pop hl
    jr nz, .lf_try64

    ld bc, 16
    add hl, bc
    ld a, (hl)
    ld (_font32_blk0), a
    inc hl
    ld a, (hl)
    ld (_font32_blk1), a
    ld a, (_lf_found)
    or 0x02
    ld (_lf_found), a
    ret

.lf_try64:
    push hl
    inc hl
    ld de, _lf_name64
    ld b, 11
    call _lf_cmp11
    pop hl
    jr nz, .lf_try_ccp

    ld bc, 16
    add hl, bc
    ld a, (hl)
    ld (_font64_blk0), a
    inc hl
    ld a, (hl)
    ld (_font64_blk1), a
    ld a, (_lf_found)
    or 0x10
    ld (_lf_found), a
    ret

.lf_try_ccp:
    ; The CCP is loaded later (load_ccp) so keep the whole allocation map:
    ; a future CCP may use every block of its extent.
    push hl
    inc hl
    ld de, _lf_name_ccp
    ld b, 11
    call _lf_cmp11
    pop hl
    jr nz, .lf_try_fid

    ld bc, 16
    add hl, bc                      ; HL = &entry[16] = AL[0]
    ld de, _ccp_al
    ld bc, 16
    ldir
    ld a, (_lf_found)
    or 0x08
    ld (_lf_found), a
    ret

.lf_try_fid:
    push hl
    inc hl
    ld de, _lf_name_fid
    ld b, 11
    call _lf_cmp11
    pop hl
    ret nz
    ld bc, 16
    add hl, bc
    ld a, (hl)
    ld (_fid_block), a              ; AL[0] = first 1K block of RAMDISK.FID
    ld a, (_lf_found)
    or 0x04
    ld (_lf_found), a
    ret


; _lf_cmp11 — Compare 11 bytes (HL) vs (DE), masking attribute bits
;   In:  HL = source, DE = reference, B = 11
;   Out: Z if all 11 bytes match, NZ on first mismatch
;   Clobbers: AF, BC, DE, HL
; @proc _lf_cmp11
; @out   zero
; @clobbers af,bc,de,hl
; @end
_lf_cmp11:
    ld a, (hl)
    and 0x7F                        ; strip attribute bit
    ld c, a
    ld a, (de)
    cp c
    ret nz
    inc hl
    inc de
    djnz _lf_cmp11
    ret                             ; Z set from last cp (all matched)


; _lf_load_n — Load up to B × 1K blocks from disk to destination DE
;   In:  HL = pointer to a 16-byte allocation map (0 = not allocated / end)
;        DE = destination address (system memory)
;        B  = maximum blocks to load
;   Out: DE = first byte after the loaded image
;   Clobbers: AF, BC, DE, HL
; @proc _lf_load_n
; @out   de
; @clobbers af,bc,hl,ix
; @end
_lf_load_n:
.lf_blk:
    push bc
    push hl
    ld a, (hl)
    or a
    jr z, .lf_blk_skip              ; block 0 = not allocated (file not found)
    call _lf_load_block             ; reads 1K to DE, advances DE by 1024
.lf_blk_skip:
    pop hl
    inc hl
    pop bc
    djnz .lf_blk
    ret


; ==========================================================================
; load_ccp — Stage CCP.COM from the boot disk into bank 6
;   load_fonts has already scanned the directory and copied the file's
;   allocation map into _ccp_al, so no second directory pass is needed.
;   Keeping the CCP out of CPM3.SYS makes the system image ~3K smaller;
;   the staging window is otherwise unused RAM, so it costs no file bytes.
;   In:  _ccp_al populated by load_fonts; motor on, drive A: selected
;   Out: _ccp_len = bytes staged (0 = CCP.COM is not on the disk)
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc load_ccp
; @clobbers af,bc,de,hl,ix
; @end
load_ccp:
    ld hl, 0
    ld (_ccp_len), hl
    ld a, (_ccp_al)
    or a
    ret z                           ; not on the disk — cold_boot reports it
    ld hl, _ccp_al
    ld de, CCP_STAGE
    ld b, CCP_MAX_BLK
    call _lf_load_n                 ; DE = first byte past the staged image
    ex de, hl                       ; HL = end of image
    ld bc, 0 - CCP_STAGE
    add hl, bc                      ; HL = bytes staged
    ld (_ccp_len), hl
    ret


; _lf_load_block — Read one 1K block (2 physical sectors) to DE
;   In:  A = CP/M block number (2..174), DE = destination
;   Out: DE advanced by 1024
;   Clobbers: AF, BC, HL
; @proc _lf_load_block
; @clobbers af,bc,de,hl,ix
; @end
_lf_load_block:
    ld l, a
    ld h, 0
    add hl, hl                      ; HL = block * 2 = first abs physical sector
    ld (_lf_abs_phys), hl

    ld b, 2                         ; 2 physical sectors per 1K block
.lf_phys:
    push bc
    push de
    ld hl, (_lf_abs_phys)
    call _lf_div9                   ; B = HL/9 (quotient), A = HL%9 (remainder)
    inc a                           ; sector ID = remainder + 1
    ld (_lf_sec_id), a              ; save across fdc_seek (avoids push/pop)
    ld a, b
    inc a                           ; track = quotient + OFF (OFF=1)
    call fdc_seek                   ; clobbers AF, BC, DE, HL
    ld a, (_lf_sec_id)
    call fdc_read_sector            ; → deblock_buf; clobbers AF, BC, DE, HL
    pop de                          ; DE = destination
    ld hl, deblock_buf
    ld bc, 512
    ldir                            ; copy 512B; DE += 512 automatically
    ld hl, (_lf_abs_phys)
    inc hl
    ld (_lf_abs_phys), hl
    pop bc
    djnz .lf_phys
    ret


; _lf_div9 — Divide HL by 9 via repeated subtraction
;   In:  HL = dividend (0..349 for our block range)
;   Out: B = quotient, A = remainder
;   Clobbers: AF, BC, HL
; @proc _lf_div9
; @out   b,a
; @clobbers af,bc,hl
; @end
_lf_div9:
    ld b, 0
.lf_d9:
    ld a, h
    or a
    jr nz, .lf_d9_sub               ; HL >= 256 → definitely >= 9
    ld a, l
    cp 9
    jr c, .lf_d9_done               ; HL < 9 → done
.lf_d9_sub:
    ld a, l
    sub 9
    ld l, a
    jr nc, .lf_d9_nb
    dec h
.lf_d9_nb:
    inc b
    jr .lf_d9
.lf_d9_done:
    ld a, l                         ; A = remainder
    ret


; --- Font/FID/CCP loader data ---
_lf_found:    db 0                  ; bit 0=font51, 1=font32, 2=fid, 3=ccp, 4=font64
_font51_blk0: db 0                  ; first block number of FONT51.BIN
_font51_blk1: db 0                  ; second block number
_font32_blk0: db 0                  ; first block number of FONT32.BIN
_font32_blk1: db 0
_font64_blk0: db 0                  ; first block number of FONT64.BIN
_font64_blk1: db 0
_fid_block:   db 0                  ; first block number of RAMDISK.FID (0 = absent)
_ccp_al:      ds 16                 ; CCP.COM allocation map (0 = end of file)
_ccp_len:     dw 0                  ; bytes staged at CCP_STAGE (0 = missing)
_lf_abs_phys: dw 0                  ; scratch: current absolute physical sector
_lf_sec_id:   db 0                  ; scratch: sector ID saved across fdc_seek
_lf_name51:   db "FONT51  BIN"      ; 11-char CP/M name (6+2spaces+3ext)
_lf_name32:   db "FONT32  BIN"
_lf_name64:   db "FONT64  BIN"
_lf_name_ccp: db "CCP     COM"
_lf_name_fid: db "RAMDISK FID"
_fid_magic:   db "OCFID", 0         ; 6-byte signature inside RAMDISK.FID


; ==========================================================================
; load_fid — Register C: if the RAMDISK.FID dir scan during load_fonts
; found one.  Loads its first 1K block to 0x9000 in bank 6, verifies the
; OCFID magic, copies the XDPB template into xdpb_c, fills xdph_c's
; prefix slots from the header's entry-point fields, points drive_table[2]
; at xdph_c, and tail-calls the FID's init routine.
;
; Helper stub addresses are NOT patched — RAMDISK.FID hardcodes
; copy_record_to_tpa / copy_record_from_tpa addresses (asserts in
; common.zpa pin them).
;
;   In:  _fid_block populated by load_fonts (0 = no FID found),
;        motor on, drive 0 selected
;   Out: nothing
;   Clobbers: AF, BC, DE, HL, IY
; ==========================================================================
; @proc load_fid
; @clobbers af,bc,de,hl,ix,iy
; @end
load_fid:
    ld a, (_fid_block)
    or a
    ret z                           ; no FID found in dir scan

    ; Load the FID's first 1K block to 0x9000 in bank 6
    ld de, 0x9000
    call _lf_load_block             ; A = block #, DE = dest

    ; Validate "OCFID\0" magic at 0x9000
    ld hl, 0x9000
    ld de, _fid_magic
    ld b, 6
.vm:
    ld a, (de)
    cp (hl)
    ret nz                          ; bad magic — abort registration
    inc de
    inc hl
    djnz .vm

    ; Copy entry addresses (8 bytes: write, read, login, init) into the
    ; xdph_c prefix slots — header layout matches slot order so a single
    ; LDIR does it.
    ld hl, 0x9000 + 12
    ld de, xdph_c_write_slot
    ld c, 8
    ldir

    ; Copy 27-byte XDPB template (header[+24..+50]) into xdpb_c
    ld hl, 0x9000 + 24
    ld de, xdpb_c
    ld c, 27
    ldir

    ; Run init before making C: visible.  A non-zero return leaves
    ; drive_table[2] at zero, so the FID remains unmounted.
    ld iy, (xdph_c_init_slot)
    call _call_iy
    or a
    ret nz

    ; Wire drive_table[2] = xdph_c only after init succeeds.
    ld hl, xdph_c
    ld (drive_table_c_slot), hl
    ret

; ALV vector for C: — read/written by BDOS while bank 4 is mapped.
; 16 blocks → ceil(16/8) = 2 bytes; add slack for safety.
alv_c:          equ 0xA840


; ==========================================================================
; CCP
; ==========================================================================
; The CCP is not part of CPM3.SYS.  It is CCP.COM on the boot disk, staged
; into the top of bank 6 by load_ccp and copied to 0100h on every boot.
; CCP_STAGE must hold one full 4K window inside bank 6.
    assert CCP_STAGE + CCP_MAX_BLK * 1024 <= 0xC000, "CCP staging area exceeds bank 6!"
    assert CCP_STAGE >= 0xB000, "CCP staging area collides with the RAMDISK.FID / screen buffers"


; ==========================================================================
; BDOS
; ==========================================================================

    include "bdos.asm"


; ==========================================================================
system_end:
    assert system_end <= 0x4000, "System code exceeds bank 4 (16K)!"

    DEPHASE
system_image_end:

; ######################################################################
; COMMON MEMORY STUB — Lives at F600-FFFF (bank 3, always visible)
; ######################################################################
;
; Assembled with PHASE COMMON_BASE so labels resolve to common memory addresses.
; The init code copies these bytes from the binary to COMMON_BASE.

common_image:
    PHASE COMMON_BASE

    include "common.asm"

    DEPHASE
common_image_end:


; ######################################################################
; End of CPM3.SYS image
; ######################################################################

    assert $ <= 0x10000, "CPM3.SYS image overflows bank 3!"
