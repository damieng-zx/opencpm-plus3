; ==========================================================================
; CP/M 3.1 Common Memory Stub (F600-FFFF)
; ==========================================================================
;
; Resident in bank 3, visible in both TPA (mode 0) and system (mode 2).
; Contains the thin dispatcher that bridges user programs to the banked
; BDOS/BIOS, plus inter-bank copy routines for DMA transfers.
;
; Included from bios.asm inside a PHASE COMMON_BASE block.
;
; ==========================================================================

; ==========================================================================
; External proc declarations — bodies live in other files
; ==========================================================================

; @extern bdos_entry
; @clobbers af,bc,de,hl
; @end

; @extern warm_boot
; @clobbers af,bc,de,hl
; @end

; FCB shadow buffer — file functions copy the user's FCB here before
; processing and copy it back on return.  It lives in bank 6 (AD80h),
; outside the image: the BDOS only touches it in system mode, where bank 6
; is mapped at 8000h-BFFFh.  See the buffer map at the end of this file.
fcb_buf:        equ 0xAD80

; ==========================================================================
; System Control Block (100 bytes at common_base + 0x00)
; ==========================================================================
;
; Programs access SCB fields directly via common_base + offset (from F49).
; This MUST be at offset 0 from the PHASE base.
;
; The first five SCB bytes are reserved, and CP/M 3 defines them as the
; area holding the page-zero BDOS vector target.  Page zero 0005h is
; `jp bdos_vector`, and 0006h is the address of bdos_vector, which lives
; at the common base = TPA_TOP.  Programs (WordStar, MBASIC, Turbo
; Pascal, ...) read (0006h) as the memory ceiling, so it *must* equal the
; top of the TPA rather than point into the system stub above it.
;
scb_base:
bdos_vector:
    jp bdos_stub                   ; 0x00-0x02: BDOS entry / memory ceiling
    ds 2                           ; 0x03-0x04: reserved
scb_version:
    db 0x31                        ; 0x05: CP/M version (3.1)
    db 0x01                        ; 0x06: system type (1=CP/M Plus)
scb_chain:
    db 0                           ; 0x07: F47 chain pending (read by the CCP)
scb_rc:
    dw 0                           ; 0x08-0x09: F108 program return code
scb_coldboot:
    db 1                           ; 0x0A: 1 = cold start (CCP runs PROFILE.SUB)
    ds 15                          ; 0x0B-0x19: reserved
scb_conwidth:
    db 50                          ; 0x1A: console width - 1
    db 0                           ; 0x1B: reserved
scb_conpage:
    db 23                          ; 0x1C: console page height - 1
    ds 5                           ; 0x1D-0x21: reserved
; I/O redirection bit vectors (CP/M 3 System Guide, Table 3-11 and the
; SCB.ASM listing).  One bit per physical device in the character device
; table: bit 15 = device 0, bit 14 = device 1, ... bits 0-3 reserved.
; A logical device with no bit set goes nowhere.
;
; We only have four devices and no second peripheral, so every logical
; device points at a single physical entry:
;   CONIN/CONOUT -> CON  (table entry 0, mask 0x8000)
;   AUXIN/AUXOUT -> AUX  (table entry 3, mask 0x1000)
;   LIST         -> LST  (table entry 2, mask 0x2000)
scb_civec:
    dw 0x8000                      ; 0x22: console input  -> CON
scb_covec:
    dw 0x8000                      ; 0x24: console output -> CON
scb_aivec:
    dw 0x1000                      ; 0x26: aux input      -> AUX
scb_aovec:
    dw 0x1000                      ; 0x28: aux output     -> AUX
scb_lovec:
    dw 0x2000                      ; 0x2A: list output    -> LST
    ds 8                           ; 0x2C-0x33: reserved
scb_tempdrv:
    db 0                           ; 0x34: SETDEF TEMPORARY drive (0=current, 1..16=A..P)
    ds 5                           ; 0x35-0x39: reserved
scb_common:
    dw 0                           ; 0x3A-0x3B: common memory base (patched at init)
scb_dma:
    dw 0x0080                      ; 0x3C-0x3D: current DMA address
scb_curdsk:
    db 0                           ; 0x3E: current disk
    ds 5                           ; 0x3F-0x43: reserved
scb_user:
    db 0                           ; 0x44: current user number
    ds 5                           ; 0x45-0x49: reserved
scb_multi:
    db 1                           ; 0x4A: multi-sector count
scb_errmode:
    db 0                           ; 0x4B: BDOS error mode
    ds 12                          ; 0x4C-0x57: reserved
scb_date:
    dw 0                           ; 0x58-0x59: date (days since 1978-01-01, LE)
scb_minute:
    dw 0                           ; 0x5A-0x5B: minutes since midnight (binary, 0-1439, LE)
scb_sec:
    db 0                           ; 0x5C: second (binary, 0-59)
    ds 5                           ; 0x5D-0x61: reserved
scb_tpa:
    dw 0                           ; 0x62-0x63: top of TPA (patched at init)

    assert $ - scb_base == 100, "SCB must be exactly 100 bytes!"
    assert scb_chain == 0xF607, "miniccp.zpa CCP_CHAIN_ADDR must match scb_chain"
    assert scb_rc == 0xF608, "miniccp.zpa CCP_RC_ADDR must match scb_rc"
    assert scb_coldboot == 0xF60A, "miniccp.zpa CCP_COLD_ADDR must match scb_coldboot"


; ==========================================================================
; BIOS Visible Jump Table (33 entries × 3 bytes = 99 bytes)
; ==========================================================================
;
; Programs compute BIOS base from the warm boot vector at 0001-0002.
; Page zero 0001 = &bios_visible[1] (WBOOT entry). So BIOS base =
; that address - 3. Each entry here dispatches to the real BIOS in
; bank 4 via bios_call_bank4.
;
; The dispatched entries (fn 2..32) share a trampoline block: each slot is a
; single `call bv_shim` (3 bytes). bv_shim recovers the bank-4 target address
; from the call-site return address, with no per-entry `ld hl,nn` needed.
; Fn 27 (BNKSEL) lives in common already and fn 30 (USERF) is handled inline,
; so their slots are dead entries — cheaper than splitting the block.
bios_visible:
    jp warm_boot_stub              ;  0: BOOT (cold → warm from TPA)
    jp warm_boot_stub              ;  1: WBOOT
    jp bv_tramp + 3*(2 - 2)        ;  2: CONST
    jp bv_tramp + 3*(3 - 2)        ;  3: CONIN
    jp bv_tramp + 3*(4 - 2)        ;  4: CONOUT
    jp bv_tramp + 3*(5 - 2)        ;  5: LIST
    jp bv_tramp + 3*(6 - 2)        ;  6: AUXOUT
    jp bv_tramp + 3*(7 - 2)        ;  7: AUXIN
    jp bv_tramp + 3*(8 - 2)        ;  8: HOME
    jp bv_tramp + 3*(9 - 2)        ;  9: SELDSK
    jp bv_tramp + 3*(10 - 2)       ; 10: SETTRK
    jp bv_tramp + 3*(11 - 2)       ; 11: SETSEC
    jp bv_tramp + 3*(12 - 2)       ; 12: SETDMA
    jp bv_tramp + 3*(13 - 2)       ; 13: READ
    jp bv_tramp + 3*(14 - 2)       ; 14: WRITE
    jp bv_tramp + 3*(15 - 2)       ; 15: LISTST
    jp bv_tramp + 3*(16 - 2)       ; 16: SECTRN
    jp bv_tramp + 3*(17 - 2)       ; 17: CONOST
    jp bv_tramp + 3*(18 - 2)       ; 18: AUXIST
    jp bv_tramp + 3*(19 - 2)       ; 19: AUXOST
    jp bv_tramp + 3*(20 - 2)       ; 20: DEVTBL
    jp bv_tramp + 3*(21 - 2)       ; 21: DEVINIT
    jp bv_tramp + 3*(22 - 2)       ; 22: DRVTBL
    jp bv_tramp + 3*(23 - 2)       ; 23: MULTIO
    jp bv_tramp + 3*(24 - 2)       ; 24: FLUSH
    jp bv_tramp + 3*(25 - 2)       ; 25: MOVE
    jp bv_tramp + 3*(26 - 2)       ; 26: TIME
    jp bank_sel                    ; 27: BNKSEL (already in common — direct)
    jp bv_tramp + 3*(28 - 2)       ; 28: SETBNK
    jp bv_tramp + 3*(29 - 2)       ; 29: XMOVE
    jp userf_stub                  ; 30: USERF (XBIOS dispatch)
    jp 0                           ; 31: reserved
    jp bv_tramp + 3*(32 - 2)       ; 32: SCRMODE

; Trampoline block: one `call bv_shim` per BIOS fn 2..32, so the call-site
; address maps linearly to the bank-4 target.  The fn 27 and fn 30/31 slots
; are unused (fn 27 and fn 30 jump direct, fn 31 is reserved), but keeping
; them makes the arithmetic a simple 3*fn.
;
; When bv_shim is entered, the return address on the stack is the address
; of the instruction *after* the CALL, i.e. bv_tramp + 3*(fn-2) + 3. The
; shim converts that back into the bank-4 target (BIOS4_BASE + 3*fn).
bv_tramp:
    dup 31
        call bv_shim               ; 31 × 3 bytes = 93 bytes total
    edup
    assert $ - bv_tramp == 31 * 3, "bv_tramp must be exactly 93 bytes"

bv_shim:
    ; lint-exempt: stack  ; pops the trampoline return; caller return stays
    ; Incoming: HL = caller HL, stack = [trampoline return][caller return].
    ; Recover the bank-4 target from the trampoline return address while
    ; preserving HL (BIOS MOVE needs HL=dst) and DE (MOVE needs DE=src).
    ld (_bc4_callhl), hl           ; save caller HL
    pop hl                         ; HL = trampoline return address
    push de                        ; save caller DE
    ld de, BIOS4_BASE + 3 - bv_tramp   ; assembler wraps mod 65536
    add hl, de                     ; HL = BIOS4_BASE + 3*fn — bank-4 target
    ld (_bc4_target), hl
    pop de                         ; restore caller DE
    ld hl, (_bc4_callhl)           ; restore caller HL
    jp bios_call_bank4


; ==========================================================================
; bdos_stub — BDOS entry dispatcher (reached via `jp bdos_vector` from 0005h)
;
; This MUST be the first executable code after the bios_visible wrappers.
; bdos_vector (the common base = TPA_TOP) is what page zero 0005h jumps to
; and what (0006h) points at, so the memory ceiling programs compute from
; (0006h) is the true top of the TPA.
;
; @proc bdos_stub
; @param %func:u8   c          ; CP/M function number
; @param %param:u16 de         ; CP/M parameter
; @out   a                     ; result low byte
; @out   hl                    ; result word
; @clobbers
; @end
bdos_stub:
    ; Guard: writable variables must be AFTER bdos_stub, never before.
    assert saved_sp > bdos_stub, "saved_sp must be after bdos_stub"
    ; lint-exempt: stack  ; SP hops between stacks: user stack -> bdos_stack
    ; -> user saved block.  The four user-register pushes pair with the
    ; four pops after ld sp, (saved_sp); bdos_ret rebases SP in between.

    di
    ; Save the caller's registers on the user stack.  CP/M 3 returns
    ; BDOS results only in A, HL and the flags; BC, DE, IX and IY must
    ; reach the caller unchanged.  The handlers pop BC/DE off the BDOS
    ; stack as parameters, and the screen and RAM-disk paths use IX/IY
    ; internally.  saved_sp points at the saved block; the four pops on
    ; the way out leave SP at the caller's return address.
    push bc
    push de
    push ix
    push iy
    ld (saved_sp), sp
    ld sp, bdos_stack

    ; Save BDOS parameters (C=function, DE=param) before bank switch clobbers BC
    push bc
    push de

    ; Switch to system banks (mode 3: 4,7,6,3). BDOS runs with
    ; interrupts enabled once the stack and bank are stable.
    ld a, (motor_flag)
    or BANK1_1FFD
    call write_1ffd
    ei

    ; Restore BDOS parameters
    pop de
    pop bc

    ; Call real BDOS (in bank 4) — interrupts enabled
    call bdos_entry

    ; Carry the results (A, HL) across the bank switch
    di
    push hl
    push af

    ; Switch back to TPA (mode 0: 0,1,2,3)
    ld a, (motor_flag)
    or BANK0_1FFD
    call write_1ffd

    ; Restore return values and user registers; SP ends on the
    ; caller's return address
    pop af
    pop hl
    ld sp, (saved_sp)
    pop iy
    pop ix
    pop de
    pop bc
    ei
    ret


; ==========================================================================
; Variables (common memory — accessible from all bank modes)
; Placed AFTER bdos_stub so the TPA stack (which grows down from
; bdos_stub address) doesn't overwrite them.
; ==========================================================================

saved_sp:       dw 0               ; User stack pointer during BDOS call
motor_flag:     db 0               ; 0x00 or MOTOR_BIT (0x08) — OR'd into every
                                   ; 1FFD write.
motor_countdown: db 0              ; Frames remaining until ISR drops the motor
                                   ; (motor_on arms it to MOTOR_OFF_DELAY; ISR
                                   ; ticks it down; on expiry the ISR clears
                                   ; motor_flag and writes last_1ffd with the
                                   ; motor bit cleared to physically stop it).
fdc_busy:       db 0               ; Non-zero while FDC code owns the motor/FDC.
                                   ; The ISR never drops the motor while busy.
last_1ffd:      db BANK1_1FFD      ; Shadow of 1FFD — maintained by write_1ffd
                                   ; so the ISR can physically drop the motor
                                   ; without having to know the current bank.
                                   ; Initial value matches cold_boot: system
                                   ; mode, motor off.
isr_tick:       dw 0               ; 16-bit frame counter (~50Hz)
isr_frac:       db 0               ; Frames within current second (0-49)
isr_installed:  db 0               ; 1 = ISR trampoline at 0038h is set up


; ==========================================================================
; bios_call_bank4 — Generic BIOS dispatch: switch to bank 4, call, return
;
; Called from bios_visible wrappers (JP bios_call_bank4).
; MUST be in the safe zone AFTER bdos_stub — the TPA stack grows down
; from bdos_stub and would corrupt code/data placed before it.
;
; @proc bios_call_bank4
; @out   af                     ; BIOS return values (function-dependent)
; @out   hl
; @clobbers bc
; @end
bios_call_bank4:
    ; lint-exempt: stack  ; uses jp (ix) via .jp_ix for the banked CALL (IX)
    di
    ; Save the caller's SP and registers.  HL and IY are inputs/outputs for
    ; BIOS calls (MOVE uses HL), so both are saved; the target address lives
    ; in _bc4_target.
    ld (_bc4_sp), sp
    ld sp, _bc4_stack
    ; Now PUSH/POP use common memory — safe across bank switches
    push af
    push bc
    push de
    push hl
    push iy
    ; Switch to system bank
    ld a, (motor_flag)
    or BANK1_1FFD
    call write_1ffd
    ; Restore caller's registers (target is in _bc4_target)
    pop iy
    pop hl
    pop de
    pop bc
    pop af
    ; Switch to system stack for the actual BIOS call (the trampoline
    ; stack is too small for screen/keyboard drivers)
    ld sp, bdos_stack - 16         ; Use lower part of BDOS stack area
    push iy                        ; caller IY survives the IX dispatch
    ld ix, (_bc4_target)
    ei
    call .jp_ix
    ; BIOS function returned — save return values on safe stack
    di
    pop iy                         ; caller IY restored
    ld sp, _bc4_stack              ; Back to trampoline stack for bank switch
    ld (_bc4_hl), hl
    push af
    push bc
    push de
    ; Switch back to TPA
    ld a, (motor_flag)
    or BANK0_1FFD
    call write_1ffd
    ; Restore return values
    pop de
    pop bc
    pop af
    ld hl, (_bc4_hl)
    ; Restore user stack
    ld sp, (_bc4_sp)
    ei
    ret

.jp_ix:
    jp (ix)                        ; Effectively CALL (IX)

_bc4_hl: dw 0
_bc4_sp: dw 0
_bc4_target: dw 0
_bc4_callhl: dw 0
    ds 16                          ; trampoline stack (5 push pairs)
_bc4_stack:


; ==========================================================================
; userf_stub — USERF (BIOS function 30) dispatcher for XBIOS calls
;
; Called as:   CALL USERF         (via bios_visible entry 30)
;              DW   func_id       (inline 2-byte XBIOS function ID — the
;                                  +3 XBIOS jump-table address)
;
; The +3 XBIOS jump table normally lives at bank 0:0x0080-0x00EC (see
; docs/cpm-plus-xbios.md). We don't implement the full table in bank 4
; yet; instead we dispatch a handful of IDs inline here and return an
; error marker for anything else — so TPA programs that probe XBIOS
; don't crash on the unknown IDs (as Mallard BASIC 1.44 did with 0x00BF
; before we hardened this stub).
;
; MUST be placed AFTER bdos_stub — the TPA stack grows down from
; bdos_stub and would overwrite code placed before it.
;
; @proc userf_stub
; @out   af                     ; function-dependent
; @out   bc
; @out   de
; @out   hl
; @out   ix
; @out   iy
; @clobbers
; @end
userf_stub:
    ld (xbios_arg_a), a            ; preserve caller A for XBIOS input
    ld (xbios_tmp_hl), hl          ; preserve caller AF as a word too
    push af
    pop hl
    ld (xbios_arg_af), hl
    ld hl, (xbios_tmp_hl)
    ld (xbios_ret_ix), ix          ; caller IX/IY are inputs and the default
    ld (xbios_ret_iy), iy          ; return values for XBIOS calls
    ex (sp), hl                    ; HL = return addr -> inline DW
    ld a, (hl)                     ; A = func_id low byte (high byte assumed 0)
    inc hl
    inc hl                         ; HL = corrected return (past the DW)
    ex (sp), hl                    ; return on stack, HL = caller HL
    ; Dispatch every XBIOS ID to the bank-4 handler. Common memory is too
    ; tight (F600-FFFF) to inline the per-function return values, and the
    ; bank switch adds only a few hundred T-states per call.  bios_call_bank4
    ; always restores the caller's IY, so load the handler's IX/IY results
    ; back here (they are the caller values unless a handler changed them).
    push hl                        ; preserve caller HL (XBIOS input)
    ld hl, xbios_handler
    ld (_bc4_target), hl
    pop hl
    call bios_call_bank4
    ld ix, (xbios_ret_ix)
    ld iy, (xbios_ret_iy)
    ret


; ==========================================================================
; write_1ffd — Write A to 1FFD and keep the last_1ffd shadow in sync.
;   All bank-switch sites go through this so the ISR motor-off path can
;   physically drop the motor bit without needing to know the current
;   bank mode itself.
; @proc write_1ffd
; @param %val:u8  a
; @clobbers bc
; @end
write_1ffd:
    ld (last_1ffd), a
    ld bc, PORT_1FFD
    out (c), a
    ret


; ==========================================================================
; warm_boot_stub — Called from JP at 0000h in TPA page zero
;
; @proc warm_boot_stub
; @clobbers af,bc,de,hl
; @end
warm_boot_stub:
    di
    ld sp, bdos_stack

    ; Switch to system banks
    ld a, (motor_flag)
    or BANK1_1FFD
    call write_1ffd

    ; Jump to warm boot in bank 4
    jp warm_boot


; ==========================================================================
; isr_handler — Interrupt service routine (IM 1, called at 0038h)
;   Must live in common memory (fires regardless of current bank mode).
;   Updates isr_tick (raw frame counter) and BCD time in SCB every 50 frames.
;
; @proc isr_handler
; @clobbers af,hl
; @end
isr_handler:
    ; lint-exempt: 1ffd  ; motor-off writes the port directly because it
    ;                     ; runs in TPA mode where write_1ffd may not be
    ;                     ; mapped; keeps last_1ffd in sync itself
    push af
    push hl

    ld a, (fdc_busy)
    or a
    jr nz, .motor_tick_done

    ; --- Motor-off timeout (modeled on +3DOS l0068) ---
    ; motor_on sets motor_countdown to MOTOR_OFF_DELAY. We decrement it
    ; only while the FDC is idle; on expiry we clear motor_flag and write
    ; last_1ffd with the motor bit cleared to physically stop the drive.
    ld a, (motor_countdown)
    or a
    jr z, .motor_tick_done
    dec a
    ld (motor_countdown), a
    jr nz, .motor_tick_done
    ; Expired — clear motor_flag and physically drop the motor bit.
    xor a
    ld (motor_flag), a
    ld (motor_running), a       ; next motor_on must spin up again
    ld a, (last_1ffd)
    and ~MOTOR_BIT                 ; = 0xF7
    ld (last_1ffd), a
    push bc                        ; ISR doesn't normally save BC
    ld bc, PORT_1FFD
    out (c), a
    pop bc
.motor_tick_done:

    ; Increment raw frame counter
    ld hl, (isr_tick)
    inc hl
    ld (isr_tick), hl

    ; Count frames within current second
    ld a, (isr_frac)
    inc a
    cp 50                          ; 50Hz = 1 second
    jr c, .isr_no_tick
    xor a                          ; Reset fractional counter
    ld (isr_frac), a

    ; --- Increment binary seconds ---
    ld a, (scb_sec)
    inc a
    cp 60
    jr c, .store_sec
    xor a                          ; Seconds overflow -> 0
.store_sec:
    ld (scb_sec), a
    jr nz, .isr_done              ; No minute rollover

    ; --- Increment 16-bit minutes-since-midnight ---
    ld hl, (scb_minute)
    inc hl
    ld a, h
    cp 0x05                        ; 1440 = 0x05A0
    jr nz, .store_min
    ld a, l
    cp 0xA0
    jr nz, .store_min_low
    ; 1440 reached → reset minutes, increment day counter
    ld hl, 0
    ld (scb_minute), hl
    ld hl, (scb_date)
    inc hl
    ld (scb_date), hl
    jr .isr_done
.store_min_low:
.store_min:
    ld (scb_minute), hl
    jr .isr_done

.isr_no_tick:
    ld (isr_frac), a              ; Store incremented frame count (1-49)
.isr_done:
    pop hl
    pop af
    ei
    reti


; ==========================================================================
; bank_sel — Select CPU bank (BIOS function 27)
;
; Must live in common memory because switching banks invalidates
; the caller's address space.
;
; @proc bank_sel
; @param %bank:u8  a            ; 0 = TPA (mode 0), non-zero = system (mode 3)
; @clobbers af,bc
; @end
bank_sel:
    or %bank
    jr nz, .sys
    ; Bank 0 (TPA): mode 0 — banks 0,1,2,3
    ld a, (motor_flag)
    or BANK0_1FFD
    jr .out
.sys:
    ; Bank 1 (system): mode 3 — banks 4,7,6,3
    ld a, (motor_flag)
    or BANK1_1FFD
.out:
    jp write_1ffd                  ; Tail-call: writes A to 1FFD, updates shadow, returns


; ==========================================================================
; FCB shadowing — copy user FCB to/from common-memory buffer
; ==========================================================================
;
; File functions call setup_fcb on entry to copy the 36-byte FCB from
; TPA to fcb_buf (common memory). BDOS works with fcb_buf. On exit,
; writeback_fcb copies the documented FCB back to the user's TPA address.
;
; Only bytes 0-32 (drive/name/type/EX/S1/S2/RC/allocation/CR) are part
; of the sequential FCB and only those are written back.  The random
; record at bytes 33-35 is caller storage unless the BDOS fills it in
; (F35/F36 use writeback_fcb_rrr for that).  Programs are allowed to put
; their own data straight after a 33-byte FCB: DRI's ED keeps its
; record-buffer base at FCB+0x21, and a 36-byte write-back zeroed it, so
; ED then built records at address 0 and destroyed page zero.

; ------------------------------------------------------------------
; setup_fcb — Copy 36-byte FCB from TPA to fcb_buf
;
; @proc setup_fcb
; @param %fcb:u16  de           ; user FCB address in TPA
; @out   ix                     ; IX = fcb_buf (common memory copy)
; @out   de                     ; DE preserved (= %fcb on return)
; @clobbers af,bc,hl
; @end
setup_fcb:
    ld (fcb_user_addr), %fcb       ; save user FCB address
    ld hl, fcb_buf
    push %fcb                      ; save user FCB address for restore
    push hl                        ; save fcb_buf ptr for IX
    ex de, hl                      ; DE = fcb_buf, HL = user FCB addr (TPA source)
    ld bc, 36
    call copy_from_user(hl, de, bc)
    pop ix                         ; IX = fcb_buf
    pop %fcb                       ; restore original DE
    ret


; ------------------------------------------------------------------
; writeback_fcb — Copy the 33-byte sequential FCB back to the TPA
;
; @proc writeback_fcb
; @clobbers af,bc,de,hl
; @end
writeback_fcb:
    ld hl, fcb_buf                 ; source: common memory
    ld de, (fcb_user_addr)         ; dest: TPA
    ld bc, 33                      ; stop before R0/R1/R2 (caller-owned)
    call copy_to_user(hl, de, bc)
    ret                            ; keep call: shrinking would move the pinned common addresses


; ==========================================================================
; User memory access (TPA bank)
; ==========================================================================
;
; The BDOS runs in system mode (bank 4 at 0000) but user buffers,
; FCBs, and strings are in TPA (bank 0 at 0000). These helpers
; switch to TPA temporarily to read/write user memory.
;
; They MUST live in common memory because system code vanishes
; when we page in TPA.

; ------------------------------------------------------------------
; read_user_byte — Read one byte from TPA memory
;
; @proc read_user_byte
; @param %addr:u16  de          ; address in TPA (banks 0/1/2)
; @out   a                      ; byte read
; @clobbers bc
; @end
read_user_byte:
    ld a, (motor_flag)
    or BANK0_1FFD
    call write_1ffd                     ; switch to TPA
    ld a, (%addr)                  ; read byte from TPA
    push af
    ld a, (motor_flag)
    or BANK1_1FFD
    call write_1ffd                     ; switch back to system
    pop af
    ret


; ------------------------------------------------------------------
; write_user_byte — Write one byte to TPA memory
;
; @proc write_user_byte
; @param %byte:u8   a           ; byte to write
; @param %addr:u16  de          ; address in TPA
; @out   a                      ; preserved
; @clobbers bc
; @end
write_user_byte:
    push af                        ; save %byte
    ld a, (motor_flag)
    or BANK0_1FFD
    call write_1ffd                     ; switch to TPA
    pop af
    ld (%addr), a                  ; write byte to TPA
    push af
    ld a, (motor_flag)
    or BANK1_1FFD
    call write_1ffd                     ; switch back to system
    pop af
    ret


; ------------------------------------------------------------------
; copy_from_user / copy_to_user - move a block across the bank boundary
;
;   The TPA is not mapped while the BDOS runs, so a block has to bounce
;   through xfer_staging in the common area: copy a chunk, switch banks,
;   copy the chunk again.  The two directions are mirrors of each other -
;   same chunking, same accounting, same two LDIRs - and differ only in
;   which bank each half of the copy runs in.
;
;   They therefore share one body (copy_xfer).  Each entry point writes the
;   two bank values into the OR immediates at copy_xfer_b1/copy_xfer_b2
;   before falling into it.  That is deliberate self-modifying code:
;
;     - it lives in the common stub, which is RAM (copied from bank 6 at
;       cold boot), and the routine never re-enters, so a later call cannot
;       observe a half-chosen direction;
;     - every entry writes BOTH immediates before use, so the patched state
;       never outlives a call and a warm boot cannot inherit it;
;     - each site is a single byte written with `ld (nn),a`, and the IM 1
;       handler (also in common memory) never executes this routine;
;     - a direction flag would instead test every chunk (two per 128-byte
;       record) and still need both bank values loaded.
;
;   `or` immediates are patched, so motor_flag is OR'd in exactly as before
;   and the motor bit is preserved.
;
;   In:  HL = source, DE = destination, BC = byte count
;   Out: HL/DE advanced past the copied bytes
;   Clobbers: AF, BC
; ------------------------------------------------------------------
; @proc copy_from_user
; @param %src:u16   hl          ; source address in the TPA
; @param %dst:u16   de          ; destination in system memory
; @param %count:u16 bc          ; byte count
; @out   hl                     ; advanced past copied bytes
; @out   de                     ; advanced past copied bytes
; @clobbers af,bc
; @end
copy_from_user:
    ld a, BANK0_1FFD           ; first half reads the TPA
    ld (copy_xfer_b1 + 1), a
    ld a, BANK1_1FFD           ; second half writes system memory
    ld (copy_xfer_b2 + 1), a
    jr copy_xfer

; @proc copy_to_user
; @param %src:u16   hl          ; source in system memory
; @param %dst:u16   de          ; destination address in the TPA
; @param %count:u16 bc          ; byte count
; @out   hl                     ; advanced past copied bytes
; @out   de                     ; advanced past copied bytes
; @clobbers af,bc
; @end
copy_to_user:
    ld a, BANK1_1FFD           ; first half reads system memory (already
    ld (copy_xfer_b1 + 1), a   ; mapped; the switch keeps one path)
    ld a, BANK0_1FFD           ; second half writes the TPA
    ld (copy_xfer_b2 + 1), a
    ; fall through into the shared body

; copy_xfer - shared body of copy_from_user / copy_to_user
;   In:  HL = source, DE = destination, BC = byte count
;   Out: HL/DE advanced past the copied bytes
;   Clobbers: AF, BC, HL, DE
; @proc copy_xfer
; @param %src:u16   hl
; @param %dst:u16   de
; @param %count:u16 bc
; @clobbers af,bc,hl,de
; @end
copy_xfer:
    ld (_cfu_src), hl
    ld (_cfu_dst), de
    ld (_cfu_cnt), bc
copy_xfer_loop:
    ld bc, (_cfu_cnt)
    ld a, b
    or c
    jr z, copy_xfer_done
    ; Clamp the chunk to 32 bytes (xfer_staging holds 32).
    ld a, b
    or a
    jr nz, copy_xfer_c32
    ld a, c
    cp 33
    jr c, copy_xfer_cok
copy_xfer_c32:
    ld bc, 32
copy_xfer_cok:
    ld (_cfu_chunk), bc
    ld hl, (_cfu_cnt)
    or a
    sbc hl, bc
    ld (_cfu_cnt), hl
    ; First half: source bank -> staging.
    ld a, (motor_flag)
copy_xfer_b1:
    or 0                       ; PATCHED: BANK0 for from_user, BANK1 for to_user
    call write_1ffd
    ld hl, (_cfu_src)
    ld de, xfer_staging
    ld bc, (_cfu_chunk)
    ldir
    ld (_cfu_src), hl
    ; Second half: staging -> destination bank.
    ld a, (motor_flag)
copy_xfer_b2:
    or 0                       ; PATCHED: BANK1 for from_user, BANK0 for to_user
    call write_1ffd
    ld hl, xfer_staging
    ld de, (_cfu_dst)
    ld bc, (_cfu_chunk)
    ldir
    ld (_cfu_dst), de
    jr copy_xfer_loop
copy_xfer_done:
    ; Leave the system banks mapped: the last TO_USER chunk ran in TPA mode.
    ld a, (motor_flag)
    or BANK1_1FFD
    call write_1ffd   ; keep call: shrinking would move the pinned common addresses
    ret

_cfu_src:   dw 0
_cfu_dst:   dw 0
_cfu_cnt:   dw 0
_cfu_chunk: dw 0


; ==========================================================================
; Inter-bank copy routines
; ==========================================================================

; ------------------------------------------------------------------
; copy_record_to_tpa — Copy 128-byte record from system to TPA
;
; Delegates to copy_to_user with count=128. Same chunked staging logic,
; no separate variables needed.
;
; @proc copy_record_to_tpa
; @param %src:u16  hl           ; source in bank 4 (system)
; @param %dst:u16  de           ; destination in TPA (banks 0/1/2)
; @clobbers af,bc,de,hl
; @end
copy_record_to_tpa:
    ld bc, 128
    jp copy_to_user


; ------------------------------------------------------------------
; copy_record_from_tpa — Copy 128-byte record from TPA to system
;
; Delegates to copy_from_user with count=128.
;
; @proc copy_record_from_tpa
; @param %src:u16  hl           ; source in TPA (banks 0/1/2)
; @param %dst:u16  de           ; destination in bank 4 (system)
; @clobbers af,bc,de,hl
; @end
copy_record_from_tpa:
    ld bc, 128
    jp copy_from_user

; RAMDISK.FID hardcodes these two addresses (see src/fid/ramdisk.asm).
; If these asserts fail, common memory has shifted and the FID source
; needs its COPY_RECORD_*_TPA equates updated.
    assert copy_record_to_tpa == 0xF97A, "RAMDISK.FID expects copy_record_to_tpa at 0xF97A"
    assert copy_record_from_tpa == 0xF980, "RAMDISK.FID expects copy_record_from_tpa at 0xF980"


; ------------------------------------------------------------------
; copy_block_to_tpa — Copy arbitrary-length block from system to TPA
;
; Used for CCP loading (warm/cold boot). Identical semantics to
; copy_to_user (system→staging→TPA in 32-byte chunks); tail-call into it.
;
; @proc copy_block_to_tpa
; @param %src:u16   hl          ; source in system memory (bank 4 or 6)
; @param %dst:u16   de          ; destination in TPA
; @param %count:u16 bc          ; byte count
; @clobbers af,bc,de,hl
; @stack modifies
; @end
copy_block_to_tpa:
    jp copy_to_user                ; tail call — same registers, same behaviour


; ------------------------------------------------------------------
; interbank_move — Inter-bank block move (byte-by-byte via common)
;
; Called from bios_move when xmove_active is set.
; Must be in common memory because it switches banks mid-copy.
;
; @proc interbank_move
; @param %dst:u16   hl          ; destination address
; @param %src:u16   de          ; source address
; @param %count:u16 bc          ; byte count
; @out   hl                     ; advanced past written bytes
; @out   de                     ; advanced past read bytes
; @clobbers af,bc
; @end
interbank_move:
    ; Clear inter-bank flag (in system bank, still active on entry)
    xor a
    ld (xmove_active), a

    ; Read bank numbers (in bank 4) before we start switching
    ld a, (xmove_src)
    ld (_ibm_src_bank), a
    ld a, (xmove_dst)
    ld (_ibm_dst_bank), a

.loop:
    push %count                    ; save BC across bank switches

    ; Switch to source bank, read byte
    ld a, (_ibm_src_bank)
    call bank_sel(a)
    ld a, (%src)                   ; read byte from source
    inc %src
    ld (_ibm_byte), a

    ; Switch to dest bank, write byte
    ld a, (_ibm_dst_bank)
    call bank_sel(a)
    ld a, (_ibm_byte)
    ld (%dst), a                   ; write byte to destination
    inc %dst

    pop %count                     ; restore BC
    dec %count
    ld a, b                        ; test BC == 0
    or c
    jr nz, .loop

    ; Restore system bank
    ld a, 1
    call bank_sel(a)
    ret                            ; keep call: shrinking would move the pinned common addresses

_ibm_src_bank: db 0
_ibm_dst_bank: db 0
_ibm_byte:     db 0


; ==========================================================================
; Disk parameter structures — in common memory so TPA programs (e.g.
; DISCKIT.COM) can dereference them after calling DRVTBL/SELDSK.
; csv_a/alv_a live in bank 6, dirbuf remains in common; only BDOS follows
; those pointers.
; ==========================================================================

; Drive pointer table — 16 DPH pointers (BIOS fn 22 DRVTBL returns this)
drive_table:
    dw xdph_a                      ; A: — +3 floppy
    dw xdph_b                      ; B: — +3 floppy (second physical drive, US=1)
drive_table_c_slot:
    dw 0                           ; C: — patched to xdph_c by load_fid (or stays 0)
    dw 0                           ; D:
    dw 0, 0, 0, 0                  ; E: through H:
    dw 0, 0, 0, 0                  ; I: through L:
    dw 0, 0, 0, 0                  ; M: through P:

; XDPH prefix (10 bytes before xdph_a label)
    dw fdc_write               ; -10: write routine
    dw fdc_read                ; -8:  read routine
    dw fdc_login               ; -6:  login routine
    dw fdc_init                ; -4:  init routine
    db 0, 0                    ; -2:  relative drive 0, padding

; DPH (Disk Parameter Header) — address returned to BDOS by sel_disk
xdph_a:
    dw 0                       ; XLT: no sector translate
    dw 0, 0, 0                 ; Scratch (used by BDOS)
    dw dirbuf                  ; DIRBUF: 128-byte directory buffer
    dw xdpb_a                  ; DPB pointer — per-drive XDPB
    dw csv_a                   ; CSV: checksum vector (bank 4, BDOS only)
    dw alv_a                   ; ALV: allocation vector (bank 4, BDOS only)

; XDPH prefix for B: (10 bytes before xdph_b label)
; B: is the second physical drive on the uPD765A (unit select US=1).
    dw fdc_write               ; -10: write routine
    dw fdc_read                ; -8:  read routine
    dw fdc_login               ; -6:  login routine
    dw fdc_init                ; -4:  init routine
    db 1, 0                    ; -2:  relative drive 1, padding

xdph_b:
    dw 0                       ; XLT: no sector translate
    dw 0, 0, 0                 ; Scratch (per-drive BDOS state)
    dw dirbuf                  ; DIRBUF (shared — BDOS only uses while selected)
    dw xdpb_b                  ; DPB pointer — per-drive XDPB
    dw csv_b                   ; CSV: B:'s checksum vector
    dw alv_b                   ; ALV: B:'s allocation vector

; XDPH prefix for C: (RAM disk via loadable FID).  All four routine
; slots are zero at boot; load_fid patches them with addresses inside
; the FID code (loaded at 0x9000 in bank 6) once it has validated the
; module.  drive_table_c_slot stays 0 unless load_fid succeeds.
xdph_c_write_slot: dw 0       ; -10: write routine
xdph_c_read_slot:  dw 0       ; -8:  read routine
xdph_c_login_slot: dw 0       ; -6:  login routine
xdph_c_init_slot:  dw 0       ; -4:  init routine
                   db 2, 0    ; -2:  relative drive 2

xdph_c:
    dw 0                       ; XLT: no sector translate
    dw 0, 0, 0                 ; Scratch (per-drive BDOS state)
    dw dirbuf                  ; DIRBUF (shared)
    dw xdpb_c                  ; DPB pointer
    dw alv_c                   ; CSV: CKS=0 so unused; point at alv_c harmlessly
    dw alv_c                   ; ALV: allocation vector (bank 4, BDOS only)

; Per-drive XDPBs (27 bytes each). Bytes 0-16: standard CP/M 3 DPB;
; bytes 17-26: Amstrad XBIOS extension. Initialised to the +3 SS/SD
; default; intended to be overwritten by fdc_login after format
; detection (once that's wired up again).  Layout per docs/cpm-plus-xbios.md.
xdpb_a:
    dw 36                      ; 0-1  SPT
    db 3                       ; 2    BSH (1K blocks)
    db 7                       ; 3    BLM
    db 0                       ; 4    EXM
    dw 174                     ; 5-6  DSM
    dw 63                      ; 7-8  DRM
    db 0xC0                    ; 9    AL0 (2 directory blocks)
    db 0x00                    ; 10   AL1
    dw 16                      ; 11-12 CKS
    dw 1                       ; 13-14 OFF (1 reserved track)
    db 2                       ; 15   PSH (log2(512/128))
    db 3                       ; 16   PHM
    ; --- Amstrad XDPB extension (bytes 17-26) ---
    db 0                       ; 17   Sidedness: 0 = single-sided
    db 40                      ; 18   Tracks per side
    db 9                       ; 19   Physical sectors per track
    db 1                       ; 20   First sector ID
    dw 512                     ; 21-22 Physical sector size
    db 42                      ; 23   Gap 3 R/W
    db 82                      ; 24   Gap 3 format
    db 0x40                    ; 25   Flags: MFM
    db 0                       ; 26   Freeze: 0 = auto-detect on login
xdpb_b:
    dw 36
    db 3
    db 7
    db 0
    dw 174
    dw 63
    db 0xC0
    db 0x00
    dw 16
    dw 1
    db 2
    db 3
    db 0
    db 40
    db 9
    db 1
    dw 512
    db 42
    db 82
    db 0x40
    db 0

; XDPB for C: — load_fid copies the FID's XDPB template here.  Stays
; zero if no FID is loaded (drive is invisible because drive_table_c_slot
; is also zero in that case).
xdpb_c:
    ds 27, 0

; Motor spin-up state, shared with the ISR.  Lives after the pinned copy
; routines so adding it does not move their addresses.
motor_running: db 0


; ==========================================================================
; Buffers
; ==========================================================================

; Directory buffer — in common memory so FDC direct copy works.
; Must be 128 bytes: the FDC driver deblocks to 128-byte records and
; copy_to_user copies the full 128-byte sector to the user DMA area.
dirbuf:     ds 128
    assert $ - dirbuf == 128, "dirbuf must be exactly 128 bytes (fdc_read writes one full deblocked record)"

; fcb_buf is defined near the top of this file; it lives in bank 6.
fcb_user_addr:  dw 0               ; TPA address of the user's FCB

; Inter-bank transfer staging buffer (32 bytes).
; Reduced from 128 to save common memory. The copy_record_to/from_tpa
; and copy_block_to_tpa routines copy in 32-byte chunks instead of 128.
xfer_staging: ds 32
    assert $ - xfer_staging == 32, "xfer_staging must be exactly 32 bytes (copy_to/from_user chunk size)"

; FCB used by the CCP's COM-loader stub.  It must live above COMMON_BASE
; so a large program cannot overwrite it while the stub is still reading.
ccp_fcb: ds 36
    assert $ - ccp_fcb == 36, "ccp_fcb must be exactly 36 bytes (CP/M FCB format)"
    assert ccp_fcb == 0xFB21, "miniccp.zpa CCP_FCB_ADDR must match ccp_fcb"


; BDOS stack (grows downward from bdos_stack label)
; ==========================================================================
; start_tpa — Switch to TPA mode, set up page zero, jump to CCP
;
; @proc start_tpa
; @clobbers af,bc,de,hl
; @end
start_tpa:
    ; Snapshot page-zero compatibility bytes while the system bank is
    ; still mapped.  0003 = IOBYTE, 0004 = (user << 4) | drive.
    ld a, (cur_user)
    add a, a
    add a, a
    add a, a
    add a, a
    ld b, a
    ld a, (cur_disk)
    and 0x0F
    or b
    push af                    ; 0004 value
    ld a, (iobyte)
    push af                    ; 0003 value

    ; Switch to TPA (mode 0: 0,1,2,3)
    ld a, (motor_flag)
    or BANK0_1FFD
    call write_1ffd

    ; Set up page zero in bank 0
    ; 0000: JP to BIOS visible WBOOT entry (programs use 0001 to find BIOS base)
    ld a, JMP_OPCODE
    ld (0x0000), a
    ld hl, bios_visible + 3       ; Entry 1 = WBOOT in visible table
    ld (0x0001), hl

    ld a, JMP_OPCODE
    ld (0x0005), a
    ld hl, bdos_vector             ; = TPA_TOP, the memory ceiling at (0006)
    ld (0x0006), hl

    pop af
    ld (0x0003), a             ; IOBYTE
    pop af
    ld (0x0004), a             ; user/drive compatibility byte

    ; Install the common tick/motor ISR at bank 0's 0x0038.  It lives in
    ; common memory (visible in TPA mode), so the clock and keyboard repeat
    ; keep running while a TPA program executes.  Programs that need their
    ; own RST 38 handler can overwrite these three bytes.
    ld a, JMP_OPCODE
    ld (0x0038), a
    ld hl, isr_handler
    ld (0x0039), hl

    ; Enable interrupts and start CCP
    im 1
    ld a, 1
    ld (isr_installed), a
    ei
    jp CCP_ADDR




bdos_stack_base:
    ds 128
bdos_stack equ bdos_stack_base + 128
    assert bdos_stack - bdos_stack_base == 128, "BDOS stack must be 128 bytes"
    assert bdos_stack <= 0x10000, "BDOS stack must fit in common memory"

; Zero-fill source for F40 (Write Random with Zero Fill).  One 128-byte
; record of zeros in common memory: both the FDC and the RAM-disk FID
; direct-copy a DMA address at or above C000h, so the BDOS can point the
; BIOS DMA here without touching the user's buffer.  This sits above the
; BDOS stack.
f40_zero equ bdos_stack
    assert f40_zero == bdos_stack, "f40_zero must follow the BDOS stack"
    assert f40_zero + 128 <= 0x10000, "f40_zero must fit in common memory"
    ds 128

; ==========================================================================
; End of common memory stub
; ==========================================================================
common_end equ f40_zero + 128

    assert common_end <= 0xFFFF, "Common stub overflows bank 3!"

; USERF/TE/disc state.  Keep it after the fixed common layout so the
; RAMDISK.FID copy routines and the staged CCP's FCB address do not move.
xbios_arg_a: db 0                  ; caller A (TE_SET_INK, DD_SEL_FORMAT)
xbios_arg_af: dw 0                 ; caller AF (low=F, high=A) for calls
                                   ; that preserve all registers/flags
xbios_ret_ix: dw 0                 ; XBIOS IX result (caller IX by default)
xbios_ret_iy: dw 0                 ; XBIOS IY result (caller IY by default)
xbios_tmp_hl: dw 0                 ; scratch for SCR_RUN_ROUTINE's call
dd_results: db 0                   ; DD_READ_ID result count
    ds 7                           ; ST0 ST1 ST2 C H R N
; dd_reserved used to hold the DD_FORMAT CHRN table (36 bytes).  DD_FORMAT
; now stages that table in the FDC deblock buffer, which holds up to 32
; entries, so this space is unused.  It was kept as a cushion, but the
; cushion is better placed after the pinned code below than before it.

; CD_INFO buffer-descriptor table: empty (single 0xFF terminator).  The
; manual requires HL to point into common memory so a TPA caller can read it.
cd_buf_tab: db 0xFF


; ==========================================================================
; ccp_run_prog — Start a freshly loaded .COM (called from the CCP's stub)
; ==========================================================================
;
; The CCP's loader stub copies the program to 0100h and jumps here after
; setting SP = TPA_TOP.  This routine pushes 0000h, so a program that ends
; with RET warm-boots like it does under the real CP/M 3 CCP.
;
; If the first byte is RET (0C9h) the file carries a CP/M 3 COM header:
; a 256-byte header with the COM module size at 0101h, the module loaded
; at 0200h and optional RSX modules after it (see the CP/M 3 LOADER).
; Move the module down over the header exactly as the LOADER does.  The
; attached RSX modules are NOT installed - this system has no RSX chain -
; see docs/third-party-tests.md.
;
; Lives in common memory because the loaded program overwrites the CCP.
;
; @proc ccp_run_prog
; @clobbers af,bc,de,hl
; @end
ccp_run_prog:
    ld a, (0x0100)
    cp 0xC9
    jr nz, .run
    ld hl, (0x0101)                ; COM module size
    ld a, h
    or l
    jr z, .run                     ; empty module
    ld a, h
    cp 0xF0
    jr nc, .run                    ; absurd size - treat as a plain COM
    push bc                        ; keep C = current drive
    ld bc, (0x0101)
    ld hl, 0x0200
    ld de, 0x0100
    ldir                           ; module down over the header
    pop bc
.run:
    ld hl, 0
    push hl                        ; RET from the program returns to warm boot
    jp 0x0100

    assert ccp_run_prog == 0xFCA6, "miniccp.zpa CCP_RUN_PROG must match ccp_run_prog"

; ==========================================================================
; BDOS directory and FCB helpers (relocated from bank 4)
; ==========================================================================
;
; These routines are only ever entered in system mode (the BDOS dispatch
; switches banks before calling any handler), so they live in common memory
; to leave room in the 16K bank-4 image.  They run from the common stub at
; F600+, which is mapped in every mode; the fixed common-stub addresses
; above (copy_record_*, ccp_fcb, ccp_run_prog) are unchanged because this
; block is appended after them.
;
; ==========================================================================

; @proc find_free_block
; @out   hl                        ; first free block, 0 if none
; @out   carry                     ; set when the disk is full
; @clobbers af,bc,de,hl
; @end
find_free_block:
    ld hl, (cached_alv)
    ld bc, 0                   ; BC = block number
.byte_loop:
    ld a, (hl)
    cp 0xFF
    jr z, .skip_byte
    ld d, 0x80
.bit_loop:
    ld a, (hl)
    and d
    jr z, .found               ; bit clear = block free
    inc bc
    push hl
    ld hl, (cached_dsm)
    or a
    sbc hl, bc
    pop hl
    jr c, .full                ; past DSM
    srl d
    jr nz, .bit_loop
    inc hl
    jr .byte_loop
.skip_byte:
    ld a, c
    add a, 8
    ld c, a
    jr nc, .skip_nc
    inc b
.skip_nc:
    inc hl
    push hl
    ld hl, (cached_dsm)
    or a
    sbc hl, bc
    pop hl
    jr nc, .byte_loop
.full:
    scf
    ret
.found:
    ld h, b
    ld l, c
    or a                       ; clear carry
    ret


; ==========================================================================
; Internal: Directory operations
; ==========================================================================

; @proc read_dir_entry
; @param %entry:u16 de
; @out   hl
; @clobbers af,bc,de,hl,iy
; @end
; read_dir_entry — Read directory sector containing entry N, return pointer
;   In:  DE = directory entry number (0-based)
;   Out: HL = pointer to 32-byte entry within dir sector buffer
;        Carry set if entry beyond DRM
;   Clobbers: AF, BC
read_dir_entry:
    ; Check bounds
    push de
    ld hl, (cached_drm)
    inc hl
    or a
    sbc hl, de
    pop de
    jr z, .out_of_range
    jr c, .out_of_range

    ; Directory sector = entry / 4 (4 entries per 128-byte sector)
    ; Offset within sector = (entry % 4) * 32
    ld a, e                    ; Low byte of entry number (max 63 for us)
    push af                    ; Save for offset calculation
    srl a
    srl a                      ; A = entry / 4 = directory sector number

    ; Check if this sector is already cached in dirbuf
    ld b, a                    ; B = sector number
    ld a, (disk_drive)
    ld c, a                    ; C = currently selected BIOS drive
    ld a, (last_dir_drv)
    cp c
    jr nz, .need_read
    ld a, (last_dir_sec)
    cp b
    jr z, .dir_cached          ; Same sector — skip disk read

    ; Read this directory sector via BIOS
.need_read:
    ld a, b
    push af                    ; Save directory sector (BIOS calls clobber BC)
    call dir_sector_to_bios    ; Set BIOS track/sector

    ; Save user DMA, then redirect to our internal directory buffer
    ld hl, (bdos_dma)
    push hl
    ld bc, dirbuf
    call set_dma

    ; Read via BIOS
    call disk_read
    or a
    jr nz, .read_error_dma

    ; Cache is valid only after a successful read.
    pop hl                     ; Saved user DMA (pushed last)
    ld (bdos_dma), hl
    pop bc                     ; B = directory sector saved above
    ld a, b
    ld (last_dir_sec), a       ; Save sector number for write_dir_entry
    ld a, (disk_drive)
    ld (last_dir_drv), a

.dir_cached:
    pop af                     ; A = original entry number (from line 913)
    and 0x03                   ; Entry within sector (0-3)
    ; Multiply by 32
    ld l, a
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl                ; HL = (entry%4) * 32
    ld de, dirbuf
    add hl, de                 ; HL = &dirbuf[offset]
    or a                       ; Clear carry
    ret

.out_of_range:
    ; Reached before any pushes — stack is clean, just return with carry
    scf
    ret

.read_error_dma:
    pop hl                     ; saved bdos_dma
    ld (bdos_dma), hl          ; Restore user DMA before returning
    ld a, 0xFF
    ld (last_dir_sec), a
    ld (last_dir_drv), a
    pop bc                     ; discard saved directory sector
    pop af                     ; entry-number af pushed at top of routine
    scf
    ret


; @proc write_dir_entry
; @clobbers af,bc,de,hl,iy
; @end
; write_dir_entry — Write back the current directory sector
;   Re-seeks to the directory sector saved by read_dir_entry.
;   Clobbers: AF, BC, DE, HL
write_dir_entry:
    ld a, (last_dir_sec)       ; Re-establish correct track/sector
    call dir_sector_to_bios
    ld bc, dirbuf
    call set_dma
    jp disk_write


; @proc dir_sector_to_bios
; @param %sector:u8 a
; @clobbers af,bc,de,hl
; @end
; dir_sector_to_bios — Set BIOS track/sector for directory sector N
;   In: A = directory sector number (0-based within directory area)
;   The directory starts at logical sector 0 of the first data track.
;   Clobbers: AF, BC, DE, HL
dir_sector_to_bios:
    ; Directory sector N maps to:
    ;   absolute_record = N (directory starts at record 0 of data area)
    ;   track = absolute_record / SPT + OFF
    ;   sector = absolute_record % SPT
    ld l, a
    ld h, 0                    ; HL = directory record number
    ld de, (cached_off)
    ; Track = OFF + record / SPT
    ; Since SPT=36 and records are small, this is just track=OFF for early records
    ld bc, (cached_spt)
    call div_hl_bc             ; HL = quotient (track offset), DE = remainder (sector)
    push de                    ; Save sector
    ld de, (cached_off)
    add hl, de                 ; HL = track
    ld b, h
    ld c, l
    call set_trk               ; BIOS set track

    pop bc                     ; BC = sector
    jp set_sec               ; BIOS set sector


; ==========================================================================
; File functions (F15-F23, F33-F36, F40)
; ==========================================================================

; F17: Search First
; @proc bf_f17
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f17:
    pop de
    pop bc
    ; DE = FCB pointer in TPA — copy to fcb_buf for system-side access
    call setup_fcb(de)         ; Copy 36 bytes from TPA to fcb_buf, IX = fcb_buf
    ld de, fcb_buf
    ld (search_fcb), de        ; Point search at system copy
    ld hl, 0
    ld (search_pos), hl        ; Start from entry 0

    ; Make sure drive is selected
    call select_fcb_drive
    jr c, .f17_bad

    jr search_next_entry

.f17_bad:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

; F18: Search Next
; @proc bf_f18
; @param %param:u16 de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,iy
; @end
bf_f18:
    pop de
    pop bc
    ; Continue from search_pos

; @proc search_next_entry
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,iy
; @end
search_next_entry:
    ld de, (search_pos)
.loop:
    push de
    call read_dir_entry        ; HL = entry, carry if past end
    pop de
    jr c, .not_found

    ; Compare entry with search FCB
    push de
    push hl                    ; Save entry pointer
    ld de, (search_fcb)
    call match_fcb             ; Z = match
    pop hl
    pop de
    jr z, .found

    inc de
    jr .loop

.not_found:
    ; Return 0xFF = not found
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

.found:
    ; Store position for Search Next
    inc de
    ld (search_pos), de
    dec de

    ; Copy the directory sector to the user's DMA area
    ; The matching entry is at position (entry % 4) within the sector.
    ; CP/M convention: copy 128-byte directory sector to DMA,
    ; return A = index (0-3) of matching entry within it.
    ld hl, dirbuf                  ; Source: common memory
    ld de, (bdos_dma)              ; Dest: user DMA in TPA
    ld bc, 128
    call copy_to_user(hl, de, bc)  ; Inter-bank copy

    ; Return index of match within sector
    ld de, (search_pos)
    dec de                     ; Back to the matched entry
    ld a, e
    and 0x03                   ; Index within 128-byte sector (0-3)
    ld l, a
    ld h, 0
    jp bdos_ret


; @proc match_fcb
; @param %entry:u16 hl
; @param %fcb:u16   de
; @out   zero
; @clobbers af,bc,de,hl
; @end
; match_fcb — Compare directory entry at HL with FCB at DE
;   Compares user number and filename (bytes 0-12).
;   '?' in the FCB matches any character.
;   Out: Z = match, NZ = no match
;   Clobbers: AF, BC, DE, HL
match_fcb:
    ; Byte 0 of directory entry = user number.  Valid values 0-15 are
    ; real user areas; 0x10-0x1F are reserved for disc labels / timestamps
    ; in CP/M 3; 0xE5 means "deleted"; anything else is garbage (e.g. a
    ; never-written entry on a BFORMAT disc).  Only user 0-15 entries
    ; should be considered for a normal directory match.
    ld a, (hl)
    cp 16
    jr nc, .no_match           ; 16+ (labels, deleted, garbage) — skip

    push hl
    push de
    ; Check user: if search FCB byte 0 is '?', match any user
    ld a, (de)                 ; FCB byte 0 (drive code, not user for search)
    ; For search, byte 0 is drive. User is matched against cur_user.
    ld a, (cur_user)
    ld c, a                    ; C = current user
    ld a, (hl)                 ; Entry user
    cp c
    jr nz, .no_match_pop       ; Different user

    ; Compare filename bytes 1-11 (8 name + 3 type)
    inc hl
    inc de
    ld b, 11
.cmp_loop:
    ld a, (de)                 ; FCB char
    cp '?'
    jr z, .cmp_next            ; Wildcard matches anything
    and 0x7F                   ; Mask off attribute bit from FCB
    ld c, a
    ld a, (hl)                 ; Directory char
    and 0x7F                   ; Mask off attribute bit from directory
    cp c
    jr nz, .no_match_pop
.cmp_next:
    inc hl
    inc de
    djnz .cmp_loop

    ; Match!
    pop de
    pop hl
    xor a                      ; Set Z
    ret

.no_match_pop:
    pop de
    pop hl
.no_match:
    or 1                       ; Clear Z
    ret


; F15: Open File
; @proc bf_f15
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f15:
    pop de
    pop bc
    ; Copy FCB from TPA to fcb_buf
    call setup_fcb(de)         ; IX = fcb_buf, DE preserved
    ld de, fcb_buf
    push de

    ; Select drive from FCB (or cur_disk if FCB[0]=0). Don't touch cur_disk.
    call select_fcb_drive
    jr c, .not_found           ; invalid drive → treat as "file not found"

    ; Search for the file in the directory
    pop de                     ; DE = fcb_buf
    push de
    ld (search_fcb), de
    ld hl, 0
    ld (search_pos), hl

.search:
    ld de, (search_pos)
    push de
    call read_dir_entry
    pop de
    jr c, .not_found

    push de
    push hl
    ld de, (search_fcb)
    call match_fcb
    pop hl
    pop de
    jr z, .found

    inc de
    ld (search_pos), de
    jr .search

.not_found:
    pop de
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

.found:
    ; Copy directory entry to fcb_buf
    ; HL = directory entry, stack has fcb_buf pointer
    pop de                     ; DE = fcb_buf
    push de
    push hl
    ; Copy bytes 0-31 from directory to fcb_buf (except byte 0 = drive)
    inc hl                     ; Skip user byte in directory
    inc de                     ; Skip drive byte in fcb_buf
    ld bc, 31
    ldir                       ; directory → fcb_buf (both common/system — OK)
    pop hl
    pop de

    ; Set CR = 0 (start of file)
    push de
    pop hl
    ld de, 32
    add hl, de
    ld (hl), 0                 ; fcb_buf[32] = 0

    ; Write modified FCB back to TPA
    call writeback_fcb()

    ld a, 0                    ; Success
    ld l, a
    ld h, 0
    jp bdos_ret


; F16: Close File
;   In:  DE = FCB (EX must reflect the extent being closed)
;   Out: HL = 0 (OK)
;   Clobbers: AF, BC, DE, HL
; @proc bf_f16
; @param %fcb:u16   de
; @param %func:u8   c
; @out   a
; @out   hl
; @clobbers af,bc,de,hl,ix,iy
; @end
bf_f16:
    pop de
    pop bc
    call setup_fcb(de)         ; IX = fcb_buf, copies 36 bytes from TPA

    ; Cache DPB/ALV for the FCB's drive — close_dir_update walks the
    ; directory using cached_*.
    call select_fcb_drive
    jr c, .f16_err
    call is_fcb_readonly
    jr nz, .f16_ro

    call flush_deblock         ; Flush any pending write data
    call close_dir_update
    call writeback_fcb()
    xor a
    ld l, a
    ld h, 0
    jp bdos_ret

.f16_ro:
    ld l, a
    ld h, 0
    jp bdos_ret

.f16_err:
    ld a, 0xFF
    ld l, a
    ld h, 0
    jp bdos_ret

; ------------------------------------------------------------------
; @proc close_dir_update
; @clobbers af,bc,de,hl,iy
; @end
; close_dir_update — Find directory entry matching FCB and update it
;   In:  IX = fcb_buf (with correct EX, RC, alloc map)
;   Clobbers: AF, BC, DE, HL
; ------------------------------------------------------------------
close_dir_update:
    ld de, 0
.cl_scan:
    push de
    call read_dir_entry        ; HL = ptr to 32-byte entry, carry = past end
    pop de
    jr c, .cl_done

    push de
    push hl
    ; Check user number
    ld a, (hl)
    cp 0xE5
    jr z, .cl_skip
    ld a, (cur_user)
    ld c, a
    ld a, (hl)
    cp c
    jr nz, .cl_skip
    ; Check filename bytes 1-11 (strip attribute bits from directory)
    push hl
    inc hl                     ; HL = &entry[1]
    push ix
    pop de
    inc de                     ; DE = &FCB[1]
    ld b, 11
.cl_name:
    ld a, (hl)
    and 0x7F
    ld c, a
    ld a, (de)
    and 0x7F                   ; Mask FCB attribute bit too
    cp c
    jr nz, .cl_name_fail
    inc hl
    inc de
    djnz .cl_name
    pop hl                     ; HL = entry base (from push before inc hl)
    ; Check EX (byte 12)
    ld de, 12
    add hl, de                 ; HL = &entry[12]
    ld a, (hl)
    ld c, a
    ld a, (ix + 12)
    cp c
    jr nz, .cl_skip_from_ex    ; EX mismatch — keep scanning
    ; Found the right entry — update RC and allocation map in-place
    ; HL = &entry[12], stack: [de_outer, hl_outer]
    ld de, 3
    add hl, de                 ; HL = &entry[15] (RC)
    ld a, (ix + 15)
    ld (hl), a                 ; entry.RC = FCB.RC
    inc hl                     ; HL = &entry[16]
    ; Copy FCB allocation map → directory entry (straight copy per spec)
    push ix
    pop de                     ; DE = FCB base
    push hl
    ld bc, 16
    ex de, hl
    add hl, bc                 ; HL = &FCB[16]
    ex de, hl                  ; DE = &FCB[16]
    pop hl                     ; HL = &entry[16]
    ex de, hl                  ; HL = &FCB[16], DE = &entry[16]
    ld bc, 16
    ldir                       ; FCB alloc → directory entry
    call write_dir_entry
    pop de                     ; Discard hl_outer
    pop de                     ; Discard de_outer
    ret

.cl_name_fail:
    pop hl                     ; Balance push hl before inc hl
.cl_skip_from_ex:              ; Stack: [de_outer, hl_outer]
.cl_skip:
    pop hl                     ; Discard hl_outer
    pop de                     ; Restore entry index
    inc de
    jr .cl_scan

.cl_done:
    ret


; ==========================================================================
; Screen helpers relocated from the bank-4 head to keep its 256-byte
; growth margin.  Common memory is mapped in both system and screen mode,
; and these routines only touch bank-4 variables or computed values.
; ==========================================================================

; ==========================================================================
; _decode_colour - Decode an ESC b/c colour parameter
;   In:  A = parameter byte (32..95, per the +3 CP/M manual)
;   Out: B = Spectrum colour 0-7 (bit0 blue, bit1 red, bit2 green)
;        C = bright flag 0 or 1
;   Clobbers: AF, DE
; ==========================================================================
; @proc _decode_colour
; @param %param:u8 a
; @out   bc
; @clobbers af,de
; @end
_decode_colour:
    sub 32
    and 0x3F
    ; fall through

; _decode_te_colour — Decode a +3 palette byte (0..3F)
;   Each pair of bits is one gun: 00 off, 01/10 on normal, 11 on high.
;   The Spectrum colour index takes the gun on/off state; the bright flag
;   is set only when every enabled gun is high.
; @proc _decode_te_colour
; @param %colour:u8 a
; @out   bc
; @clobbers af,de
; @end
_decode_te_colour:
    ld e, a

    ; Colour index: bit0 blue, bit1 red, bit2 green.  A gun is on for
    ; pair values 1, 2 or 3, so test the whole pair, not just one bit.
    xor a
    ld b, a
    ld a, e
    and 0x03
    jr z, .dtc_red
    set 0, b                   ; blue
.dtc_red:
    ld a, e
    and 0x0C
    jr z, .dtc_green
    set 1, b                   ; red
.dtc_green:
    ld a, e
    and 0x30
    jr z, .dtc_bright
    set 2, b                   ; green
.dtc_bright:
    ; Bright only when no gun is 01 or 10: XOR each pair's two bits.
    ld a, e
    ld d, a
    srl a
    xor d
    and 0x15                   ; blue bit0, red bit2, green bit4
    jr nz, .dtc_normal
    ld a, e
    and 0x15                   ; all guns off (black) is not bright
    jr z, .dtc_normal
    ld c, 1
    ret
.dtc_normal:
    ld c, 0
    ret


; ==========================================================================
; _set_attr - Recompute scr_attr from the ink/paper/bright state
;   Both colours must be bright for the BRIGHT attribute to be set,
;   matching the +3's "mix normal with bright and both stay normal".
;   Clobbers: AF, B
; ==========================================================================
; @proc _set_attr
; @clobbers af,b
; @end
_set_attr:
    ld a, (scr_ink_br)
    and a
    jr z, .sa_nobr
    ld a, (scr_paper_br)
    and a
    jr z, .sa_nobr
    ld a, 0x40
    jr .sa_have
.sa_nobr:
    xor a
.sa_have:
    ld b, a

    ; FLASH only when both inks have a different flash colour.  Hardware
    ; then alternates the whole cell between ink and paper.
    xor a
    ld (scr_flash), a
    ld a, (scr_ink_fl)
    and a
    jr z, .sa_noflash
    ld a, (scr_paper_fl)
    and a
    jr z, .sa_noflash
    ld a, 0x80
    ld (scr_flash), a
    or b
    ld b, a
.sa_noflash:
    ld a, (scr_paper)
    and 0x07
    add a, a
    add a, a
    add a, a
    or b
    ld b, a
    ld a, (scr_ink)
    and 0x07
    or b
    ld (scr_attr), a
    ret



; @proc _mul80
; @param %n:u8 a
; @out   hl
; @clobbers af,de,hl
; @end
_mul80:
    ld l, a
    ld h, 0
    add hl, hl                 ; *2
    add hl, hl                 ; *4
    add hl, hl                 ; *8
    add hl, hl                 ; *16
    ld d, h
    ld e, l
    add hl, hl                 ; *32
    add hl, hl                 ; *64
    add hl, de                 ; *80
    ret


; @proc _lg_width
; @out   a
; @clobbers af
; @end
_lg_width:
    ld a, (mode80)
    or a
    jr nz, .lw80
    ld a, (vp_width)
    ret
.lw80:
    ld a, 80
    ret


; ==========================================================================
; _cancel_paging - Clear the BDOS page-mode bit (ESC 3 resets paging)
;   Clobbers: AF
; ==========================================================================
; @proc _cancel_paging
; @clobbers af
; @end
_cancel_paging:
    ld a, (con_mode)
    and 0xFE
    ld (con_mode), a
    ret


; ==========================================================================
; Character device table (CP/M 3 BIOS function 20, DEVTBL)
; ==========================================================================
; Format is the DRI one: 6-byte space-padded name, mode byte, baud code,
; repeating, terminated by a zero byte in the name position (CP/M 3 System
; Guide, Listing 3-2/3-3).
;
; This MUST be in common memory: a TPA program calls DEVTBL through page
; zero and then reads the returned pointer while mode 0 is selected, where
; bank 4 (0x0000-0x3FFF) is not mapped.
;
; Mode bits: 0x01 input, 0x02 output, 0x04 software baud, 0x08 serial,
; 0x10 XON/XOFF.
char_dev_table:
    db 'CON   '                    ; console: keyboard in, screen out
    db 0x03                        ; input + output
    db 0                           ; baud$none (not a serial port)
    db 'CONO  '                    ; console output only (PIP CONO:=FILE)
    db 0x02                        ; output
    db 0                           ; baud$none
    db 'LST   '                    ; printer: declared, no hardware fitted
    db 0x02                        ; output
    db 0                           ; baud$none
    db 'AUX   '                    ; serial: declared, no hardware fitted
    db 0x03                        ; input + output
    db 0                           ; baud$none
    db 0                           ; table terminator

    assert char_dev_table + 33 <= 0x10000, "Device table must fit in common memory"


; ==========================================================================
; Character device redirection dispatch
; ==========================================================================
; The BIOS list_out / aux_out entries load the SCB redirection vector and
; branch here.  Lives in common memory because it only ever runs in system
; mode and bank 4 is short of headroom (docs/boot.md, "Remaining strategies").
;
; A vector is a bit per character-device table entry: bit 15 = entry 0 (CON),
; bit 14 = entry 1, ...  A +3 has no printer or serial port, so only the CON
; bit does anything; the rest are sinks, which CP/M 3 allows.

; dev_out - emit C to the console if HL selects CON, else discard.
; @proc dev_out
; @param %vec:u16  hl
; @param %char:u8  c
; @clobbers af,bc,de,hl,ix
; @end
dev_out:
    ld a, h
    and 0x80                       ; CON is bit 15 of the vector
    ret z                          ; not assigned to CON: drop it
    ld a, %char
    jp scr_putchar


