; ==========================================================================
; CP/M 3.1 Screen Driver for ZX Spectrum +3
; ==========================================================================
;
; Three text modes, all 24 rows (24 x 8 = 192 pixels, exact Spectrum height):
;
;   51 x 24   5-pixel font, 255 pixels.  Characters are NOT byte-aligned: a
;             glyph at column C starts at pixel C*5 and may straddle two
;             screen bytes, so the renderer has eight shift variants.
;   32 x 24   8-pixel font, 256 pixels, byte-aligned, one byte per glyph row.
;   64 x 24   4-pixel font ("Compression"), 64*4 = 256 pixels exactly.  A
;             glyph lives in one nibble of one byte, so it never spills and
;             consecutive characters need no shifting - the cheapest path.
;
; Spectrum screen address:  010 TT SSS RRR CCCCC
;   TT    = screen third (0-2)
;   SSS   = pixel row within char cell (0-7)
;   RRR   = char row within third (0-7)
;   CCCCC = byte column (0-31)
; Advancing scan lines within a char cell: INC H (increments SSS).
;
; ==========================================================================
;
; REGISTER CLOBBERING RULES
; =========================
; Every routine documents:  In:, Out:, Clobbers:
; "Clobbers" means the register is DESTROYED on return.
; Callers MUST save any listed clobbered register they need.
;
; _page_in and _page_out clobber AF and BC.
; _cursor_buf_addr clobbers AF, DE, HL.
; _render_char clobbers AF, BC, DE, HL, IX.
;
; ==========================================================================

; --- Constants ---
SCR_COLS_MAX equ 64            ; Largest mode (64x4 = 256 pixels)
SCR_ROWS    equ 24
SCR_BASE    equ 0x4000
SCR_ATTR    equ 0x5800

; --- Escape-sequence state constants ---
ESC_NORMAL     equ 0   ; no pending ESC
ESC_SAW_ESC    equ 1   ; received 0x1B, next byte is command
ESC_WAIT_Y_ROW equ 2   ; ESC Y: waiting for row param (+32)
ESC_WAIT_Y_COL equ 3   ; ESC Y: got row, waiting for col param (+32)
ESC_WAIT_X_TR  equ 4   ; ESC X: waiting for top-row param (+32)
ESC_WAIT_X_LC  equ 5   ; ESC X: got tr, waiting for left-col (+32)
ESC_WAIT_X_H   equ 6   ; ESC X: got lc, waiting for height (+32)
ESC_WAIT_X_W   equ 7   ; ESC X: got h, waiting for width (+32) — last param
ESC_WAIT_1P    equ 8   ; one-param stub: ESC b/c/2/3/4/5 — consume and ignore

; PORT_1FFD, PORT_ULA, BANK1_1FFD, motor_flag defined in parent/common

PAGING_SCREEN equ 0x05         ; Mode 2 (4,5,6,3) — bank 5 at 0x4000

DEFAULT_ATTR equ 0x0F          ; Blue paper, white ink
BORDER_COL   equ 1             ; Blue


; ==========================================================================
; Variables (in system bank — only accessed during BDOS/BIOS calls)
; ==========================================================================

; Cursor/render scratch lives in bank 6 (A730-A732), outside the image;
; scr_init establishes the cursor values.
cursor_col: equ 0xA730         ; 0-50
cursor_row: equ 0xA731         ; 0-23
_rnd_row:   equ 0xA732         ; Row for current render (saved here
                               ; because we run out of registers)

; --- Escape-sequence parser state ---
; Scratch only; lives in bank 6 (A730-A738) outside the image.
esc_state:  equ 0xA733         ; Current parser state (ESC_*)
esc_cmd:    equ 0xA734         ; Command byte for parameterised ESC
esc_p1:     equ 0xA735         ; First param byte (e.g. Y row, X top)
esc_p2:     equ 0xA736         ; Second param byte
esc_p3:     equ 0xA737         ; Third param byte
saved_row:  equ 0xA738         ; Saved cursor row  (ESC j / ESC k)
saved_col:  equ 0xA739         ; Saved cursor col  (ESC j / ESC k)

; --- Viewport (ESC X) ---
; The cursor is stored relative to the viewport; buffer/screen accesses add
; vp_top/vp_left.  The whole-screen defaults are set by scr_init.
vp_top:     equ 0xA73A         ; viewport top row, absolute
vp_left:    equ 0xA73B         ; viewport left column, absolute
vp_height:  equ 0xA73C         ; viewport rows (1..24)
vp_width:   equ 0xA73D         ; viewport columns (1..scr_cols)
vp_tmp_row: equ 0xA73E         ; ESC X: cursor's old absolute row
vp_tmp_col: equ 0xA73F         ; ESC X: cursor's old absolute column

; --- Status line (ESC 0/1, TE_STL_ON_OFF) ---
; 0 = off (24 text rows), 1 = on (23 text rows + status row 23).
; Stored in the free bank-6 gap at A8C0, outside the image.
stl_on:     equ 0xA8C0

; --- 24x80 mode (bank 6, outside the image) ---
; mode80   : 0 = physical screen, 1 = 80-column logical screen
; lg_off   : first logical column shown on the physical screen
; lg_auto  : 1 = follow the cursor (ESC 5 1), 0 = manual only (ESC 5 0)
; lg_step  : logical columns between pages (32->24, 51->29, 64->16)
; lg_savecols: physical width to restore when leaving 24x80
mode80:      equ 0xA8C1
lg_off:      equ 0xA8C2
lg_auto:     equ 0xA8C3
lg_step:     equ 0xA8C4
lg_savecols: equ 0xA8C5
lg_char:     equ 0xA8C6
lg_vis:      equ 0xA8C7
lg_row:      equ 0xA8C8
lg_col:      equ 0xA8C9
lg_src:      equ 0xA8CA
lg_dst:      equ 0xA8CC
lg_loop:     equ 0xA8CE
lg_loop2:    equ 0xA8CF
lg_old:      equ 0xA8D0
lg_delta:    equ 0xA8D1
lg_dir:      equ 0xA8D2
lg_dcount:   equ 0xA8D3
lg_bytes:    equ 0xA8D4
lg_bits:     equ 0xA8D5
lg_ptr:      equ 0xA8D6
lg_first:    equ 0xA8D8
LG_BUF       equ 0x5B00         ; 80*24 bytes in bank 5, after the attributes

; --- XBIOS colour state ---
scr_ink:      db 7             ; Ink colour 0-7 (Spectrum GRB)
scr_paper:    db 1             ; Paper colour 0-7
scr_ink_br:   db 0             ; Ink bright: 0 or 1
scr_paper_br: db 0             ; Paper bright: 0 or 1
scr_ink_fl:   db 0             ; Ink flashing: 0 = steady, 1 = flash
scr_paper_fl: db 0             ; Paper flashing: 0 = steady, 1 = flash
scr_flash:    db 0             ; Computed FLASH attribute bit: 0x00 or 0x80
scr_attr:     db DEFAULT_ATTR  ; Computed attribute byte (F B PPP III)
scr_border_v: db BORDER_COL    ; Current border colour 0-7
scr_cols:     db 51            ; Runtime column count (32, 51 or 64)
scr_wrap:     db 1             ; 1 = wrap at the right edge (ESC v/w)
font_ptr:     dw 0x8000       ; Active font in bank 6 (8000=51col, 8800=32col, 9400=64col)

; The character buffer and row table are runtime-initialised and are not
; stored in CPM3.SYS.  Bank 6 is mapped at 8000h in both system mode
; (4,7,6,3) and screen mode (4,5,6,3).  Fonts occupy 8000h-8FFFh (51/32) and
; 9400h-9BFFh (64), the optional RAMDISK.FID starts at 9000h, and the FDC
; deblock buffer lives at 9C00h, so the text buffers start at A000h.
char_buffer equ 0xA000

; Row -> char_buffer offset table. Populated by scr_init from scr_cols.
; 24 words: row_buf_tbl[r] = r * scr_cols. Replaces iterative multiply.
row_buf_tbl equ 0xA700


; ==========================================================================
; scr_init — Clear screen, set attributes, reset cursor
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc scr_init
; @clobbers af,bc,de,hl
; @end
scr_init:
    ; A size change cancels any escape sequence in progress.
    xor a
    ld (esc_state), a
    ; A mode change resets the viewport to the whole screen, minus the
    ; status row when it is enabled.
    ld (vp_top), a
    ld (vp_left), a
    ld a, (stl_on)
    ld b, a
    ld a, SCR_ROWS
    sub b
    ld (vp_height), a
    ld a, (scr_cols)
    ld (vp_width), a
    xor a
    ; Build row_buf_tbl[r] = r * scr_cols for r in 0..SCR_ROWS-1
    ld hl, row_buf_tbl
    ld a, (scr_cols)
    ld c, a
    ld b, 0                    ; BC = scr_cols increment
    ld de, 0                   ; DE = running sum
    ld a, SCR_ROWS
.rbt_loop:
    ld (hl), e
    inc hl
    ld (hl), d
    inc hl
    ex de, hl
    add hl, bc                 ; sum += scr_cols
    ex de, hl
    dec a
    jr nz, .rbt_loop

    ld hl, char_buffer
    ld de, char_buffer + 1
    ld (hl), 0x20
    ld bc, SCR_COLS_MAX * SCR_ROWS - 1
    ldir

    xor a
    ld (cursor_col), a
    ld (cursor_row), a

    ld a, BORDER_COL
    out (PORT_ULA), a

    call _page_in              ; Clobbers AF, BC

    ld hl, SCR_BASE
    ld de, SCR_BASE + 1
    ld (hl), 0
    ld bc, 6143
    ldir

    ld a, (scr_attr)
    ld hl, SCR_ATTR
    ld de, SCR_ATTR + 1
    ld (hl), a
    ld bc, 767
    ldir

    ld a, (mode80)
    or a
    jr z, .si_no_lg
    call _lg_clear_all
.si_no_lg:
    call _page_out             ; Clobbers AF, BC
    ret


; ==========================================================================
; scr_reset — Re-initialise the terminal emulator
;   Restores the default palette and wrap/page state, then clears the
;   screen and homes the cursor.  The screen width (scr_cols) is a mode
;   choice, not terminal state, so it is left alone.
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc scr_reset
; @clobbers af,bc,de,hl
; @end
scr_reset:
    xor a
    ld (scr_ink_br), a
    ld (scr_paper_br), a
    ld (scr_ink_fl), a
    ld (scr_paper_fl), a
    ld (scr_flash), a
    ld (saved_row), a
    ld (saved_col), a

    ld a, 7
    ld (scr_ink), a
    ld a, 1
    ld (scr_paper), a
    ld a, DEFAULT_ATTR
    ld (scr_attr), a
    ld a, BORDER_COL
    ld (scr_border_v), a
    ld a, 1
    ld (scr_wrap), a

    call _cancel_paging
    call scr_init
    ret


; ==========================================================================
; scr_putchar — Output character at cursor, advance cursor
;   In:      A = character
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX, IY
; ==========================================================================
; @proc scr_putchar
; @param %ch:u8 a
; @clobbers af,bc,de,hl,ix,iy
; @end
scr_putchar:
    ; lint-exempt: stack  ; ESC-dispatch table uses jp (hl) to reach handlers
    ; ----- Escape-sequence state machine -----
    push af                    ; save char while we check state
    ld a, (esc_state)
    or a
    jr z, .esc_normal          ; state 0 → normal char dispatch
    cp ESC_SAW_ESC
    jp z, .esc_dispatch        ; state 1 → decode command char
    cp ESC_WAIT_Y_ROW
    jp z, .esc_y_row
    cp ESC_WAIT_Y_COL
    jp z, .esc_y_col
    cp ESC_WAIT_X_TR
    jp z, .esc_x_tr
    cp ESC_WAIT_X_LC
    jp z, .esc_x_lc
    cp ESC_WAIT_X_H
    jp z, .esc_x_h
    cp ESC_WAIT_X_W
    jp z, .esc_x_w
    ; ESC_WAIT_1P — consume the parameter and apply one-param commands
    pop af                     ; A = parameter byte
    ld b, a
    ld a, (esc_cmd)
    cp '3'
    jp z, .esc_p3              ; screen size
    cp '4'
    jp z, .esc_p4              ; page mode
    cp '5'
    jp z, .esc_p5              ; 24x80 auto-flip
    cp 'b'
    jp z, .esc_pb              ; foreground colour
    cp 'c'
    jp z, .esc_pc              ; background colour
    ; '2' (national charset) and '5' (24x80 auto-flip) are consumed and
    ; ignored; we have one font and no 24x80 mode.
    xor a
    ld (esc_state), a
    ret

.esc_normal:
    pop af                     ; restore char for normal dispatch
    cp 0x1B
    jr z, .enter_esc
    cp 0x0D
    jp z, _do_cr
    cp 0x0A
    jp z, _do_lf
    cp 0x08
    jp z, _do_bs
    cp 0x09
    jp z, _do_tab
    cp 0x07
    ret z                      ; BEL — ignore
    cp 0x20
    ret c                      ; Other control chars — ignore

    ; --- Printable character ---
    ld b, a
    ld a, (mode80)
    or a
    ld a, b
    jp nz, _put80

    push af                    ; Save char (in A)

    ; Write to buffer
    call _cursor_buf_addr      ; Clobbers AF, DE, HL → HL = buf addr
    pop af                     ; Restore char
    ld (hl), a                 ; Store in buffer

    ; Render to screen
    push af                    ; Save char again
    call _page_in              ; Clobbers AF, BC
    pop af                     ; A = char

    ; Set up args for _render_char: B=char, C=abs col, D=abs row
    ld b, a                    ; B = char (preserved by _abs_cursor)
    call _abs_cursor           ; C = vp_left+col, D = vp_top+row
    call _render_char          ; Clobbers AF, BC, DE, HL, IX
    call _page_out             ; Clobbers AF, BC

    ; Advance cursor (wrap or clamp, per ESC v/w)
    jp _adv_col

.enter_esc:
    ; Received 0x1B — enter ESC state
    ld a, ESC_SAW_ESC
    ld (esc_state), a
    ret

; ------------------------------------------------------------------
; State 1: received ESC, A = command char (on stack → pop first)
; ------------------------------------------------------------------
.esc_dispatch:
    pop af                     ; A = command char
    ld b, a                    ; save command in B
    xor a
    ld (esc_state), a          ; default: return to NORMAL

    ; --- No-param sequences ---
    ld hl, .esc_table
    ; Walk table: pairs of (char, target_lo, target_hi) — terminated by 0
.tbl_loop:
    ld a, (hl)
    or a
    jr z, .esc_unknown         ; end of table
    cp b
    jr z, .tbl_found
    inc hl
    inc hl
    inc hl
    jr .tbl_loop
.tbl_found:
    inc hl
    ld e, (hl)
    inc hl
    ld d, (hl)
    ex de, hl
    jp (hl)                    ; jump to handler

.esc_unknown:
    ; Unknown ESC char — display it as a literal character (per manual)
    ld a, b                    ; recover command char
    cp 0x20
    ret c                      ; skip non-printable unknowns
    ; Treat as printable: write to buffer + render, advance cursor
    push af
    call _cursor_buf_addr
    pop af
    ld (hl), a
    push af
    call _page_in
    pop af
    ld b, a
    call _abs_cursor
    call _render_char
    call _page_out
    ; Advance cursor (wrap or clamp, per ESC v/w)
    jp _adv_col

; Jump table: byte cmd, word target (little-endian)
.esc_table:
    db 'A'
    dw .esc_A
    db 'B'
    dw .esc_B
    db 'C'
    dw .esc_C
    db 'D'
    dw .esc_D
    db 'E'
    dw .esc_E
    db 'H'
    dw .esc_H
    db 'I'
    dw .esc_I
    db 'J'
    dw .esc_J
    db 'K'
    dw .esc_K
    db 'L'
    dw .esc_L
    db 'M'
    dw .esc_M
    db 'N'
    dw .esc_N
    db 'Y'
    dw .esc_Y_start
    db '='
    dw .esc_Y_start     ; ADM-3A / Kaypro: absolute cursor position
    db '+'
    dw .esc_H           ; ADM-3A / Kaypro: cursor home
    db '*'
    dw .esc_star        ; ADM-3A / Kaypro: clear screen and home
    db 'T'
    dw .esc_K           ; ADM-3A / Kaypro: erase to end of line
    db 'X'
    dw .esc_X_start
    db '0'
    dw .esc_stl_off     ; status line off
    db '1'
    dw .esc_stl_on      ; status line on
    db '2'
    dw .esc_1p          ; national variant — consume 1 param
    db '3'
    dw .esc_1p          ; screen mode      — consume 1 param
    db '4'
    dw .esc_1p          ; page mode        — consume 1 param
    db '5'
    dw .esc_1p          ; auto-flip        — consume 1 param
    db 'b'
    dw .esc_1p          ; fg colour        — consume 1 param
    db 'c'
    dw .esc_1p          ; bg colour        — consume 1 param
    db 'd'
    dw .esc_d
    db 'e'
    dw .esc_ret         ; cursor on        — ignore
    db 'f'
    dw .esc_ret         ; cursor off       — ignore
    db 'j'
    dw .esc_j
    db 'k'
    dw .esc_k
    db 'l'
    dw .esc_l
    db 'o'
    dw .esc_o
    db 'p'
    dw .esc_ret         ; reverse on       — ignore
    db 'q'
    dw .esc_ret         ; reverse off      — ignore
    db 'r'
    dw .esc_ret         ; underline on     — ignore
    db 'u'
    dw .esc_ret         ; underline off    — ignore
    db 'v'
    dw .esc_v          ; wrap on
    db 'w'
    dw .esc_w          ; wrap off
    db 'x'
    dw _enter80         ; enter 24x80 mode
    db 'y'
    dw _exit80          ; leave 24x80 mode
    db 0                ; end of table

; ------- simple helpers -------
.esc_ret:
    ret

.esc_1p:
    ; Set state to consume one more byte, save cmd in esc_cmd
    ld a, b
    ld (esc_cmd), a
    ld a, ESC_WAIT_1P
    ld (esc_state), a
    ret

; ------- one-parameter sequences (ESC 3 / 4 / b / c) -------

.esc_p3:
    ; ESC 3 n - screen size.  The +3 manual has you type ESC 3 0/1/2, so
    ; the parameter arrives as an ASCII digit (raw 0-2 is accepted too).
    ; Anything else is consumed and ignored: old WordStar Z19 drivers use
    ; ESC 3 / ESC 4 with a space parameter as attribute controls, which
    ; must not resize the screen.
    ld a, b
    cp '0'
    jr c, .p3_raw
    cp '3'
    jr nc, .p3_ignore
    sub '0'
    jr .p3_have
.p3_raw:
    cp 3
    jr nc, .p3_ignore
.p3_have:
    cp 2
    jr z, .p3_80
    cp 1
    ld a, 32
    jr nz, .p3_apply
    ld a, 51
.p3_apply:
    push af
    xor a
    ld (esc_state), a
    ld (mode80), a             ; ESC 3 cancels 24x80
    ld (lg_off), a
    call _cancel_paging
    pop af
    jp scr_set_cols
.p3_80:
    xor a
    ld (esc_state), a
    call _cancel_paging
    jp _enter80

.p3_ignore:
    xor a
    ld (esc_state), a
    ret

.esc_p4:
    ; ESC 4 n - page mode (0 off, 1 on); other parameters are ignored.
    ld a, b
    cp '0'
    jr c, .p4_raw
    cp '2'
    jr nc, .p4_done
    sub '0'
    jr .p4_have
.p4_raw:
    cp 2
    jr nc, .p4_done
.p4_have:
    or a
    jr z, .p4_off
    ld a, (con_mode)
    or 0x01
    ld (con_mode), a
    jr .p4_done
.p4_off:
    ld a, (con_mode)
    and 0xFE
    ld (con_mode), a
.p4_done:
    xor a
    ld (esc_state), a
    ret

.esc_p5:
    ; ESC 5 n - auto-flip in 24x80 mode: 0 disables, 1 enables.
    ld a, b
    cp '0'
    jr c, .p5_raw
    cp '2'
    jr nc, .p5_done
    sub '0'
    jr .p5_have
.p5_raw:
    cp 2
    jr nc, .p5_done
.p5_have:
    ld (lg_auto), a
    xor a
    ld (esc_state), a
    ld a, (lg_auto)
    or a
    ret z
    jp _lg_autoflip
.p5_done:
    xor a
    ld (esc_state), a
    ret

.esc_pb:
    ; ESC b c - foreground colour
    ld a, b
    call _decode_colour
    ld a, b
    ld (scr_ink), a
    ld a, c
    ld (scr_ink_br), a
    call _set_attr
    xor a
    ld (esc_state), a
    ret

.esc_pc:
    ; ESC c c - background colour; the border follows the paper
    ld a, b
    call _decode_colour
    ld a, b
    ld (scr_paper), a
    ld (scr_border_v), a
    out (PORT_ULA), a
    ld a, c
    ld (scr_paper_br), a
    call _set_attr
    xor a
    ld (esc_state), a
    ret

.esc_v:
    ; ESC v - wrap at the right edge
    ld a, 1
    ld (scr_wrap), a
    ret

.esc_w:
    ; ESC w - no wrap: the last column is overwritten
    xor a
    ld (scr_wrap), a
    ret

; ------- status line (ESC 0 / ESC 1) -------
.esc_stl_off:
    xor a
    jp _stl_apply

.esc_stl_on:
    ld a, 1
    jp _stl_apply

; ------- cursor movement -------
.esc_A:
    ; Cursor up (stop at row 0)
    ld a, (cursor_row)
    or a
    ret z
    dec a
    ld (cursor_row), a
    ret

.esc_B:
    ; Cursor down (stop at bottom of the viewport)
    ld a, (vp_height)
    dec a
    ld b, a
    ld a, (cursor_row)
    cp b
    ret z
    inc a
    ld (cursor_row), a
    ret

.esc_C:
    ; Cursor right (stop at right edge of the logical screen)
    call _lg_width
    dec a
    ld b, a
    ld a, (cursor_col)
    cp b
    ret z
    inc a
    ld (cursor_col), a
    jp _lg_autoflip

.esc_D:
    ; Cursor left (stop at column 0)
    ld a, (cursor_col)
    or a
    ret z
    dec a
    ld (cursor_col), a
    jp _lg_autoflip

.esc_H:
    ; Home cursor
    xor a
    ld (cursor_col), a
    ld (cursor_row), a
    jp _lg_autoflip

.esc_star:
    ; ADM-3A / Kaypro: clear the screen and home the cursor
    call _clear_screen
    xor a
    ld (cursor_col), a
    ld (cursor_row), a
    ret

.esc_I:
    ; Reverse index: cursor up; if already at row 0, scroll DOWN
    ld a, (cursor_row)
    or a
    jr z, .do_scroll_down
    dec a
    ld (cursor_row), a
    ret
.do_scroll_down:
    call _scroll_down
    ret

; ------- clear operations -------
.esc_E:
    ; Clear the viewport, cursor unchanged
    call _clear_viewport
    ret

.esc_J:
    ; Erase from cursor to the bottom of the viewport (inclusive).
    call _erase_line_from_cursor
    ld a, (cursor_row)
    ld b, a
    ld a, (vp_height)
    dec a                      ; last relative row
    sub b                      ; full rows below the cursor
    ret z
    ld b, a                    ; loop count
    ld a, (vp_top)
    ld c, a
    ld a, (cursor_row)
    add a, c
    inc a                      ; first absolute row below
    ld (_vp_row_ctr), a
.esc_J_loop:
    push bc
    ld a, (_vp_row_ctr)
    call _clear_vp_row_a
    pop bc
    ld a, (_vp_row_ctr)
    inc a
    ld (_vp_row_ctr), a
    djnz .esc_J_loop
    ret

.esc_K:
    ; Erase from cursor to end of line (inclusive)
    call _erase_line_from_cursor
    ret

.esc_d:
    ; Erase from the top of the viewport to the cursor (inclusive).
    ld a, (cursor_row)
    or a
    jr z, .esc_d_cur           ; cursor on the first viewport row
    ld b, a                    ; full rows above the cursor
    ld a, (vp_top)
    ld (_vp_row_ctr), a
.esc_d_loop:
    push bc
    ld a, (_vp_row_ctr)
    call _clear_vp_row_a
    pop bc
    ld a, (_vp_row_ctr)
    inc a
    ld (_vp_row_ctr), a
    djnz .esc_d_loop
.esc_d_cur:
    ; Erase the cursor row from the viewport's left edge to the cursor
    call _erase_line_to_cursor
    ret

.esc_l:
    ; Erase the current line inside the viewport
    ld a, (vp_top)
    ld b, a
    ld a, (cursor_row)
    add a, b
    call _clear_vp_row_a
    ret

.esc_o:
    ; Erase from start of line to cursor (inclusive)
    call _erase_line_to_cursor
    ret

; ------- line operations -------
.esc_L:
    ; Insert line at cursor row: push cursor row and below DOWN by one,
    ; losing the last row; cursor row becomes blank
    call _insert_line
    ret

.esc_M:
    ; Delete cursor row: pull rows below UP, blank last row
    call _delete_line
    ret

.esc_N:
    ; Delete char under cursor; shift rest of row left; fill last col space
    call _delete_char
    ret

; ------- save / restore cursor -------
.esc_j:
    ld a, (cursor_row)
    ld (saved_row), a
    ld a, (cursor_col)
    ld (saved_col), a
    ret

.esc_k:
    ld a, (saved_row)
    ld (cursor_row), a
    ld a, (saved_col)
    ld (cursor_col), a
    ret

; ------- ESC Y: absolute cursor position (2 params) -------
.esc_Y_start:
    ; Record that we're waiting for row param
    ld a, ESC_WAIT_Y_ROW
    ld (esc_state), a
    ret

.esc_y_row:
    ; A still on stack from putchar entry; pop it, subtract 32, clamp
    pop af                     ; A = row param byte
    sub 0x20                   ; subtract offset
    jr nc, .yr_ok
    xor a
.yr_ok:
    ld b, a
    ld a, (vp_height)
    cp b                       ; carry set if height <= row (clamp needed)
    jr z, .yr_clamp
    jr c, .yr_clamp
    ld a, b
    jr .yr_store
.yr_clamp:
    dec a                      ; height - 1
.yr_store:
    ld (esc_p1), a
    ld a, ESC_WAIT_Y_COL
    ld (esc_state), a
    ret

.esc_y_col:
    pop af                     ; A = col param byte
    sub 0x20
    jr nc, .yc_ok
    xor a
.yc_ok:
    ld b, a                    ; B = decoded col
    call _lg_width
    cp b                       ; carry set if width <= col (clamp needed)
    jr z, .yc_clamp
    jr c, .yc_clamp
    ld a, b                    ; A = decoded col (valid)
    jr .yc_store
.yc_clamp:
    dec a                      ; width - 1
.yc_store:
    ld (cursor_col), a
    ld a, (esc_p1)
    ld (cursor_row), a
    xor a
    ld (esc_state), a
    jp _lg_autoflip

; ------- ESC X: set viewport (4 params) -------
; ESC X tr lc h w, all + 32.  tr/lc are absolute screen coordinates; h/w
; are height/width minus 1.  The cursor is moved if it falls outside.
.esc_X_start:
    ; Remember the cursor's absolute position before the viewport changes
    ld a, (vp_top)
    ld b, a
    ld a, (cursor_row)
    add a, b
    ld (vp_tmp_row), a
    ld a, (vp_left)
    ld b, a
    ld a, (cursor_col)
    add a, b
    ld (vp_tmp_col), a
    ld a, ESC_WAIT_X_TR
    ld (esc_state), a
    ret

.esc_x_tr:
    pop af
    sub 0x20
    jr nc, .xt_ok
    xor a
.xt_ok:
    ld (esc_p1), a
    ld a, ESC_WAIT_X_LC
    ld (esc_state), a
    ret

.esc_x_lc:
    pop af
    sub 0x20
    jr nc, .xl_ok
    xor a
.xl_ok:
    ld (esc_p2), a
    ld a, ESC_WAIT_X_H
    ld (esc_state), a
    ret

.esc_x_h:
    pop af
    sub 0x20
    jr nc, .xh_ok
    xor a
.xh_ok:
    inc a                       ; height = h + 1
    ld b, a
    ld a, SCR_ROWS
    cp b
    jr c, .xh_clamp             ; height > SCR_ROWS
    ld a, b                     ; height <= SCR_ROWS
    jr .xh_have
.xh_clamp:
    ld a, SCR_ROWS
.xh_have:
    ld (vp_height), a
    ld a, ESC_WAIT_X_W
    ld (esc_state), a
    ret

.esc_x_w:
    pop af
    sub 0x20
    jr nc, .xw_ok
    xor a
.xw_ok:
    inc a                       ; width = w + 1
    ld b, a
    ld a, (scr_cols)
    cp b
    jr c, .xw_clamp             ; width > scr_cols
    ld a, b                     ; width <= scr_cols
    jr .xw_have
.xw_clamp:
    ld a, (scr_cols)
.xw_have:
    ld (vp_width), a

    ; top = min(tr, SCR_ROWS - height)
    ld a, (esc_p1)
    ld b, a
    ld a, SCR_ROWS
    ld c, a
    ld a, (vp_height)
    ld e, a
    ld a, c
    sub e                       ; SCR_ROWS - height
    ld c, a
    ld a, b
    cp c
    jr c, .xt_store
    jr z, .xt_store
    ld a, c
.xt_store:
    ld (vp_top), a

    ; left = min(lc, scr_cols - width)
    ld a, (esc_p2)
    ld b, a
    ld a, (scr_cols)
    ld c, a
    ld a, (vp_width)
    ld e, a
    ld a, c
    sub e
    ld c, a
    ld a, b
    cp c
    jr c, .xl_store
    jr z, .xl_store
    ld a, c
.xl_store:
    ld (vp_left), a

    ; --- move the cursor into the new viewport if necessary ---
    ; row: rel = abs - top, clamped to height-1
    ld a, (vp_tmp_row)
    ld b, a
    ld a, (vp_top)
    ld c, a
    ld a, b
    cp c
    jr c, .xcr_zero
    sub c
    ld b, a
    ld a, (vp_height)
    cp b
    jr c, .xcr_max
    jr z, .xcr_max
    ld a, b
    jr .xcr_store
.xcr_max:
    ld a, (vp_height)
    dec a
    jr .xcr_store
.xcr_zero:
    xor a
.xcr_store:
    ld (cursor_row), a

    ; column: rel = abs - left, clamped to width-1
    ld a, (vp_tmp_col)
    ld b, a
    ld a, (vp_left)
    ld c, a
    ld a, b
    cp c
    jr c, .xcc_zero
    sub c
    ld b, a
    ld a, (vp_width)
    cp b
    jr c, .xcc_max
    jr z, .xcc_max
    ld a, b
    jr .xcc_store
.xcc_max:
    ld a, (vp_width)
    dec a
    jr .xcc_store
.xcc_zero:
    xor a
.xcc_store:
    ld (cursor_col), a

    xor a
    ld (esc_state), a
    ret


; ==========================================================================
; _decode_colour - Decode an ESC b/c colour parameter
;   In:  A = parameter byte (32..95, per the +3 CP/M manual)
;   Out: B = Spectrum colour 0-7 (bit0 blue, bit1 red, bit2 green)
;        C = bright flag 0 or 1
;   Clobbers: AF, DE
; ==========================================================================
; @proc _decode_colour
; @param %param:u8 a
; @out   bc
; @clobbers af,de
; @end
_decode_colour:
    sub 32
    and 0x3F
    ; fall through

; _decode_te_colour — Decode a +3 palette byte (0..3F)
;   Each pair of bits is one gun: 00 off, 01/10 on normal, 11 on high.
;   The Spectrum colour index takes the gun on/off state; the bright flag
;   is set only when every enabled gun is high.
; @proc _decode_te_colour
; @param %colour:u8 a
; @out   bc
; @clobbers af,de
; @end
_decode_te_colour:
    ld e, a

    ; Colour index: bit0 blue, bit1 red, bit2 green.  A gun is on for
    ; pair values 1, 2 or 3, so test the whole pair, not just one bit.
    xor a
    ld b, a
    ld a, e
    and 0x03
    jr z, .dtc_red
    set 0, b                   ; blue
.dtc_red:
    ld a, e
    and 0x0C
    jr z, .dtc_green
    set 1, b                   ; red
.dtc_green:
    ld a, e
    and 0x30
    jr z, .dtc_bright
    set 2, b                   ; green
.dtc_bright:
    ; Bright only when no gun is 01 or 10: XOR each pair's two bits.
    ld a, e
    ld d, a
    srl a
    xor d
    and 0x15                   ; blue bit0, red bit2, green bit4
    jr nz, .dtc_normal
    ld a, e
    and 0x15                   ; all guns off (black) is not bright
    jr z, .dtc_normal
    ld c, 1
    ret
.dtc_normal:
    ld c, 0
    ret


; ==========================================================================
; _set_attr - Recompute scr_attr from the ink/paper/bright state
;   Both colours must be bright for the BRIGHT attribute to be set,
;   matching the +3's "mix normal with bright and both stay normal".
;   Clobbers: AF, B
; ==========================================================================
; @proc _set_attr
; @clobbers af,b
; @end
_set_attr:
    ld a, (scr_ink_br)
    and a
    jr z, .sa_nobr
    ld a, (scr_paper_br)
    and a
    jr z, .sa_nobr
    ld a, 0x40
    jr .sa_have
.sa_nobr:
    xor a
.sa_have:
    ld b, a

    ; FLASH only when both inks have a different flash colour.  Hardware
    ; then alternates the whole cell between ink and paper.
    xor a
    ld (scr_flash), a
    ld a, (scr_ink_fl)
    and a
    jr z, .sa_noflash
    ld a, (scr_paper_fl)
    and a
    jr z, .sa_noflash
    ld a, 0x80
    ld (scr_flash), a
    or b
    ld b, a
.sa_noflash:
    ld a, (scr_paper)
    and 0x07
    add a, a
    add a, a
    add a, a
    or b
    ld b, a
    ld a, (scr_ink)
    and 0x07
    or b
    ld (scr_attr), a
    ret


; ==========================================================================
; _cancel_paging - Clear the BDOS page-mode bit (ESC 3 resets paging)
;   Clobbers: AF
; ==========================================================================
; @proc _cancel_paging
; @clobbers af
; @end
_cancel_paging:
    ld a, (con_mode)
    and 0xFE
    ld (con_mode), a
    ret


; ==========================================================================
; _adv_col - Advance the cursor after a printable character
;   Wraps to the next line when scr_wrap is set; otherwise clamps to
;   the last column so the next character overwrites it.
;   Clobbers: AF, B
; ==========================================================================
; @proc _adv_col
; @clobbers af,bc,de,hl,ix,iy
; @end
_adv_col:
    ld a, (cursor_col)
    inc a
    ld b, a
    call _lg_width
    dec a
    cp b
    jr c, .ac_past
    ; Still inside the row: store the new column.
    ld a, b
    ld (cursor_col), a
    jp _lg_autoflip
.ac_past:
    ld a, (scr_wrap)
    or a
    jr z, .ac_clamp
    xor a
    ld (cursor_col), a
    jp _do_lf
.ac_clamp:
    call _lg_width
    dec a
    ld (cursor_col), a
    jp _lg_autoflip


; ==========================================================================
; _put_attr - Stamp scr_attr into the attribute cell for a character
;   In:  C = column, D = row
;   Clobbers: AF, DE, HL (D is destroyed; callers save the row first)
; ==========================================================================
; @proc _put_attr
; @param %col:u8 c
; @param %row:u8 d
; @clobbers af,de,hl
; @end
_put_attr:
    ld a, d
    ld l, a
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl                 ; row * 32
    ld a, (scr_cols)
    cp 64
    jr z, .pa_64
    cp 32
    ld a, c
    jr z, .pa_32
    ld e, a
    add a, a
    add a, a
    add a, e                   ; col * 5 (51-column font)
    jr .pa_shift
.pa_32:
    add a, a
    add a, a
    add a, a                   ; col * 8 (32-column font)
.pa_shift:
    srl a
    srl a
    srl a                      ; pixel_x / 8
    jr .pa_add
.pa_64:
    ld a, c
    srl a                      ; 4-pixel pitch: two characters per 8x8 cell
.pa_add:
    ld e, a
    ld d, 0
    add hl, de
    ld de, SCR_ATTR
    add hl, de
    ld a, (scr_attr)
    ld (hl), a
    ret


; ==========================================================================
; _do_cr — Carriage return: cursor to column 0
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF
; ==========================================================================
; @proc _do_cr
; @clobbers af,bc,de,hl,ix
; @end
_do_cr:
    xor a
    ld (cursor_col), a
    jp _lg_autoflip


; ==========================================================================
; _do_tab - Advance to the next 8-column tab stop, padding with spaces
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _do_tab
; @clobbers af,bc,de,hl,ix
; @end
_do_tab:
    ld a, ' '
    call scr_putchar
    ld a, (cursor_col)
    and 0x07
    jr nz, _do_tab
    ret


; ==========================================================================
; _do_lf — Line feed: cursor down one row, scroll if needed
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX, IY
; ==========================================================================
; @proc _do_lf
; @clobbers af,bc,de,hl,ix,iy
; @end
_do_lf:
    ld a, (cursor_row)
    inc a
    ld b, a
    ld a, (vp_height)
    cp b
    jr nz, .lf_inside
    call _scroll_up            ; Clobbers AF, BC, DE, HL, IX, IY
    ld a, (vp_height)
    dec a
    jr .lf_store
.lf_inside:
    ld a, b                    ; new row is inside the viewport
.lf_store:
    ld (cursor_row), a
    ret


; ==========================================================================
; _do_bs — Backspace: move cursor left, erase character
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _do_bs
; @clobbers af,bc,de,hl,ix
; @end
_do_bs:
    ld a, (cursor_col)
    or a
    jr nz, .back_in_row
    ; col 0: wrap to end of previous row so BDOS fn 10 can
    ; backspace through a line that auto-wrapped during entry.
    ; ESC w (no wrap) keeps the cursor on the top-left cell.
    ld a, (scr_wrap)
    or a
    ret z
    ld a, (cursor_row)
    or a
    ret z                      ; (0,0) — nothing left to back over
    dec a
    ld (cursor_row), a
    call _lg_width             ; col = width; dec below → width-1
.back_in_row:
    dec a
    ld (cursor_col), a

    ld a, (mode80)
    or a
    jr nz, .bs80

    ; Put space in buffer at new cursor position
    call _cursor_buf_addr      ; Clobbers AF, DE, HL → HL = addr
    ld (hl), 0x20

    ; Render space to screen
    call _page_in              ; Clobbers AF, BC
    ld b, 0x20                 ; B = space
    call _abs_cursor           ; C = abs col, D = abs row
    call _render_char          ; Clobbers AF, BC, DE, HL, IX
    call _page_out             ; Clobbers AF, BC
    ret
.bs80:
    ld a, ' '
    call _lg_store_char
    jp _lg_autoflip


; ==========================================================================
; scr_status — Console output ready status
;   In:      nothing
;   Out:     A = 0xFF (always ready)
;   Clobbers: (none besides A)
; ==========================================================================
; @proc scr_status
; @out   a
; @clobbers
; @end
scr_status:
    ld a, 0xFF
    ret


; ==========================================================================
; _page_in — Page in screen bank (mode 2: 4,5,6,3)
;   In:      nothing (system mode 3 active, interrupts already disabled)
;   Out:     nothing
;   Clobbers: AF, BC
; ==========================================================================
; @proc _page_in
; @clobbers af,bc
; @end
_page_in:
    ld a, (motor_flag)         ; Preserve motor state
    or PAGING_SCREEN           ; Mode 2 (4,5,6,3)
    jp write_1ffd              ; Tail-call (updates shadow too)


; ==========================================================================
; _page_out — Restore system bank (mode 3: 4,7,6,3)
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC
; ==========================================================================
; @proc _page_out
; @clobbers af,bc
; @end
_page_out:
    ld a, (motor_flag)         ; Preserve motor state
    or BANK1_1FFD              ; Mode 3 (4,7,6,3)
    jp write_1ffd              ; Tail-call (updates shadow too)


; ==========================================================================
; _cursor_buf_addr — Buffer address for current cursor position
;   In:      cursor_col, cursor_row (memory)
;   Out:     HL = &char_buffer[cursor_row * scr_cols + cursor_col]
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc _cursor_buf_addr
; @out   hl
; @clobbers af,bc,de,hl
; @end
_cursor_buf_addr:
    ld a, (vp_top)             ; absolute row = vp_top + cursor_row
    ld b, a
    ld a, (cursor_row)
    add a, b
    call _mul_row_scr_cols     ; HL = row * scr_cols
    ld a, (vp_left)            ; absolute col = vp_left + cursor_col
    ld b, a
    ld a, (cursor_col)
    add a, b
    ld e, a
    ld d, 0
    add hl, de                 ; HL += col
    ld de, char_buffer
    add hl, de
    ret


; ==========================================================================
; _abs_cursor - Map the viewport-relative cursor to screen coordinates
;   Out:     C = vp_left + cursor_col, D = vp_top + cursor_row
;   Clobbers: AF, B
; ==========================================================================
; @proc _abs_cursor
; @out   c
; @out   d
; @clobbers af,e
; @end
_abs_cursor:
    ld a, (cursor_col)
    ld e, a
    ld a, (vp_left)
    add a, e
    ld c, a
    ld a, (cursor_row)
    ld e, a
    ld a, (vp_top)
    add a, e
    ld d, a
    ret


; ==========================================================================
; _stl_apply - Enable or disable the status line
;   In:  A = 0 (off, 24 text rows) / 1 (on, 23 text rows + status row)
;   Enabling clears the bottom row and clamps the cursor into the 23-row
;   viewport; disabling hands the row back to the CRT without clearing it.
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _stl_apply
; @param %on:u8 a
; @clobbers af,bc,de,hl,ix
; @end
_stl_apply:
    and 1
    ld (stl_on), a
    ld b, a
    ld a, SCR_ROWS
    sub b
    ld (vp_height), a
    dec a
    ld b, a
    ld a, (cursor_row)
    cp b
    jr c, .sa_row_ok
    ld a, b
    ld (cursor_row), a
.sa_row_ok:
    jp _stl_draw


; ==========================================================================
; _vp_fast_scroll - Can the fast scroll path handle the current viewport?
;   Out:     Z set when vp_top=0, vp_left=0, vp_width=scr_cols and
;            vp_height >= 2; NZ otherwise
;   Clobbers: AF, B
; ==========================================================================
; @proc _vp_fast_scroll
; @clobbers af,b
; @end
_vp_fast_scroll:
    ld a, (vp_top)
    or a
    ret nz
    ld a, (vp_left)
    or a
    ret nz
    ld a, (vp_width)
    ld b, a
    ld a, (scr_cols)
    cp b
    ret nz
    ld a, (vp_height)
    cp 2
    ret c
    xor a
    ret


; ==========================================================================
; _mul_row_scr_cols - Compute HL = A * scr_cols
;   In:  A = multiplier (row 0-23, or count up to SCR_ROWS)
;   Out: HL = A * scr_cols
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc _mul_row_scr_cols
; @param %n:u8 a
; @out   hl
; @clobbers af,bc,de,hl
; @end
_mul_row_scr_cols:
    add a, a                   ; A = word index (row * 2)
    ld c, a
    ld b, 0
    ld hl, row_buf_tbl
    add hl, bc
    ld a, (hl)
    inc hl
    ld h, (hl)
    ld l, a
    ret


; ==========================================================================
; _render_char — Render one character to the screen bitmap
;   In:      B = character code
;            C = column (0-50)
;            D = row (0-23)
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX
;
;   Screen must be paged in before calling.
;   Uses memory variable _rnd_row as temporary.
;
;   51-col shift dispatch: pixel_x = col*5 gives shift = pixel_x & 7, one
;   of 8 values. Each .shiftN variant unrolls that many right-shifts and
;   uses hard-coded mask constants so the inner scan loop only does the
;   font load, the unrolled shifts, and the screen write. Shifts 0-3 fit
;   the 5-pixel glyph in one byte (no spill); shifts 4-7 always spill
;   into the next byte.
; ==========================================================================
; @proc _render_char
; @param %ch:u8  b
; @param %col:u8 c
; @param %row:u8 d
; @clobbers af,bc,de,hl,ix
; @end
_render_char:
    ; Save row to memory (we'll need D for other things)
    ld a, d
    ld (_rnd_row), a

    ; Stamp the 8x8 attribute cell with the current colours (ESC b/c).
    call _put_attr
    jr _render_char_body

; @proc _render_char_noattr
;   As _render_char, but the caller has already painted this row's
;   attributes.  The 24x80 page flip stamps the whole attribute row in one
;   pass and then draws the exposed cells, so paying _put_attr again for
;   every cell only rewrites the same byte.
; @param %ch:u8  b
; @param %col:u8 c
; @param %row:u8 d
; @clobbers af,bc,de,hl,ix
; @end
_render_char_noattr:
    ld a, d
    ld (_rnd_row), a

_render_char_body:

    ; --- Font data pointer → IX ---
    ; B = char code. HL and DE are free to use.
    ld l, b
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl                ; HL = char × 8
    ld de, (font_ptr)          ; DE = base of active font
    add hl, de                 ; HL = &font[char * 8]
    push hl
    pop ix                     ; IX = font pointer

    ; --- Branch on column mode ---
    ld a, (scr_cols)
    cp 32
    jr z, .render32
    cp 64
    jr z, .render64

    ; --- 51-col path: pixel_x = col * 5, non-byte-aligned ---
    ld a, c
    ld b, a                    ; B = column (temp)
    add a, a                   ; ×2
    add a, a                   ; ×4
    add a, b                   ; ×5 (A = pixel_x, max 250)
    ld c, a                    ; C = pixel_x (save for shift below)
    srl a
    srl a
    srl a                      ; A = pixel_x >> 3 = byte column
    ld b, a                    ; B = byte_col (preserved by _calc_row_addr)
    ld a, c
    and 0x07                   ; A = pixel_x & 7 = shift amount
    ld c, a                    ; C = shift (preserved by _calc_row_addr)

    ; --- Screen base address for (row, scan 0, byte_col) ---
    ld a, (_rnd_row)
    call _calc_row_addr        ; HL = screen addr for (row, byte_col=0, scan 0)
    ld a, b                    ; A = byte_col
    or l
    ld l, a                    ; HL = screen addr for (row, byte_col, scan 0)

    ; --- Dispatch on shift value (0..7) ---
    ld a, c
    or a
    jp z, .shift0
    dec a
    jp z, .shift1
    dec a
    jp z, .shift2
    dec a
    jp z, .shift3
    dec a
    jp z, .shift4
    dec a
    jp z, .shift5
    dec a
    jp z, .shift6
    jp .shift7

.render32:
    ; --- 32-col path: col * 8, byte-aligned, direct write ---
    ; byte_col = column (col*8>>3 = col), shift always 0
    ld a, (_rnd_row)
    call _calc_row_addr        ; HL = screen addr for (row, byte_col=0, scan 0)
    ld a, c                    ; byte_col = column for 8px chars
    or l
    ld l, a

    ; --- Render 8 scan lines (byte-aligned, direct) ---
    ld b, 8
.scan32:
    ld a, (ix)
    inc ix
    ld (hl), a
    inc h                      ; Next scan line
    djnz .scan32

    ret

.render64:
    ; --- 64-col path: 4-pixel pitch, two phases ---
    ; pixel_x = col * 4, so byte_col = col >> 1 and the phase is col & 1:
    ; even columns take the glyph's high nibble, odd columns its low nibble.
    ; A 4-pixel glyph never spills past its byte (16 bits would be needed to
    ; straddle), so this is the simplest and fastest of the three renderers.
    ld a, c
    ld e, a                    ; E = column (preserved by _calc_row_addr)
    srl a
    ld b, a                    ; B = byte_col
    ld a, (_rnd_row)
    call _calc_row_addr        ; HL = screen addr for (row, byte_col=0, scan 0)
    ld a, b
    or l
    ld l, a                    ; HL = screen addr for (row, byte_col, scan 0)
    ld a, e
    and 1
    jr nz, .r64_hi

    ; phase 0: glyph in the high nibble, keep the odd column's pixels
    ld b, 8
.r64_lo_scan:
    ld d, (ix + 0)
    inc ix
    ld a, (hl)
    and 0x0F
    or d
    ld (hl), a
    inc h
    djnz .r64_lo_scan
    ret

.r64_hi:
    ; phase 1: glyph >> 4 into the low nibble, keep the even column's pixels
    ld b, 8
.r64_hi_scan:
    ld d, (ix + 0)
    inc ix
    srl d
    srl d
    srl d
    srl d
    ld a, (hl)
    and 0xF0
    or d
    ld (hl), a
    inc h
    djnz .r64_hi_scan
    ret

; --- Shift-specialised 51-col bodies ---
; Entry: IX = font, HL = screen addr (row, scan 0, byte_col).
; Each body renders 8 scan lines and returns.

; shift=0: pixels in bits 7..3. Mask 0xF8, keep 0x07, no spill.
.shift0:
    ld b, 8
.s0_scan:
    ld d, (ix + 0)
    inc ix
    ld a, (hl)
    and 0x07
    or d
    ld (hl), a
    inc h
    djnz .s0_scan
    ret

; shift=1: pixels in bits 6..2. Mask 0x7C, keep 0x83, no spill.
.shift1:
    ld b, 8
.s1_scan:
    ld d, (ix + 0)
    inc ix
    srl d
    ld a, (hl)
    and 0x83
    or d
    ld (hl), a
    inc h
    djnz .s1_scan
    ret

; shift=2: pixels in bits 5..1. Mask 0x3E, keep 0xC1, no spill.
.shift2:
    ld b, 8
.s2_scan:
    ld d, (ix + 0)
    inc ix
    srl d
    srl d
    ld a, (hl)
    and 0xC1
    or d
    ld (hl), a
    inc h
    djnz .s2_scan
    ret

; shift=3: pixels in bits 4..0. Mask 0x1F, keep 0xE0, no spill.
.shift3:
    ld b, 8
.s3_scan:
    ld d, (ix + 0)
    inc ix
    srl d
    srl d
    srl d
    ld a, (hl)
    and 0xE0
    or d
    ld (hl), a
    inc h
    djnz .s3_scan
    ret

; shift=4: hi mask 0x0F (keep 0xF0), lo mask 0x80 (keep 0x7F).
.shift4:
    ld b, 8
.s4_scan:
    ld d, (ix + 0)
    inc ix
    ld e, 0
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    ld a, (hl)
    and 0xF0
    or d
    ld (hl), a
    inc l
    ld a, (hl)
    and 0x7F
    or e
    ld (hl), a
    dec l
    inc h
    djnz .s4_scan
    ret

; shift=5: hi mask 0x07 (keep 0xF8), lo mask 0xC0 (keep 0x3F).
.shift5:
    ld b, 8
.s5_scan:
    ld d, (ix + 0)
    inc ix
    ld e, 0
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    ld a, (hl)
    and 0xF8
    or d
    ld (hl), a
    inc l
    ld a, (hl)
    and 0x3F
    or e
    ld (hl), a
    dec l
    inc h
    djnz .s5_scan
    ret

; shift=6: hi mask 0x03 (keep 0xFC), lo mask 0xE0 (keep 0x1F).
.shift6:
    ld b, 8
.s6_scan:
    ld d, (ix + 0)
    inc ix
    ld e, 0
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    ld a, (hl)
    and 0xFC
    or d
    ld (hl), a
    inc l
    ld a, (hl)
    and 0x1F
    or e
    ld (hl), a
    dec l
    inc h
    djnz .s6_scan
    ret

; shift=7: hi mask 0x01 (keep 0xFE), lo mask 0xF0 (keep 0x0F).
.shift7:
    ld b, 8
.s7_scan:
    ld d, (ix + 0)
    inc ix
    ld e, 0
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    ld a, (hl)
    and 0xFE
    or d
    ld (hl), a
    inc l
    ld a, (hl)
    and 0x0F
    or e
    ld (hl), a
    dec l
    inc h
    djnz .s7_scan
    ret


; ==========================================================================
; _scroll_up — Scroll screen up by one text row, clear bottom row
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL
;
;   Fast pixel-level scroll: moves screen bitmap up by 8 pixel rows
;   (one character row) using LDIR on each scan line. Handles the
;   Spectrum's interleaved screen layout (thirds + scan lines).
;   Much faster than redrawing all 1224 characters.
; ==========================================================================
; _scroll_up - Scroll screen up by one text row, clear bottom row
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX, IY
;
;   Fast path: moves the viewport bitmap up by 8 pixel rows (one character
;   row) using LDIR on each scan line, and shifts the character/attribute
;   buffers to match.  It requires a viewport anchored at the top-left with
;   the full screen width; anything else falls back to a buffer move plus a
;   whole-screen redraw (_delete_line).
; ==========================================================================
; @proc _scroll_up
; @clobbers af,bc,de,hl,ix,iy
; @end
_scroll_up:
    ld a, (mode80)
    or a
    jr z, _scroll_up_vis
    call _lg_scroll_up
    call _scroll_up_vis
    ld a, (vp_height)
    dec a
    jp _lg_render_row

; @proc _scroll_up_vis
; @clobbers af,bc,de,hl,ix,iy
; @end
_scroll_up_vis:
    call _vp_fast_scroll
    jr z, .su_fast
    ; Partial viewport: deleting the top viewport row is a scroll up
    ; (delete_line blanks the bottom row and redraws the screen).
    ld a, (cursor_row)
    push af
    ld a, (cursor_col)
    push af
    xor a
    ld (cursor_row), a
    call _delete_line
    pop af
    ld (cursor_col), a
    pop af
    ld (cursor_row), a
    ret
.su_fast:
    ; last = vp_height - 1, the row that will be cleared
    ld a, (vp_height)
    dec a
    ld (_scroll_last), a

    ; Buffer: rows 1..last -> 0..last-1
    call _mul_row_scr_cols      ; HL = last * scr_cols (count)
    ld b, h
    ld c, l
    ld hl, char_buffer
    ld a, (scr_cols)
    ld e, a
    ld d, 0
    add hl, de                  ; HL = source (row 1)
    ld de, char_buffer          ; DE = dest (row 0)
    ldir

    ; Clear the last buffer row
    ld a, (_scroll_last)
    call _mul_row_scr_cols
    ld de, char_buffer
    add hl, de
    ld d, h
    ld e, l
    inc de
    ld (hl), 0x20
    ld a, (scr_cols)
    ld c, a
    ld b, 0
    dec bc
    ldir

    ; Pixel scroll: row R+1 -> R for R = 0..last-1
    call _page_in
    xor a
    ld (_scroll_row_ctr), a
.scroll_row:
    ld a, (_scroll_row_ctr)
    call _calc_row_addr         ; HL = dest row, scan 0
    push hl
    ld a, (_scroll_row_ctr)
    inc a
    call _calc_row_addr         ; HL = source row+1, scan 0
    pop de                      ; DE = dest, HL = source
    ld b, 8
.scroll_scan:
    push bc
    push hl
    push de
    ld bc, 32
    ldir
    pop de
    pop hl
    inc h                       ; next scan line
    inc d
    pop bc
    djnz .scroll_scan

    ld a, (_scroll_row_ctr)
    inc a
    ld (_scroll_row_ctr), a
    ld b, a
    ld a, (_scroll_last)
    cp b
    jr z, .su_clear
    jr c, .su_clear
    jr .scroll_row

.su_clear:
    jp _scroll_clear

_scroll_row_ctr: db 0
_scroll_last:    db 0

; Helper: calculate screen address for character row A, scan line 0
;   In:  A = character row (0-23)
;   Out: HL = screen address
;   Clobbers: AF
; @proc _calc_row_addr
; @param %row:u8 a
; @out   hl
; @clobbers af
; @end
_calc_row_addr:
    push de
    add a, a                   ; A = word index (row * 2)
    ld e, a
    ld d, 0
    ld hl, _row_scr_tbl
    add hl, de
    ld a, (hl)
    inc hl
    ld h, (hl)
    ld l, a
    pop de
    ret

_row_scr_tbl equ 0xA890
; The loader stages the 24 words (row -> screen address at scan 0, byte
; column 0) into bank 6 at A890, so they cost no CPM3.SYS image space.
;   H = 0x40 | ((r>>3) << 3),  L = (r & 7) << 5


; ==========================================================================
; _attr_row_offset - Compute the attribute-plane offset of a text row
;   In:  A = row (0-23)
;   Out: HL = row * 32
;   Clobbers: AF, HL
; ==========================================================================
; @proc _attr_row_offset
; @param %row:u8 a
; @out   hl
; @clobbers af,hl
; @end
_attr_row_offset:
    ld l, a
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    ret


; ==========================================================================
; _scroll_clear - Clear the last viewport row (pixels, buffer, attributes)
;   Uses _scroll_last.  Called by _scroll_up after the pixel shift.
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc _scroll_clear
; @clobbers af,bc,de,hl
; @end
_scroll_clear:
    ; Clear the last row's bitmap: 8 scan lines x 32 bytes
    ld a, (_scroll_last)
    call _calc_row_addr
    ld b, 8
.clear_scan:
    push bc
    push hl
    ld d, h
    ld e, l
    inc de
    ld (hl), 0
    ld bc, 31
    ldir
    pop hl
    inc h
    pop bc
    djnz .clear_scan

    ; Attributes: rows 1..last -> 0..last-1, then clear row last
    ld a, (_scroll_last)
    call _attr_row_offset       ; HL = last * 32
    ld b, h
    ld c, l                     ; BC = count
    push bc
    ld hl, SCR_ATTR + 32        ; source: row 1
    ld de, SCR_ATTR             ; dest: row 0
    pop bc
    ldir
    ld a, (_scroll_last)
    call _attr_row_offset
    ld de, SCR_ATTR
    add hl, de                  ; HL = attr row last
    ld d, h
    ld e, l
    inc de
    ld a, (scr_attr)
    ld (hl), a
    ld bc, 31
    ldir

    call _page_out
    ret


; ==========================================================================
; _scroll_down - Scroll screen down one text row; blank top row
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX, IY
;
;   Mirror of _scroll_up.  Same fast/slow split.
; ==========================================================================
; @proc _scroll_down
; @clobbers af,bc,de,hl,ix,iy
; @end
_scroll_down:
    ld a, (mode80)
    or a
    jr z, _scroll_down_vis
    call _lg_scroll_down
    call _scroll_down_vis
    xor a
    jp _lg_render_row

; @proc _scroll_down_vis
; @clobbers af,bc,de,hl,ix,iy
; @end
_scroll_down_vis:
    call _vp_fast_scroll
    jr z, .sd_fast
    ; Partial viewport: inserting a row at the top scrolls down
    ; (insert_line blanks the top row and redraws the screen).
    ld a, (cursor_row)
    push af
    ld a, (cursor_col)
    push af
    xor a
    ld (cursor_row), a
    call _insert_line
    pop af
    ld (cursor_col), a
    pop af
    ld (cursor_row), a
    ret
.sd_fast:
    ; last = vp_height - 1
    ld a, (vp_height)
    dec a
    ld (_scroll_last), a

    ; Buffer: rows 0..last-1 -> 1..last (LDDR)
    call _mul_row_scr_cols      ; HL = last * scr_cols (count)
    ld b, h
    ld c, l
    push bc
    ld de, char_buffer - 1
    add hl, de                  ; HL = source end
    push hl
    ld a, (scr_cols)
    ld e, a
    ld d, 0
    pop hl
    ex de, hl
    add hl, de                  ; HL = dest end (source end + scr_cols)
    ex de, hl                   ; DE = dest end, HL = source end
    pop bc
    lddr

    ; Clear the top buffer row
    ld hl, char_buffer
    ld de, char_buffer + 1
    ld (hl), 0x20
    ld a, (scr_cols)
    ld c, a
    ld b, 0
    dec bc
    ldir

    ; Pixel scroll: row R -> R+1 for R = last-1..0
    call _page_in
    ld a, (_scroll_last)
    dec a
    ld (_scroll_row_ctr), a
.sd_row:
    ld a, (_scroll_row_ctr)
    call _calc_row_addr         ; HL = source row
    push hl
    ld a, (_scroll_row_ctr)
    inc a
    call _calc_row_addr         ; HL = dest row
    pop de                      ; DE = source, HL = dest
    ex de, hl                   ; HL = source, DE = dest
    ld b, 8
.sd_scan:
    push bc
    push hl
    push de
    ld bc, 32
    ldir
    pop de
    pop hl
    inc h
    inc d
    pop bc
    djnz .sd_scan

    ld a, (_scroll_row_ctr)
    or a
    jr z, .sd_done
    dec a
    ld (_scroll_row_ctr), a
    jr .sd_row

.sd_done:
    ; Clear the top row's bitmap
    xor a
    call _calc_row_addr         ; HL = row 0, scan 0
    ld b, 8
.sd_clear_scan:
    push bc
    push hl
    ld d, h
    ld e, l
    inc de
    ld (hl), 0
    ld bc, 31
    ldir
    pop hl
    inc h
    pop bc
    djnz .sd_clear_scan

    ; Attributes: rows 0..last-1 -> 1..last, then clear row 0
    ld a, (_scroll_last)
    call _attr_row_offset       ; HL = last * 32
    ld b, h
    ld c, l                     ; BC = count
    push bc
    ld de, SCR_ATTR
    add hl, de                  ; HL = dest end (attr row last)
    push hl
    ld de, 32
    ld a, l
    sub e
    ld l, a
    ld a, h
    sbc a, 0
    ld h, a                     ; HL = source end (attr row last-1)
    pop de                      ; DE = dest end
    pop bc
    lddr

    ; Clear the top attr row
    ld a, (scr_attr)
    ld hl, SCR_ATTR
    ld de, SCR_ATTR + 1
    ld (hl), a
    ld bc, 31
    ldir

    call _page_out
    ret


; ==========================================================================
; _clear_screen — Clear entire screen (char_buffer + pixels + attrs)
;   In:      nothing
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc _clear_screen
; @clobbers af,bc,de,hl
; @end
_clear_screen:
    ; Clear char_buffer
    ld hl, char_buffer
    ld de, char_buffer + 1
    ld (hl), 0x20
    ld bc, SCR_COLS_MAX * SCR_ROWS - 1
    ldir

    call _page_in

    ; Clear bitmap
    ld hl, SCR_BASE
    ld de, SCR_BASE + 1
    ld (hl), 0
    ld bc, 6143
    ldir

    ; Restore attributes
    ld a, (scr_attr)
    ld hl, SCR_ATTR
    ld de, SCR_ATTR + 1
    ld (hl), a
    ld bc, 767
    ldir

    ld a, (mode80)
    or a
    jr z, .cs_no_lg
    call _lg_clear_all
.cs_no_lg:
    call _page_out
    ret


; ==========================================================================
; _clear_row_a — Clear row A in char_buffer and pixel screen
;   In:      A = row to clear (0-23)
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc _clear_row_a
; @param %row:u8 a
; @clobbers af,bc,de,hl
; @end
_clear_row_a:
    ld (_cra_row), a            ; save row for pixel phase

    ; Clear row in char_buffer: offset = A * scr_cols
    call _mul_row_scr_cols      ; HL = row * scr_cols
    ld de, char_buffer
    add hl, de                  ; HL = &char_buffer[row * scr_cols]
    ld d, h
    ld e, l
    inc de                      ; DE = HL + 1
    ld (hl), 0x20
    ld a, (scr_cols)
    ld c, a
    ld b, 0
    dec bc                      ; BC = scr_cols - 1
    ldir

    ; Clear row pixels
    ld a, (_cra_row)
    call _calc_row_addr         ; HL = pixel row addr, scan 0

    call _page_in

    ld b, 8
._cra_scan:
    push bc                     ; lint: ignore  (only B is used; C pushed/popped as padding)
    push hl
    ld d, h
    ld e, l
    inc de
    ld (hl), 0
    ld bc, 31
    ldir
    pop hl
    inc h
    pop bc
    djnz ._cra_scan

    call _page_out
    ret

_cra_row: db 0                  ; scratch for _clear_row_a row value


; ==========================================================================
; _clear_vp_row_a - Clear one absolute row inside the viewport
;   In:  A = absolute screen row
;   Clears vp_left..vp_left+vp_width-1 in the buffer and on screen.
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _clear_vp_row_a
; @param %row:u8 a
; @clobbers af,bc,de,hl,ix
; @end
_clear_vp_row_a:
    ld (lg_row), a              ; save the caller's row
    ld a, (mode80)
    or a
    jr z, .cvra_vis
    xor a
    ld c, a                     ; start column 0
    ld b, 80                    ; full logical row
    ld a, (lg_row)
    jp _lg_erase_range
.cvra_vis:
    ; A = absolute row; clear vp_left..vp_left+vp_width-1
    ld a, (lg_row)
    ld b, a                     ; B = row
    ld a, (vp_left)
    ld c, a                     ; C = start column
    ld a, (vp_width)
    ld e, a                     ; E = count
    ld a, b                     ; A = row
    ld b, e                     ; B = count
    jp _blank_render_range

_blank_render_range:
    ; In: A = absolute row, C = absolute start column, B = count
    ; Fills the range with spaces in char_buffer and re-renders it.
    ; Clobbers: AF, BC, DE, HL, IX
    ld (_brr_row), a
    ld a, c
    ld (_brr_col), a
    ld a, b
    ld (_brr_cnt), a

    ld a, (_brr_row)
    call _mul_row_scr_cols
    ld de, char_buffer
    add hl, de
    ld a, (_brr_col)
    ld e, a
    ld d, 0
    add hl, de
    ld d, h
    ld e, l
    inc de
    ld (hl), 0x20
    ld a, (_brr_cnt)
    dec a
    ld c, a
    ld b, 0
    ld a, b
    or c
    jr z, .brr_render
    ldir
.brr_render:
    call _page_in
    ld a, (_brr_row)
    ld d, a
    ld a, (_brr_col)
    ld c, a
    ld a, (_brr_cnt)
    ld b, a
.brr_loop:
    push bc
    push de
    ld b, 0x20
    call _render_char
    pop de
    pop bc
    inc c
    djnz .brr_loop
    call _page_out
    ret

_brr_row: db 0
_brr_col: db 0
_brr_cnt: db 0


; ==========================================================================
; _clear_viewport - Clear every row of the viewport (cursor unchanged)
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _clear_viewport
; @clobbers af,bc,de,hl,ix
; @end
_clear_viewport:
    ld a, (mode80)
    or a
    jr z, .cv_vis
    call _lg_clear_viewport
.cv_vis:
    ld a, (vp_top)
    ld (_vp_row_ctr), a
    ld a, (vp_height)
    ld b, a
.vp_row_loop:
    push bc
    ld a, (_vp_row_ctr)
    call _clear_vp_row_a
    pop bc
    ld a, (_vp_row_ctr)
    inc a
    ld (_vp_row_ctr), a
    djnz .vp_row_loop
    ret

_vp_row_ctr: db 0


; ==========================================================================
; _erase_line_from_cursor - Erase cursor col..vp_width-1 on the cursor row
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _erase_line_from_cursor
; @clobbers af,bc,de,hl,ix
; @end
_erase_line_from_cursor:
    ld a, (mode80)
    or a
    jr z, .efc_vis
    ld a, (cursor_col)
    ld c, a                     ; start column (logical)
    ld b, 80
    ld a, b
    sub c
    ld b, a                     ; count
    ld a, (vp_top)
    ld d, a
    ld a, (cursor_row)
    add a, d                    ; logical row
    jp _lg_erase_range
.efc_vis:
    ld a, (cursor_col)
    ld d, a
    ld a, (vp_width)
    sub d
    ret z
    ld b, a                     ; count
    ld a, (vp_left)
    add a, d
    ld c, a                     ; absolute start column
    ld a, (vp_top)
    ld d, a
    ld a, (cursor_row)
    add a, d                    ; absolute row
    jp _blank_render_range


; ==========================================================================
; _erase_line_to_cursor - Erase viewport col 0..cursor_col on the cursor row
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _erase_line_to_cursor
; @clobbers af,bc,de,hl,ix
; @end
_erase_line_to_cursor:
    ld a, (mode80)
    or a
    jr z, .eltc_vis
    ld a, (cursor_col)
    inc a
    ld b, a                     ; count
    xor a
    ld c, a                     ; start column 0
    ld a, (vp_top)
    ld d, a
    ld a, (cursor_row)
    add a, d
    jp _lg_erase_range
.eltc_vis:
    ld a, (cursor_col)
    inc a
    ld b, a                     ; count
    ld a, (vp_left)
    ld c, a                     ; absolute start column
    ld a, (vp_top)
    ld d, a
    ld a, (cursor_row)
    add a, d                    ; absolute row
    jp _blank_render_range


; ==========================================================================
; _delete_char - Delete the character under the cursor within the viewport
;   Shifts the rest of the viewport row left, blanks the last column and
;   re-renders the row from the cursor to the right edge.
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _delete_char
; @clobbers af,bc,de,hl,ix
; @end
_delete_char:
    ld a, (mode80)
    or a
    jr z, .dc_vis
    jp _lg_delete_char
.dc_vis:
    ; --- shift the buffer left from the cursor ---
    ld a, (vp_width)
    dec a
    ld b, a
    ld a, (cursor_col)
    sub b
    neg                         ; count = vp_width-1-cursor_col
    jr z, .dc_blank
    call _cursor_buf_addr       ; HL = &buffer[abs start]
    ld d, h
    ld e, l
    inc hl                      ; HL = source (col+1)
    ld a, (vp_width)
    dec a
    ld b, a
    ld a, (cursor_col)
    sub b
    neg                         ; recompute after the call
    ld c, a
    ld b, 0
    ldir

.dc_blank:
    ; --- blank the rightmost viewport cell on this row ---
    ld a, (vp_top)
    ld d, a
    ld a, (cursor_row)
    add a, d
    ld d, a                     ; D = absolute row
    ld a, (vp_left)
    ld b, a
    ld a, (vp_width)
    dec a
    add a, b
    ld c, a                     ; C = absolute right column
    ld a, d
    ld b, 1
    call _blank_render_range

    ; --- re-render the shifted range from the buffer ---
    call _cursor_buf_addr       ; HL = &buffer[abs start]
    call _page_in               ; Clobbers AF, BC - set B after this
    call _abs_cursor            ; C = absolute start, D = absolute row
    ld a, (vp_width)
    ld b, a
    ld a, (cursor_col)
    ld e, a
    ld a, b
    sub e
    ld b, a                     ; B = columns to render
.dc_col:
    ld a, (hl)
    inc hl
    push hl
    push bc
    push de
    ld b, a
    call _render_char
    pop de
    pop bc
    pop hl
    inc c
    djnz .dc_col
    call _page_out
    ret


; ==========================================================================
; _insert_line - Insert a blank line at the cursor row (within the viewport)
;   Rows below the cursor move down; the last viewport row is lost.
;   Clobbers: AF, BC, DE, HL, IX, IY
; ==========================================================================
; @proc _insert_line
; @clobbers af,bc,de,hl,ix,iy
; @end
_insert_line:
    ld a, (mode80)
    or a
    jr z, .il_vis
    call _lg_insert_line
    jp _lg_redraw
.il_vis:
    ld a, (cursor_row)
    ld (_il_row), a
    ld b, a
    ld a, (vp_height)
    dec a
    sub b                       ; rows below the cursor
    jr z, .il_blank
    call _mul_row_scr_cols      ; HL = rows * scr_cols
    ld b, h
    ld c, l
    push bc
    ; source end = char_buffer + (vp_top+vp_height-1)*scr_cols - 1
    ld a, (vp_top)
    ld b, a
    ld a, (vp_height)
    dec a
    add a, b
    call _mul_row_scr_cols
    ld de, char_buffer - 1
    add hl, de
    push hl
    ; dest end = source end + scr_cols
    ld a, (scr_cols)
    ld e, a
    ld d, 0
    pop hl
    ex de, hl
    add hl, de
    ex de, hl
    pop bc
    lddr

.il_blank:
    ; Blank the cursor row inside the viewport
    ld a, (vp_top)
    ld b, a
    ld a, (_il_row)
    add a, b
    call _clear_vp_row_a

    call _page_in
    call _redraw_all_screenpaged
    call _page_out
    ret

_il_row: db 0


; ==========================================================================
; _delete_line - Delete the cursor row within the viewport
;   Rows below move up; the last viewport row is blanked.
;   Clobbers: AF, BC, DE, HL, IX, IY
; ==========================================================================
; @proc _delete_line
; @clobbers af,bc,de,hl,ix,iy
; @end
_delete_line:
    ld a, (mode80)
    or a
    jr z, .dl_vis
    call _lg_delete_line
    jp _lg_redraw
.dl_vis:
    ld a, (cursor_row)
    ld (_dl_row), a
    ld b, a
    ld a, (vp_height)
    dec a
    sub b                       ; rows below the cursor
    jr z, .dl_blank
    call _mul_row_scr_cols      ; HL = rows * scr_cols
    ld (_dl_count), hl

    ; dest = &char_buffer[(vp_top+cursor_row) * scr_cols]
    ld a, (vp_top)
    ld b, a
    ld a, (_dl_row)
    add a, b
    call _mul_row_scr_cols
    ld de, char_buffer
    add hl, de                  ; HL = dest
    ld d, h
    ld e, l
    ld a, (scr_cols)
    ld c, a
    ld b, 0
    add hl, bc                  ; HL = source = dest + scr_cols
    ld bc, (_dl_count)
    ldir

.dl_blank:
    ; Blank the last viewport row
    ld a, (vp_top)
    ld b, a
    ld a, (vp_height)
    dec a
    add a, b
    call _clear_vp_row_a

    call _page_in
    call _redraw_all_screenpaged
    call _page_out
    ret

_dl_row: db 0
_dl_count: dw 0


; ==========================================================================
; _redraw_all_screenpaged — Redraw entire screen (screen must be paged in)
;   In:      screen paged in
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _redraw_all_screenpaged
; @clobbers af,bc,de,hl,ix
; @end
_redraw_all_screenpaged:
    push iy                     ; preserve caller IY (we use it as a cursor)
    ; Clear bitmap
    ld hl, SCR_BASE
    ld de, SCR_BASE + 1
    ld (hl), 0
    ld bc, 6143
    ldir
    ; Render each character
    ld iy, char_buffer
    ld d, 0
._ras_row:
    ld c, 0
._ras_col:
    ld b, (iy + 0)
    inc iy
    push de
    push bc
    push iy
    call _render_char
    pop iy
    pop bc
    pop de
    inc c
    ld a, (scr_cols)
    cp c                        ; Z when c == scr_cols (done with row)
    jr nz, ._ras_col
    inc d
    ld a, d
    cp SCR_ROWS
    jr c, ._ras_row
    pop iy
    ret


; ##########################################################################
; XBIOS Terminal Emulator (TE) and Screen (SCR) Functions
; ##########################################################################


; ==========================================================================
; scr_set_cols — Set screen column count and clear screen (BIOS function 32)
;   In:  A = desired columns (32, 51 or 64)
;   Out: nothing
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc scr_set_cols
; @param %cols:u8 a
; @clobbers af,bc,de,hl,ix
; @end
scr_set_cols:
    cp 51
    jr z, .valid
    cp 64
    jr z, .check64
    cp 32
    jr z, .check32
    ret                         ; ignore invalid values silently
.check64:
    ld a, (LF_FLAGS)
    and 0x10                    ; FONT64.BIN found on the boot disk?
    jr z, .invalid
    ld a, 64
    jr .valid
.check32:
    ld a, (LF_FLAGS)
    and 0x02                    ; FONT32.BIN found on the boot disk?
    jr z, .invalid
    ld a, 32
    jr .valid
.invalid:
    ret                         ; ignore unavailable values silently
.valid:
    ld (scr_cols), a            ; update runtime column count
    dec a
    ld (scb_conwidth), a        ; update SCB offset 0x1A (cols - 1)
    ld hl, 0x8000               ; default: 51-col font (5px) in bank 6
    ld a, (scr_cols)
    cp 32
    jr z, .font32
    cp 64
    jr nz, .setfont
    ld hl, 0x9400               ; 64-col uses the 4px font in bank 6
    jr .setfont
.font32:
    ld hl, 0x8800               ; 32-col uses the 8px font in bank 6
.setfont:
    ld (font_ptr), hl
    call scr_init               ; clear screen, reset cursor
    jp _stl_draw                ; markers follow the current page



; ==========================================================================
; 24x80 mode
; ==========================================================================
; The logical screen is 80 columns wide and lives in bank 5 at LG_BUF
; (5B00-62BF), outside the image and the 32/51/64-column char_buffer.
; The physical screen shows a window of scr_cols columns starting at
; lg_off.  Pages are lg_step apart: 32 columns -> 0, 24, 48 (three
; pages); 51 -> 0, 29; 64 -> 0, 16.  The wider the physical font, the
; fewer pages are needed.
;
; Every logical buffer access pages bank 5 in (mode 2).  The visible
; char_buffer mirrors the current window, so the existing redraw, scroll
; and status-line paths keep working unchanged.
;
; The manual flip chord is EXTEND+Enter (CAPS+SYMB+Enter, since EXTEND is
; CAPS+SYMB).  Auto-flip (ESC 5 1, the default) follows the cursor when it
; leaves the window.

; @proc _mul80
; @param %n:u8 a
; @out   hl
; @clobbers af,de,hl
; @end
_mul80:
    ld l, a
    ld h, 0
    add hl, hl                 ; *2
    add hl, hl                 ; *4
    add hl, hl                 ; *8
    add hl, hl                 ; *16
    ld d, h
    ld e, l
    add hl, hl                 ; *32
    add hl, hl                 ; *64
    add hl, de                 ; *80
    ret


; @proc _lg_width
; @out   a
; @clobbers af
; @end
_lg_width:
    ld a, (mode80)
    or a
    jr nz, .lw80
    ld a, (vp_width)
    ret
.lw80:
    ld a, 80
    ret


; @proc _lg_step_for_cols
; @clobbers af,b
; @end
_lg_step_for_cols:
    ld a, (scr_cols)
    ld b, 29
    cp 51
    jr z, .lgs_store
    ld b, 24
    cp 32
    jr z, .lgs_store
    ld b, 16
.lgs_store:
    ld a, b
    ld (lg_step), a
    ret


; @proc _enter80
; @clobbers af,bc,de,hl,ix,iy
; @end
_enter80:
    ld a, (mode80)
    or a
    ret nz
    ld a, (scr_cols)
    ld (lg_savecols), a
    call _lg_step_for_cols
    ld a, 1
    ld (mode80), a
    xor a
    ld (lg_off), a
    call scr_init              ; clears the visible screen and LG_BUF
    jp _stl_draw


; @proc _exit80
; @clobbers af,bc,de,hl,ix,iy
; @end
_exit80:
    ld a, (mode80)
    or a
    ret z
    xor a
    ld (mode80), a
    ld (lg_off), a
    ld a, (lg_savecols)
    cp 32
    jr z, .ex_set
    cp 64
    jr z, .ex_set
    ld a, 51
.ex_set:
    jp scr_set_cols            ; clears and restores the width


; @proc _lg_clear_all
;   Fill the whole logical screen with spaces.  Bank 5 must be paged in.
; @clobbers af,bc,de,hl
; @end
_lg_clear_all:
    ld hl, LG_BUF
    ld de, LG_BUF + 1
    ld (hl), ' '
    ld bc, 80 * 24 - 1
    ldir
    ret


; @proc _lg_clear_row
;   In: A = logical row.  Bank 5 must be paged in.
; @param %row:u8 a
; @clobbers af,bc,de,hl
; @end
_lg_clear_row:
    call _mul80
    ld de, LG_BUF
    add hl, de
    ld d, h
    ld e, l
    inc de
    ld (hl), ' '
    ld bc, 79
    ldir
    ret


; @proc _lg_clear_viewport
; @clobbers af,bc,de,hl
; @end
_lg_clear_viewport:
    call _page_in
    ld a, (vp_top)
    ld (lg_loop), a
    ld a, (vp_height)
    ld b, a
.lcv_loop:
    push bc
    ld a, (lg_loop)
    call _lg_clear_row
    pop bc
    ld a, (lg_loop)
    inc a
    ld (lg_loop), a
    djnz .lcv_loop
    call _page_out
    ret


; @proc _lg_scroll_up
; @clobbers af,bc,de,hl
; @end
_lg_scroll_up:
    call _page_in
    ld a, (vp_height)
    dec a
    jr z, .lsu_blank
    call _mul80
    ld b, h
    ld c, l
    ld hl, LG_BUF + 80
    ld de, LG_BUF
    ldir
.lsu_blank:
    ld a, (vp_height)
    dec a
    call _lg_clear_row
    call _page_out
    ret


; @proc _lg_scroll_down
; @clobbers af,bc,de,hl
; @end
_lg_scroll_down:
    call _page_in
    ld a, (vp_height)
    dec a
    jr z, .lsd_blank
    call _mul80                ; HL = last * 80 (count)
    ld b, h
    ld c, l
    push bc
    ld de, LG_BUF - 1
    add hl, de                 ; HL = source end
    push hl
    ld de, 80
    add hl, de
    ex de, hl                  ; DE = dest end
    pop hl                     ; HL = source end
    pop bc
    lddr
.lsd_blank:
    xor a
    call _lg_clear_row         ; row 0
    call _page_out
    ret


; @proc _lg_render_row
;   Copy one logical row into the visible window and redraw it.
;   In: A = logical row.
; @param %row:u8 a
; @clobbers af,bc,de,hl,ix
; @end
_lg_render_row:
    ld (lg_row), a
    call _page_in
    ld a, (lg_row)
    call _mul80
    ld de, LG_BUF
    add hl, de
    ld a, (lg_off)
    ld e, a
    ld d, 0
    add hl, de
    ld (lg_src), hl
    ld a, (lg_row)
    call _mul_row_scr_cols
    ld de, char_buffer
    add hl, de
    ld (lg_dst), hl
    xor a
    ld (lg_col), a
.lrr_loop:
    ld hl, (lg_src)
    ld a, (hl)
    inc hl
    ld (lg_src), hl
    ld (lg_char), a
    ld hl, (lg_dst)
    ld a, (lg_char)
    ld (hl), a
    inc hl
    ld (lg_dst), hl
    ld b, a
    ld a, (lg_col)
    ld c, a
    ld a, (lg_row)
    ld d, a
    call _render_char
    ld a, (lg_col)
    inc a
    ld (lg_col), a
    ld b, a
    ld a, (scr_cols)
    cp b
    jr nz, .lrr_loop
    call _page_out
    ret


; @proc _lg_redraw
;   Redraw every visible row from the logical buffer.
; @clobbers af,bc,de,hl,ix
; @end
_lg_redraw:
    xor a
    ld (lg_loop), a
.lrd_loop:
    ld a, (lg_loop)
    call _lg_render_row
    ld a, (lg_loop)
    inc a
    ld (lg_loop), a
    ld b, a
    ld a, (vp_height)
    cp b
    jr nz, .lrd_loop
    ret


; @proc _lg_store_char
;   Write A to the logical cell at the cursor and mirror it into the
;   visible window when it falls inside the current page.
;   In: A = character.
; @param %ch:u8 a
; @clobbers af,bc,de,hl,ix
; @end
_lg_store_char:
    ld (lg_char), a
    call _page_in
    ld a, (cursor_row)
    call _mul80
    ld de, LG_BUF
    add hl, de
    ld a, (cursor_col)
    ld e, a
    ld d, 0
    add hl, de
    ld a, (lg_char)
    ld (hl), a

    ld a, (cursor_col)
    ld b, a
    ld a, (lg_off)
    ld c, a
    ld a, b
    sub c
    jr c, .lsc_done
    ld (lg_vis), a
    ld b, a
    ld a, (scr_cols)
    cp b
    jr c, .lsc_done
    jr z, .lsc_done

    ld a, (cursor_row)
    call _mul_row_scr_cols
    ld de, char_buffer
    add hl, de
    ld a, (lg_vis)
    ld e, a
    ld d, 0
    add hl, de
    ld a, (lg_char)
    ld (hl), a
    ld b, a
    ld a, (lg_vis)
    ld c, a
    ld a, (cursor_row)
    ld d, a
    call _render_char
.lsc_done:
    call _page_out
    ret


; @proc _put80
;   Printable character in 24x80 mode: store it logically, follow the
;   cursor, then advance.
; @param %ch:u8 a
; @clobbers af,bc,de,hl,ix
; @end
_put80:
    ld (lg_char), a
    call _lg_autoflip
    ld a, (lg_char)
    call _lg_store_char
    jp _adv_col


; @proc _lg_autoflip
;   If auto-flip is on and the cursor left the window, page to it.
; @clobbers af,bc,de,hl,ix
; @end
_lg_autoflip:
    ld a, (mode80)
    or a
    ret z
    ld a, (lg_auto)
    or a
    ret z
    ld a, (cursor_col)
    ld c, a                    ; C = cursor column
    ld a, (lg_off)
    ld (lg_old), a
    ld b, a                    ; B = current page
    ld a, (scr_cols)
    add a, b
    ld e, a                    ; E = page end (exclusive)
    ld a, c
    cp b
    jr c, .laf_need
    cp e
    jr c, .laf_ok
.laf_need:
    ld a, 80
    ld e, a
    ld a, (scr_cols)
    ld d, a
    ld a, e
    sub d
    ld e, a                    ; E = max page offset
    xor a
    ld b, a                    ; B = best
    ld d, a                    ; D = candidate
.laf_pick:
    ld a, d
    cp c
    jr z, .laf_cand
    jr nc, .laf_done
    ld a, e
    cp d
    jr c, .laf_done
    ld b, d
    ld a, (lg_step)
    add a, d
    ld d, a
    jr .laf_pick
.laf_cand:
    ld a, e
    cp d
    jr c, .laf_done
    ld b, d
.laf_done:
    ld a, (lg_off)
    cp b
    ret z
    ld a, b
    jp _lg_set_page
.laf_ok:
    ret


; @proc _lg_flip
;   Manual page flip (EXTEND+Enter).  Preserves IX/IY so the keyboard
;   scanner's contract is unchanged.
; @clobbers af,bc,de,hl
; @end
_lg_flip:
    ld a, (mode80)
    or a
    ret z
    push ix
    push iy
    ld a, (lg_off)
    ld (lg_old), a
    ld b, a
    ld a, (lg_step)
    add a, b
    ld b, a
    ld a, 80
    ld c, a
    ld a, (scr_cols)
    ld e, a
    ld a, c
    sub e                      ; max page offset
    cp b
    jr nc, .lf_ok
    xor a
    ld b, a
.lf_ok:
    ld a, b
    call _lg_set_page
.lf_done:
    pop iy
    pop ix
    ret


; @proc _lg_set_page
;   Show the page in A, using the fast bitmap shift when the viewport is
;   the full window, otherwise a full redraw.
;   In: A = new page offset; lg_old must hold the current page.
;   @param %page:u8 a
;   @clobbers af,bc,de,hl,ix
;   @end
_lg_set_page:
    ld c, a                    ; C = new page
    ld a, (lg_old)
    cp c
    ret z                      ; same page: nothing to do
    ld a, c
    ld (lg_off), a
    ; delta = new - old (signed)
    ld a, (lg_old)
    ld b, a
    ld a, c
    sub b
    ld (lg_delta), a
    ; offset/narrow viewports cannot be shifted reliably: redraw them
    ld a, (vp_top)
    or a
    jr nz, .sp_full
    ld a, (vp_left)
    or a
    jr nz, .sp_full
    ld a, (vp_width)
    ld b, a
    ld a, (scr_cols)
    cp b
    jr nz, .sp_full
    ld a, (lg_delta)
    or a
    jp m, .sp_right
    ; window moved right: shift left and paint the new right columns
    ld b, a
    ld a, (scr_cols)
    cp b
    jr c, .sp_full
    jr z, .sp_full
    call _lg_flip_left
    jr .sp_drawn
.sp_right:
    neg
    ld b, a
    ld a, (scr_cols)
    cp b
    jr c, .sp_full
    jr z, .sp_full
    call _lg_flip_right
    jr .sp_drawn
.sp_full:
    call _lg_redraw
.sp_drawn:
    jp _stl_draw


; @proc _flip_chord
;   EXTEND+Enter from the keyboard scanner; preserves all registers.
; @clobbers
; @end
_flip_chord:
    push af
    push bc
    push de
    push hl
    push ix
    push iy
    call _lg_flip
    pop iy
    pop ix
    pop hl
    pop de
    pop bc
    pop af
    ret


; ==========================================================================
; 24x80 line editing
; ==========================================================================

; @proc _lg_erase_range
;   Fill count logical cells with spaces and re-render the row.
;   In: A = row, C = start column, B = count.
; @param %row:u8 a
; @param %start:u8 c
; @param %count:u8 b
; @clobbers af,bc,de,hl,ix
; @end
_lg_erase_range:
    ld (lg_row), a
    ld a, c
    ld (lg_col), a
    ld a, b
    ld (lg_vis), a
    or a
    ret z
    call _page_in
    ld a, (lg_row)
    call _mul80
    ld de, LG_BUF
    add hl, de
    ld a, (lg_col)
    ld e, a
    ld d, 0
    add hl, de
    ld d, h
    ld e, l
    inc de
    ld (hl), ' '
    ld a, (lg_vis)
    dec a
    ld c, a
    ld b, 0
    ld a, b
    or c
    jr z, .ler_end
    ldir
.ler_end:
    call _page_out
    ld a, (lg_row)
    jp _lg_render_row


; @proc _lg_delete_line
;   Move the logical rows below the cursor up and blank the last row.
; @clobbers af,bc,de,hl,ix
; @end
_lg_delete_line:
    call _page_in
    ld a, (vp_height)
    dec a
    ld (lg_loop), a            ; last row
    ld a, (cursor_row)
    ld (lg_row), a
    ld b, a
    ld a, (lg_loop)
    cp b
    jr z, .ldl_blank
    sub b
    call _mul80
    ld b, h
    ld c, l
    push bc
    ld a, (lg_row)
    call _mul80
    ld de, LG_BUF
    add hl, de
    ld d, h
    ld e, l
    ld a, 80
    ld c, a
    ld b, 0
    add hl, bc                 ; source = dest + 80
    pop bc
    ldir
    ld a, (lg_loop)
    call _lg_clear_row
    jr .ldl_done
.ldl_blank:
    ld a, (lg_row)
    call _lg_clear_row
.ldl_done:
    call _page_out
    ret


; @proc _lg_insert_line
;   Move the logical rows below the cursor down (losing the last one) and
;   blank the cursor row.
; @clobbers af,bc,de,hl,ix
; @end
_lg_insert_line:
    call _page_in
    ld a, (vp_height)
    dec a
    ld (lg_loop), a
    ld a, (cursor_row)
    ld (lg_row), a
    ld b, a
    ld a, (lg_loop)
    cp b
    jr z, .lil_blank
    sub b
    call _mul80
    ld b, h
    ld c, l
    push bc
    ld a, (lg_loop)
    call _mul80
    ld de, LG_BUF - 1
    add hl, de                 ; HL = source end (last row)
    push hl
    ld de, 80
    add hl, de
    ex de, hl                  ; DE = dest end
    pop hl                     ; HL = source end
    pop bc
    lddr
.lil_blank:
    ld a, (lg_row)
    call _lg_clear_row
    call _page_out
    ret


; @proc _lg_delete_char
;   Shift the logical row left from the cursor and blank the last cell.
; @clobbers af,bc,de,hl,ix
; @end
_lg_delete_char:
    ld a, (cursor_row)
    ld (lg_row), a
    ld a, (cursor_col)
    ld (lg_col), a
    call _page_in
    ld a, (lg_row)
    call _mul80
    ld de, LG_BUF
    add hl, de
    ld a, (lg_col)
    ld e, a
    ld d, 0
    add hl, de                  ; HL = dest (cursor cell)
    ld d, h
    ld e, l
    inc hl                      ; HL = source (next cell)
    ld a, 79
    ld b, a
    ld a, (lg_col)
    ld c, a
    ld a, b
    sub c                       ; count = 79 - cursor_col
    ld c, a
    ld b, 0
    ld a, b
    or c
    jr z, .ldc_blank
    ldir
.ldc_blank:
    ld a, (lg_row)
    call _mul80
    ld de, LG_BUF
    add hl, de
    ld de, 79
    add hl, de
    ld (hl), ' '
    call _page_out
    ld a, (lg_row)
    jp _lg_render_row


; ==========================================================================
; Fast page flip
; ==========================================================================
; Both pages show the same logical text shifted horizontally, so instead of
; redrawing every column we shift the bitmap of each text scan line by
; delta * font_pitch bits and render only the newly exposed columns.
; 32 columns use the 8px font (byte-aligned), 51 the 5px font (byte + one
; bit) and 64 the 4px font (byte-aligned).

; @proc _lg_line_left
;   Shift a scan line left for the 24x80 page flip.
;
;   Only the columns that stay on screen are moved: the B bytes exposed at
;   the right edge are re-rendered from LG_BUF straight afterwards, so they
;   are neither cleared nor rotated here.  That matters at 51 columns,
;   where a page step is 29 columns = 18 bytes: the old code rotated (and
;   zeroed) the whole 32-byte line, i.e. more than half the work was spent
;   on bytes the render pass overwrote.
;
;   In: HL = 32-byte scan line, B = whole bytes, C = bits (0/1)
;   Clobbers: AF, BC, DE, HL
; @end
_lg_line_left:
    ld (lg_ptr), hl
    ld a, b
    ld (lg_bytes), a
    ld a, c
    ld (lg_bits), a
    ld a, (lg_bytes)
    or a
    jr z, .ll_bits
    ; Move the survivors: dst[0..31-B] = src[B..31]
    ld e, a
    ld d, 0
    ld hl, (lg_ptr)
    push hl                    ; dest
    add hl, de                 ; HL = source
    ld a, 32
    sub e                      ; 32 - bytes
    ld c, a
    ld b, 0
    pop de                     ; DE = dest
    ldir
.ll_bits:
    ld a, (lg_bits)
    or a
    ret z
    ; Left shift in pixel space: bit 7 is the leftmost pixel, so the
    ; carry chain runs from the high byte down and the carry out of the
    ; last survivor is discarded.  Bytes past it are re-rendered.
    ld a, (lg_bytes)
    ld e, a
    ld d, 0
    ld a, 32
    sub e                      ; 32 - bytes
    ld b, a
    ld hl, (lg_ptr)
    ld e, a
    ld d, 0
    add hl, de                 ; HL = one past the last survivor
    dec hl                     ; last survivor
    xor a                      ; carry = 0
.ll_roll:
    rl (hl)
    dec hl
    djnz .ll_roll
    ret


; @proc _lg_line_right
;   Shift a scan line right for the 24x80 page flip.
;
;   The B bytes exposed at the left edge are re-rendered from LG_BUF, so
;   the move and the bit rotation only cover the surviving bytes (see
;   _lg_line_left for why that is worth doing).
;
;   In: HL = 32-byte scan line, B = whole bytes, C = bits (0/1)
;   Clobbers: AF, BC, DE, HL
; @end
_lg_line_right:
    ld (lg_ptr), hl
    ld a, b
    ld (lg_bytes), a
    ld a, c
    ld (lg_bits), a
    ld a, (lg_bytes)
    or a
    jr z, .lr_bits
    ; Move the survivors: dst[B..31] = src[0..31-B]
    ld c, a                    ; C = bytes
    ld b, 0
    ld hl, (lg_ptr)
    ld a, 31
    sub c
    ld e, a
    ld d, 0
    add hl, de                 ; HL = source end (ptr + 31 - bytes)
    push hl
    ld e, c
    ld d, 0
    add hl, de                 ; HL = dest end (ptr + 31)
    ex de, hl                  ; DE = dest end
    pop hl                     ; HL = source end
    ld a, 32
    sub c                      ; count = 32 - bytes
    ld c, a
    ld b, 0
    lddr
.lr_bits:
    ld a, (lg_bits)
    or a
    ret z
    ; Right shift in pixel space: bit 0 is the rightmost pixel, so the
    ; carry chain runs from the low byte up.  Only the survivors rotate;
    ; the bytes below them are re-rendered from LG_BUF.
    ld a, (lg_bytes)
    ld e, a
    ld d, 0
    ld hl, (lg_ptr)
    add hl, de                 ; HL = first survivor
    ld a, 32
    sub e                      ; 32 - bytes
    ld b, a
    xor a                      ; carry = 0
.lr_roll:
    rr (hl)
    inc hl
    djnz .lr_roll
    ret


; @proc _lg_flip_left
; @clobbers af,bc,de,hl,ix
; @end
_lg_flip_left:
    xor a
    ld (lg_dir), a
    jr _lg_flip_shift


; @proc _lg_flip_right
; @clobbers af,bc,de,hl,ix
; @end
_lg_flip_right:
    ld a, 1
    ld (lg_dir), a
    ; fall through


; @proc _lg_flip_shift
;   Shift the text bitmap and render the exposed columns.
; @clobbers af,bc,de,hl,ix
; @end
_lg_flip_shift:
    ; pixels = |delta| * font pitch
    ld a, (lg_delta)
    or a
    jp p, .fs_abs
    neg
.fs_abs:
    ld b, a                    ; B = |delta|
    ld l, a
    ld h, 0
    ld a, (scr_cols)
    cp 32
    jr z, .fs_p8
    cp 64
    jr z, .fs_p4
    add hl, hl
    add hl, hl                 ; *4
    ld e, b
    ld d, 0
    add hl, de                 ; *5
    jr .fs_product
.fs_p8:
    add hl, hl
    add hl, hl
    add hl, hl                 ; *8
    jr .fs_product
.fs_p4:
    add hl, hl
    add hl, hl                 ; *4
.fs_product:
    ld a, l
    ld b, a
    and 7
    ld (lg_bits), a
    ld a, b
    srl a
    srl a
    srl a
    ld (lg_bytes), a
    ; exposed columns and their screen position
    ld a, (lg_delta)
    or a
    jp m, .fs_expr
    ld a, (scr_cols)
    ld b, a
    ld a, (lg_delta)
    ld c, a
    ld a, b
    sub c
    ld (lg_first), a
    ld (lg_vis), a             ; first screen column
    ld a, c
    ld (lg_dcount), a
    jr .fs_rows
.fs_expr:
    xor a
    ld (lg_first), a
    ld (lg_vis), a
    ld a, (lg_delta)
    neg
    ld (lg_dcount), a
.fs_rows:
    call _page_in
    xor a
    ld (lg_loop), a
.fs_row:
    ; paint the whole text row's attributes with the current colour
    ld a, (lg_loop)
    call _attr_row_offset
    ld de, SCR_ATTR
    add hl, de
    ld a, (scr_attr)
    ld b, 32
.fs_attr:
    ld (hl), a
    inc hl
    djnz .fs_attr
    ; shift the eight scan lines of this text row
    ld a, (lg_loop)
    call _calc_row_addr
    ld b, 8
.fs_scan:
    push bc
    push hl
    ld a, (lg_bytes)
    ld b, a
    ld a, (lg_bits)
    ld c, a
    ld a, (lg_dir)
    or a
    jr nz, .fs_scan_right
    call _lg_line_left
    jr .fs_scan_done
.fs_scan_right:
    call _lg_line_right
.fs_scan_done:
    pop hl                     ; line base
    ; 51 columns use 255 of the 256 pixels; the last one belongs to the
    ; column just outside the window, so blank it after a shift.
    ld a, (scr_cols)
    cp 51
    jr nz, .fs_scan_clipped
    push hl
    ld de, 31
    add hl, de
    res 0, (hl)
    pop hl
.fs_scan_clipped:
    inc h
    pop bc
    djnz .fs_scan
    ; mirror the new window into char_buffer
    ld a, (lg_loop)
    call _mul_row_scr_cols
    ld de, char_buffer
    add hl, de
    push hl
    ld a, (lg_loop)
    call _mul80
    ld de, LG_BUF
    add hl, de
    ld a, (lg_off)
    ld e, a
    ld d, 0
    add hl, de
    pop de
    ld a, (scr_cols)
    ld c, a
    ld b, 0
    ldir
    ; render the newly exposed columns from the logical row
    ld a, (lg_loop)
    call _mul80
    ld de, LG_BUF
    add hl, de
    ld a, (lg_off)
    ld e, a
    ld d, 0
    add hl, de
    ld a, (lg_first)
    ld e, a
    ld d, 0
    add hl, de
    ld (lg_src), hl
    ld a, (lg_first)
    ld (lg_vis), a
    ld a, (lg_dcount)
    ld (lg_loop2), a
.fs_cell:
    ld hl, (lg_src)
    ld a, (hl)
    inc hl
    ld (lg_src), hl
    ld b, a
    ld a, (lg_vis)
    ld c, a
    ld a, (lg_loop)
    ld d, a
    call _render_char_noattr    ; the whole row's attributes are already set
    ld a, (lg_vis)
    inc a
    ld (lg_vis), a
    ld a, (lg_loop2)
    dec a
    ld (lg_loop2), a
    jr nz, .fs_cell
    ; next text row
    ld a, (lg_loop)
    inc a
    ld (lg_loop), a
    ld b, a
    ld a, (vp_height)
    cp b
    jp nz, .fs_row
    call _page_out
    ret


; ==========================================================================
; Status line drawing (row 23) and 80-column page markers
; ==========================================================================
; @proc _stl_draw
;   Blank the status row and, in 24x80 mode with the status line on,
;   place '<' when text is hidden to the left and '>' when it is hidden
;   to the right.
; @clobbers af,bc,de,hl,ix
; @end
_stl_draw:
    xor a
    ld c, a
    ld a, (scr_cols)
    ld b, a
    ld a, SCR_ROWS - 1
    call _blank_render_range
    ld a, (stl_on)
    or a
    ret z
    ld a, (mode80)
    or a
    ret z
    ld a, (lg_off)
    or a
    jr z, .sd_no_left
    ld b, '<'
    xor a
    call _stl_mark
.sd_no_left:
    ld a, (lg_off)
    ld b, a
    ld a, (scr_cols)
    add a, b
    cp 80
    ret nc
    ld b, '>'
    ld a, (scr_cols)
    dec a
    jp _stl_mark


; @proc _stl_mark
;   In: A = screen column, B = character.
; @param %col:u8 a
; @param %ch:u8 b
; @clobbers af,bc,de,hl,ix
; @end
_stl_mark:
    ld (lg_vis), a
    ld a, b
    ld (lg_char), a
    ld a, SCR_ROWS - 1
    call _mul_row_scr_cols
    ld de, char_buffer
    add hl, de
    ld a, (lg_vis)
    ld e, a
    ld d, 0
    add hl, de
    ld a, (lg_char)
    ld (hl), a
    call _page_in
    ld a, (lg_vis)
    ld c, a
    ld a, SCR_ROWS - 1
    ld d, a
    ld a, (lg_char)
    ld b, a
    call _render_char
    call _page_out
    ret


; Font data is NOT embedded here.  All three fonts are loaded from disk at
; cold_boot into bank 6: font51.bin -> 8000h, font32.bin -> 8800h,
; font64.bin -> 9400h.  font_ptr above tracks the active font; scr_set_cols
; updates it.
