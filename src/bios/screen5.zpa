; ==========================================================================
; screen5.zpa - Screen code that runs from bank 5
; ==========================================================================
;
; Everything here runs with the screen paged in (mode 2: banks 4,5,6,3) and
; is assembled at SCREEN5_BASE (62C0h), in bank 5 itself, above the bitmap,
; the attributes and the 24x80 buffer (LG_BUF, 5B00-62BF).  It is the first
; part of CPM3.SYS's companion file CPM3C.SYS; the loader stages that file at
; 62C0, so this code is in place before init runs and costs nothing in the
; 16K CPM3.SYS head.
;
; Bank 4, bank 6 and common memory stay mapped in mode 2, so code here may
; call the bank-4 helpers and use the bank-6 buffers freely.  The rules, which
; tools/check_bank5.py enforces after every build:
;
;   * Bank-4 code reaches these routines only with the screen paged in: the
;     usual entry is a short bank-4 stub ("call _page_in / jp X_b5").
;   * Code here never calls anything that switches banks.  A routine leaves
;     bank 5 with a final "jp _page_out", which returns to its bank-4 caller.
;
; Banks 4-7 are all contended on the +2A/+3, so running from bank 5 costs
; the same as running from bank 4.
; ==========================================================================


; ==========================================================================
; _put_attr - Stamp scr_attr into the attribute cell for a character
;   In:  C = column, D = row
;   Clobbers: AF, DE, HL (D is destroyed; callers save the row first)
; ==========================================================================
; @proc _put_attr
; @param %col:u8 c
; @param %row:u8 d
; @clobbers af,de,hl
; @end
_put_attr:
    ld a, d
    ld l, a
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl                 ; row * 32
    ld a, (scr_cols)
    cp 64
    jr z, .pa_64
    cp 32
    ld a, c
    jr z, .pa_32
    ld e, a
    add a, a
    add a, a
    add a, e                   ; col * 5 (51-column font)
    jr .pa_shift
.pa_32:
    add a, a
    add a, a
    add a, a                   ; col * 8 (32-column font)
.pa_shift:
    srl a
    srl a
    srl a                      ; pixel_x / 8
    jr .pa_add
.pa_64:
    ld a, c
    srl a                      ; 4-pixel pitch: two characters per 8x8 cell
.pa_add:
    ld e, a
    ld d, 0
    add hl, de
    ld de, SCR_ATTR
    add hl, de
    ld a, (scr_attr)
    ld (hl), a
    ret


; ==========================================================================
; _lg_cur_row_addr / _lg_row_addr - Compute HL = &LG_BUF[row * 80]
;   In:  _lg_row_addr: A = logical row; _lg_cur_row_addr: row = lg_row
;   Out: HL = start of that row in the 24x80 buffer (bank 5)
;   Clobbers: AF, DE, HL
; ==========================================================================
; @proc _lg_cur_row_addr
; @out   hl
; @clobbers af,de,hl
; @end
_lg_cur_row_addr:
    ld a, (lg_row)
    ; fall through
; @proc _lg_row_addr
; @param %row:u8 a
; @out   hl
; @clobbers af,de,hl
; @end
_lg_row_addr:
    call _mul80
    ld de, LG_BUF
    add hl, de
    ret


; ==========================================================================
; _clear_char_row - Zero the bitmap of one character row
;   In:  HL = screen address of the row's first scan line (screen paged in)
;   Out: HL = H advanced by 8 (the scan line below the row), B = 0
;   Clobbers: BC, DE, HL
; ==========================================================================
; @proc _clear_char_row
; @param %addr:u16 hl
; @out   hl
; @clobbers bc,de,hl
; @end
_clear_char_row:
    ld b, 8
.scan:
    push bc
    push hl
    ld d, h
    ld e, l
    inc de
    ld (hl), 0
    ld bc, 31
    ldir
    pop hl
    inc h
    pop bc
    djnz .scan
    ret


; ==========================================================================
; _render_char — Render one character to the screen bitmap
;   In:      B = character code
;            C = column (0-50)
;            D = row (0-23)
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX
;
;   Screen must be paged in before calling.
;   Uses memory variable _rnd_row as temporary.
;
;   51-col shift dispatch: pixel_x = col*5 gives shift = pixel_x & 7, one
;   of 8 values. Each .shiftN variant unrolls that many right-shifts and
;   uses hard-coded mask constants so the inner scan loop only does the
;   font load, the unrolled shifts, and the screen write. Shifts 0-3 fit
;   the 5-pixel glyph in one byte (no spill); shifts 4-7 always spill
;   into the next byte.
; ==========================================================================
; @proc _render_char
; @param %ch:u8  b
; @param %col:u8 c
; @param %row:u8 d
; @clobbers af,bc,de,hl,ix
; @end
_render_char:
    ; Save row to memory (we'll need D for other things)
    ld a, d
    ld (_rnd_row), a

    ; Stamp the 8x8 attribute cell with the current colours (ESC b/c).
    call _put_attr
    jr _render_char_body

; @proc _render_char_noattr
;   As _render_char, but the caller has already painted this row's
;   attributes.  The 24x80 page flip hides the whole page with one attribute
;   fill (_lg_attr_hide) and restores it with another, so stamping every
;   cell with _put_attr in between would only rewrite the same byte.
; @param %ch:u8  b
; @param %col:u8 c
; @param %row:u8 d
; @clobbers af,bc,de,hl,ix
; @end
_render_char_noattr:
    ld a, d
    ld (_rnd_row), a

_render_char_body:

    ; --- Font data pointer → IX ---
    ; B = char code. HL and DE are free to use.
    ld l, b
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl                ; HL = char × 8
    ld de, (font_ptr)          ; DE = base of active font
    add hl, de                 ; HL = &font[char * 8]
    push hl
    pop ix                     ; IX = font pointer

    ; --- Branch on column mode ---
    ld a, (scr_cols)
    cp 32
    jr z, .render32
    cp 64
    jr z, .render64

    ; --- 51-col path: pixel_x = col * 5, non-byte-aligned ---
    ld a, c
    ld b, a                    ; B = column (temp)
    add a, a                   ; ×2
    add a, a                   ; ×4
    add a, b                   ; ×5 (A = pixel_x, max 250)
    ld c, a                    ; C = pixel_x (save for shift below)
    srl a
    srl a
    srl a                      ; A = pixel_x >> 3 = byte column
    ld b, a                    ; B = byte_col (preserved by _calc_row_addr)
    ld a, c
    and 0x07                   ; A = pixel_x & 7 = shift amount
    ld c, a                    ; C = shift (preserved by _calc_row_addr)

    ; --- Screen base address for (row, scan 0, byte_col) ---
    ld a, (_rnd_row)
    call _calc_row_addr        ; HL = screen addr for (row, byte_col=0, scan 0)
    ld a, b                    ; A = byte_col
    or l
    ld l, a                    ; HL = screen addr for (row, byte_col, scan 0)

    ; --- Dispatch on shift value (0..7) ---
    ld a, c
    or a
    jr z, .shift0
    dec a
    jr z, .shift1
    dec a
    jp z, .shift2
    dec a
    jp z, .shift3
    dec a
    jp z, .shift4
    dec a
    jp z, .shift5
    dec a
    jp z, .shift6
    jp .shift7

.render32:
    ; --- 32-col path: col * 8, byte-aligned, direct write ---
    ; byte_col = column (col*8>>3 = col), shift always 0
    ld a, (_rnd_row)
    call _calc_row_addr        ; HL = screen addr for (row, byte_col=0, scan 0)
    ld a, c                    ; byte_col = column for 8px chars
    or l
    ld l, a

    ; --- Render 8 scan lines (byte-aligned, direct) ---
    ld b, 8
.scan32:
    ld a, (ix)
    inc ix
    ld (hl), a
    inc h                      ; Next scan line
    djnz .scan32

    ret

.render64:
    ; --- 64-col path: 4-pixel pitch, two phases ---
    ; pixel_x = col * 4, so byte_col = col >> 1 and the phase is col & 1:
    ; even columns take the glyph's high nibble, odd columns its low nibble.
    ; A 4-pixel glyph never spills past its byte (16 bits would be needed to
    ; straddle), so this is the simplest and fastest of the three renderers.
    ld a, c
    ld e, a                    ; E = column (preserved by _calc_row_addr)
    srl a
    ld b, a                    ; B = byte_col
    ld a, (_rnd_row)
    call _calc_row_addr        ; HL = screen addr for (row, byte_col=0, scan 0)
    ld a, b
    or l
    ld l, a                    ; HL = screen addr for (row, byte_col, scan 0)
    ld a, e
    and 1
    jr nz, .r64_hi

    ; phase 0: glyph in the high nibble, keep the odd column's pixels
    ld b, 8
.r64_lo_scan:
    ld d, (ix + 0)
    inc ix
    ld a, (hl)
    and 0x0F
    or d
    ld (hl), a
    inc h
    djnz .r64_lo_scan
    ret

.r64_hi:
    ; phase 1: glyph >> 4 into the low nibble, keep the even column's pixels
    ld b, 8
.r64_hi_scan:
    ld d, (ix + 0)
    inc ix
    srl d
    srl d
    srl d
    srl d
    ld a, (hl)
    and 0xF0
    or d
    ld (hl), a
    inc h
    djnz .r64_hi_scan
    ret

; --- Shift-specialised 51-col bodies ---
; Entry: IX = font, HL = screen addr (row, scan 0, byte_col).
; Each body renders 8 scan lines and returns.

; shift=0: pixels in bits 7..3. Mask 0xF8, keep 0x07, no spill.
.shift0:
    ld b, 8
.s0_scan:
    ld d, (ix + 0)
    inc ix
    ld a, (hl)
    and 0x07
    or d
    ld (hl), a
    inc h
    djnz .s0_scan
    ret

; shift=1: pixels in bits 6..2. Mask 0x7C, keep 0x83, no spill.
.shift1:
    ld b, 8
.s1_scan:
    ld d, (ix + 0)
    inc ix
    srl d
    ld a, (hl)
    and 0x83
    or d
    ld (hl), a
    inc h
    djnz .s1_scan
    ret

; shift=2: pixels in bits 5..1. Mask 0x3E, keep 0xC1, no spill.
.shift2:
    ld b, 8
.s2_scan:
    ld d, (ix + 0)
    inc ix
    srl d
    srl d
    ld a, (hl)
    and 0xC1
    or d
    ld (hl), a
    inc h
    djnz .s2_scan
    ret

; shift=3: pixels in bits 4..0. Mask 0x1F, keep 0xE0, no spill.
.shift3:
    ld b, 8
.s3_scan:
    ld d, (ix + 0)
    inc ix
    srl d
    srl d
    srl d
    ld a, (hl)
    and 0xE0
    or d
    ld (hl), a
    inc h
    djnz .s3_scan
    ret

; shift=4: hi mask 0x0F (keep 0xF0), lo mask 0x80 (keep 0x7F).
.shift4:
    ld b, 8
.s4_scan:
    ld d, (ix + 0)
    inc ix
    ld e, 0
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    ld a, (hl)
    and 0xF0
    or d
    ld (hl), a
    inc l
    ld a, (hl)
    and 0x7F
    or e
    ld (hl), a
    dec l
    inc h
    djnz .s4_scan
    ret

; shift=5: hi mask 0x07 (keep 0xF8), lo mask 0xC0 (keep 0x3F).
.shift5:
    ld b, 8
.s5_scan:
    ld d, (ix + 0)
    inc ix
    ld e, 0
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    ld a, (hl)
    and 0xF8
    or d
    ld (hl), a
    inc l
    ld a, (hl)
    and 0x3F
    or e
    ld (hl), a
    dec l
    inc h
    djnz .s5_scan
    ret

; shift=6: hi mask 0x03 (keep 0xFC), lo mask 0xE0 (keep 0x1F).
.shift6:
    ld b, 8
.s6_scan:
    ld d, (ix + 0)
    inc ix
    ld e, 0
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    ld a, (hl)
    and 0xFC
    or d
    ld (hl), a
    inc l
    ld a, (hl)
    and 0x1F
    or e
    ld (hl), a
    dec l
    inc h
    djnz .s6_scan
    ret

; shift=7: hi mask 0x01 (keep 0xFE), lo mask 0xF0 (keep 0x0F).
.shift7:
    ld b, 8
.s7_scan:
    ld d, (ix + 0)
    inc ix
    ld e, 0
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    srl d
    rr e
    ld a, (hl)
    and 0xFE
    or d
    ld (hl), a
    inc l
    ld a, (hl)
    and 0x0F
    or e
    ld (hl), a
    dec l
    inc h
    djnz .s7_scan
    ret


; @proc _scroll_up_b5
;   _scroll_up_vis fast path: the viewport is the whole screen width and
;   anchored at the top left.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl
; @end
_scroll_up_b5:
    ; last = vp_height - 1, the row that will be cleared
    ld a, (vp_height)
    dec a
    ld (_scroll_last), a

    ; Buffer: rows 1..last -> 0..last-1
    call _mul_row_scr_cols      ; HL = last * scr_cols (count)
    ld b, h
    ld c, l
    ld hl, char_buffer
    ld a, (scr_cols)
    ld e, a
    ld d, 0
    add hl, de                  ; HL = source (row 1)
    ld de, char_buffer          ; DE = dest (row 0)
    ldir

    ; Clear the last buffer row
    ld a, (_scroll_last)
    call _row_buf_addr
    ld d, h
    ld e, l
    inc de
    ld (hl), 0x20
    ld a, (scr_cols)
    ld c, a
    ld b, 0
    dec bc
    ldir

    ; Pixel scroll: row R+1 -> R for R = 0..last-1
    xor a
    ld (_scroll_row_ctr), a
.scroll_row:
    ld a, (_scroll_row_ctr)
    call _calc_row_addr         ; HL = dest row, scan 0
    push hl
    ld a, (_scroll_row_ctr)
    inc a
    call _calc_row_addr         ; HL = source row+1, scan 0
    pop de                      ; DE = dest, HL = source
    ld b, 8
.scroll_scan:
    push bc
    push hl
    push de
    ld bc, 32
    ldir
    pop de
    pop hl
    inc h                       ; next scan line
    inc d
    pop bc
    djnz .scroll_scan

    ld a, (_scroll_row_ctr)
    inc a
    ld (_scroll_row_ctr), a
    ld b, a
    ld a, (_scroll_last)
    cp b
    jr z, .su_clear
    jr c, .su_clear
    jr .scroll_row

.su_clear:
    jr _scroll_clear

; Helper: calculate screen address for character row A, scan line 0
;   In:  A = character row (0-23)
;   Out: HL = screen address
;   Clobbers: AF
; @proc _calc_row_addr
; @param %row:u8 a
; @out   hl
; @clobbers af
; @end
_calc_row_addr:
    push de
    add a, a                   ; A = word index (row * 2)
    ld e, a
    ld d, 0
    ld hl, _row_scr_tbl
    add hl, de
    ld a, (hl)
    inc hl
    ld h, (hl)
    ld l, a
    pop de
    ret

_row_scr_tbl equ 0xA890
; The loader stages the 24 words (row -> screen address at scan 0, byte
; column 0) into bank 6 at A890, so they cost no CPM3.SYS image space.
;   H = 0x40 | ((r>>3) << 3),  L = (r & 7) << 5


; ==========================================================================
; _attr_row_offset - Compute the attribute-plane offset of a text row
;   In:  A = row (0-23)
;   Out: HL = row * 32
;   Clobbers: AF, HL
; ==========================================================================
; @proc _attr_row_offset
; @param %row:u8 a
; @out   hl
; @clobbers af,hl
; @end
_attr_row_offset:
    ld l, a
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    ret


; ==========================================================================
; _scroll_clear - Clear the last viewport row (pixels, buffer, attributes)
;   Uses _scroll_last.  Called by _scroll_up after the pixel shift.
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc _scroll_clear
; @clobbers af,bc,de,hl
; @end
_scroll_clear:
    ; Clear the last row's bitmap: 8 scan lines x 32 bytes
    ld a, (_scroll_last)
    call _calc_row_addr
    call _clear_char_row      ; 8 scan lines of 32 zero bytes from HL

    ; Attributes: rows 1..last -> 0..last-1, then clear row last
    ld a, (_scroll_last)
    call _attr_row_offset       ; HL = last * 32
    ld b, h
    ld c, l                     ; BC = count
    push bc
    ld hl, SCR_ATTR + 32        ; source: row 1
    ld de, SCR_ATTR             ; dest: row 0
    pop bc
    ldir
    ld a, (_scroll_last)
    call _attr_row_offset
    ld de, SCR_ATTR
    add hl, de                  ; HL = attr row last
    ld d, h
    ld e, l
    inc de
    ld a, (scr_attr)
    ld (hl), a
    ld bc, 31
    ldir

    jp _page_out


; @proc _scroll_down_b5
;   _scroll_down_vis fast path.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl
; @end
_scroll_down_b5:
    ; last = vp_height - 1
    ld a, (vp_height)
    dec a
    ld (_scroll_last), a

    ; Buffer: rows 0..last-1 -> 1..last (LDDR)
    call _mul_row_scr_cols      ; HL = last * scr_cols (count)
    ld b, h
    ld c, l
    push bc
    ld de, char_buffer - 1
    add hl, de                  ; HL = source end
    push hl
    ld a, (scr_cols)
    ld e, a
    ld d, 0
    pop hl
    ex de, hl
    add hl, de                  ; HL = dest end (source end + scr_cols)
    ex de, hl                   ; DE = dest end, HL = source end
    pop bc
    lddr

    ; Clear the top buffer row
    ld hl, char_buffer
    ld de, char_buffer + 1
    ld (hl), 0x20
    ld a, (scr_cols)
    ld c, a
    ld b, 0
    dec bc
    ldir

    ; Pixel scroll: row R -> R+1 for R = last-1..0
    ld a, (_scroll_last)
    dec a
    ld (_scroll_row_ctr), a
.sd_row:
    ld a, (_scroll_row_ctr)
    call _calc_row_addr         ; HL = source row
    push hl
    ld a, (_scroll_row_ctr)
    inc a
    call _calc_row_addr         ; HL = dest row
    pop de                      ; DE = source, HL = dest
    ex de, hl                   ; HL = source, DE = dest
    ld b, 8
.sd_scan:
    push bc
    push hl
    push de
    ld bc, 32
    ldir
    pop de
    pop hl
    inc h
    inc d
    pop bc
    djnz .sd_scan

    ld a, (_scroll_row_ctr)
    or a
    jr z, .sd_done
    dec a
    ld (_scroll_row_ctr), a
    jr .sd_row

.sd_done:
    ; Clear the top row's bitmap
    xor a
    call _calc_row_addr         ; HL = row 0, scan 0
    call _clear_char_row      ; 8 scan lines of 32 zero bytes from HL

    ; Attributes: rows 0..last-1 -> 1..last, then clear row 0
    ld a, (_scroll_last)
    call _attr_row_offset       ; HL = last * 32
    ld b, h
    ld c, l                     ; BC = count
    push bc
    ld de, SCR_ATTR
    add hl, de                  ; HL = dest end (attr row last)
    push hl
    ld de, 32
    ld a, l
    sub e
    ld l, a
    ld a, h
    sbc a, 0
    ld h, a                     ; HL = source end (attr row last-1)
    pop de                      ; DE = dest end
    pop bc
    lddr

    ; Clear the top attr row
    ld a, (scr_attr)
    ld hl, SCR_ATTR
    ld de, SCR_ATTR + 1
    ld (hl), a
    ld bc, 31
    ldir

    jp _page_out


; @proc _clear_screen_b5
;   Body of _clear_screen.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl
; @end
_clear_screen_b5:
    ; Clear char_buffer
    ld hl, char_buffer
    ld de, char_buffer + 1
    ld (hl), 0x20
    ld bc, SCR_COLS_MAX * SCR_ROWS - 1
    ldir

    ; Clear bitmap
    ld hl, SCR_BASE
    ld de, SCR_BASE + 1
    ld (hl), 0
    ld bc, 6143
    ldir

    ; Restore attributes
    ld a, (scr_attr)
    ld hl, SCR_ATTR
    ld de, SCR_ATTR + 1
    ld (hl), a
    ld bc, 767
    ldir

    ld a, (mode80)
    or a
    jr z, .cs_no_lg
    call _lg_clear_all
.cs_no_lg:
    jp _page_out


; @proc _blank_render_range_b5
;   Body of _blank_render_range: _brr_row/_brr_col/_brr_cnt hold the
;   range.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl,ix
; @end
_blank_render_range_b5:
    ; ---- Fast path: a whole row starting at column 0 ----
    ; Re-rendering one space glyph per cell costs a font load and eight
    ; scan-line merges per cell.  For a whole row the pixels can simply be
    ; zeroed, which is what the scroll and clear code already does.  ESC E
    ; and ESC K from column 0 both land here, and so does the status row.
    ld a, (_brr_col)
    or a
    jr nz, .brr_generic
    ld a, (_brr_cnt)
    ld hl, scr_cols
    cp (hl)
    jr nz, .brr_generic
    ld a, (_brr_row)
    jr _blank_row_direct

.brr_generic:
    ld a, (_brr_row)
    call _row_buf_addr
    ld a, (_brr_col)
    ld e, a
    ld d, 0
    add hl, de
    ld d, h
    ld e, l
    inc de
    ld (hl), 0x20
    ld a, (_brr_cnt)
    dec a
    ld c, a
    ld b, 0
    ld a, b
    or c
    jr z, .brr_render
    ldir
.brr_render:
    ld a, (_brr_row)
    ld d, a
    ld a, (_brr_col)
    ld c, a
    ld a, (_brr_cnt)
    ld b, a
.brr_loop:
    push bc
    push de
    ld b, 0x20
    call _render_char
    pop de
    pop bc
    inc c
    djnz .brr_loop
    jp _page_out


; ==========================================================================
; _blank_row_direct - Blank a whole text row without re-rendering glyphs
;   In:  A = absolute screen row, also in _brr_row (screen paged in;
;        returns paged out).  Only _blank_render_range enters it.
;
;   Fills the row's cells with spaces in char_buffer, zeroes its eight scan
;   lines of bitmap and paints the attributes with the current colour.
;   That is all a full-row erase needs: drawing one space glyph per cell
;   costs a font load and eight masked merges per cell, for a result that
;   is simply "zero these bytes".
;
;   Every column of the physical screen is cleared, not just the viewport,
;   because a full-width row erase is the only caller.
;
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc _blank_row_direct
; @param %row:u8 a
; @clobbers af,bc,de,hl
; @end
_blank_row_direct:
    ; char_buffer: scr_cols spaces at row * scr_cols
    call _row_buf_addr
    ld d, h
    ld e, l
    inc de
    ld (hl), ' '
    ld a, (scr_cols)
    ld c, a
    ld b, 0
    dec bc
    ldir

    ld a, (_brr_row)
    call _calc_row_addr

    ; bitmap: eight scan lines of 32 zero bytes
    call _clear_char_row      ; 8 scan lines of 32 zero bytes from HL

    ; attributes: the row's 32 attribute cells take the current colour
    ld a, (_brr_row)
    call _attr_row_offset
    ld de, SCR_ATTR
    add hl, de
    ld a, (scr_attr)
    ld b, 32
.bd_attr:
    ld (hl), a
    inc hl
    djnz .bd_attr

    jp _page_out


; @proc _delete_char_b5
;   _delete_char's re-render of the shifted range.
;   In: HL = &char_buffer[cursor].  Screen paged in; returns paged out.
; @param %buf:u16 hl
; @clobbers af,bc,de,hl,ix
; @end
_delete_char_b5:
    call _abs_cursor            ; C = absolute start, D = absolute row
    ld a, (vp_width)
    ld b, a
    ld a, (cursor_col)
    ld e, a
    ld a, b
    sub e
    ld b, a                     ; B = columns to render
.dc_col:
    ld a, (hl)
    inc hl
    push hl
    push bc
    push de
    ld b, a
    call _render_char
    pop de
    pop bc
    pop hl
    inc c
    djnz .dc_col
    jp _page_out


; ==========================================================================
; _redraw_all_screenpaged — Redraw entire screen (screen must be paged in)
;   In:      screen paged in
;   Out:     nothing
;   Clobbers: AF, BC, DE, HL, IX
; ==========================================================================
; @proc _redraw_all_screenpaged
; @clobbers af,bc,de,hl,ix
; @end
_redraw_all_screenpaged:
    push iy                     ; preserve caller IY (we use it as a cursor)
    ; Clear bitmap
    ld hl, SCR_BASE
    ld de, SCR_BASE + 1
    ld (hl), 0
    ld bc, 6143
    ldir
    ; Render each character
    ld iy, char_buffer
    ld d, 0
._ras_row:
    ld c, 0
._ras_col:
    ld b, (iy + 0)
    inc iy
    push de
    push bc
    push iy
    call _render_char
    pop iy
    pop bc
    pop de
    inc c
    ld a, (scr_cols)
    cp c                        ; Z when c == scr_cols (done with row)
    jr nz, ._ras_col
    inc d
    ld a, d
    cp SCR_ROWS
    jr c, ._ras_row
    pop iy
    ret


; @proc _lg_clear_all
;   Fill the whole logical screen with spaces.  Bank 5 must be paged in.
; @clobbers af,bc,de,hl
; @end
_lg_clear_all:
    ld hl, LG_BUF
    ld de, LG_BUF + 1
    ld (hl), ' '
    ld bc, 80 * 24 - 1
    ldir
    ret


; @proc _lg_clear_row
;   In: A = logical row.  Bank 5 must be paged in.
; @param %row:u8 a
; @clobbers af,bc,de,hl
; @end
_lg_clear_row:
    call _lg_row_addr
    ld d, h
    ld e, l
    inc de
    ld (hl), ' '
    ld bc, 79
    ldir
    ret


; @proc _lg_clear_viewport_b5
;   Body of _lg_clear_viewport.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl
; @end
_lg_clear_viewport_b5:
    ld a, (vp_top)
    ld (lg_loop), a
    ld a, (vp_height)
    ld b, a
.lcv_loop:
    push bc
    ld a, (lg_loop)
    call _lg_clear_row
    pop bc
    ld a, (lg_loop)
    inc a
    ld (lg_loop), a
    djnz .lcv_loop
    jp _page_out


; @proc _lg_scroll_up_b5
;   Body of _lg_scroll_up.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl
; @end
_lg_scroll_up_b5:
    ld a, (vp_height)
    dec a
    jr z, .lsu_blank
    call _mul80
    ld b, h
    ld c, l
    ld hl, LG_BUF + 80
    ld de, LG_BUF
    ldir
.lsu_blank:
    ld a, (vp_height)
    dec a
    call _lg_clear_row
    jp _page_out


; @proc _lg_scroll_down_b5
;   Body of _lg_scroll_down.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl
; @end
_lg_scroll_down_b5:
    ld a, (vp_height)
    dec a
    jr z, .lsd_blank
    call _mul80                ; HL = last * 80 (count)
    ld b, h
    ld c, l
    push bc
    ld de, LG_BUF - 1
    add hl, de                 ; HL = source end
    push hl
    ld de, 80
    add hl, de
    ex de, hl                  ; DE = dest end
    pop hl                     ; HL = source end
    pop bc
    lddr
.lsd_blank:
    xor a
    call _lg_clear_row         ; row 0
    jp _page_out


; @proc _lg_render_row_b5
;   Body of _lg_render_row.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl,ix
; @end
_lg_render_row_b5:
    ; The whole row is rewritten, so zero its pixels and stamp its 32
    ; attribute cells once up front; blank cells then need no drawing.
    ld a, (lg_row)
    call _calc_row_addr
    call _clear_char_row
    ld a, (lg_row)
    call _attr_row_offset
    ld de, SCR_ATTR
    add hl, de
    ld d, h
    ld e, l
    inc de
    ld a, (scr_attr)
    ld (hl), a
    ld bc, 31
    ldir
    call _lg_cur_row_addr
    ld a, (lg_off)
    ld e, a
    ld d, 0
    add hl, de
    ld (lg_src), hl
    ld a, (lg_row)
    call _row_buf_addr
    ld (lg_dst), hl
    xor a
    ld (lg_col), a
.lrr_loop:
    ld hl, (lg_src)
    ld a, (hl)
    inc hl
    ld (lg_src), hl
    ld (lg_char), a
    ld hl, (lg_dst)
    ld a, (lg_char)
    ld (hl), a
    inc hl
    ld (lg_dst), hl
    cp ' '                     ; already zero: nothing to draw
    jr z, .lrr_next
    ld b, a
    ld a, (lg_col)
    ld c, a
    ld a, (lg_row)
    ld d, a
    call _render_char_noattr   ; the row's attributes are stamped above
.lrr_next:
    ld a, (lg_col)
    inc a
    ld (lg_col), a
    ld b, a
    ld a, (scr_cols)
    cp b
    jr nz, .lrr_loop
    jp _page_out


; @proc _lg_store_char_b5
;   Body of _lg_store_char.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl,ix
; @end
_lg_store_char_b5:
    ld a, (cursor_row)
    call _lg_row_addr
    ld a, (cursor_col)
    ld e, a
    ld d, 0
    add hl, de
    ld a, (lg_char)
    ld (hl), a

    ld a, (cursor_col)
    ld b, a
    ld a, (lg_off)
    ld c, a
    ld a, b
    sub c
    jr c, .lsc_done
    ld (lg_vis), a
    ld b, a
    ld a, (scr_cols)
    cp b
    jr c, .lsc_done
    jr z, .lsc_done

    ld a, (cursor_row)
    call _row_buf_addr
    ld a, (lg_vis)
    ld e, a
    ld d, 0
    add hl, de
    ld a, (lg_char)
    ld (hl), a
    ld b, a
    ld a, (lg_vis)
    ld c, a
    ld a, (cursor_row)
    ld d, a
    call _render_char
.lsc_done:
    jp _page_out


; @proc _lg_erase_range_b5
;   Body of _lg_erase_range (lg_row/lg_col/lg_vis set).  Screen paged
;   in; returns paged out.
; @clobbers af,bc,de,hl,ix
; @end
_lg_erase_range_b5:
    call _lg_cur_row_addr
    ld a, (lg_col)
    ld e, a
    ld d, 0
    add hl, de
    ld d, h
    ld e, l
    inc de
    ld (hl), ' '
    ld a, (lg_vis)
    dec a
    ld c, a
    ld b, 0
    ld a, b
    or c
    jr z, .ler_end
    ldir
.ler_end:
    jp _lg_render_row_b5       ; lg_row is set; stays paged in


; @proc _lg_delete_line_b5
;   Body of _lg_delete_line.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl,ix
; @end
_lg_delete_line_b5:
    ld a, (vp_height)
    dec a
    ld (lg_loop), a            ; last row
    ld a, (cursor_row)
    ld (lg_row), a
    ld b, a
    ld a, (lg_loop)
    cp b
    jr z, .ldl_blank
    sub b
    call _mul80
    ld b, h
    ld c, l
    push bc
    call _lg_cur_row_addr
    ld d, h
    ld e, l
    ld a, 80
    ld c, a
    ld b, 0
    add hl, bc                 ; source = dest + 80
    pop bc
    ldir
    ld a, (lg_loop)
    call _lg_clear_row
    jr .ldl_done
.ldl_blank:
    ld a, (lg_row)
    call _lg_clear_row
.ldl_done:
    jp _page_out


; @proc _lg_insert_line_b5
;   Body of _lg_insert_line.  Screen paged in; returns paged out.
; @clobbers af,bc,de,hl,ix
; @end
_lg_insert_line_b5:
    ld a, (vp_height)
    dec a
    ld (lg_loop), a
    ld a, (cursor_row)
    ld (lg_row), a
    ld b, a
    ld a, (lg_loop)
    cp b
    jr z, .lil_blank
    sub b
    call _mul80
    ld b, h
    ld c, l
    push bc
    ld a, (lg_loop)
    call _mul80
    ld de, LG_BUF - 1
    add hl, de                 ; HL = source end (last row)
    push hl
    ld de, 80
    add hl, de
    ex de, hl                  ; DE = dest end
    pop hl                     ; HL = source end
    pop bc
    lddr
.lil_blank:
    ld a, (lg_row)
    call _lg_clear_row
    jp _page_out


; @proc _lg_delete_char_b5
;   Body of _lg_delete_char (lg_row/lg_col set).  Screen paged in;
;   returns paged out.
; @clobbers af,bc,de,hl,ix
; @end
_lg_delete_char_b5:
    call _lg_cur_row_addr
    ld a, (lg_col)
    ld e, a
    ld d, 0
    add hl, de                  ; HL = dest (cursor cell)
    ld d, h
    ld e, l
    inc hl                      ; HL = source (next cell)
    ld a, 79
    ld b, a
    ld a, (lg_col)
    ld c, a
    ld a, b
    sub c                       ; count = 79 - cursor_col
    ld c, a
    ld b, 0
    ld a, b
    or c
    jr z, .ldc_blank
    ldir
.ldc_blank:
    call _lg_cur_row_addr
    ld de, 79
    add hl, de
    ld (hl), ' '
    jp _lg_render_row_b5       ; lg_row is set; stays paged in


; ==========================================================================
; Fast page flip
; ==========================================================================
; Both pages show the same logical text shifted horizontally, so instead of
; redrawing every column we shift the bitmap of each text scan line by
; delta * font_pitch bits and render only the newly exposed columns.
; 32 columns use the 8px font (byte-aligned), 51 the 5px font (byte + one
; bit) and 64 the 4px font (byte-aligned).

; @proc _lg_line_left
;   Shift a scan line left for the 24x80 page flip.
;
;   Only the columns that stay on screen are moved: the B bytes exposed at
;   the right edge are re-rendered from LG_BUF straight afterwards, so they
;   are neither cleared nor rotated here.  That matters at 51 columns,
;   where a page step is 29 columns = 18 bytes: the old code rotated (and
;   zeroed) the whole 32-byte line, i.e. more than half the work was spent
;   on bytes the render pass overwrote.
;
;   In: HL = 32-byte scan line, B = whole bytes, C = bits (0/1)
;   Clobbers: AF, BC, DE, HL
; @end
_lg_line_left:
    ld (lg_ptr), hl
    ld a, b
    ld (lg_bytes), a
    ld a, c
    ld (lg_bits), a
    ld a, (lg_bytes)
    or a
    jr z, .ll_bits
    ; Move the survivors: dst[0..31-B] = src[B..31]
    ld e, a
    ld d, 0
    ld hl, (lg_ptr)
    push hl                    ; dest
    add hl, de                 ; HL = source
    ld a, 32
    sub e                      ; 32 - bytes
    ld c, a
    ld b, 0
    pop de                     ; DE = dest
    ldir
.ll_bits:
    ld a, (lg_bits)
    or a
    ret z
    ; Left shift in pixel space: bit 7 is the leftmost pixel, so the
    ; carry chain runs from the high byte down and the carry out of the
    ; last survivor is discarded.  Bytes past it are re-rendered.
    ld a, (lg_bytes)
    ld e, a
    ld d, 0
    ld a, 32
    sub e                      ; 32 - bytes
    ld b, a
    ld hl, (lg_ptr)
    ld e, a
    ld d, 0
    add hl, de                 ; HL = one past the last survivor
    dec hl                     ; last survivor
    xor a                      ; carry = 0
.ll_roll:
    rl (hl)
    dec hl
    djnz .ll_roll
    ret


; @proc _lg_line_right
;   Shift a scan line right for the 24x80 page flip.
;
;   The B bytes exposed at the left edge are re-rendered from LG_BUF, so
;   the move and the bit rotation only cover the surviving bytes (see
;   _lg_line_left for why that is worth doing).
;
;   In: HL = 32-byte scan line, B = whole bytes, C = bits (0/1)
;   Clobbers: AF, BC, DE, HL
; @end
_lg_line_right:
    ld (lg_ptr), hl
    ld a, b
    ld (lg_bytes), a
    ld a, c
    ld (lg_bits), a
    ld a, (lg_bytes)
    or a
    jr z, .lr_bits
    ; Move the survivors: dst[B..31] = src[0..31-B]
    ld c, a                    ; C = bytes
    ld b, 0
    ld hl, (lg_ptr)
    ld a, 31
    sub c
    ld e, a
    ld d, 0
    add hl, de                 ; HL = source end (ptr + 31 - bytes)
    push hl
    ld e, c
    ld d, 0
    add hl, de                 ; HL = dest end (ptr + 31)
    ex de, hl                  ; DE = dest end
    pop hl                     ; HL = source end
    ld a, 32
    sub c                      ; count = 32 - bytes
    ld c, a
    ld b, 0
    lddr
.lr_bits:
    ld a, (lg_bits)
    or a
    ret z
    ; Right shift in pixel space: bit 0 is the rightmost pixel, so the
    ; carry chain runs from the low byte up.  Only the survivors rotate;
    ; the bytes below them are re-rendered from LG_BUF.
    ld a, (lg_bytes)
    ld e, a
    ld d, 0
    ld hl, (lg_ptr)
    add hl, de                 ; HL = first survivor
    ld a, 32
    sub e                      ; 32 - bytes
    ld b, a
    xor a                      ; carry = 0
.lr_roll:
    rr (hl)
    inc hl
    djnz .lr_roll
    ret


; @proc _lg_clear_strip
;   Zero the exposed strip of one scan line, as laid out by _lg_flip_shift
;   (lg_cs/lg_cn/lg_pi/lg_pm).  Bank 5 must be paged in.
;   In: HL = line base (32-byte aligned).  HL is preserved.
; @param %line:u16 hl
; @clobbers af,bc,de
; @end
_lg_clear_strip:
    push hl
    ld a, (lg_pi)
    or l
    ld l, a
    ld a, (lg_pm)
    and (hl)
    ld (hl), a                 ; the straddling byte keeps the survivors' bits
    pop hl
    ld a, (lg_cn)
    or a
    ret z
    push hl
    ld c, a
    ld a, (lg_cs)
    or l
    ld e, a
    ld d, h                    ; DE = start of the strip
    call _lg_zero_run
    pop hl
    ret


; @proc _lg_zero_run
;   Zero C bytes (0..32) at DE, ascending.  An unrolled run of
;   "ld (de),a / inc e" entered part-way: 11 T-states a byte against 21 for
;   LDIR.  The destination is always inside one 32-byte scan line, so
;   "inc e" never carries.
;   In: DE = start, C = count.   Out: DE = start + count.
; @clobbers af,bc,de,hl
; @end
_lg_zero_run:
    ; lint-exempt: stack  ; jp (hl) enters the unrolled run below
    ld hl, .zr_end
    ld a, c
    add a, a                   ; two bytes of code per store
    ld c, a
    ld b, 0
    or a
    sbc hl, bc                 ; HL = .zr_end - 2 * count
    xor a
    jp (hl)
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
    ld (de), a
    inc e
.zr_end:
    ret

; @proc _lg_row_left0
;   Byte-aligned left shift of one text row (32 and 64 columns): on every
;   scan line the survivors move down by lg_bytes and the lg_bytes bytes
;   above them are zeroed.  Register-only apart from the two counts.
;   In: HL = scan 0 of the row.
; @clobbers af,bc,de,hl
; @end
_lg_row_left0:
.l0_scan:
    push hl
    ld d, h
    ld e, l                    ; DE = line base
    ld a, (lg_bytes)
    add a, l
    ld l, a                    ; HL = base + shift
    ld bc, (lg_sn)
    ldir                       ; survivors; DE = start of the strip
    ld a, (lg_bytes)
    ld c, a                    ; strip length
    call _lg_zero_run
    pop hl
    inc h
    ld a, h
    and 7
    jr nz, .l0_scan
    ret


; @proc _lg_row_right0
;   Byte-aligned right shift of one text row: survivors move up by
;   lg_bytes (LDDR) and the lg_bytes bytes below them are zeroed.
;   In: HL = scan 0 of the row.
; @clobbers af,bc,de,hl
; @end
_lg_row_right0:
.r0_scan:
    push hl
    ld a, l
    add a, 31                  ; line bases are 32-aligned: no carry
    ld e, a
    ld d, h                    ; DE = last byte of the line
    ld a, (lg_bytes)
    ld c, a
    ld a, e
    sub c
    ld l, a                    ; HL = last survivor (base + 31 - shift)
    ld bc, (lg_sn)
    lddr                       ; survivors moved up
    pop hl                     ; line base
    push hl
    ld d, h
    ld e, l                    ; the strip is the shift bytes at the base
    ld a, (lg_bytes)
    ld c, a
    call _lg_zero_run
    pop hl
    inc h
    ld a, h
    and 7
    jr nz, .r0_scan
    ret


; @proc _lg_row_left51
;   Shift one text row left by 145 pixels (18 bytes + 1 bit: 29 columns of
;   the 5-pixel font).  The 1-bit rotate must stay: without it the
;   survivors would sit a pixel off the 5-pixel cell grid, and any later
;   edit of those cells would leave a one-pixel sliver of the old glyph.
;   It is unrolled and register-only, 14 bytes per scan line.
;   In: HL = scan 0 of the row.
; @clobbers af,bc,de,hl
; @end
_lg_row_left51:
.l5_scan:
    push hl
    ld d, h
    ld e, l                    ; DE = line base
    ld a, l
    add a, 18
    ld l, a                    ; HL = base + 18
    ld bc, 14
    ldir                       ; survivors; DE = base + 14
    dec de
    ex de, hl                  ; HL = last survivor (base + 13)
    or a                       ; carry in = 0
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    dec hl
    rl (hl)
    pop hl                     ; line base
    call _lg_clear_strip       ; top 6 bits of byte 13 stay, 14..31 zeroed
    inc h
    ld a, h
    and 7
    jr nz, .l5_scan
    ret


; @proc _lg_row_right51
;   The mirror image: shift one text row right by 145 pixels.
;   In: HL = scan 0 of the row.
; @clobbers af,bc,de,hl
; @end
_lg_row_right51:
.r5_scan:
    push hl
    ld a, l
    add a, 31
    ld e, a
    ld d, h                    ; DE = base + 31
    sub 18
    ld l, a                    ; HL = base + 13
    ld bc, 14
    lddr                       ; bytes 0..13 -> 18..31; DE = base + 17
    ld h, d
    ld l, e
    inc hl                     ; HL = base + 18, the first survivor
    or a                       ; carry in = 0
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    inc hl
    rr (hl)
    pop hl                     ; line base
    call _lg_clear_strip       ; bytes 0..17 zeroed, byte 18 loses its top bit
    ; pixel 255 belongs to the column just outside the window
    ld a, l
    or 31
    ld l, a
    res 0, (hl)
    xor 31
    ld l, a                    ; back to the line base
    inc h
    ld a, h
    and 7
    jr nz, .r5_scan
    ret


; @proc _lg_flip_shift
;   Shift the text bitmap and render the exposed columns.  Screen paged
;   in (by _lg_flip_go); returns paged out.
; @clobbers af,bc,de,hl,ix
; @end
_lg_flip_shift:
    ; pixels = |delta| * font pitch
    ld a, (lg_delta)
    or a
    jp p, .fs_abs
    neg
.fs_abs:
    ld b, a                    ; B = |delta|
    ld l, a
    ld h, 0
    ld a, (scr_cols)
    cp 32
    jr z, .fs_p8
    cp 64
    jr z, .fs_p4
    add hl, hl
    add hl, hl                 ; *4
    ld e, b
    ld d, 0
    add hl, de                 ; *5
    jr .fs_product
.fs_p8:
    add hl, hl
    add hl, hl
    add hl, hl                 ; *8
    jr .fs_product
.fs_p4:
    add hl, hl
    add hl, hl                 ; *4
.fs_product:
    ld a, l
    ld b, a
    and 7
    ld (lg_bits), a
    ld a, b
    srl a
    srl a
    srl a
    ld (lg_bytes), a
    ; exposed columns and their screen position
    ld a, (lg_delta)
    or a
    jp m, .fs_expr
    ld a, (scr_cols)
    ld b, a
    ld a, (lg_delta)
    ld c, a
    ld a, b
    sub c
    ld (lg_first), a
    ld (lg_vis), a             ; first screen column
    ld a, c
    ld (lg_dcount), a
    jr .fs_rows
.fs_expr:
    xor a
    ld (lg_first), a
    ld (lg_vis), a
    ld a, (lg_delta)
    neg
    ld (lg_dcount), a
.fs_rows:
    ; Geometry of the exposed strip.  Every scan line has it zeroed right
    ; after the shift, so blank cells need no drawing at all.
    ;   window moved right (dir 0): the strip is the right edge, pixels
    ;     Sx..end where Sx = used width - shift (used width is 255 at 51
    ;     columns, 256 otherwise); byte Sx/8 keeps its top (Sx mod 8) bits,
    ;     bytes above it are zeroed.
    ;   window moved left (dir 1): the strip is pixels 0..X-1 (X = shift);
    ;     bytes 0..X/8-1 are zeroed, byte X/8 keeps its bottom 8-(X mod 8)
    ;     bits.
    ld a, (lg_bytes)
    ld b, a                    ; B = whole bytes of the shift
    ld a, (lg_bits)
    ld e, a                    ; E = leftover bits
    ld a, (lg_dir)
    or a
    jr nz, .fs_geo_right
    ld a, b
    add a, a
    add a, a
    add a, a
    or e                       ; A = shift in pixels
    ld c, a
    ld a, (scr_cols)
    cp 51
    ld a, c
    jr z, .fs_geo_51
    neg                        ; 256 - shift
    jr .fs_geo_left
.fs_geo_51:
    cpl                        ; 255 - shift
.fs_geo_left:
    ld c, a                    ; C = Sx
    and 7
    ld e, a                    ; E = Sx mod 8
    ld a, c
    srl a
    srl a
    srl a                      ; A = Sx / 8
    ld (lg_pi), a
    inc a
    ld (lg_cs), a              ; zero from the next byte on
    ld b, a
    ld a, 32
    sub b
    ld (lg_cn), a
    jr .fs_geo_mask
.fs_geo_right:
    xor a
    ld (lg_cs), a
    ld a, b
    ld (lg_cn), a              ; zero bytes 0..B-1
    ld (lg_pi), a              ; the straddling byte
.fs_geo_mask:
    ld b, e
    inc b
    ld a, 0xFF
.fs_geo_shr:
    dec b
    jr z, .fs_geo_done
    srl a
    jr .fs_geo_shr
.fs_geo_done:                  ; A = 0xFF >> (leftover bits)
    ld c, a
    ld a, (lg_dir)
    or a
    ld a, c
    jr nz, .fs_geo_store
    cpl                        ; left strip keeps the top bits instead
.fs_geo_store:
    ld (lg_pm), a
    ; Pick the row routine.  Byte-aligned shifts (32/64 columns) and the one
    ; 51-column page step (18 bytes + 1 bit) have tight versions; anything
    ; else takes the generic per-scan-line loop.
    ld a, (lg_bytes)
    ld b, a
    ld a, 32
    sub b
    ld l, a
    ld h, 0
    ld (lg_sn), hl             ; survivors = 32 - shift bytes
    ld c, 0                    ; mode 0 = generic
    ld a, (scr_cols)
    cp 51
    ld a, (lg_bits)
    jr z, .fs_m51
    or a
    jr nz, .fs_mode_set
    ld c, 1                    ; byte-aligned: 1 = left, 2 = right
    jr .fs_mode_dir
.fs_m51:
    dec a
    jr nz, .fs_mode_set        ; not a 1-bit shift
    ld a, b
    cp 18
    jr nz, .fs_mode_set
    ld c, 3                    ; 3 = left, 4 = right
.fs_mode_dir:
    ld a, (lg_dir)
    add a, c
    ld c, a
.fs_mode_set:
    ld a, c
    ld (lg_mode), a
    xor a
    ld (lg_loop), a
.fs_row:
    ; (the attributes are not touched here: _lg_set_page has hidden the whole
    ; page and restores it at the end)
    ; shift the eight scan lines of this text row
    ld a, (lg_loop)
    call _calc_row_addr
    ld a, (lg_mode)
    or a
    jr z, .fs_generic
    dec a
    jr nz, .fs_not1
    call _lg_row_left0
    jr .fs_shifted
.fs_not1:
    dec a
    jr nz, .fs_not2
    call _lg_row_right0
    jr .fs_shifted
.fs_not2:
    dec a
    jr nz, .fs_not3
    call _lg_row_left51
    jr .fs_shifted
.fs_not3:
    call _lg_row_right51
    jr .fs_shifted
.fs_generic:
    ld b, 8
.fs_scan:
    push bc
    push hl
    ld a, (lg_bytes)
    ld b, a
    ld a, (lg_bits)
    ld c, a
    ld a, (lg_dir)
    or a
    jr nz, .fs_scan_right
    call _lg_line_left
    jr .fs_scan_done
.fs_scan_right:
    call _lg_line_right
.fs_scan_done:
    pop hl                     ; line base
    call _lg_clear_strip       ; zero the exposed strip (HL preserved)
    ; 51 columns use 255 of the 256 pixels; the last one belongs to the
    ; column just outside the window, so blank it after a shift.
    ld a, (scr_cols)
    cp 51
    jr nz, .fs_scan_clipped
    push hl
    ld de, 31
    add hl, de
    res 0, (hl)
    pop hl
.fs_scan_clipped:
    inc h
    pop bc
    djnz .fs_scan
.fs_shifted:
    ; mirror the new window into char_buffer
    ld a, (lg_loop)
    call _row_buf_addr
    push hl
    ld a, (lg_loop)
    call _lg_row_addr
    ld a, (lg_off)
    ld e, a
    ld d, 0
    add hl, de
    pop de
    ld a, (scr_cols)
    ld c, a
    ld b, 0
    ldir
    ; render the newly exposed columns from the logical row
    ld a, (lg_loop)
    call _lg_row_addr
    ld a, (lg_off)
    ld e, a
    ld d, 0
    add hl, de
    ld a, (lg_first)
    ld e, a
    ld d, 0
    add hl, de
    ld (lg_src), hl
    ld a, (lg_first)
    ld (lg_vis), a
    ld a, (lg_dcount)
    ld (lg_loop2), a
.fs_cell:
    ld hl, (lg_src)
    ld a, (hl)
    inc hl
    ld (lg_src), hl
    cp ' '                     ; the strip is already zero: nothing to draw
    jr z, .fs_blank            ; (a space is an all-zero glyph in every font)
    ld b, a
    ld a, (lg_vis)
    ld c, a
    ld a, (lg_loop)
    ld d, a
    call _render_char_noattr    ; the whole row's attributes are already set
.fs_blank:
    ld a, (lg_vis)
    inc a
    ld (lg_vis), a
    ld a, (lg_loop2)
    dec a
    ld (lg_loop2), a
    jr nz, .fs_cell
    ; next text row
    ld a, (lg_loop)
    inc a
    ld (lg_loop), a
    ld b, a
    ld a, (vp_height)
    cp b
    jp nz, .fs_row
    jp _page_out


; @proc _clk_draw_b5
;   Paint clk_text on row 23 from clk_col.  Screen paged in; returns
;   paged out.
; @clobbers af,bc,de,hl,ix
; @end
_clk_draw_b5:
    ; Write the five cells into char_buffer first, then render them.
    ld a, SCR_ROWS - 1
    call _row_buf_addr          ; HL = row 23 in char_buffer
    ld a, (clk_col)
    ld e, a
    ld d, 0
    add hl, de
    ld de, clk_text
    ld b, 5
.lb_copy:
    ld a, (de)
    ld (hl), a
    inc hl
    inc de
    djnz .lb_copy

    xor a
    ld (clk_i), a
.lb_render:
    ld a, (clk_i)
    ld e, a
    ld d, 0
    ld hl, clk_text
    add hl, de
    ld a, (hl)
    ld b, a                     ; B = character
    ld a, (clk_col)
    add a, e                    ; C = clk_col + i
    ld c, a
    ld a, SCR_ROWS - 1
    ld d, a                     ; D = row 23
    call _render_char
    ld a, (clk_i)
    inc a
    ld (clk_i), a
    cp 5
    jr nz, .lb_render
    jp _page_out


; @proc _stl_mark_b5
;   Body of _stl_mark (lg_vis/lg_char set).  Screen paged in; returns
;   paged out.
; @clobbers af,bc,de,hl,ix
; @end
_stl_mark_b5:
    ld a, SCR_ROWS - 1
    call _row_buf_addr
    ld a, (lg_vis)
    ld e, a
    ld d, 0
    add hl, de
    ld a, (lg_char)
    ld (hl), a
    ld a, (lg_vis)
    ld c, a
    ld a, SCR_ROWS - 1
    ld d, a
    ld a, (lg_char)
    ld b, a
    call _render_char
    jp _page_out
