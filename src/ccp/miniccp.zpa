; ==========================================================================
; Mini-CCP — Minimal Console Command Processor for CP/M 3.1
; ==========================================================================
;
; Runs at 0100h in the TPA (bank 0).
; Provides the A> prompt, reads commands via BDOS F10,
; and handles a few built-in commands.
;
; BDOS calls go through address 0005 (set up by BIOS).
;
; Assembled separately as CCP.COM and loaded from the boot disk by the
; BIOS (cold boot), staged in bank 7, then copied to 0100h.
;   sjasmplus --raw=build/CCP.COM build/zpa/miniccp.asm
;
; ==========================================================================

    org 0x0100

BDOS    equ 0x0005             ; BDOS entry point
FCB1    equ 0x005C             ; Default FCB 1
DMA     equ 0x0080             ; Default DMA / command tail
TPA_TOP equ 0xF600             ; First byte of common memory — initial stack top
CCP_FCB_ADDR equ 0xFB21        ; common-memory FCB for the COM loader stub
CCP_RUN_PROG equ 0xFCA6        ; common-memory ccp_run_prog (COM header check)
CCP_CHAIN_ADDR equ 0xF607      ; SCB[0x07]: BDOS F47 chain pending
CCP_RC_ADDR    equ 0xF608      ; SCB[0x08]: program return code (F108)
CCP_COLD_ADDR  equ 0xF60A      ; SCB[0x0A]: 1 = cold start, PROFILE.SUB due

; BDOS function numbers
F_CIN   equ 1                  ; Console input (blocking, echoes)
F_COUT  equ 2                  ; Console output (E = char)
F_PSTR  equ 9                  ; Print string (DE = addr, '$' terminated)
F_RDBUF equ 10                 ; Read console buffer (DE = buf addr)
F_CSTAT equ 11                 ; Console status
F_SCB   equ 49                 ; Get/Set SCB byte (DE→[offset,op]; op=0=get)
F_BIOS  equ 50                 ; Direct BIOS call (DE→8-byte BIOSPB)
F_CONMODE equ 109              ; Get/Set console mode word (F109)
F_GET_ORD  equ 120             ; Get SETDEF order byte (F120)
F_GET_PATH equ 122             ; Get SETDEF search path (DE = 4-byte buf)
F_SUBIN equ 124                ; private: queue submit-file program input
F_PEND  equ 125                ; private: store/fetch the rest of a "!" line

CON_MODE_DISPLAY equ 0x02      ; con_mode bit 1: echo SUBmit lines

; SETDEF order byte values (must match BDOS bdos_order encoding).
ORDER_COM_SUB equ 0
ORDER_SUB_COM equ 1
ORDER_COM     equ 2
ORDER_SUB     equ 3

; ==========================================================================
; CCP Entry Point
; ==========================================================================

; @proc ccp_start
; @clobbers af,bc,de,hl,ix
; @end
ccp_start:
    ld sp, ccp_stack           ; Local stack

    ; Rebuild ALV from directory (fn 13 Reset Disk System) but preserve
    ; the user's current drive across the reset — without this, running
    ; A:PROG from a B> prompt would drop us back to A> after PROG exits,
    ; because fn 13 resets cur_disk to A: per CP/M spec.
    ld c, 25                   ; F25: Return Current Disk
    call BDOS
    push af                    ; Save user's drive
    ld c, 13                   ; F13: Reset Disk System
    call BDOS
    pop af
    ld e, a
    ld c, 14                   ; F14: Select Disk — restore user's drive
    call BDOS

    ; Cold start: run PROFILE.SUB once, the way CP/M 3 does.  The flag is in
    ; the SCB, which every cold boot re-initialises, so a warm boot (each
    ; program exit) does not run the profile a second time.
    ld a, (CCP_COLD_ADDR)
    or a
    jr z, .no_profile
    xor a
    ld (CCP_COLD_ADDR), a
    call profile_cmd           ; fills cmd_buf if PROFILE.SUB exists
    jp c, .got_line
.no_profile:

    ; BDOS F47 (chain to program) leaves a flag and the command tail at
    ; 0080h, then warm boots.  Consume it here instead of prompting.
    ld a, (CCP_CHAIN_ADDR)
    or a
    jr z, .no_chain
    xor a
    ld (CCP_CHAIN_ADDR), a
    ld a, (DMA)                ; tail length
    cp 126
    jr c, .chain_len_ok
    ld a, 126
.chain_len_ok:
    ld (cmd_buf + 1), a
    or a
    jr z, .no_chain            ; empty tail: nothing to chain to
    ld c, a
    ld b, 0
    ld hl, DMA + 1
    ld de, cmd_buf + 2
    ldir
    ld hl, cmd_buf + 2
    ld a, (cmd_buf + 1)
    ld e, a
    ld d, 0
    add hl, de
    ld (hl), 0
    jp .got_line

.no_chain:
    ; A new command from the console: clear the program return code.
    xor a
    ld (CCP_RC_ADDR), a
    ld (CCP_RC_ADDR + 1), a

.prompt:
    ; Program input left over from the last program is dropped.
    ld de, 0
    ld c, F_SUBIN
    call BDOS

    ; The rest of a "cmd1!cmd2" line comes next, shown after a prompt like a
    ; typed command.
    ld de, cmd_buf + 2
    ld b, 0
    ld c, F_PEND
    call BDOS                  ; A = length of the pending text (0 = none)
    or a
    jr z, .no_pending
    ld (cmd_buf + 1), a
    ld l, a
    ld h, 0
    ld de, cmd_buf + 2
    add hl, de
    ld (hl), 0
    call print_prompt
    call echo_sub_line
    jr .got_line
.no_pending:
    call try_sub
    jr c, .read_console

    call print_prompt
    ld de, 0xFFFF
    ld c, F_CONMODE
    call BDOS                  ; HL = con_mode
    ld a, l
    and CON_MODE_DISPLAY
    call nz, echo_sub_line
    jr .got_line

.read_console:
    call print_prompt
    ; Read command line
    ld de, cmd_buf
    ld c, F_RDBUF
    call BDOS

.got_line:
    ; Parse and execute
    call parse_cmd
    jr .prompt

; @proc print_prompt
; @clobbers af,bc,de,hl
; @end
print_prompt:
    ; Prompt: CRLF + user number (when not 0) + drive letter + '>', as in
    ; "3A>".
    ld c, 25                   ; F25: Return Current Disk
    call BDOS                  ; A = current drive (0-15)
    push af
    call print_crlf
    ld e, 0xFF
    ld c, 32                   ; F32: Get User
    call BDOS
    or a
    call nz, print_decimal_a
    pop af
    add a, 'A'
    call putc
    ld a, '>'
    jp putc


; ==========================================================================
; parse_cmd — Parse the command buffer and dispatch
;   In:  cmd_buf filled by BDOS F10
;   Out: nothing (may not return if command reboots)
;   Clobbers: everything
; ==========================================================================
; @proc parse_cmd
; @clobbers af,bc,de,hl,ix
; @end
parse_cmd:
    ld a, (cmd_buf + 1)        ; Characters read
    or a
    ret z                      ; Empty line — just re-prompt

    ; Null-terminate the command for easier parsing
    ld l, a
    ld h, 0
    ld de, cmd_buf + 2
    add hl, de
    ld (hl), 0                 ; Null terminate

    ; "cmd1!cmd2": run cmd1 now and hand the rest to the BDOS, which keeps
    ; it until the next prompt (a program may run in between).
    ld hl, cmd_buf + 2
.bang:
    ld a, (hl)
    or a
    jr z, .no_bang
    inc hl
    cp '!'
    jr nz, .bang
    push hl                    ; HL = text after the '!'
    ld d, h
    ld e, l
    ld b, 0
.bang_len:
    ld a, (hl)
    or a
    jr z, .bang_store
    inc hl
    inc b
    jr .bang_len
.bang_store:
    ld a, b
    or a
    ld c, F_PEND
    call nz, BDOS              ; DE = text, B = length
    pop hl
    dec hl
    ld (hl), 0                 ; cmd1 ends at the '!'
    ld de, cmd_buf + 2
    or a
    sbc hl, de
    ld a, l
    ld (cmd_buf + 1), a        ; new length
.no_bang:
    ld a, (cmd_buf + 1)
    or a
    ret z                      ; nothing before the '!': just re-prompt

    ; Point to start of command text
    ld hl, cmd_buf + 2

    ; Skip leading spaces
.skip_space:
    ld a, (hl)
    cp ' '
    jr nz, .got_cmd
    inc hl
    jr .skip_space

.got_cmd:
    ld (ccp_cmdp), hl          ; the built-ins find their argument from here

    ; Check for drive switch: "X:" where X is A-P, optionally followed by
    ; space, CR, or end of line. Dispatches to BDOS F14 (Select Disk).
    ld a, (hl)
    call to_upper
    cp 'A'
    jr c, .check_builtins
    cp 'P' + 1
    jr nc, .check_builtins
    ld b, a                    ; B = uppercase drive letter
    push hl
    inc hl
    ld a, (hl)
    cp ':'
    jr nz, .not_drive
    inc hl
    ld a, (hl)
    or a
    jr z, .do_drive_switch
    cp ' '
    jr z, .do_drive_switch
.not_drive:
    pop hl
    jr .check_builtins
.do_drive_switch:
    pop hl
    ld a, b
    sub 'A'
    ld e, a
    ld c, 14                   ; F14: Select Disk
    jp BDOS

.check_builtins:
    ; Walk cmd_table: name, 0, handler address.  A table end (name starts
    ; with 0) means the word is not a built-in, so it is loaded as a program.
    ld de, .cmd_table
.bt_next:
    ld a, (de)
    or a
    jp z, .do_load_com         ; HL still holds the start of the command
    push de                    ; str_match gives DE and HL back unchanged
    call str_match
    pop de
    jr z, .bt_hit
.bt_skip:
    ld a, (de)
    inc de
    or a
    jr nz, .bt_skip
    inc de                     ; step over the handler address
    inc de
    jr .bt_next
.bt_hit:
    ld a, (de)                 ; find the end of the name
    inc de
    or a
    jr nz, .bt_hit
    ex de, hl                  ; HL = handler address slot
    ld e, (hl)
    inc hl
    ld d, (hl)
    ex de, hl                  ; HL = handler
    jp (hl)                    ; lint-exempt: stack

; The built-in command names (CP/M 3 User's Guide, Table 4-1 and its
; abbreviations) and their handlers.
.cmd_table:
    db "DIR", 0
    dw .do_dir
    db "DIRSYS", 0
    dw .do_dirsys
    db "DIRS", 0
    dw .do_dirsys
    db "ERASE", 0
    dw .do_era
    db "ERA", 0
    dw .do_era
    db "RENAME", 0
    dw .do_ren
    db "REN", 0
    dw .do_ren
    db "TYPE", 0
    dw .do_type
    db "TYP", 0
    dw .do_type
    db "USER", 0
    dw .do_user
    db "USE", 0
    dw .do_user
    db "HELP", 0
    dw .do_help
    db 0

; --- Built-in commands ---

; An option list ("[...]") needs the related transient (DIR.COM, ERASE.COM,
; RENAME.COM): load the program of the same name, as the manual describes.
.opt_com:
    ld hl, (ccp_cmdp)
    jp .do_load_com

; ERA and REN are abbreviations: the program they load is ERASE.COM /
; RENAME.COM, whatever the line was typed as.  The command tail the program
; sees is still taken from the line itself.
.opt_era:
    ld hl, str_erase_com
    jp .do_load_com
.opt_ren:
    ld hl, str_rename_com
    jp .do_load_com

; ==========================================================================
; DIR / DIRSYS [d:][filespec]
;   DIR lists the files without the SYS attribute, DIRSYS those with it.  A
;   name with no type matches only a blank type; * and ? are wildcards.
; ==========================================================================
.do_dirsys:
    call find_opt
    jr nc, .dirsys_plain
    ; DIRSYS [options] is DIR [SYS options]: put SYS first in the option list
    ; and let DIR.COM do the work.
    ld c, 4                    ; HL = the text after the '['
    ld de, str_sys_opt
    call insert_text
    jp c, .com_unknown         ; no room in the line for it
    ld hl, str_dir_com
    jp .do_load_com
.dirsys_plain:
    ld a, 0x80                 ; list SYS files
    jr .dir_go
.do_dir:
    xor a                      ; list non-SYS files
.dir_go:
    ld (dir_mode), a
    ld hl, 0
    ld (dir_shown), hl         ; dir_shown = dir_other = 0
    call find_opt
    jp c, .opt_com
    call skip_arg
    jr nz, .dir_arg
    ld hl, nul_str             ; no argument: parse fails, FCB is cleared
.dir_arg:
    call parse_filename
    jr nc, .dir_search
    ld hl, type_fcb + 1        ; no name ("DIR", "DIR B:"): every file
    ld b, 11
    ld a, '?'
.fill_q:
    ld (hl), a
    inc hl
    djnz .fill_q
.dir_search:
    ; Display drive for the prefix: the FCB's drive, or the current one.
    ld a, (type_fcb)
    or a
    jr nz, .dir_got_ddrv
    ld c, 25                   ; F25: Return Current Disk
    call BDOS
    jr .dir_ddrv_set
.dir_got_ddrv:
    dec a
.dir_ddrv_set:
    ld (dir_display_drive), a

    ; Compute columns from the console width (SCB 0x1A = conwidth = cols-1;
    ; the BIOS reports 80 in 24x80 mode).  Each entry is "FILENAME TYP"
    ; (12) with " : " (3) between entries and "A: " (3) in front, so a line
    ; of N entries is 15*N characters.  N = floor(width / 16) keeps a spare
    ; column: 2 at 32, 3 at 51, 4 at 64 and 5 (75 characters) at 80.
    ld de, scr_query_pb
    ld c, F_SCB
    call BDOS
    inc a                      ; conwidth+1 = actual column count
    rrca
    rrca
    rrca
    rrca
    and 0x0F                   ; / 16
    jr nz, .cols_ok
    inc a                      ; Minimum 1 column
.cols_ok:
    ld (dir_maxcols), a

    ; Search first
    ld de, type_fcb
    ld c, 17                   ; F17: Search First
    call BDOS
    cp 0xFF
    jp z, .dir_end

    ld b, 0                    ; B = column counter (0-based)
.dir_loop:
    ; A = index (0-3) of match in DMA buffer
    push bc
    call dir_entry             ; HL = entry address

    ; Skip entries with extent > 0 (avoid duplicate filenames)
    push hl
    ld de, 12
    add hl, de
    ld a, (hl)                 ; EX field
    pop hl
    or a
    jr nz, .dir_next_skip

    ; Only one kind is listed: bit 7 of the second type byte is SYS.
    push hl
    ld de, 10
    add hl, de
    ld a, (hl)
    pop hl
    and 0x80
    ld e, a
    ld a, (dir_mode)
    xor e
    jr z, .dir_show
    ld (dir_other), a          ; the other kind exists (non-zero)
    jr .dir_next_skip
.dir_show:
    ld a, 1
    ld (dir_shown), a

    ; At start of line: print "A: " prefix; otherwise print " : " separator
    pop bc                     ; B = column counter
    push bc
    ld a, b
    or a
    jr nz, .mid_line
    ld a, (dir_display_drive)
    add a, 'A'
    call putc
    ld a, ':'
    call putc
    ld a, ' '
    call putc
    jr .print_entry
.mid_line:
    push hl
    ld de, dir_sep
    call pstr
    pop hl
.print_entry:
    inc hl                     ; skip the user byte
    ld b, 8
.pr_name:
    ld a, (hl)
    and 0x7F                   ; mask the attribute bit
    call putc
    inc hl
    djnz .pr_name
    ld a, ' '                  ; where the dot would be (real CP/M style)
    call putc
    ld b, 3
.pr_type:
    ld a, (hl)
    and 0x7F
    call putc
    inc hl
    djnz .pr_type

    ; Advance column
    pop bc                     ; B = column counter
    inc b
    ld a, (dir_maxcols)
    cp b                       ; Reached max columns?
    jr nz, .dir_next           ; Not yet — separator printed before next entry
    push bc
    ld de, msg_crlf
    call pstr
    pop bc
    ld b, 0                    ; Reset column
    jr .dir_next

.dir_next_skip:
    pop bc                     ; Balance the push bc at .dir_loop entry
.dir_next:
    push bc
    ld c, 18                   ; F18: Search Next
    call BDOS
    pop bc
    cp 0xFF
    jp nz, .dir_loop

.dir_end:
    ld a, (dir_shown)
    or a
    jr z, .dir_none
    ld de, msg_crlf            ; final newline
    call pstr
.dir_none:
    ld a, (dir_other)
    or a
    jr nz, .dir_exist
    ld a, (dir_shown)
    or a
    ret nz
    ld de, msg_no_file
    jp pstr
.dir_exist:
    ld de, msg_sys_exist       ; DIR found SYS files ...
    ld a, (dir_mode)
    or a
    jp z, pstr
    ld de, msg_dir_exist       ; ... DIRSYS found non-SYS files
    jp pstr

; ==========================================================================
; TYPE [d:]filename [[PAGE] | [NO PAGE]]
; ==========================================================================
.do_type:
    call get_arg               ; prompts "Enter filename:" when missing
    ret z
    call parse_filename        ; HL = filename string -> type_fcb
    jr c, .no_file

    ld de, type_fcb
    ld c, 15                   ; F15: Open File
    call BDOS
    cp 0xFF
    jr z, .no_file

    ; "[NO PAGE]" (any option starting with N) turns the page pause off
    ; for this listing; the console mode is put back at the end.
    ld de, 0xFFFF
    ld c, F_CONMODE
    call BDOS                  ; HL = con_mode
    ld (type_mode), hl
    call find_opt              ; HL = text after the '['
    jr nc, .type_loop
    ld a, (hl)
    call to_upper
    cp 'N'
    jr nz, .type_loop
    ld hl, (type_mode)
    res 0, l                   ; CON_MODE_PAGE
    ex de, hl
    ld c, F_CONMODE
    call BDOS

    ; Read and print records until EOF
.type_loop:
    ld de, DMA
    ld c, 26                   ; F26: Set DMA
    call BDOS
    ld de, type_fcb
    ld c, 20                   ; F20: Read Sequential
    call BDOS
    or a
    jr nz, .type_eof           ; Non-zero = EOF or error

    ; Print 128 bytes from DMA, stop at Ctrl-Z (0x1A)
    ld hl, DMA
    ld b, 128
.type_char:
    ld a, (hl)
    cp 0x1A                    ; Ctrl-Z = EOF marker
    jr z, .type_eof
    call putc
    inc hl
    djnz .type_char
    jr .type_loop

.type_eof:
    call print_crlf
    ld de, (type_mode)
    ld c, F_CONMODE
    jp BDOS

.no_file:
    ld de, msg_no_file
    jp pstr

.do_help:
    ld de, msg_help
    jp pstr


; ==========================================================================
; ERASE / ERA [d:]filespec
;   Any wildcard asks "ERASE spec (Y/N)?" first, as the DRI CCP does.
;   An option list ("[CONFIRM]") needs ERASE.COM.
; ==========================================================================

.do_era:
    call find_opt
    jp c, .opt_era
    call get_arg               ; prompts "Enter filename:" when missing
    ret z
    push hl
    call parse_filename        ; optional "X:" prefix, wildcards
    pop hl                     ; HL = the spec as typed
    jr c, .no_file
    push hl
    call _fcb_wild             ; Z if there is a wildcard (clobbers HL)
    pop hl
    jr nz, .era_delete         ; no wildcard: no question
    push hl
    ld de, msg_erase
    call pstr
    pop hl
    call print_word
    ld de, msg_yn
    call pstr
    call ask_yes
    ret nz                     ; anything but Y: nothing is erased
.era_delete:
    ld de, type_fcb
    ld c, 19                   ; F19: Delete File (wildcards allowed)
    call BDOS
    inc a                      ; A = 0xFF (nothing matched) -> Z
    ret nz
    jr .no_file


; ==========================================================================
; RENAME / REN new=old        (also "new old", or prompts for both names)
;   The wildcards of the two names must correspond (REN A*.T*=S*.T*): each
;   matching file is renamed on its own, with the new name's '?' filled
;   from the old name.  An existing target asks "delete (Y/N)?".
; ==========================================================================

.do_ren:
    call find_opt
    jp c, .opt_ren
    ld hl, ren_fcb             ; clear ren_fcb and ren_chk (72 bytes)
    ld de, ren_fcb + 1
    ld bc, 71
    ld (hl), 0
    ldir
    call skip_arg
    jr z, .ren_ask
    ld (ren_new), hl           ; start of the new name

    ; Find the separator.  "REN new=old" is the documented form; RENAME.COM
    ; style "REN new old" is accepted too, in the same new-then-old order.
    ; An '=' anywhere wins, so spaces around it do not confuse the split.
.ren_find_eq:
    ld a, (hl)
    or a
    jr z, .ren_find_sp
    cp '='
    jr z, .ren_got_sep
    inc hl
    jr .ren_find_eq
.ren_find_sp:
    ld hl, (ren_new)
.ren_sp_loop:
    ld a, (hl)
    or a
    jp z, .ren_usage
    cp ' '
    jr z, .ren_got_sep
    inc hl
    jr .ren_sp_loop
.ren_got_sep:
    ld (hl), 0                 ; terminate the new name here
    inc hl
    ld (ren_old), hl
    ld hl, (ren_new)
    call ren_new_name
    jp c, .ren_usage
    ld hl, (ren_old)
    jr .ren_old

.ren_ask:
    ld de, msg_ren_new
    call prompt_line
    ret z
    call ren_new_name
    jp c, .ren_usage
    ld de, msg_ren_old
    call prompt_line
    ret z

.ren_old:
    call parse_filename        ; the old name (maybe wild) -> type_fcb
    jp c, .ren_usage
    ld a, (type_fcb)
    or a
    jr nz, .ren_drive_set      ; an explicit old drive wins
    ld a, (ren_drive)
    ld (type_fcb), a
.ren_drive_set:
    ld (ren_drive), a

    ; The wildcards must correspond: '?' in the new name exactly where the
    ; old name has one.
    ld hl, ren_newname
    ld de, type_fcb + 1
    ld b, 11
.ren_wcheck:
    ld a, (hl)
    xor '?'
    cp 1
    sbc a, a                   ; 0xFF where the new name has a '?'
    ld c, a
    ld a, (de)
    xor '?'
    cp 1
    sbc a, a
    xor c
    jp nz, .ren_wild
    inc hl
    inc de
    djnz .ren_wcheck

    ; Each pass searches the directory afresh and takes the first file that
    ; was not left alone before: a renamed file no longer matches the old
    ; name (the wildcards correspond), and the files left alone are the
    ; first matches, in directory order.
    xor a
    ld (ren_skip), a           ; files seen and left alone so far
    ld (ren_any), a            ; non-zero once a file was renamed
.ren_restart:
    ld a, (ren_skip)
    ld (ren_seen), a
    ld de, type_fcb
    ld c, 17                   ; F17: Search First for the old name(s)
    call BDOS
.ren_scan:
    cp 0xFF
    jp z, .ren_end
    call dir_entry             ; HL = directory entry
    push hl
    ld de, 12
    add hl, de
    ld a, (hl)                 ; extent: only the first one names the file
    pop hl
    or a
    jr nz, .ren_nextf
    ld a, (ren_seen)
    or a
    jr z, .ren_found           ; not one of the files left alone
    dec a
    ld (ren_seen), a
.ren_nextf:
    ld c, 18                   ; F18: Search Next
    call BDOS
    jr .ren_scan

.ren_found:
    ; Old name from the entry (attribute bits stripped), new name from the
    ; pattern with '?' replaced by the old name's character.
    inc hl
    ld de, ren_fcb + 1
    ld b, 11
.ren_copy_old:
    ld a, (hl)
    and 0x7F
    ld (de), a
    inc hl
    inc de
    djnz .ren_copy_old
    ld hl, ren_newname
    ld de, ren_fcb + 17
    ld ix, ren_fcb + 1
    ld b, 11
.ren_make_new:
    ld a, (hl)
    cp '?'
    jr nz, .ren_keep
    ld a, (ix + 0)
.ren_keep:
    ld (de), a
    inc hl
    inc de
    inc ix
    djnz .ren_make_new
    ld a, (ren_drive)
    ld (ren_fcb), a
    ld (ren_chk), a

    ; Renaming a file to its own name needs nothing.
    ld hl, ren_fcb + 1
    ld de, ren_fcb + 17
    ld b, 11
.ren_same:
    ld a, (de)
    cp (hl)
    jr nz, .ren_differs
    inc hl
    inc de
    djnz .ren_same
    jr .ren_left
.ren_differs:

    ; Does the new name already exist?
    ld hl, ren_fcb + 17
    ld de, ren_chk + 1
    ld bc, 11
    ldir
    ld de, ren_chk
    ld c, 17                   ; F17: Search First for the new name
    call BDOS
    inc a
    jr z, .ren_do              ; nothing there
    ld de, msg_not_renamed
    call pstr
    ld hl, ren_fcb + 17
    call print_name11
    ld de, msg_exists
    call pstr
    call ask_yes
    jr nz, .ren_left           ; keep the old file, leave this one alone
    ld de, ren_chk
    ld c, 19                   ; F19: Delete the existing file
    call BDOS
.ren_do:
    ld de, ren_fcb
    ld c, 23                   ; F23: Rename this one file
    call BDOS
    inc a
    jr z, .ren_left            ; refused (read-only): leave it alone
    ld a, 1
    ld (ren_any), a
    jp .ren_restart
.ren_left:
    ld hl, ren_skip
    inc (hl)
    jp .ren_restart

.ren_end:
    ld hl, ren_skip            ; ren_any follows ren_skip
    ld a, (hl)
    inc hl
    or (hl)
    ret nz                     ; something matched
    jp .no_file                ; "No File": nothing matched

.ren_wild:
    ld de, msg_ren_wild
    jp pstr

.ren_usage:
    ld de, msg_ren_usage
    jp pstr


; ==========================================================================
; USER [n] — set the CP/M user area (0-15); asks "Enter User# :" if no number
;   Uses BDOS F32, which also keeps page-zero byte 0004h in sync for
;   programs that read it.
; ==========================================================================

.do_user:
    call skip_arg
    jr nz, .user_num
    ld de, msg_enter_user
    call prompt_line
    ret z                      ; just Return: leave the user alone
.user_num:
    ; First digit
    ld a, (hl)
    cp '0'
    jr c, .user_usage
    cp '9' + 1
    jr nc, .user_usage
    sub '0'
    ld b, a
    inc hl

    ; Optional second digit, so USER 10..15 works
    ld a, (hl)
    cp '0'
    jr c, .user_delim
    cp '9' + 1
    jr nc, .user_delim
    sub '0'
    ld c, a
    ld a, b
    add a, a                   ; x2
    add a, a                   ; x4
    add a, b                   ; x5
    add a, a                   ; x10
    add a, c
    ld b, a
    inc hl
.user_delim:
    ; The number must end at a delimiter
    ld a, (hl)
    or a
    jr z, .user_set
    cp ' '
    jr nz, .user_usage
.user_set:
    ld a, b
    cp 16
    jr nc, .user_usage
    ld e, a
    ld c, 32                   ; F32: Set User
    jp BDOS

.user_usage:
    ld de, msg_user_usage
    jp pstr


; ==========================================================================
; .do_load_com — Try to load and execute COMMAND.COM
;   HL points to the command name in the input buffer.
;   Parse the name, append .COM, open, load to 0100h, execute.
; ==========================================================================
.do_load_com:
    ; Parse command name into com_fcb (reuse parse_filename)
    ; First, extract just the command name (up to space or null)
    call parse_filename        ; Fills type_fcb from (HL)
    jp c, .com_unknown         ; Parse error

    ; --- Build the working search-path list ---
    ; Explicit drive in the command (e.g. "B:FOO") uses just that drive.
    ; Otherwise pull the SETDEF search path. Either way, the result lands
    ; in ccp_search_buf and the rest of the code walks it identically.
    ld a, (type_fcb)
    or a
    jr z, .com_use_setdef_path
    ld (ccp_search_buf), a
    xor a
    ld (ccp_search_buf + 1), a
    ld (ccp_search_buf + 2), a
    ld (ccp_search_buf + 3), a
    jr .com_path_ready
.com_use_setdef_path:
    ld de, ccp_search_buf
    ld c, F_GET_PATH
    call BDOS
.com_path_ready:

    ; --- Apply ORDER: try the configured extensions in sequence ---
    ; A .SUB hit below rewrites the command to "SUBMIT <name>" and re-enters
    ; parse_cmd.  SUBMIT.COM must still load even when ORDER=(SUB) excludes
    ; .COM files, otherwise the feature could never run a submit file.
    ld a, (ccp_force_com)
    or a
    jr z, .com_read_order
    xor a
    ld (ccp_force_com), a
    jp .com_order_c
.com_read_order:
    ld c, F_GET_ORD
    call BDOS                  ; A = bdos_order
    cp ORDER_SUB_COM
    jr z, .com_order_sc
    cp ORDER_COM
    jr z, .com_order_c
    cp ORDER_SUB
    jr z, .com_order_s
    ; default / ORDER_COM_SUB
    call .com_try_com
    call .com_try_sub
    jp .com_unknown
.com_order_c:
    call .com_try_com
    jp .com_unknown
.com_order_s:
    call .com_try_sub
    jp .com_unknown
.com_order_sc:
    call .com_try_sub
    call .com_try_com
    jp .com_unknown

; .com_try_com / .com_try_sub — Walk ccp_search_buf with the given extension.
;   On success: tail-jumps to .com_opened (COM) or .com_chain_submit (SUB).
;   On miss: returns to caller so the next extension can be tried.
.com_try_com:
    ld a, 'C'
    ld (type_fcb + 9), a
    ld a, 'O'
    ld (type_fcb + 10), a
    ld a, 'M'
    ld (type_fcb + 11), a
    call .com_clear_fcb_tail
    call .com_walk_path
    ret nc
    jp .com_opened

.com_try_sub:
    ld a, 'S'
    ld (type_fcb + 9), a
    ld a, 'U'
    ld (type_fcb + 10), a
    ld a, 'B'
    ld (type_fcb + 11), a
    call .com_clear_fcb_tail
    call .com_walk_path
    ret nc
    ; Found a .SUB hit. Rewrite cmd_buf as "SUBMIT <orig>" and re-enter
    ; parse_cmd so the regular load path runs SUBMIT.COM (which the PRL
    ; loader now handles). SUBMIT will create A:$$$.SUB and the prompt
    ; loop's existing $$$.SUB drain takes over from there.
    pop hl                     ; discard the ORDER dispatcher's return
    ld a, (type_fcb)           ; the drive the search path found it on
    or a
    jr z, .sub_prefix          ; the current drive: nothing to add
    add a, 'A' - 1
    ld (sub_drive_text), a
    ld hl, (ccp_cmdp)
    inc hl
    ld a, (hl)
    dec hl
    cp ':'
    jr z, .sub_prefix          ; the line names the drive itself
    ld de, sub_drive_text      ; "X:" in front of the name
    ld c, 2
    call insert_text
    jp c, .com_unknown         ; the rewritten line would not fit
.sub_prefix:
    ld hl, cmd_buf + 2
    ld de, str_submit_prefix
    ld c, 7
    call insert_text
    jp c, .com_unknown
    ld a, 1
    ld (ccp_force_com), a      ; load SUBMIT.COM regardless of ORDER
    jp parse_cmd

.com_clear_fcb_tail:
    ld hl, type_fcb + 12
    ld b, 24
    xor a
.cft_loop:
    ld (hl), a
    inc hl
    djnz .cft_loop
    ret

; .com_walk_path — Walk ccp_search_buf attempting F15 with the current
;   extension on each non-empty drive slot.
;   Out: CF=1 if a hit was found (type_fcb left holding the matched drive),
;        CF=0 otherwise.
.com_walk_path:
    ld hl, ccp_search_buf
    ld b, 4
.wp_loop:
    ld a, (hl)
    or a
    jr z, .wp_next
    cp 0xFF
    jr nz, .wp_set
    xor a                      ; '*' → FCB drive = 0 (= current drive)
.wp_set:
    ld (type_fcb), a
    push hl
    push bc
    ld de, type_fcb
    ld c, 15                   ; F15: Open File
    call BDOS
    pop bc
    pop hl
    cp 0xFF
    jr nz, .wp_found
.wp_next:
    inc hl
    djnz .wp_loop
    or a                       ; CF=0, not found
    ret
.wp_found:
    scf                        ; CF=1, found
    ret

.com_opened:
    ; Peek at the first record to spot a CP/M 3 PRL/RSX prefix (file starts
    ; with 0xC9 RET). For these binaries the program is assembled as if
    ; loaded at 0x0100, so there's nothing to relocate — we just have to
    ; skip the 256-byte header before loading the rest. SUBMIT.COM and
    ; SET.COM both follow this convention (code spans 0x0100..end of file
    ; minus header, and all internal addresses already resolve into that
    ; range).
    ld de, ccp_prl_header
    ld c, 26                   ; F26: Set DMA
    call BDOS
    ld de, type_fcb
    ld c, 20                   ; F20: Read Sequential — consume record 0
    call BDOS
    or a
    jr nz, .com_reopen_classic

    ld a, (ccp_prl_header)
    cp 0xC9
    jr nz, .com_reopen_classic
    ld a, (ccp_prl_header + 1)
    or a
    jr nz, .com_reopen_classic
    ld a, (ccp_prl_header + 3)
    cp 0xC9
    jr z, .com_opened_prl

.com_reopen_classic:
    ; Classic .COM — rewind so the loader reads from record 0 again.
    ld de, type_fcb
    ld c, 16                   ; F16: Close File
    call BDOS
    ld de, type_fcb
    ld c, 15                   ; F15: Open File
    call BDOS
    cp 0xFF
    jp z, .com_unknown
    jr .com_do_load

.com_opened_prl:
    ; PRL/RSX — consume the second header record so the loader picks up at
    ; record 2 (start of program code). No relocation, no BSS zero — the
    ; reference utilities don't need either.
    ld de, ccp_prl_header
    ld c, 26
    call BDOS
    ld de, type_fcb
    ld c, 20
    call BDOS
    or a
    jp nz, .com_unknown

    ; (Command tail is set up after FCB parsing, so clear_fcb_de
    ; on FCB2 at 006Ch doesn't clobber the tail at 0080h.)

.com_do_load:
    ; Load .COM file to 0100h via a page-zero stub.
    ;
    ; The stub and its FCB copy live in page zero (0x0008+).
    ; The stub uses .stub_fcb (not 005Ch) for reading, so FCB1/FCB2
    ; at 005Ch/006Ch remain intact for the loaded program.
    ;
    ; Layout in page zero:
    ;   0x0008 .. 0x0008+stub_size-1 : loader stub code
    ;   .stub_fcb = 0x0008+stub_size  : 36-byte command FCB copy
    ;   0x0038                        : ISR vector (preserved: stub fits below)

    ; --- Parse arguments into FCB1 (005Ch) and FCB2 (006Ch) ---
    ; HL still points into cmd_buf after .com_found_space / .com_no_args.
    ; Find the first argument after the command word.
    call skip_arg
    jr z, .com_args_done       ; No args at all

    ; Parse first argument into FCB1 at 005Ch
    ld de, 0x005C
    call parse_fcb             ; HL advanced past first arg

    ; Skip spaces between first and second arg
.com_skip_space2:
    ld a, (hl)
    or a
    jr z, .com_clear_fcb2
    cp ' '
    jr nz, .com_parse_arg2
    inc hl
    jr .com_skip_space2

.com_parse_arg2:
    ; Parse second argument into FCB2 at 006Ch
    ld de, 0x006C
    call parse_fcb
    jr .com_load_file

.com_args_done:
    ; No arguments — clear FCB1 at 005Ch
    ld de, 0x005C
    call .clear_fcb_de

.com_clear_fcb2:
    ; Clear FCB2 at 006Ch
    ld de, 0x006C
    call .clear_fcb_de

.com_load_file:
    ; --- Set up command tail at 0080h ---
    ; Done here (after FCB parsing) so clear_fcb_de on FCB2 at 006Ch
    ; doesn't clobber the tail at 0080h (006Ch + 36 = 0090h).
    ld hl, (ccp_cmdp)
.com_skip_name:
    ld a, (hl)
    or a
    jr z, .com_no_tail
    cp ' '
    jr z, .com_found_space
    inc hl
    jr .com_skip_name
.com_found_space:
    ; HL points to space after command. Copy rest to 0081h+
    ld de, 0x0081
    ld b, 0                    ; Length counter
.com_copy_tail:
    ld a, (hl)
    or a
    jr z, .com_tail_done
    ld (de), a
    inc hl
    inc de
    inc b
    jr .com_copy_tail
.com_tail_done:
    ; Null-terminate so the loaded program's parser stops at end of
    ; tail rather than reading into whatever the last DMA left at
    ; 0x0081+length+ (e.g. DIR's F17 search results). Without this,
    ; RENAME.COM parses "rped.sub\0mno..." after a `dir *.sub`.
    xor a
    ld (de), a
    ld a, b
    ld (0x0080), a             ; Store tail length
    jr .com_tail_ready

.com_no_tail:
    xor a
    ld (0x0080), a             ; Empty tail
    ld (0x0081), a             ; ...with a null at [0x0081] too

.com_tail_ready:
    ; Copy type_fcb into the common-memory buffer reserved by the BIOS
    ; (ccp_fcb, just above COMMON_BASE).  A loaded program cannot reach
    ; it, unlike the old copy at F5DC which a large .COM overwrote while
    ; the loader stub was still reading it.
    ld hl, CCP_FCB_ADDR
    ld (.stub_fcb_addr), hl    ; Save for patching the stub
    ex de, hl                  ; DE = common FCB address
    ld hl, type_fcb
    ld bc, 36
    ldir

    ; Copy the loader stub to 0x0008
    ld hl, .stub_src
    ld de, 0x0008
    ld bc, .stub_src_end - .stub_src
    ldir

    ; Patch the stub's FCB address (the LD DE,xxxx at offset .stub_fcb_ref)
    ld hl, (.stub_fcb_addr)
    ld (0x0008 + .stub_fcb_ref - .stub_src + 1), hl

    ; Set SP to the top of the TPA (COMMON_BASE, not bdos_stub — the
    ; common SCB and visible BIOS table live above F600 and must not be
    ; overwritten by the program's stack).
    ld sp, TPA_TOP
    jp 0x0008

.stub_fcb_addr: dw 0          ; Patched FCB address in high TPA

    ; Helper: clear the 36-byte FCB at DE (drive=0, name/ext=spaces, rest=0):
    ; parsing the empty string does exactly that.
.clear_fcb_de:
    ld hl, nul_str
    jp parse_fcb

    ; The stub is position-independent (JR=relative, CALL/JP=absolute).
    ; The FCB address in the LD DE below is patched by the CCP before jumping here.
.stub_src:
    ld hl, 0x0100              ; Load address
.stub_loop:
    push hl
    ld d, h
    ld e, l
    ld c, 26                   ; F26: Set DMA
    call 0x0005
    pop hl
    push hl
.stub_fcb_ref:
    ld de, 0x0000              ; FCB in high TPA (PATCHED by CCP before jump)
    ld c, 20                   ; F20: Read Sequential
    call 0x0005
    pop hl
    or a
    jr nz, .stub_done          ; EOF/error → done loading
    ld de, 128
    add hl, de
    jr .stub_loop
.stub_done:
    ; Reset DMA, then jump to loaded program.
    ; Per CP/M convention, the transient program is entered with
    ; C = currently selected drive so utilities like STAT can recover it.
    ld de, 0x0080
    ld c, 26
    call 0x0005
    ld c, 25                   ; F25: Return Current Disk
    call 0x0005
    ld c, a                    ; C = current drive (0=A:, 1=B:, ...)
    jp CCP_RUN_PROG            ; common-memory helper: COM header handling
.stub_src_end:

    ; The stub is copied to 0008h, so it must stop before the IM 1
    ; interrupt vector at 0038h (the BIOS installs JP isr_handler there).
    assert .stub_src_end - .stub_src <= 0x0038 - 0x0008, \
        "COM loader stub overruns the IM 1 vector at 0038h"

    ; (Loading and execution handled by stub at 0x0008)

.com_unknown:
    ; Repeat the command word followed by a question mark, as CP/M 3 does.
    ld hl, (ccp_cmdp)
    call print_word
    ld de, msg_unknown
    jp pstr


; ==========================================================================
; Helpers shared by the built-in commands
; ==========================================================================

; skip_arg — find the argument that follows the command word
;   Out: HL = argument text; Z set if there is none
; @proc skip_arg
; @out   hl
; @out   zero
; @clobbers af
; @end
skip_arg:
    ld hl, (ccp_cmdp)
.word:
    ld a, (hl)
    or a
    ret z                      ; no argument
    inc hl
    cp ' '
    jr nz, .word
.spaces:
    ld a, (hl)
    cp ' '
    jr nz, .done
    inc hl
    jr .spaces
.done:
    or a                       ; Z if the text ended
    ret

; get_arg — the argument, or ask for a file name when there is none
;   Out: HL = text; Z set if still empty
; @proc get_arg
; @out   hl
; @out   zero
; @clobbers af,bc,de
; @end
get_arg:
    call skip_arg
    ret nz
    ld de, msg_enter_file
    ; falls through to prompt_line

; prompt_line — print the prompt at DE and read a line into cmd_buf
;   Out: HL = line text (NUL-terminated); Z set if the line is empty
; @proc prompt_line
; @out   hl
; @out   zero
; @clobbers af,bc,de
; @end
prompt_line:
    ld c, F_PSTR
    call BDOS
    ld de, cmd_buf
    ld c, F_RDBUF
    call BDOS                  ; the BDOS ends the line itself
    ld hl, cmd_buf + 2
    ld a, (cmd_buf + 1)
    ld e, a
    ld d, 0
    add hl, de
    ld (hl), 0
    ld hl, cmd_buf + 2
    or a                       ; Z if the line is empty
    ret

; find_opt — look for an option list in the command line
;   Out: CF set and HL = text after the '[' if there is one
; @proc find_opt
; @out   carry
; @out   hl
; @clobbers af
; @end
find_opt:
    ld hl, (ccp_cmdp)
.scan:
    ld a, (hl)
    or a
    ret z                      ; end of line, carry clear
    inc hl
    cp '['
    jr nz, .scan
    scf
    ret

; insert_text — put C characters from DE into the command line at HL
;   In:  HL = a position in cmd_buf's text, DE = the text, C = its length
;   Out: carry set if the line would not fit (126 characters); otherwise the
;        text is in, cmd_buf+1 is the new length and the line ends in a NUL
; @proc insert_text
; @param %at:u16 hl
; @param %src:u16 de
; @param %n:u8 c
; @out   carry
; @clobbers af,bc,de,hl
; @end
insert_text:
    ld a, (cmd_buf + 1)
    add a, c
    cp 127
    ccf
    ret c                      ; no room
    ld (cmd_buf + 1), a
    push de                    ; the text
    push bc                    ; its length
    push hl                    ; the position
    ld e, a
    ld d, 0
    ld hl, cmd_buf + 2
    add hl, de                 ; HL = the NUL that ends the new line
    ex de, hl                  ; DE = that NUL
    ld h, d
    ld l, e
    ld b, 0
    or a
    sbc hl, bc                 ; HL = the NUL that ended the old line
    pop bc                     ; BC = the position
    push hl
    or a
    sbc hl, bc
    inc hl
    ld b, h
    ld c, l                    ; BC = the tail and its NUL
    pop hl
    lddr                       ; move the tail up (ends with DE just below it)
    pop bc                     ; C = the length of the text
    ld b, 0
    pop hl                     ; HL = the text
    add hl, bc
    dec hl                     ; its last character
    lddr                       ; fills the gap, backwards
    or a
    ret

; putc — print the character in A, keeping BC and HL
; @proc putc
; @param %ch:u8 a
; @clobbers af,de
; @end
putc:
    push bc
    push hl
    ld e, a
    ld c, F_COUT
    call BDOS
    pop hl
    pop bc
    ret

; pstr — print the '$'-terminated string at DE
; @proc pstr
; @param %str:u16 de
; @clobbers af,bc,de,hl
; @end
pstr:
    ld c, F_PSTR
    jp BDOS

; print_word — print the word at HL (up to a space or the end) in capitals
; @proc print_word
; @param %str:u16 hl
; @clobbers af,bc,de,hl
; @end
print_word:
    ld a, (hl)
    or a
    ret z
    cp ' '
    ret z
    call to_upper
    call putc
    inc hl
    jr print_word

; print_name11 — print "NAME.TYP" from the 11 name bytes at HL
; @proc print_name11
; @param %name:u16 hl
; @clobbers af,bc,de,hl
; @end
print_name11:
    ld b, 8
    call .part
    ld a, (hl)
    cp ' '
    ret z                      ; no type
    ld a, '.'
    call putc
    ld b, 3
.part:
    ld a, (hl)
    inc hl
    cp ' '
    call nz, putc
    djnz .part
    ret

; ren_new_name — parse the new name of a RENAME into ren_newname / ren_drive
;   In:  HL = the text
;   Out: CF set if the name is not valid
; @proc ren_new_name
; @param %str:u16 hl
; @out   carry
; @clobbers af,bc,de,hl
; @end
ren_new_name:
    call parse_filename
    ret c
    ld a, (type_fcb)
    ld (ren_drive), a
    ld hl, type_fcb + 1
    ld de, ren_newname
    ld bc, 11
    ldir
    ret                        ; carry is still clear




; ==========================================================================
; str_match — Case-insensitive match of (HL) against (DE)
;   DE points to uppercase null-terminated command name.
;   HL points to input text.
;   Match succeeds if input starts with the command (followed by
;   space, null, or end of input).
;   Out: Z flag set if match
;   Clobbers: AF
; ==========================================================================
; @proc str_match
; @param %input:u16  hl
; @param %pattern:u16 de
; @out   zero
; @clobbers af,bc,de,hl
; @end
str_match:
    push hl
    push de
.loop:
    ld a, (de)
    or a
    jr z, .end_pattern         ; End of pattern — check delimiter
    ; Compare with input (case-insensitive)
    ld a, (hl)
    call to_upper
    push af
    ld a, (de)
    ld b, a                    ; B = pattern char (already upper)
    pop af                     ; A = input char (uppercased)
    cp b
    jr nz, .no_match
    inc hl
    inc de
    jr .loop

.end_pattern:
    ; Pattern ended — input must be at space, null, or end
    ld a, (hl)
    or a
    jr z, .match               ; Null = match
    cp ' '
    jr z, .match               ; Space = match
    cp 0x0D
    jr z, .match               ; CR = match
    ; Fall through: no match (input has more chars)

.no_match:
    pop de
    pop hl
    or 1                       ; Clear Z flag
    ret

.match:
    pop de
    pop hl
    xor a                      ; Set Z flag
    ret


; ==========================================================================
; _fcb_wild — Z if the FCB in type_fcb contains a '?' wildcard
;   Out: Z set when any name/extension byte is '?'
;   Clobbers: AF, B, HL
; ==========================================================================
; @proc _fcb_wild
; @out   zero
; @clobbers af,b,hl
; @end
_fcb_wild:
    ld hl, type_fcb + 1
    ld b, 11
.fw_loop:
    ld a, (hl)
    cp '?'
    ret z
    inc hl
    djnz .fw_loop
    ld a, 1
    or a                       ; NZ: no wildcard found
    ret


; ------------------------------------------------------------------
; to_upper — Convert A to uppercase if lowercase
;   In:  A = character
;   Out: A = uppercased character
;   Clobbers: (none besides A)
; ------------------------------------------------------------------
; @proc to_upper
; @param %ch:u8 a
; @out   a
; @end
to_upper:
    cp 'a'
    ret c
    cp 'z' + 1
    ret nc
    sub 0x20                   ; 'a' - 'A' = 0x20
    ret


; ==========================================================================
; profile_cmd - Run PROFILE.SUB on a cold start
;
;   CP/M 3 submits PROFILE.SUB before the first prompt.  We hand it to
;   SUBMIT.COM through the normal command path: cmd_buf is filled with
;   "SUBMIT PROFILE.SUB" and the caller jumps to its ".got_line" entry, so
;   the profile runs exactly like a typed command and the $$$.SUB drain
;   takes over from there.
;
;   The search is on the default drive (drive byte 0), which is A: after a
;   cold boot.  A missing PROFILE.SUB leaves the prompt alone; a missing
;   SUBMIT.COM reports "?" like any other unknown command.
;
;   Out:      carry set   = cmd_buf holds the command to run
;             carry clear = no PROFILE.SUB, just prompt
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc profile_cmd
; @out   carry
; @clobbers af,bc,de,hl
; @end
profile_cmd:
    ld hl, str_profile_cmd + 7 ; "PROFILE.SUB", default drive
    call parse_filename
    ld de, type_fcb
    ld c, 17                   ; F17: Search First on the default drive
    call BDOS
    inc a                      ; 0xFF (not found) wraps to zero
    jp nz, .found
    xor a                      ; carry clear: nothing to submit
    ret
.found:
    ld hl, str_profile_cmd
    ld de, cmd_buf + 2
    ld bc, PROFILE_CMD_LEN + 1 ; command text plus its NUL
    ldir
    ld a, PROFILE_CMD_LEN
    ld (cmd_buf + 1), a
    scf
    ret


; ==========================================================================
; try_sub — If A:$$$.SUB is active, load the next line into cmd_buf;
;   otherwise leave cmd_buf untouched.  The caller echoes the line (after the
;   prompt, when DISPLAY is on).
;
;   $$$.SUB record layout (128 bytes):
;     byte 0  : length L, or 0xFF if the record has been consumed
;     1..L    : command text (no terminator; L <= 126)
;
;   Records are consumed from the highest index downwards — SUBMIT writes the
;   commands in reverse execution order so the *last* record is the *first*
;   line to run. Consuming a record is just overwriting byte 0 with 0xFF; we
;   never rewrite or rename the file. Once every record is consumed (or on any
;   error) the file is deleted.
;
;   Out: carry clear if cmd_buf was filled from SUB (skip F10 read)
;        carry set if no SUB line is available (caller should F10)
;   Clobbers: AF, BC, DE, HL
; @proc try_sub
; @out   carry
; @clobbers af,bc,de,hl
; @end
try_sub:
    ld hl, str_sub_name
    ld de, sub_fcb
    call parse_fcb

    ; SUBMIT creates $$$.SUB on the current drive, not necessarily A:.
    ld c, 25                   ; F25: Return Current Disk
    call BDOS
    inc a                      ; 1-based drive for the FCB
    ld (sub_fcb), a

    ld de, sub_fcb
    ld c, 15                   ; F15: Open File
    call BDOS
    cp 0xFF
    jr nz, .opened
    scf                        ; No $$$.SUB on the current drive
    ret

.opened:
    ld de, sub_fcb
    ld c, 35                   ; F35: Compute File Size → R0/R1/R2
    call BDOS

    ld a, (sub_fcb + 35)
    or a
    jp nz, .abort              ; > 16M records: bogus, nuke it
    ld a, (sub_fcb + 34)
    ld h, a
    ld a, (sub_fcb + 33)
    ld l, a
    or h
    jp z, .all_done            ; Zero-length file

    dec hl                     ; HL = index of last record

.scan:
    call sub_read
    jp nz, .abort              ; read error

    ld a, (sub_dma)
    cp 0xFF
    jr nz, .found

    ld a, h
    or l
    jp z, .all_done            ; record 0 was already consumed — done
    dec hl
    jr .scan

.found:
    ; A = length byte, HL = record index (random record still set in FCB)
    cp 127
    jp nc, .abort              ; garbage length

    ld (cmd_buf + 1), a
    or a
    jr z, .copied              ; empty line
    ld c, a
    ld b, 0
    push hl
    ld hl, sub_dma + 1
    ld de, cmd_buf + 2
    ldir
    pop hl
    xor a
    ld (de), a                 ; NUL-terminate for parse_cmd
.copied:
    ; Mark this record consumed, keeping the record index for the
    ; collection below.
    call sub_consume

    ; CP/M Plus feeds a program with the '<' lines that follow its command.
    ; Collect them now (the program cannot read the file itself) and queue
    ; them as console input.  Records are consumed from the highest index
    ; down, so continue downwards from the command line.
.collect:
    ld a, h
    or l
    jr z, .collect_done        ; the command was record 0: nothing follows
    dec hl
.collect_scan:
    call sub_read
    jr nz, .collect_done       ; read error: leave the rest to the CCP

    ld a, (sub_dma)
    cp 0xFF
    jr z, .collect_next        ; already consumed: keep looking downwards
    or a
    jr z, .collect_done        ; empty line: not program input
    cp 127
    jr nc, .collect_done       ; garbage length
    ld b, a                    ; B = line length
    ld a, (sub_dma + 1)
    cp '<'
    jr nz, .collect_done       ; the next command: leave it for try_sub

    ; Queue the text after the '<'.  HL is saved because the BDOS and F34
    ; both clobber it.
    dec b
    ld de, sub_dma + 2
    push hl
    ld c, F_SUBIN
    call BDOS
    pop hl
    call sub_consume
.collect_next:
    ld a, h
    or l
    jr z, .collect_done
    dec hl
    jr .collect_scan
.collect_done:

    ld de, sub_fcb
    ld c, 16                   ; F16: Close File
    call BDOS
    call restore_dma
    xor a                      ; CF=0 → cmd_buf is loaded (.prompt echoes it)
    ret

.all_done:
.abort:
    ld de, sub_fcb
    ld c, 16                   ; F16: Close (harmless if never fully opened)
    call BDOS
    ld de, sub_fcb
    ld c, 19                   ; F19: Delete File
    call BDOS
    call restore_dma
    scf
    ret


; dir_entry — address of a directory entry that F17/F18 returned
;   In:  A = its index (0-3) in the DMA buffer at 0080h
;   Out: HL = 0080h + A * 32
; @proc dir_entry
; @param %idx:u8 a
; @out   hl
; @clobbers af
; @end
dir_entry:
    rrca
    rrca
    rrca                       ; A * 32 for A < 8
    add a, DMA                 ; 0080h + 96 at most: no carry
    ld l, a
    ld h, 0
    ret

; ask_yes — read one key as the answer to a (Y/N) question
;   Out: Z set if it was Y or y
; @proc ask_yes
; @out   zero
; @clobbers af,bc,de,hl
; @end
ask_yes:
    ld c, F_CIN
    call BDOS
    and 0xDF                   ; upper case
    push af
    call print_crlf
    pop af
    cp 'Y'
    ret

; sub_read — read record HL of $$$.SUB into sub_dma
;   In:  HL = record index
;   Out: Z set if it was read; HL unchanged
; @proc sub_read
; @param %rec:u16 hl
; @out   zero
; @clobbers af,bc,de
; @end
sub_read:
    ld (sub_fcb + 33), hl      ; random record = HL (R0, R1)
    xor a
    ld (sub_fcb + 35), a       ; R2
    push hl
    ld de, sub_dma
    ld c, 26                   ; F26: Set DMA
    call BDOS
    ld de, sub_fcb
    ld c, 33                   ; F33: Read Random
    call BDOS
    pop hl
    or a
    ret

; sub_consume — mark the record just read as used (byte 0 = 0xFF) and write
;   it back
;   In:  HL = record index (kept)
; @proc sub_consume
; @param %rec:u16 hl
; @clobbers af,bc,de
; @end
sub_consume:
    ld a, 0xFF
    ld (sub_dma), a
    push hl
    ld de, sub_fcb
    ld c, 34                   ; F34: Write Random
    call BDOS
    pop hl
    ret

; ------------------------------------------------------------------
; restore_dma — point the BDOS DMA back at 0x0080 after $$$.SUB I/O.
;   The CCP's DIR built-in (and loaded programs) expect 0x0080.
; @proc restore_dma
; @clobbers af,bc,de
; @end
restore_dma:
    ld de, 0x0080
    ld c, 26                   ; F26: Set DMA
    jp BDOS


; ==========================================================================
; echo_sub_line — Print cmd_buf text + CRLF so a SUB line is visible after
;   the prompt the same way a typed command would be.
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc echo_sub_line
; @clobbers af,bc,de,hl
; @end
echo_sub_line:
    ld a, (cmd_buf + 1)
    or a
    jr z, .crlf
    ld b, a
    ld hl, cmd_buf + 2
.loop:
    ld a, (hl)
    call putc                  ; keeps BC and HL
    inc hl
    djnz .loop
.crlf:
    jp print_crlf


; ==========================================================================
; Data
; ==========================================================================

; Messages ('$' terminated for BDOS F9)
msg_unknown:
    db "?", 0x0D, 0x0A, '$'

msg_crlf:
    db 0x0D, 0x0A, '$'

dir_sep:
    db " : ", '$'

msg_no_file:
    db "No File", 0x0D, 0x0A, '$'

msg_sys_exist:
    db "SYSTEM FILE(S) EXIST", 0x0D, 0x0A, '$'

msg_dir_exist:
    db "NON-SYSTEM FILE(S) EXIST", 0x0D, 0x0A, '$'

msg_enter_file:
    db "Enter filename:", '$'

msg_erase:
    db "ERASE ", '$'

msg_yn:
    db " (Y/N)?", '$'

msg_ren_usage:
    db "REN new=old", 0x0D, 0x0A, '$'

msg_ren_wild:
    db "Wildcards do not correspond", 0x0D, 0x0A, '$'

msg_ren_new:
    db "Enter New Name:", '$'

msg_ren_old:
    db "Enter Old Name:", '$'

msg_not_renamed:
    db "Not renamed ", '$'

msg_exists:
    db " file already exists", 0x0D, 0x0A, "delete (Y/N)?", '$'

msg_enter_user:
    db "Enter User# : ", '$'

msg_user_usage:
    db "USER n (0-15)", 0x0D, 0x0A, '$'

msg_help:
    db "Built-in commands:", 0x0D, 0x0A
    db "  DIR, DIRSYS (DIRS)  list files", 0x0D, 0x0A
    db "  ERASE (ERA)  RENAME (REN)", 0x0D, 0x0A
    db "  TYPE (TYP)   USER (USE)   HELP", 0x0D, 0x0A
    db "d:name.typ takes * and ?.  [options]", 0x0D, 0x0A
    db "load the .COM of the same name.", 0x0D, 0x0A
    db "cmd1!cmd2 runs cmd1 then cmd2.", 0x0D, 0x0A
    db '$'

nul_str:
    db 0
str_erase_com:
    db "ERASE", 0
str_rename_com:
    db "RENAME", 0
str_dir_com:
    db "DIR", 0
str_sys_opt:
    db "SYS "

; ------------------------------------------------------------------
; print_crlf — Print CR+LF
; ------------------------------------------------------------------
; @proc print_crlf
; @clobbers af,bc,de,hl
; @end
print_crlf:
    ld de, msg_crlf
    jp pstr


; ------------------------------------------------------------------
; print_decimal_a — Print A as decimal (handles 0-99)
;   In:  A = value
;   Clobbers: AF, BC, DE
; ------------------------------------------------------------------
; @proc print_decimal_a
; @param %val:u8 a
; @clobbers af,bc,de
; @end
print_decimal_a:
    ld b, 0
.pda_tens:
    sub 10
    jr c, .pda_ones
    inc b
    jr .pda_tens
.pda_ones:
    add a, 10              ; A = ones digit
    push af
    ld a, b
    or a
    jr z, .pda_no_tens
    add a, '0'
    call putc
.pda_no_tens:
    pop af
    add a, '0'
    jp putc


; ------------------------------------------------------------------
; parse_filename — Parse "FILENAME.EXT" at HL into type_fcb
;   In: HL = pointer to null-terminated filename string
;   Out: type_fcb filled, HL = first char after parsed name
;        carry clear = OK, carry set = error
;   Clobbers: AF, BC, DE, HL
; ------------------------------------------------------------------
; @proc parse_filename
; @param %str:u16 hl
; @out   carry
; @clobbers af,bc,de,hl
; @end
parse_filename:
    ld de, type_fcb            ; parse_fcb also handles the "X:" prefix
    jp parse_fcb

; ------------------------------------------------------------------
; parse_fcb — Parse "FILENAME.EXT" at HL into FCB at DE
;   In: HL = pointer to null-terminated filename string
;        DE = destination FCB (36 bytes)
;   Out: FCB filled, HL = first char after parsed name (space/null)
;        carry clear = OK, carry set = error
;   Clobbers: AF, BC, DE, HL
; ------------------------------------------------------------------
; @proc parse_fcb
; @param %str:u16 hl
; @param %fcb:u16 de
; @out   carry
; @clobbers af,bc,de,hl
; @end
parse_fcb:
    push hl
    push de
    ; Clear FCB to zeros
    ld h, d
    ld l, e
    ld (hl), 0
    push hl
    inc de
    ld bc, 35
    ldir
    pop hl                     ; HL = FCB base

    ; Fill name+ext fields (bytes 1-11) with spaces
    inc hl                     ; HL = &FCB[1]
    push hl
    ex de, hl                  ; DE = &FCB[1]
    ld b, 11
    ld a, ' '
.fill_sp:
    ld (de), a
    inc de
    djnz .fill_sp
    pop de                     ; DE = &FCB[1] (name start)

    pop hl                     ; Restore saved DE (FCB base, not needed)
    pop hl                     ; Restore source string pointer

    ; Skip leading spaces
.skip_spaces:
    ld a, (hl)
    cp ' '
    jr nz, .parse_name_start
    inc hl
    jr .skip_spaces

.parse_name_start:
    ; Check for drive prefix (e.g., "B:")
    ld a, (hl)
    call to_upper
    sub 'A'
    cp 16
    jr nc, .no_drive_prefix
    push af
    inc hl
    ld a, (hl)
    cp ':'
    jr nz, .not_drive_colon
    pop af
    inc a                       ; FCB drive: 1=A:, 2=B:, etc.
    dec de                      ; DE → FCB[0]
    ld (de), a
    inc de                      ; DE → FCB[1] again
    inc hl                      ; Skip past ':'
    jr .parse_name_go
.not_drive_colon:
    pop af
    dec hl                      ; Back to the letter
.no_drive_prefix:
.parse_name_go:
    push de                    ; Save &FCB[1]

    ; Parse name part (up to 8 chars, stop at '.', null, or space)
    ld b, 8
.parse_name:
    ld a, (hl)
    or a
    jr z, .parse_done
    cp ' '
    jr z, .parse_done
    cp '.'
    jr z, .parse_dot
    cp '?'
    jr z, .pfn_store
    cp '*'
    jr z, .pfn_star
    call to_upper
.pfn_store:
    ld (de), a
    inc hl
    inc de
    djnz .parse_name
    jr .skip_name
.pfn_star:
    ld a, '?'
    ld (de), a
    inc de
    djnz .pfn_star
.skip_name:
    ld a, (hl)
    or a
    jr z, .parse_done
    cp '.'
    jr z, .parse_dot
    cp ' '
    jr z, .parse_done
    inc hl
    jr .skip_name

.parse_dot:
    inc hl                     ; Skip the '.'
    pop de                     ; DE = &FCB[1]
    push de                    ; Re-save for .parse_done
    ; Advance DE to extension field: FCB[1] + 8 = FCB[9]
    ld a, 8
    add a, e
    ld e, a
    jr nc, .no_ext_carry
    inc d
.no_ext_carry:
    ld b, 3
.parse_ext:
    ld a, (hl)
    or a
    jr z, .parse_done
    cp ' '
    jr z, .parse_done
    cp '?'
    jr z, .pfe_store
    cp '*'
    jr z, .pfe_star
    call to_upper
.pfe_store:
    ld (de), a
    inc hl
    inc de
    djnz .parse_ext
    jr .parse_done
.pfe_star:
    ld a, '?'
    ld (de), a
    inc de
    djnz .pfe_star

.parse_done:
    ; Check we got at least one character
    pop de                     ; DE = &FCB[1]
    ld a, (de)
    cp ' '
    jr z, .parse_fail
    or a                       ; Clear carry = success
    ret
.parse_fail:
    scf
    ret


; "SUBMIT " prefix prepended to cmd_buf when CCP chains a .SUB hit
; through SUBMIT.COM.
str_submit_prefix:
    db 'SUBMIT '

; Command submitted on a cold start when PROFILE.SUB is on the default drive.
; PROFILE_CMD_LEN must match its length (the assert below keeps them in step).
PROFILE_CMD_LEN equ 18
str_profile_cmd:
    db 'SUBMIT PROFILE.SUB'
    db 0
    assert $ - str_profile_cmd == PROFILE_CMD_LEN + 1,         "PROFILE_CMD_LEN must match str_profile_cmd"

; SCB query used by DIR to pick its column count (conwidth at 0x1A)
scr_query_pb:
    db 0x1A, 0                   ; SCB offset=conwidth (0x1A), op=0 (get)

sub_drive_text:
    db 0, ':'                  ; "X:", the letter filled in when a .SUB is chained
ccp_force_com:
    db 0

; Name of the submit file; try_sub parses it into sub_fcb at each prompt.
str_sub_name:
    db "$$$.SUB", 0

; ==========================================================================
; Uninitialised data
;
; Everything below is RAM the CCP only writes before it reads: it is not
; part of CCP.COM, so it does not count against the 4K staging window.  The
; command buffer comes first: its two header bytes are the last bytes of the
; file and its text area follows them.
; ==========================================================================

; Command buffer for BDOS F10
cmd_buf:
    db 126                     ; Max characters
    db 0                       ; Characters read (filled by BDOS)

CMD_BUF_TEXT   equ cmd_buf + 2           ; 127 bytes of text
type_fcb       equ CMD_BUF_TEXT + 127    ; FCB of the file a command names
ren_fcb        equ type_fcb + 36         ; F23 FCB (old name 1..11, new 17..27)
ren_chk        equ ren_fcb + 36          ; F17 FCB for "does the new name exist"
ccp_prl_header equ ren_chk + 36          ; first 128 bytes of a PRL file's
                                         ; header (spots the 0xC9 prefix)
sub_fcb        equ ccp_prl_header + 128  ; working FCB for $$$.SUB
sub_dma        equ sub_fcb + 36          ; $$$.SUB record buffer; it lives
                                         ; outside 0x0080 so the command-tail
                                         ; setup cannot race an in-flight read
ccp_search_buf equ sub_dma + 128         ; SETDEF search path (F122)
ccp_cmdp       equ ccp_search_buf + 4    ; word: start of the command word
type_mode      equ ccp_cmdp + 2          ; word: con_mode saved by TYPE
ren_new        equ type_mode + 2         ; word: new name text
ren_old        equ ren_new + 2           ; word: old name text
ren_newname    equ ren_old + 2           ; 11 bytes: new name pattern
ren_drive      equ ren_newname + 11      ; drive of the rename (0 = default)
ren_skip       equ ren_drive + 1         ; files a REN left alone so far
ren_any        equ ren_skip + 1          ; non-zero once a REN renamed a file
ren_seen       equ ren_any + 1           ; files still to step over
dir_mode       equ ren_seen + 1          ; 0 = DIR, 0x80 = DIRSYS
dir_shown      equ dir_mode + 1          ; non-zero once a file was listed
dir_other      equ dir_shown + 1         ; non-zero if the other kind matched
dir_maxcols    equ dir_other + 1         ; columns for the DIR display
dir_display_drive equ dir_maxcols + 1    ; drive letter shown by DIR (0 = A:)
ccp_stack_base equ dir_display_drive + 1
ccp_stack      equ ccp_stack_base + 64   ; local stack grows down from here
