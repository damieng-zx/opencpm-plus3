; ==========================================================================
; Mini-CCP — Minimal Console Command Processor for CP/M 3.1
; ==========================================================================
;
; Runs at 0100h in the TPA (bank 0).
; Provides the A> prompt, reads commands via BDOS F10,
; and handles a few built-in commands.
;
; BDOS calls go through address 0005 (set up by BIOS).
;
; Assembled separately as CCP.COM and loaded from the boot disk by the
; BIOS (cold boot), staged in bank 7, then copied to 0100h.
;   sjasmplus --raw=build/CCP.COM build/zpa/miniccp.asm
;
; ==========================================================================

    org 0x0100

BDOS    equ 0x0005             ; BDOS entry point
FCB1    equ 0x005C             ; Default FCB 1
DMA     equ 0x0080             ; Default DMA / command tail
TPA_TOP equ 0xF600             ; First byte of common memory — initial stack top
CCP_FCB_ADDR equ 0xFB7F        ; common-memory FCB for the COM loader stub
CCP_CHAIN_ADDR equ 0xF607      ; SCB[0x07]: BDOS F47 chain pending
CCP_RC_ADDR    equ 0xF608      ; SCB[0x08]: program return code (F108)

; BDOS function numbers
F_CIN   equ 1                  ; Console input (blocking, echoes)
F_COUT  equ 2                  ; Console output (E = char)
F_PSTR  equ 9                  ; Print string (DE = addr, '$' terminated)
F_RDBUF equ 10                 ; Read console buffer (DE = buf addr)
F_CSTAT equ 11                 ; Console status
F_SCB   equ 49                 ; Get/Set SCB byte (DE→[offset,op]; op=0=get)
F_BIOS  equ 50                 ; Direct BIOS call (DE→8-byte BIOSPB)
F_CONMODE equ 109              ; Get/Set console mode word (F109)
F_GET_ORD  equ 120             ; Get SETDEF order byte (F120)
F_GET_PATH equ 122             ; Get SETDEF search path (DE = 4-byte buf)

CON_MODE_DISPLAY equ 0x02      ; con_mode bit 1: echo SUBmit lines

; SETDEF order byte values (must match BDOS bdos_order encoding).
ORDER_COM_SUB equ 0
ORDER_SUB_COM equ 1
ORDER_COM     equ 2
ORDER_SUB     equ 3

; ==========================================================================
; CCP Entry Point
; ==========================================================================

; @proc ccp_start
; @clobbers af,bc,de,hl
; @end
ccp_start:
    ld sp, ccp_stack           ; Local stack

    ; Rebuild ALV from directory (fn 13 Reset Disk System) but preserve
    ; the user's current drive across the reset — without this, running
    ; A:PROG from a B> prompt would drop us back to A> after PROG exits,
    ; because fn 13 resets cur_disk to A: per CP/M spec.
    ld c, 25                   ; F25: Return Current Disk
    call BDOS
    push af                    ; Save user's drive
    ld c, 13                   ; F13: Reset Disk System
    call BDOS
    pop af
    ld e, a
    ld c, 14                   ; F14: Select Disk — restore user's drive
    call BDOS

    ; BDOS F47 (chain to program) leaves a flag and the command tail at
    ; 0080h, then warm boots.  Consume it here instead of prompting.
    ld a, (CCP_CHAIN_ADDR)
    or a
    jr z, .no_chain
    xor a
    ld (CCP_CHAIN_ADDR), a
    ld a, (DMA)                ; tail length
    cp 126
    jr c, .chain_len_ok
    ld a, 126
.chain_len_ok:
    ld (cmd_buf + 1), a
    or a
    jr z, .no_chain            ; empty tail: nothing to chain to
    ld c, a
    ld b, 0
    ld hl, DMA + 1
    ld de, cmd_buf + 2
    ldir
    ld hl, cmd_buf + 2
    ld a, (cmd_buf + 1)
    ld e, a
    ld d, 0
    add hl, de
    ld (hl), 0
    jp .got_line

.no_chain:
    ; A new command from the console: clear the program return code.
    xor a
    ld (CCP_RC_ADDR), a
    ld (CCP_RC_ADDR + 1), a

.prompt:
    call try_sub
    jr c, .read_console

    call print_prompt
    ld de, 0xFFFF
    ld c, F_CONMODE
    call BDOS                  ; HL = con_mode
    ld a, l
    and CON_MODE_DISPLAY
    call nz, echo_sub_line
    jr .got_line

.read_console:
    call print_prompt
    ; Read command line
    ld de, cmd_buf
    ld c, F_RDBUF
    call BDOS

.got_line:
    ; Parse and execute
    call parse_cmd
    jr .prompt

; @proc print_prompt
; @clobbers af,bc,de,hl
; @end
print_prompt:
    ; Prompt: CRLF + drive letter (from BDOS) + '>'
    ld c, 25                   ; F25: Return Current Disk
    call BDOS                  ; A = current drive (0-15)
    ld (cur_drive), a

    ld e, 0x0D
    ld c, F_COUT
    call BDOS
    ld e, 0x0A
    ld c, F_COUT
    call BDOS
    ld a, (cur_drive)
    add a, 'A'
    ld e, a
    ld c, F_COUT
    call BDOS
    ld e, '>'
    ld c, F_COUT
    jp BDOS


; ==========================================================================
; parse_cmd — Parse the command buffer and dispatch
;   In:  cmd_buf filled by BDOS F10
;   Out: nothing (may not return if command reboots)
;   Clobbers: everything
; ==========================================================================
; @proc parse_cmd
; @clobbers af,bc,de,hl
; @end
parse_cmd:
    ld a, (cmd_buf + 1)        ; Characters read
    or a
    ret z                      ; Empty line — just re-prompt

    ; Null-terminate the command for easier parsing
    ld l, a
    ld h, 0
    ld de, cmd_buf + 2
    add hl, de
    ld (hl), 0                 ; Null terminate

    ; Point to start of command text
    ld hl, cmd_buf + 2

    ; Skip leading spaces
.skip_space:
    ld a, (hl)
    cp ' '
    jr nz, .got_cmd
    inc hl
    jr .skip_space

.got_cmd:
    ; Check for drive switch: "X:" where X is A-P, optionally followed by
    ; space, CR, or end of line. Dispatches to BDOS F14 (Select Disk).
    ld a, (hl)
    call to_upper
    cp 'A'
    jr c, .check_builtins
    cp 'P' + 1
    jr nc, .check_builtins
    ld b, a                    ; B = uppercase drive letter
    push hl
    inc hl
    ld a, (hl)
    cp ':'
    jr nz, .not_drive
    inc hl
    ld a, (hl)
    or a
    jr z, .do_drive_switch
    cp ' '
    jr z, .do_drive_switch
    cp 0x0D
    jr z, .do_drive_switch
.not_drive:
    pop hl
    jr .check_builtins
.do_drive_switch:
    pop hl
    ld a, b
    sub 'A'
    ld e, a
    ld c, 14                   ; F14: Select Disk
    call BDOS
    ret

.check_builtins:
    ; Check against built-in commands
    ld de, cmd_dir
    call str_match
    jr z, .do_dir

    ld de, cmd_type
    call str_match
    jp z, .do_type

    ld de, cmd_help
    call str_match
    jp z, .do_help

    ld de, cmd_era
    call str_match
    jp z, .do_era

    ld de, cmd_ren
    call str_match
    jp z, .do_ren

    ld de, cmd_user
    call str_match
    jp z, .do_user

    ; Not a built-in — try loading as .COM file
    ; HL still points to start of command text (str_match preserves HL)
    jp .do_load_com

; --- Built-in commands ---

.do_dir:
    ; Check for optional filename argument
.dir_skip_cmd:
    ld a, (hl)
    or a
    jr z, .dir_no_arg
    cp ' '
    jr z, .dir_found_space
    inc hl
    jr .dir_skip_cmd
.dir_found_space:
    inc hl
    ld a, (hl)
    cp ' '
    jr z, .dir_found_space
    or a
    jr z, .dir_no_arg
    ; HL points to argument — detect optional "X:" drive prefix
    ld c, 0
    ld a, (hl)
    call to_upper
    cp 'A'
    jr c, .dir_try_parse
    cp 'P' + 1
    jr nc, .dir_try_parse
    push hl
    inc hl
    ld a, (hl)
    cp ':'
    jr nz, .dir_not_drv
    pop hl
    ld a, (hl)
    call to_upper
    sub 'A' - 1
    ld c, a
    jr .dir_try_parse
.dir_not_drv:
    pop hl
.dir_try_parse:
    push bc
    call parse_filename
    pop bc
    jr nc, .dir_got_fcb
    ; Parse failed — use wildcard with detected drive (e.g. "DIR B:")
    ld a, c
    or a
    jr nz, .dir_wildcard_drv
    jr .dir_no_arg
.dir_got_fcb:
    ; Copy type_fcb to dir_fcb. parse_filename has already stamped the
    ; drive byte into type_fcb[0] (0 = default, 1=A:, 2=B:, ...).
    ld hl, type_fcb
    ld de, dir_fcb
    ld bc, 36
    ldir
.dir_check_ext:
    ; If ext is spaces (no explicit ext given), fill with '?' so
    ; DIR FOO matches FOO.* (standard CP/M behavior)
    ld hl, dir_fcb + 9
    ld a, (hl)
    cp ' '
    jr nz, .dir_search
    inc hl
    ld a, (hl)
    cp ' '
    jr nz, .dir_search
    inc hl
    ld a, (hl)
    cp ' '
    jr nz, .dir_search
    ld hl, dir_fcb + 9
    ld (hl), '?'
    inc hl
    ld (hl), '?'
    inc hl
    ld (hl), '?'
    jr .dir_search
.dir_wildcard_drv:
    ; A = drive number (1=A:, 2=B:, ...); fall through with drive saved
    ld b, a
    jr .wild_common
.dir_no_arg:
    ld b, 0                    ; default drive
.wild_common:
    ; Zero the whole FCB so stale EX/S1/S2/RC/AL/CR from a previous DIR
    ; can't bias Search First.
    push bc
    ld hl, dir_fcb
    ld de, dir_fcb + 1
    ld (hl), 0
    ld bc, 35
    ldir
    pop bc
    ld a, b
    ld (dir_fcb), a            ; drive byte (0 = default)
    ld hl, dir_fcb + 1
    ld b, 11
    ld a, '?'
.fill_q:
    ld (hl), a
    inc hl
    djnz .fill_q
.dir_search:
    ; Compute display drive for prefix from dir_fcb[0]
    ld a, (dir_fcb)
    or a
    jr nz, .dir_got_ddrv
    ld a, (cur_drive)
    jr .dir_ddrv_set
.dir_got_ddrv:
    dec a
.dir_ddrv_set:
    ld (dir_display_drive), a

    ; Compute columns from screen width (query SCB offset 0x1A = conwidth = cols-1)
    ; Each column = "FILENAME TYP" (13) + " : " (3) = 16 chars
    ; Plus "A: " prefix (3). Line = 3 + N*13 + (N-1)*3 = 16*N.
    ; So N = floor(SCR_WIDTH / 16).
    ld de, scr_query_pb
    ld c, F_SCB
    call BDOS
    inc a                      ; conwidth+1 = actual column count
    ld c, 0                    ; C = column count
.div16:
    sub 16
    jr c, .div_done
    inc c
    jr .div16
.div_done:
    ld a, c
    or a
    jr nz, .cols_ok
    inc c                      ; Minimum 1 column
.cols_ok:
    ld a, c
    ld (dir_maxcols), a

    ; Search first
    ld de, dir_fcb
    ld c, 17                   ; F17: Search First
    call BDOS
    cp 0xFF
    jp z, .dir_empty

    ld b, 0                    ; B = column counter (0-based)
.dir_loop:
    ; A = index (0-3) of match in DMA buffer
    ; Entry is at DMA + A*32
    push bc
    ld l, a
    ld h, 0
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl
    add hl, hl                ; HL = A * 32
    ld de, DMA
    add hl, de                 ; HL = entry address

    ; Skip entries with extent > 0 (avoid duplicate filenames)
    push hl
    ld de, 12
    add hl, de
    ld a, (hl)                 ; EX field
    pop hl
    or a
    jr nz, .dir_next_skip

    ; At start of line: print "A: " prefix; otherwise print " : " separator
    pop bc                     ; B = column counter
    push bc
    ld a, b
    or a
    jr nz, .mid_line
    ; Start of line — print drive prefix
    push hl
    ld a, (dir_display_drive)
    add a, 'A'
    ld e, a
    ld c, F_COUT
    call BDOS
    ld e, ':'
    ld c, F_COUT
    call BDOS
    ld e, ' '
    ld c, F_COUT
    call BDOS
    pop hl
    jr .print_entry
.mid_line:
    ; Mid-line — print separator before this entry
    push hl
    ld de, dir_sep
    ld c, F_PSTR
    call BDOS
    pop hl
.print_entry:

    ; Print filename: 8 chars name (space-padded)
    inc hl                     ; Skip user byte
    ld b, 8
.pr_name:
    ld a, (hl)
    and 0x7F                   ; Mask attribute bit
    push hl
    push bc
    ld e, a
    ld c, F_COUT
    call BDOS
    pop bc
    pop hl
    inc hl
    djnz .pr_name

    ; Space between name and type (where dot would be)
    push hl
    ld e, ' '
    ld c, F_COUT
    call BDOS
    pop hl

    ; Print type (3 chars, no dot — real CP/M style)
    ld b, 3
.pr_type:
    ld a, (hl)
    and 0x7F
    push hl
    push bc
    ld e, a
    ld c, F_COUT
    call BDOS
    pop bc
    pop hl
    inc hl
    djnz .pr_type

    ; Advance column
    pop bc                     ; B = column counter
    inc b
    ld a, (dir_maxcols)
    cp b                       ; Reached max columns?
    jr nz, .dir_next           ; Not yet — separator printed before next entry
    ; End of line
    push bc
    ld de, msg_crlf
    ld c, F_PSTR
    call BDOS
    pop bc
    ld b, 0                    ; Reset column
    jr .dir_next

.dir_next_skip:
    pop bc                     ; Balance the push bc at .dir_loop entry
.dir_next:
    ; Search next
    push bc
    ld c, 18                   ; F18: Search Next
    call BDOS
    pop bc
    cp 0xFF
    jp nz, .dir_loop

    ; Final newline
    ld de, msg_crlf
    ld c, F_PSTR
    call BDOS
    ret

.dir_empty:
    ld de, msg_no_files
    ld c, F_PSTR
    call BDOS
    ret

.do_type:
    ; Skip past "TYPE" in the command buffer to find the filename
.type_skip_cmd:
    ld a, (hl)
    cp ' '
    jr z, .type_skip_sp
    or a
    jr z, .type_no_arg
    inc hl
    jr .type_skip_cmd
.type_skip_sp:
    inc hl
    ld a, (hl)
    cp ' '
    jr z, .type_skip_sp
    or a
    jr z, .type_no_arg

    ; HL points to filename. Parse into FCB.
    call parse_filename        ; HL = filename string → type_fcb filled
    jr c, .type_no_arg         ; Carry = parse failed

    ; Open file
    ld de, type_fcb
    ld c, 15                   ; F15: Open File
    call BDOS
    cp 0xFF
    jr z, .type_not_found

    ; Read and print records until EOF
.type_loop:
    ; Set DMA to 0080h
    ld de, 0x0080
    ld c, 26                   ; F26: Set DMA
    call BDOS

    ; Read sequential
    ld de, type_fcb
    ld c, 20                   ; F20: Read Sequential
    call BDOS
    or a
    jr nz, .type_eof           ; Non-zero = EOF or error

    ; Print 128 bytes from DMA, stop at Ctrl-Z (0x1A)
    ld hl, 0x0080
    ld b, 128
.type_char:
    ld a, (hl)
    cp 0x1A                    ; Ctrl-Z = EOF marker
    jr z, .type_eof
    push hl
    push bc
    ld e, a
    ld c, 2                    ; F2: Console Output
    call BDOS
    pop bc
    pop hl
    inc hl
    djnz .type_char
    jr .type_loop

.type_eof:
    ; Print final newline
    ld e, 0x0D
    ld c, 2
    call BDOS
    ld e, 0x0A
    ld c, 2
    call BDOS
    ret

.type_no_arg:
    ld de, msg_type_usage
    ld c, F_PSTR
    call BDOS
    ret

.type_not_found:
    ld de, msg_type_nf
    ld c, F_PSTR
    call BDOS
    ret

.do_help:
    ld de, msg_help
    ld c, F_PSTR
    call BDOS
    ret


; ==========================================================================
; .do_era — ERA filespec: delete one or more files (F19, wildcards allowed)
;   An all-wildcard spec (ERA *.*) asks for confirmation, like CP/M.
; ==========================================================================

.do_era:
    ; Skip the command word
.era_skip_cmd:
    ld a, (hl)
    cp ' '
    jr z, .era_skip_sp
    or a
    jr z, .era_usage
    cp 0x0D
    jr z, .era_usage
    inc hl
    jr .era_skip_cmd
.era_skip_sp:
    inc hl
    ld a, (hl)
    cp ' '
    jr z, .era_skip_sp
    or a
    jr z, .era_usage
    cp 0x0D
    jr z, .era_usage

    ; HL = filespec.  parse_filename handles an optional "X:" prefix.
    call parse_filename
    jr c, .era_usage

    ; An all-wildcard spec needs an explicit Y, like the DRI CCP.
    call _era_all
    jr nz, .era_delete
    ld de, msg_era_all
    ld c, F_PSTR
    call BDOS
    ld c, F_CIN
    call BDOS
    push af
    ld de, msg_crlf
    ld c, F_PSTR
    call BDOS
    pop af
    cp 'Y'
    jr z, .era_delete
    cp 'y'
    jr z, .era_delete
    ret

.era_delete:
    ld de, type_fcb
    ld c, 19                   ; F19: Delete File (wildcards allowed)
    call BDOS
    inc a                      ; A = 0xFF (nothing matched) -> Z
    ret nz
    ld de, msg_no_file
    ld c, F_PSTR
    jp BDOS

.era_usage:
    ld de, msg_era_usage
    ld c, F_PSTR
    jp BDOS


; ==========================================================================
; .do_ren — REN new=old: rename a file (F23)
;   Wildcards are rejected: F23 renames every matching entry, so a wildcard
;   could rename several files to the same name.
; ==========================================================================

.do_ren:
    ; Skip the command word and any spaces
.ren_skip_cmd:
    ld a, (hl)
    cp ' '
    jr z, .ren_skip_sp
    or a
    jp z, .ren_usage
    cp 0x0D
    jp z, .ren_usage
    inc hl
    jr .ren_skip_cmd
.ren_skip_sp:
    inc hl
    ld a, (hl)
    cp ' '
    jr z, .ren_skip_sp
    or a
    jp z, .ren_usage
    cp 0x0D
    jp z, .ren_usage
    ld (ren_new), hl           ; start of the new name

    ; Find the separator.  "REN new=old" is the documented form; RENAME.COM
    ; style "REN new old" is accepted too, in the same new-then-old order.
    ; An '=' anywhere wins, so spaces around it do not confuse the split.
    ld hl, (ren_new)
.ren_find_eq:
    ld a, (hl)
    or a
    jr z, .ren_find_sp
    cp 0x0D
    jr z, .ren_find_sp
    cp '='
    jr z, .ren_got_sep
    inc hl
    jr .ren_find_eq
.ren_find_sp:
    ld hl, (ren_new)
.ren_sp_loop:
    ld a, (hl)
    or a
    jp z, .ren_usage
    cp 0x0D
    jp z, .ren_usage
    cp ' '
    jr z, .ren_got_sep
    inc hl
    jr .ren_sp_loop
.ren_got_sep:
    ld (hl), 0                 ; terminate the new name here
    inc hl
    ld (ren_old), hl

    ; --- New name ---
    ld hl, (ren_new)
    call parse_filename
    jp c, .ren_usage
    call _fcb_wild
    jr z, .ren_wild
    ld a, (type_fcb)
    ld (ren_drive), a
    ld hl, type_fcb + 1
    ld de, ren_fcb + 17        ; F23 expects the new name at 17..27
    ld bc, 11
    ldir

    ; --- Old name ---
    ld hl, (ren_old)
    call parse_filename
    jp c, .ren_usage
    call _fcb_wild
    jr z, .ren_wild
    ld a, (type_fcb)           ; an explicit old drive wins
    or a
    jr z, .ren_drive_done
    ld (ren_drive), a
.ren_drive_done:
    ld a, (ren_drive)
    ld (ren_fcb), a
    ld hl, type_fcb + 1
    ld de, ren_fcb + 1
    ld bc, 11
    ldir

    ; Zero the fields F23 must not see: EX/S1/S2/RC (12-15), the spare
    ; byte 16 and the tail (28-35).
    ld hl, ren_fcb + 12
    ld b, 5
.ren_zero_a:
    ld (hl), 0
    inc hl
    djnz .ren_zero_a
    ld hl, ren_fcb + 28
    ld b, 8
.ren_zero_b:
    ld (hl), 0
    inc hl
    djnz .ren_zero_b

    ld de, ren_fcb
    ld c, 23                   ; F23: Rename File
    call BDOS
    inc a                      ; 0xFF (nothing matched) -> Z
    ret nz
    ld de, msg_no_file
    ld c, F_PSTR
    jp BDOS

.ren_wild:
    ld de, msg_ren_wild
    ld c, F_PSTR
    jp BDOS

.ren_usage:
    ld de, msg_ren_usage
    ld c, F_PSTR
    jp BDOS


; ==========================================================================
; .do_user — USER [n]: show or change the CP/M user area (0-15)
;   Uses BDOS F32, which also keeps page-zero byte 0004h in sync for
;   programs that read it.
; ==========================================================================

.do_user:
    ; Skip the command word and any spaces
.user_skip_cmd:
    ld a, (hl)
    cp ' '
    jr z, .user_skip_sp
    or a
    jr z, .user_query
    cp 0x0D
    jr z, .user_query
    inc hl
    jr .user_skip_cmd
.user_skip_sp:
    inc hl
    ld a, (hl)
    cp ' '
    jr z, .user_skip_sp
    or a
    jr z, .user_query
    cp 0x0D
    jr z, .user_query

    ; First digit
    cp '0'
    jp c, .user_usage
    cp '9' + 1
    jp nc, .user_usage
    sub '0'
    ld b, a
    inc hl

    ; Optional second digit, so USER 10..15 works
    ld a, (hl)
    cp '0'
    jr c, .user_delim
    cp '9' + 1
    jr nc, .user_delim
    sub '0'
    ld c, a
    ld a, b
    add a, a                   ; ×2
    add a, a                   ; ×4
    add a, b                   ; ×5
    add a, a                   ; ×10
    add a, c
    ld b, a
    inc hl
.user_delim:
    ; The number must end at a delimiter
    ld a, (hl)
    or a
    jr z, .user_set
    cp ' '
    jr z, .user_set
    cp 0x0D
    jr z, .user_set
    jp .user_usage

.user_set:
    ld a, b
    cp 16
    jp nc, .user_usage
    ld e, a
    ld c, 32                   ; F32: Set User
    call BDOS
    ret

.user_query:
    ld e, 0xFF
    ld c, 32                   ; F32: Get User
    call BDOS
    push af
    ld de, str_user
    ld c, F_PSTR
    call BDOS
    pop af
    call print_decimal_a
    ld de, msg_crlf
    ld c, F_PSTR
    jp BDOS

.user_usage:
    ld de, msg_user_usage
    ld c, F_PSTR
    jp BDOS


; ==========================================================================
; .do_load_com — Try to load and execute COMMAND.COM
;   HL points to the command name in the input buffer.
;   Parse the name, append .COM, open, load to 0100h, execute.
; ==========================================================================
.do_load_com:
    ; Parse command name into com_fcb (reuse parse_filename)
    ; First, extract just the command name (up to space or null)
    call parse_filename        ; Fills type_fcb from (HL)
    jp c, .com_unknown         ; Parse error

    ; --- Build the working search-path list ---
    ; Explicit drive in the command (e.g. "B:FOO") uses just that drive.
    ; Otherwise pull the SETDEF search path. Either way, the result lands
    ; in ccp_search_buf and the rest of the code walks it identically.
    ld a, (type_fcb)
    or a
    jr z, .com_use_setdef_path
    ld (ccp_search_buf), a
    xor a
    ld (ccp_search_buf + 1), a
    ld (ccp_search_buf + 2), a
    ld (ccp_search_buf + 3), a
    jr .com_path_ready
.com_use_setdef_path:
    ld de, ccp_search_buf
    ld c, F_GET_PATH
    call BDOS
.com_path_ready:

    ; --- Apply ORDER: try the configured extensions in sequence ---
    ld c, F_GET_ORD
    call BDOS                  ; A = bdos_order
    cp ORDER_SUB_COM
    jr z, .com_order_sc
    cp ORDER_COM
    jr z, .com_order_c
    cp ORDER_SUB
    jr z, .com_order_s
    ; default / ORDER_COM_SUB
    call .com_try_com
    call .com_try_sub
    jp .com_unknown
.com_order_c:
    call .com_try_com
    jp .com_unknown
.com_order_s:
    call .com_try_sub
    jp .com_unknown
.com_order_sc:
    call .com_try_sub
    call .com_try_com
    jp .com_unknown

; .com_try_com / .com_try_sub — Walk ccp_search_buf with the given extension.
;   On success: tail-jumps to .com_opened (COM) or .com_chain_submit (SUB).
;   On miss: returns to caller so the next extension can be tried.
.com_try_com:
    ld a, 'C'
    ld (type_fcb + 9), a
    ld a, 'O'
    ld (type_fcb + 10), a
    ld a, 'M'
    ld (type_fcb + 11), a
    call .com_clear_fcb_tail
    call .com_walk_path
    ret nc
    jp .com_opened

.com_try_sub:
    ld a, 'S'
    ld (type_fcb + 9), a
    ld a, 'U'
    ld (type_fcb + 10), a
    ld a, 'B'
    ld (type_fcb + 11), a
    call .com_clear_fcb_tail
    call .com_walk_path
    ret nc
    ; Found a .SUB hit. Rewrite cmd_buf as "SUBMIT <orig>" and re-enter
    ; parse_cmd so the regular load path runs SUBMIT.COM (which the PRL
    ; loader now handles). SUBMIT will create A:$$$.SUB and the prompt
    ; loop's existing $$$.SUB drain takes over from there.
    xor a
    ld (ccp_chain_drive), a
    ld (ccp_chain_skip), a
    ld a, (type_fcb)
    or a
    jr z, .com_chain_len
    ld (ccp_chain_drive), a
    call .com_chain_has_drive
    jr nc, .com_chain_len
    xor a
    ld (ccp_chain_drive), a
.com_chain_len:
    ld a, (ccp_chain_drive)
    or a
    call nz, .com_chain_count_spaces
    ld a, (cmd_buf + 1)
    ld b, a
    ld a, (ccp_chain_skip)
    ld c, a
    ld a, b
    sub c
    add a, 7                   ; "SUBMIT " adds 7 chars
    ld b, a
    ld a, (ccp_chain_drive)
    or a
    ld a, b
    jr z, .com_chain_len_ready
    add a, 2                   ; injected "X:"
.com_chain_len_ready:
    cp 127
    jp nc, .com_unknown        ; rewritten command wouldn't fit
    push af                    ; save new length

    ; Move the original command text up in-place. LDDR is safe here because
    ; the destination is higher than the source. If a drive prefix is being
    ; injected, leading spaces are trimmed so the tail becomes "X:NAME".
    ld a, (cmd_buf + 1)
    ld b, a
    ld a, (ccp_chain_skip)
    ld c, a
    ld a, b
    sub c
    or a
    jr z, .com_chain_no_orig_shift
    ld c, a
    ld b, 0
    ld hl, cmd_buf + 2
    ld a, (ccp_chain_skip)
    add a, l
    ld l, a
    jr nc, .com_chain_src_start
    inc h
.com_chain_src_start:
    ld de, cmd_buf + 9
    ld a, (ccp_chain_drive)
    or a
    jr z, .com_chain_dst_start
    inc de
    inc de
.com_chain_dst_start:
    push bc
    dec bc
    add hl, bc
    ex de, hl
    add hl, bc
    ex de, hl
    pop bc
    lddr
.com_chain_no_orig_shift:

    ; cmd_buf+2 ← "SUBMIT " plus optional matched-drive prefix.
    ld hl, str_submit_prefix
    ld de, cmd_buf + 2
    ld bc, 7
    ldir

    ld a, (ccp_chain_drive)
    or a
    jr z, .com_chain_no_drive_back
    add a, 'A' - 1
    ld (de), a
    inc de
    ld a, ':'
    ld (de), a
    inc de
.com_chain_no_drive_back:
    pop af
    ld (cmd_buf + 1), a
    pop hl                     ; discard ORDER-dispatcher return
    jp parse_cmd

; .com_chain_has_drive — Check whether the original command already starts
;   with an explicit A:..P: drive after any leading spaces.
;   Out: CF=1 if a drive prefix is already present, CF=0 otherwise.
.com_chain_has_drive:
    ld hl, cmd_buf + 2
    ld a, (cmd_buf + 1)
    ld b, a
.chd_skip:
    ld a, b
    or a
    jr z, .chd_no
    ld a, (hl)
    cp ' '
    jr nz, .chd_check
    inc hl
    djnz .chd_skip
.chd_no:
    or a
    ret
.chd_check:
    ld a, b
    cp 2
    jr c, .chd_no
    ld a, (hl)
    call to_upper
    cp 'A'
    jr c, .chd_no
    cp 'P' + 1
    jr nc, .chd_no
    inc hl
    ld a, (hl)
    cp ':'
    jr nz, .chd_no
    scf
    ret

; .com_chain_count_spaces — Count leading spaces in cmd_buf for the SUBMIT
;   rewrite. Used only when injecting a matched search-path drive.
;   Out: ccp_chain_skip = count of leading spaces.
.com_chain_count_spaces:
    ld hl, cmd_buf + 2
    ld a, (cmd_buf + 1)
    ld b, a
    ld c, 0
.ccs_loop:
    ld a, b
    or a
    jr z, .ccs_done
    ld a, (hl)
    cp ' '
    jr nz, .ccs_done
    inc hl
    inc c
    djnz .ccs_loop
.ccs_done:
    ld a, c
    ld (ccp_chain_skip), a
    ret

.com_clear_fcb_tail:
    ld hl, type_fcb + 12
    ld b, 24
    xor a
.cft_loop:
    ld (hl), a
    inc hl
    djnz .cft_loop
    ret

; .com_walk_path — Walk ccp_search_buf attempting F15 with the current
;   extension on each non-empty drive slot.
;   Out: CF=1 if a hit was found (type_fcb left holding the matched drive),
;        CF=0 otherwise.
.com_walk_path:
    ld hl, ccp_search_buf
    ld b, 4
.wp_loop:
    ld a, (hl)
    or a
    jr z, .wp_next
    cp 0xFF
    jr nz, .wp_set
    xor a                      ; '*' → FCB drive = 0 (= current drive)
.wp_set:
    ld (type_fcb), a
    push hl
    push bc
    ld de, type_fcb
    ld c, 15                   ; F15: Open File
    call BDOS
    pop bc
    pop hl
    cp 0xFF
    jr nz, .wp_found
.wp_next:
    inc hl
    djnz .wp_loop
    or a                       ; CF=0, not found
    ret
.wp_found:
    scf                        ; CF=1, found
    ret

.com_opened:
    ; Peek at the first record to spot a CP/M 3 PRL/RSX prefix (file starts
    ; with 0xC9 RET). For these binaries the program is assembled as if
    ; loaded at 0x0100, so there's nothing to relocate — we just have to
    ; skip the 256-byte header before loading the rest. SUBMIT.COM and
    ; SET.COM both follow this convention (code spans 0x0100..end of file
    ; minus header, and all internal addresses already resolve into that
    ; range).
    ld de, ccp_prl_header
    ld c, 26                   ; F26: Set DMA
    call BDOS
    ld de, type_fcb
    ld c, 20                   ; F20: Read Sequential — consume record 0
    call BDOS
    or a
    jr nz, .com_reopen_classic

    ld a, (ccp_prl_header)
    cp 0xC9
    jr nz, .com_reopen_classic
    ld a, (ccp_prl_header + 1)
    or a
    jr nz, .com_reopen_classic
    ld a, (ccp_prl_header + 3)
    cp 0xC9
    jr z, .com_opened_prl

.com_reopen_classic:
    ; Classic .COM — rewind so the loader reads from record 0 again.
    ld de, type_fcb
    ld c, 16                   ; F16: Close File
    call BDOS
    ld de, type_fcb
    ld c, 15                   ; F15: Open File
    call BDOS
    cp 0xFF
    jp z, .com_unknown
    jr .com_do_load

.com_opened_prl:
    ; PRL/RSX — consume the second header record so the loader picks up at
    ; record 2 (start of program code). No relocation, no BSS zero — the
    ; reference utilities don't need either.
    ld de, ccp_prl_header
    ld c, 26
    call BDOS
    ld de, type_fcb
    ld c, 20
    call BDOS
    or a
    jp nz, .com_unknown

    ; (Command tail is set up after FCB parsing, so clear_fcb_de
    ; on FCB2 at 006Ch doesn't clobber the tail at 0080h.)

.com_do_load:
    ; Load .COM file to 0100h via a page-zero stub.
    ;
    ; The stub and its FCB copy live in page zero (0x0008+).
    ; The stub uses .stub_fcb (not 005Ch) for reading, so FCB1/FCB2
    ; at 005Ch/006Ch remain intact for the loaded program.
    ;
    ; Layout in page zero:
    ;   0x0008 .. 0x0008+stub_size-1 : loader stub code
    ;   .stub_fcb = 0x0008+stub_size  : 36-byte command FCB copy
    ;   0x0038                        : ISR vector (preserved: stub fits below)

    ; --- Parse arguments into FCB1 (005Ch) and FCB2 (006Ch) ---
    ; HL still points into cmd_buf after .com_found_space / .com_no_args.
    ; Re-scan from command tail to find the first argument.
    ld hl, cmd_buf + 2
.com_skip_cmd:
    ld a, (hl)
    or a
    jr z, .com_args_done       ; No args at all
    cp ' '
    jr z, .com_found_arg_space
    inc hl
    jr .com_skip_cmd
.com_found_arg_space:
    ; Skip spaces between command and first arg
    inc hl
    ld a, (hl)
    cp ' '
    jr z, .com_found_arg_space

    ; Parse first argument into FCB1 at 005Ch
    ld de, 0x005C
    or a                       ; Check if null (no arg)
    jr z, .com_clear_fcb2
    call parse_fcb             ; HL advanced past first arg

    ; Skip spaces between first and second arg
.com_skip_space2:
    ld a, (hl)
    or a
    jr z, .com_clear_fcb2
    cp ' '
    jr nz, .com_parse_arg2
    inc hl
    jr .com_skip_space2

.com_parse_arg2:
    ; Parse second argument into FCB2 at 006Ch
    ld de, 0x006C
    call parse_fcb
    jr .com_load_file

.com_args_done:
    ; No arguments — clear FCB1 at 005Ch
    ld de, 0x005C
    call .clear_fcb_de

.com_clear_fcb2:
    ; Clear FCB2 at 006Ch
    ld de, 0x006C
    call .clear_fcb_de

.com_load_file:
    ; --- Set up command tail at 0080h ---
    ; Done here (after FCB parsing) so clear_fcb_de on FCB2 at 006Ch
    ; doesn't clobber the tail at 0080h (006Ch + 36 = 0090h).
    ld hl, cmd_buf + 2
.com_skip_name:
    ld a, (hl)
    or a
    jr z, .com_no_tail
    cp ' '
    jr z, .com_found_space
    inc hl
    jr .com_skip_name
.com_found_space:
    ; HL points to space after command. Copy rest to 0081h+
    ld de, 0x0081
    ld b, 0                    ; Length counter
.com_copy_tail:
    ld a, (hl)
    or a
    jr z, .com_tail_done
    ld (de), a
    inc hl
    inc de
    inc b
    jr .com_copy_tail
.com_tail_done:
    ; Null-terminate so the loaded program's parser stops at end of
    ; tail rather than reading into whatever the last DMA left at
    ; 0x0081+length+ (e.g. DIR's F17 search results). Without this,
    ; RENAME.COM parses "rped.sub\0mno..." after a `dir *.sub`.
    xor a
    ld (de), a
    ld a, b
    ld (0x0080), a             ; Store tail length
    jr .com_tail_ready

.com_no_tail:
    xor a
    ld (0x0080), a             ; Empty tail
    ld (0x0081), a             ; ...with a null at [0x0081] too

.com_tail_ready:
    ; Copy type_fcb into the common-memory buffer reserved by the BIOS
    ; (ccp_fcb, just above COMMON_BASE).  A loaded program cannot reach
    ; it, unlike the old copy at F5DC which a large .COM overwrote while
    ; the loader stub was still reading it.
    ld hl, CCP_FCB_ADDR
    ld (.stub_fcb_addr), hl    ; Save for patching the stub
    ex de, hl                  ; DE = common FCB address
    ld hl, type_fcb
    ld bc, 36
    ldir

    ; Copy the loader stub to 0x0008
    ld hl, .stub_src
    ld de, 0x0008
    ld bc, .stub_src_end - .stub_src
    ldir

    ; Patch the stub's FCB address (the LD DE,xxxx at offset .stub_fcb_ref)
    ld hl, (.stub_fcb_addr)
    ld (0x0008 + .stub_fcb_ref - .stub_src + 1), hl

    ; Set SP to the top of the TPA (COMMON_BASE, not bdos_stub — the
    ; common SCB and visible BIOS table live above F600 and must not be
    ; overwritten by the program's stack).
    ld sp, TPA_TOP
    jp 0x0008

.stub_fcb_addr: dw 0          ; Patched FCB address in high TPA

    ; Helper: clear 36-byte FCB at DE (drive=0, name/ext=spaces, rest=0)
.clear_fcb_de:
    push de
    ld h, d
    ld l, e
    ld (hl), 0
    inc de
    ld b, 11
    ld a, ' '
.clr_name:
    ld (de), a
    inc de
    djnz .clr_name
    xor a
    ld b, 24
.clr_rest:
    ld (de), a
    inc de
    djnz .clr_rest
    pop de
    ret

    ; The stub is position-independent (JR=relative, CALL/JP=absolute).
    ; The FCB address in the LD DE below is patched by the CCP before jumping here.
.stub_src:
    ld hl, 0x0100              ; Load address
.stub_loop:
    push hl
    ld d, h
    ld e, l
    ld c, 26                   ; F26: Set DMA
    call 0x0005
    pop hl
    push hl
.stub_fcb_ref:
    ld de, 0x0000              ; FCB in high TPA (PATCHED by CCP before jump)
    ld c, 20                   ; F20: Read Sequential
    call 0x0005
    pop hl
    or a
    jr nz, .stub_done          ; EOF/error → done loading
    ld de, 128
    add hl, de
    jr .stub_loop
.stub_done:
    ; Reset DMA, then jump to loaded program.
    ; Per CP/M convention, the transient program is entered with
    ; C = currently selected drive so utilities like STAT can recover it.
    ld de, 0x0080
    ld c, 26
    call 0x0005
    ld c, 25                   ; F25: Return Current Disk
    call 0x0005
    ld c, a                    ; C = current drive (0=A:, 1=B:, ...)
    jp 0x0100
.stub_src_end:

    ; (Loading and execution handled by stub at 0x0008)

.com_unknown:
    ld de, msg_unknown
    ld c, F_PSTR
    call BDOS
    ret




; ==========================================================================
; str_match — Case-insensitive match of (HL) against (DE)
;   DE points to uppercase null-terminated command name.
;   HL points to input text.
;   Match succeeds if input starts with the command (followed by
;   space, null, or end of input).
;   Out: Z flag set if match
;   Clobbers: AF
; ==========================================================================
; @proc str_match
; @param %input:u16  hl
; @param %pattern:u16 de
; @out   zero
; @clobbers af,bc,de,hl
; @end
str_match:
    push hl
    push de
.loop:
    ld a, (de)
    or a
    jr z, .end_pattern         ; End of pattern — check delimiter
    ; Compare with input (case-insensitive)
    ld a, (hl)
    call to_upper
    push af
    ld a, (de)
    ld b, a                    ; B = pattern char (already upper)
    pop af                     ; A = input char (uppercased)
    cp b
    jr nz, .no_match
    inc hl
    inc de
    jr .loop

.end_pattern:
    ; Pattern ended — input must be at space, null, or end
    ld a, (hl)
    or a
    jr z, .match               ; Null = match
    cp ' '
    jr z, .match               ; Space = match
    cp 0x0D
    jr z, .match               ; CR = match
    ; Fall through: no match (input has more chars)

.no_match:
    pop de
    pop hl
    or 1                       ; Clear Z flag
    ret

.match:
    pop de
    pop hl
    xor a                      ; Set Z flag
    ret


; ==========================================================================
; _era_all — Z if the parsed spec is all wildcards (ERA *.*)
;   Out: Z set when all 11 name/extension bytes are '?'
;   Clobbers: AF, B, HL
; ==========================================================================
; @proc _era_all
; @out   zero
; @clobbers af,b,hl
; @end
_era_all:
    ld hl, type_fcb + 1
    ld b, 11
.era_all_loop:
    ld a, (hl)
    cp '?'
    ret nz
    inc hl
    djnz .era_all_loop
    xor a                      ; every byte is '?' — Z set
    ret


; ==========================================================================
; _fcb_wild — Z if the FCB in type_fcb contains a '?' wildcard
;   Out: Z set when any name/extension byte is '?'
;   Clobbers: AF, B, HL
; ==========================================================================
; @proc _fcb_wild
; @out   zero
; @clobbers af,b,hl
; @end
_fcb_wild:
    ld hl, type_fcb + 1
    ld b, 11
.fw_loop:
    ld a, (hl)
    cp '?'
    ret z
    inc hl
    djnz .fw_loop
    ld a, 1
    or a                       ; NZ: no wildcard found
    ret


; ------------------------------------------------------------------
; to_upper — Convert A to uppercase if lowercase
;   In:  A = character
;   Out: A = uppercased character
;   Clobbers: (none besides A)
; ------------------------------------------------------------------
; @proc to_upper
; @param %ch:u8 a
; @out   a
; @end
to_upper:
    cp 'a'
    ret c
    cp 'z' + 1
    ret nc
    sub 0x20                   ; 'a' - 'A' = 0x20
    ret


; ==========================================================================
; try_sub — If A:$$$.SUB is active, load the next line into cmd_buf and echo
;   it; otherwise leave cmd_buf untouched.
;
;   $$$.SUB record layout (128 bytes):
;     byte 0  : length L, or 0xFF if the record has been consumed
;     1..L    : command text (no terminator; L <= 126)
;
;   Records are consumed from the highest index downwards — SUBMIT writes the
;   commands in reverse execution order so the *last* record is the *first*
;   line to run. Consuming a record is just overwriting byte 0 with 0xFF; we
;   never rewrite or rename the file. Once every record is consumed (or on any
;   error) the file is deleted.
;
;   Out: carry clear if cmd_buf was filled from SUB (skip F10 read)
;        carry set if no SUB line is available (caller should F10)
;   Clobbers: AF, BC, DE, HL
; @proc try_sub
; @out   carry
; @clobbers af,bc,de,hl
; @end
try_sub:
    ld hl, sub_fcb_init
    ld de, sub_fcb
    ld bc, 36
    ldir

    ; SUBMIT creates $$$.SUB on the current drive, not necessarily A:.
    ld c, 25                   ; F25: Return Current Disk
    call BDOS
    inc a                      ; 1-based drive for the FCB
    ld (sub_fcb), a

    ld de, sub_fcb
    ld c, 15                   ; F15: Open File
    call BDOS
    cp 0xFF
    jr nz, .opened
    scf                        ; No $$$.SUB on the current drive
    ret

.opened:
    ld de, sub_fcb
    ld c, 35                   ; F35: Compute File Size → R0/R1/R2
    call BDOS

    ld a, (sub_fcb + 35)
    or a
    jp nz, .abort              ; > 16M records: bogus, nuke it
    ld a, (sub_fcb + 34)
    ld h, a
    ld a, (sub_fcb + 33)
    ld l, a
    or h
    jp z, .all_done            ; Zero-length file

    dec hl                     ; HL = index of last record

.scan:
    ld a, l
    ld (sub_fcb + 33), a
    ld a, h
    ld (sub_fcb + 34), a
    xor a
    ld (sub_fcb + 35), a

    push hl
    ld de, sub_dma
    ld c, 26                   ; F26: Set DMA
    call BDOS

    ld de, sub_fcb
    ld c, 33                   ; F33: Read Random
    call BDOS
    or a
    pop hl
    jp nz, .abort              ; read error

    ld a, (sub_dma)
    cp 0xFF
    jr nz, .found

    ld a, h
    or l
    jp z, .all_done            ; record 0 was already consumed — done
    dec hl
    jr .scan

.found:
    ; A = length byte, HL = record index (random record still set in FCB)
    cp 127
    jp nc, .abort              ; garbage length

    ld (cmd_buf + 1), a
    or a
    jr z, .copied              ; empty line
    ld c, a
    ld b, 0
    push hl
    ld hl, sub_dma + 1
    ld de, cmd_buf + 2
    ldir
    pop hl
    xor a
    ld (de), a                 ; NUL-terminate for parse_cmd
.copied:
    ; Mark this record consumed (byte 0 = 0xFF), write back to same record.
    ld a, 0xFF
    ld (sub_dma), a
    ld de, sub_fcb
    ld c, 34                   ; F34: Write Random
    call BDOS

    ld de, sub_fcb
    ld c, 16                   ; F16: Close File
    call BDOS
    call restore_dma

    ld de, 0xFFFF
    ld c, F_CONMODE
    call BDOS                  ; HL = con_mode
    ld a, l
    and CON_MODE_DISPLAY
    call nz, echo_sub_line     ; DISPLAY on → echo the SUB line
    xor a                      ; CF=0 → cmd_buf is loaded
    ret

.all_done:
.abort:
    ld de, sub_fcb
    ld c, 16                   ; F16: Close (harmless if never fully opened)
    call BDOS
    ld de, sub_fcb
    ld c, 19                   ; F19: Delete File
    call BDOS
    call restore_dma
    scf
    ret


; ------------------------------------------------------------------
; restore_dma — point the BDOS DMA back at 0x0080 after $$$.SUB I/O.
;   The CCP's DIR built-in (and loaded programs) expect 0x0080.
; @proc restore_dma
; @clobbers af,bc,de
; @end
restore_dma:
    ld de, 0x0080
    ld c, 26                   ; F26: Set DMA
    call BDOS
    ret


; ==========================================================================
; echo_sub_line — Print cmd_buf text + CRLF so a SUB line is visible after
;   the prompt the same way a typed command would be.
;   Clobbers: AF, BC, DE, HL
; ==========================================================================
; @proc echo_sub_line
; @clobbers af,bc,de,hl
; @end
echo_sub_line:
    ld a, (cmd_buf + 1)
    or a
    jr z, .crlf
    ld b, a
    ld hl, cmd_buf + 2
.loop:
    ld a, (hl)
    push hl
    push bc
    ld e, a
    ld c, F_COUT
    call BDOS
    pop bc
    pop hl
    inc hl
    djnz .loop
.crlf:
    ld e, 0x0D
    ld c, F_COUT
    call BDOS
    ld e, 0x0A
    ld c, F_COUT
    jp BDOS


; ==========================================================================
; Data
; ==========================================================================

; Command buffer for BDOS F10
cmd_buf:
    db 126                     ; Max characters
    db 0                       ; Characters read (filled by BDOS)
    ds 127                     ; Character data

; Command names (uppercase, null-terminated)
cmd_dir:    db "DIR", 0
cmd_type:   db "TYPE", 0
cmd_era:    db "ERA", 0
cmd_ren:    db "REN", 0
cmd_user:   db "USER", 0
cmd_help:   db "HELP", 0

; Messages ('$' terminated for BDOS F9)
msg_version:
    db "CP/M 3.1 Mini-CCP v0.1", 0x0D, 0x0A, '$'

msg_unknown:
    db "?", 0x0D, 0x0A, '$'

msg_no_files:
    db "No files", 0x0D, 0x0A, '$'

msg_crlf:
    db 0x0D, 0x0A, '$'

dir_sep:
    db " : ", '$'

msg_type_usage:
    db "TYPE filename.ext", 0x0D, 0x0A, '$'

msg_type_nf:
    db "File not found", 0x0D, 0x0A, '$'

msg_era_usage:
    db "ERA filespec", 0x0D, 0x0A, '$'

msg_era_all:
    db "ALL (Y/N)? $"

msg_no_file:
    db "No file", 0x0D, 0x0A, '$'

msg_ren_usage:
    db "REN new=old", 0x0D, 0x0A, '$'

msg_ren_wild:
    db "No wildcards", 0x0D, 0x0A, '$'

str_user:
    db "User $"

msg_user_usage:
    db "USER n (0-15)", 0x0D, 0x0A, '$'

msg_help:
    db "Built-in commands:", 0x0D, 0x0A
    db "  DIR    - Directory listing (wildcards: * ?)", 0x0D, 0x0A
    db "  TYPE   - Display file", 0x0D, 0x0A
    db "  ERA    - Erase files (wildcards: * ?)", 0x0D, 0x0A
    db "  REN    - Rename file (new=old)", 0x0D, 0x0A
    db "  USER   - Show/set the user area (0-15)", 0x0D, 0x0A
    db "  HELP   - This help", 0x0D, 0x0A
    db '$'

; ------------------------------------------------------------------
; print_hex16 — Print HL as 4-digit hex
;   In: HL = value
;   Clobbers: AF, BC, DE, HL
; ------------------------------------------------------------------
; @proc print_hex16
; @param %val:u16 hl
; @clobbers af,bc,de,hl
; @end
print_hex16:
    ld a, h
    call print_hex8
    ld a, l
    jp print_hex8

; ------------------------------------------------------------------
; print_hex8 — Print A as 2-digit hex
;   In: A = value
;   Clobbers: AF, BC, DE
; ------------------------------------------------------------------
; @proc print_hex8
; @param %val:u8 a
; @clobbers af,bc,de
; @end
print_hex8:
    push af
    rrca
    rrca
    rrca
    rrca
    call .nibble
    pop af
.nibble:
    and 0x0F
    add a, '0'
    cp '9' + 1
    jr c, .digit
    add a, 'A' - '0' - 10
.digit:
    ld e, a
    ld c, 2
    jp BDOS

; ------------------------------------------------------------------
; print_crlf — Print CR+LF
; ------------------------------------------------------------------
; @proc print_crlf
; @clobbers af,bc,de
; @end
print_crlf:
    ld e, 0x0D
    ld c, 2
    call BDOS
    ld e, 0x0A
    ld c, 2
    jp BDOS


; ------------------------------------------------------------------
; print_decimal_a — Print A as decimal (handles 0-99)
;   In:  A = value
;   Clobbers: AF, BC, DE
; ------------------------------------------------------------------
; @proc print_decimal_a
; @param %val:u8 a
; @clobbers af,bc,de
; @end
print_decimal_a:
    ld b, 0
.pda_tens:
    sub 10
    jr c, .pda_ones
    inc b
    jr .pda_tens
.pda_ones:
    add a, 10              ; A = ones digit
    push af
    ld a, b
    or a
    jr z, .pda_no_tens
    add a, '0'
    ld e, a
    ld c, F_COUT
    call BDOS
.pda_no_tens:
    pop af
    add a, '0'
    ld e, a
    ld c, F_COUT
    jp BDOS


; ------------------------------------------------------------------
; parse_filename — Parse "FILENAME.EXT" at HL into type_fcb
;   In: HL = pointer to null-terminated filename string
;   Out: type_fcb filled, HL = first char after parsed name
;        carry clear = OK, carry set = error
;   Clobbers: AF, BC, DE, HL
; ------------------------------------------------------------------
; @proc parse_filename
; @param %str:u16 hl
; @out   carry
; @clobbers af,bc,de,hl
; @end
parse_filename:
    ; Strip optional "X:" drive prefix so we can handle commands like
    ; "a:foo" or "B:TEST" — skip the prefix and remember the drive so
    ; we can patch FCB byte 0 (drive: 0=default, 1=A, 2=B, ...) after
    ; parse_fcb clears the FCB.
    xor a
    ld b, a                    ; B = drive override (0 = default)
    ld a, (hl)
    or a
    jr z, .pf_do_parse         ; empty — let parse_fcb fail
    ; Uppercase the first char in-place for comparison (we may back out)
    cp 'a'
    jr c, .pf_upper_done
    cp 'z' + 1
    jr nc, .pf_upper_done
    sub 32
.pf_upper_done:
    cp 'A'
    jr c, .pf_do_parse
    cp 'P' + 1
    jr nc, .pf_do_parse
    ; A = uppercase drive letter candidate. Peek next char for ':'.
    push af
    inc hl
    ld a, (hl)
    cp ':'
    jr z, .pf_got_drive
    dec hl                     ; not "X:" — restore HL, discard drive
    pop af
    jr .pf_do_parse
.pf_got_drive:
    pop af
    sub 'A' - 1                ; drive number 1=A, 2=B, ...
    ld b, a
    inc hl                     ; skip past ':'
.pf_do_parse:
    ld de, type_fcb
    push bc
    call parse_fcb             ; fills type_fcb; clears FCB byte 0; carry=error
    pop bc
    ret c                      ; propagate parse error
    ld a, b
    or a                       ; clears carry
    ret z                      ; no drive override — success, carry clear
    ld (type_fcb), a           ; patch FCB drive byte
    or a                       ; clear carry (success)
    ret

; ------------------------------------------------------------------
; parse_fcb — Parse "FILENAME.EXT" at HL into FCB at DE
;   In: HL = pointer to null-terminated filename string
;        DE = destination FCB (36 bytes)
;   Out: FCB filled, HL = first char after parsed name (space/null)
;        carry clear = OK, carry set = error
;   Clobbers: AF, BC, DE, HL
; ------------------------------------------------------------------
; @proc parse_fcb
; @param %str:u16 hl
; @param %fcb:u16 de
; @out   carry
; @clobbers af,bc,de,hl
; @end
parse_fcb:
    push hl
    push de
    ; Clear FCB to zeros
    ld h, d
    ld l, e
    ld (hl), 0
    push hl
    inc de
    ld bc, 35
    ldir
    pop hl                     ; HL = FCB base

    ; Fill name+ext fields (bytes 1-11) with spaces
    inc hl                     ; HL = &FCB[1]
    push hl
    ex de, hl                  ; DE = &FCB[1]
    ld b, 11
    ld a, ' '
.fill_sp:
    ld (de), a
    inc de
    djnz .fill_sp
    pop de                     ; DE = &FCB[1] (name start)

    pop hl                     ; Restore saved DE (FCB base, not needed)
    pop hl                     ; Restore source string pointer

    ; Skip leading spaces
.skip_spaces:
    ld a, (hl)
    cp ' '
    jr nz, .parse_name_start
    inc hl
    jr .skip_spaces

.parse_name_start:
    ; Check for drive prefix (e.g., "B:")
    ld a, (hl)
    call to_upper
    sub 'A'
    cp 16
    jr nc, .no_drive_prefix
    push af
    inc hl
    ld a, (hl)
    cp ':'
    jr nz, .not_drive_colon
    pop af
    inc a                       ; FCB drive: 1=A:, 2=B:, etc.
    dec de                      ; DE → FCB[0]
    ld (de), a
    inc de                      ; DE → FCB[1] again
    inc hl                      ; Skip past ':'
    jr .parse_name_go
.not_drive_colon:
    pop af
    dec hl                      ; Back to the letter
.no_drive_prefix:
.parse_name_go:
    push de                    ; Save &FCB[1]

    ; Parse name part (up to 8 chars, stop at '.', null, or space)
    ld b, 8
.parse_name:
    ld a, (hl)
    or a
    jr z, .parse_done
    cp ' '
    jr z, .parse_done
    cp '.'
    jr z, .parse_dot
    cp '?'
    jr z, .pfn_store
    cp '*'
    jr z, .pfn_star
    call to_upper
.pfn_store:
    ld (de), a
    inc hl
    inc de
    djnz .parse_name
    jr .skip_name
.pfn_star:
    ld a, '?'
    ld (de), a
    inc de
    djnz .pfn_star
.skip_name:
    ld a, (hl)
    or a
    jr z, .parse_done
    cp '.'
    jr z, .parse_dot
    cp ' '
    jr z, .parse_done
    inc hl
    jr .skip_name

.parse_dot:
    inc hl                     ; Skip the '.'
    pop de                     ; DE = &FCB[1]
    push de                    ; Re-save for .parse_done
    ; Advance DE to extension field: FCB[1] + 8 = FCB[9]
    ld a, 8
    add a, e
    ld e, a
    jr nc, .no_ext_carry
    inc d
.no_ext_carry:
    ld b, 3
.parse_ext:
    ld a, (hl)
    or a
    jr z, .parse_done
    cp ' '
    jr z, .parse_done
    cp '?'
    jr z, .pfe_store
    cp '*'
    jr z, .pfe_star
    call to_upper
.pfe_store:
    ld (de), a
    inc hl
    inc de
    djnz .parse_ext
    jr .parse_done
.pfe_star:
    ld a, '?'
    ld (de), a
    inc de
    djnz .pfe_star

.parse_done:
    ; Check we got at least one character
    pop de                     ; DE = &FCB[1]
    ld a, (de)
    cp ' '
    jr z, .parse_fail
    or a                       ; Clear carry = success
    ret
.parse_fail:
    scf
    ret


; FCB for TYPE command
type_fcb:
    ds 36

; REN state: the two halves of "REN new=old" are parsed into type_fcb in
; turn, then assembled into ren_fcb for F23 (old name 1..11, new 17..27).
ren_new:   dw 0
ren_old:   dw 0
ren_drive: db 0
ren_fcb:   ds 36

; DIR state
cur_drive:        db 0               ; Current drive (0=A:)
dir_maxcols:      db 3               ; Columns for DIR display
dir_display_drive: db 0              ; Drive to display in prefix (0=A:)

; SCB query used by DIR to pick its column count (conwidth at 0x1A)
scr_query_pb:
    db 0x1A, 0                   ; SCB offset=conwidth (0x1A), op=0 (get)

; FCB for DIR command
dir_fcb:
    ds 36

; Buffer for SETDEF search path fetched via F_GET_PATH during command load
ccp_search_buf:
    ds 4

; "SUBMIT " prefix prepended to cmd_buf when CCP chains a .SUB hit
; through SUBMIT.COM.
str_submit_prefix:
    db 'SUBMIT '

ccp_chain_drive:
    db 0
ccp_chain_skip:
    db 0

; First 128 bytes of a PRL file's header — used to spot the 0xC9 prefix
; before deciding how many records to skip in the loader.
ccp_prl_header:
    ds 128

; FCB template for A:$$$.SUB — copied into sub_fcb at each prompt
sub_fcb_init:
    db 1                       ; drive 1 = A: (we only look on A:)
    db "$$$     "              ; name, space-padded to 8
    db "SUB"                   ; ext
    ds 24                      ; EX, S1, S2, RC, alloc map, CR, R0..R2 = 0

sub_fcb:
    ds 36

; DMA buffer for $$$.SUB record I/O. Lives outside 0x0080 so parse_cmd's
; command-tail setup doesn't race with an in-flight read.
sub_dma:
    ds 128

; Stack
    ds 64
ccp_stack:
