      ],
      "frames": 5000,
      "notes": "BASIC-80 compiler: compile CHELLO.BAS with /O (stand-alone), link with OBSLIB and run the resulting CHELLO.COM. BASCOM53.ZIP is an OEM build whose start-up probes a bank-switched machine (ports 0/1 and 0EF08h) and exits on a standard CP/M memory map; BASCOM.ZIP carries the generic build.",
      "steps": [
        {
          "text": "L80 CHELLO,OBSLIB,CHELLO/N/E",
          "frames": 5000,
          "expect": [
            "Data",
            "Bytes Free",
            "]"
